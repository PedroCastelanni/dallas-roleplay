				if(WantedLevel[sscanfid] != 0)
				{
				    return SendClientMessage(playerid, COR_GREY, "Este jogador est� procurado !");
				}
				if(IsPlayerConnected(sscanfid))
				{
				    if(sscanfid != INVALID_PLAYER_ID)
				    {
						if(TipoEvento == 1)
