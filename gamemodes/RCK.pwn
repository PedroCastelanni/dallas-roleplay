										return 1;
									}
									if (Mobile[sscanfid] == 255)
									{
										format(stringZCMD, sizeof(stringZCMD), "Seu celular est� tocando (/At) Chamando: %s", sendername);
										SendClientMessage(sscanfid, COR_AMARELO, stringZCMD);
										GetPlayerName(sscanfid, sendername, sizeof(sendername));
										RingTone[sscanfid] = 10;
										format(stringZCMD, sizeof(stringZCMD), "* %s's est� tocando o celular.", sendername);
										ProxDetector(30.0, i, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
										SendClientMessage(playerid, COR_MSG, "{0099ff}�{ffffff} USE: 'T' para falar, digite /des para desligar");
										CellTime[playerid] = 1;
										SBizzInfo[7][sbTill] += 500;
										ExtortionSBiz(7, 500);
										new Conta = CofreOrg[7][Dinheiro] + 250;
										DepositarGranaOrg(7, Conta);
										return 1;
									}
								}
							}
						}
					}
				}
				SendClientMessage(playerid, COR_GRAD2, "Voc� acabou de ligar para um n�mero ocupado...");
			}
		}
		return 1;
	}
