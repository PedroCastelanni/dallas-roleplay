				Dominando[playerid] = 1;
				MenuTR[playerid] = 0;
				ProvocoPark[playerid] = 1;
				GuerranoPark = 1;
				TempoGuerraPark = SetTimerEx("GuerraInd", 60000, 0, "i", playerid);
				return 1;
