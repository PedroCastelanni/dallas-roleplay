								EditarLog(stringZCMD);
							}
							default:
							{
								return SendClientMessage(playerid, COR_AMARELO, "{FFFF00}!{FFFFFF} nao reconhecermos esse codigo");
							}

						}
						ABroadCast(COR_AMARELO,stringZCMD,1);
					}
					else
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o esta autorizado a usar este comando!");
					}
				}
