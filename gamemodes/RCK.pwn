	    	PlayerTextDrawSetString(playerid, SedePosetagem[playerid], str);
			//PlayerTextDrawTextSize(playerid, BarraSede[playerid], 533, 1.0 );
			//PlayerTextDrawShow(playerid, BarraSede[playerid]);
		}
		retirada[playerid] ++;
	    TextDrawShowForPlayer(playerid, FomeSedeTDTD[0]);
		TextDrawShowForPlayer(playerid, FomeSedeTDTD[1]);
		TextDrawShowForPlayer(playerid, FomeSedeTDTD[2]);
		TextDrawShowForPlayer(playerid, FomeSedeTDTD[3]);
		PlayerTextDrawShow(playerid, FomePosetagem[playerid]);
		PlayerTextDrawShow(playerid, SedePosetagem[playerid]);
		if(retirada[playerid] == 150)
		{
			if(vidaplayer > 5)
			{
			    if(PlayerInfo[playerid][pFome] < 10  || PlayerInfo[playerid][pSede] < 10)
			    {
	                PlayerInfo[playerid][pFome] -- ;
	                PlayerInfo[playerid][pSede] -= random(2);
			        if(PlayerInfo[playerid][pFome] < 1)PlayerInfo[playerid][pFome] = 1;
	                if(PlayerInfo[playerid][pSede] < 1)PlayerInfo[playerid][pSede] = 1;

			        if(vidaplayer >10 )
	                {
	                    SetPlayerHealth(playerid, vidaplayer - 10);
	                }
	                else if(vidaplayer >6 )
	                {
	                    SetPlayerHealth(playerid, vidaplayer - 6);
	                }
	                else if(vidaplayer >3 )
	                {
	                    SetPlayerHealth(playerid, vidaplayer - 3);
	                }
					if(PlayerInfo[playerid][pFome] < 10){
						SendClientMessage(playerid, COR_LIGHTBLUE, "{FFFF00}[FOME BAIXA]{ffffff} Voce esta com fome, procure uma lanchonete e va comer.");
					}
					if(PlayerInfo[playerid][pSede] < 10){
						SendClientMessage(playerid, COR_LIGHTBLUE, "{FFFF00}[SEDE BAIXA]{ffffff} Voc� esta com sede, procure uma lanchonete e va beber algo.");
					}
			        retirada[playerid] = 0;
			        return 1;
			    }

			    if(PlayerInfo[playerid][pFome] < 25 || PlayerInfo[playerid][pSede] < 25)
			    {
			        PlayerInfo[playerid][pFome] -- ;
	                PlayerInfo[playerid][pSede] -= random(2);
			        if(PlayerInfo[playerid][pFome] < 1)PlayerInfo[playerid][pFome] = 1;
	                if(PlayerInfo[playerid][pSede] < 1)PlayerInfo[playerid][pSede] = 1;
	                if(vidaplayer >5 )
	                {
	                    SetPlayerHealth(playerid, vidaplayer - 5);
	                }
	                retirada[playerid] = 0;
			        return 1;
			    }
			    if(PlayerInfo[playerid][pFome] < 50 || PlayerInfo[playerid][pSede] < 50 )
			    {
	                PlayerInfo[playerid][pFome] -- ;
	                PlayerInfo[playerid][pSede] -= random(2);
	                if(PlayerInfo[playerid][pFome] < 1)PlayerInfo[playerid][pFome] = 1;
	                if(PlayerInfo[playerid][pSede] < 1)PlayerInfo[playerid][pSede] = 1;
	                if(vidaplayer >2 )
	                {
	                    SetPlayerHealth(playerid, vidaplayer - 2);
	                }
	                retirada[playerid] = 0;
					return 1;
				}
				PlayerInfo[playerid][pFome] -- ;
	   			PlayerInfo[playerid][pSede] -= random(2);
	            retirada[playerid] = 0;
			}
		}
	}
	return 1;
}
new IncomingConnection[iI];
public OnIncomingConnection(playerid, ip_address[], port)
{
	if(!strcmp(IncomingConnection[IncomingIP], ip_address, true) && IncomingConnection[IncomingTempo] > gettime()) {
		if(IncomingConnection[IncomingVezes] > 3) return BlockIpAddress(ip_address, 0), printf("ip %s bloqueado!", ip_address);
		IncomingConnection[IncomingVezes]++;
		return 1;
	}
	format(IncomingConnection[IncomingIP], 16, ip_address);
	IncomingConnection[IncomingVezes] = 0;
	IncomingConnection[IncomingTempo] = GetTickCount()+2;
	return 1;
}
//Mobilia Casa
public OnPlayerSelectDynamicObject(playerid, objectid, modelid, Float:x, Float:y, Float:z){
	for(new h; h != MAX_HOUSES; h++)
	{
	    for(new m; m != MAX_MOVEIS; m++)
		{
			if(MobInfo[h][m][mobCreated] && objectid == MobInfo[h][m][mobObject])
			{
	            SetPVarInt(playerid, "editandoh", 999);
	            EditDynamicObject(playerid, MobInfo[h][m][mobObject]);
	            SetPVarInt(playerid, "editMovel", m);
				return 1;
	        }
	    }
	}
	return 1;
}
public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
	if(response == 1 || response == 0)
	{
        if(GetPVarInt(playerid, "editandoh") == 999)
		{
			new m = GetPVarInt(playerid, "editMovel"),casaid = PlayerInfo[playerid][pPHousekey];
			if(response == 1)
			{
				MobInfo[casaid][m][mobX] = x;
				MobInfo[casaid][m][mobY] = y;
				MobInfo[casaid][m][mobZ] = z;
				//
				MobInfo[casaid][m][mobRX] = rx;
				MobInfo[casaid][m][mobRY] = ry;
				MobInfo[casaid][m][mobRZ] = rz;
				//
				DestroyDynamicObject(MobInfo[casaid][m][mobObject]);
				MobInfo[casaid][m][mobObject]	= CreateDynamicObject(MobInfo[casaid][m][mobModel], x, y, z, rx, ry, rz, GetPlayerVirtualWorld(playerid));
				SetPlayerInterior(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hInt]);
				SetPlayerVirtualWorld(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hWorld]);
				SetPlayerPos(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hExitx],HouseInfo[PlayerInfo[playerid][pPHousekey]][hExity],HouseInfo[PlayerInfo[playerid][pPHousekey]][hExitz]);
				showBalao(playerid, "Movel Colocado Com Sucesso", 5000);
				if(EstaNaLoja[playerid] == 1)
				{
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerPos(playerid, poshx, poshy, poshz);
					InteriorAtual[playerid] = 0;
					LocalAtual[playerid] = 999;
					HouseEntered[playerid] = 999;
					EstaNaLoja[playerid] = 0;
				}
			}
			else
			{
			    MobInfo[casaid][m][mobCreated] = 0;
			    DestroyDynamicObject(MobInfo[casaid][m][mobObject]);
			    SetPlayerInterior(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hInt]);
				SetPlayerVirtualWorld(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hWorld]);
				SetPlayerPos(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hExitx],HouseInfo[PlayerInfo[playerid][pPHousekey]][hExity],HouseInfo[PlayerInfo[playerid][pPHousekey]][hExitz]);
				showBalao(playerid, "Voce cancelou o Movel", 5000);
				if(EstaNaLoja[playerid] == 1)
				{
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerPos(playerid, poshx, poshy, poshz);
					InteriorAtual[playerid] = 0;
					LocalAtual[playerid] = 999;
					HouseEntered[playerid] = 999;
					EstaNaLoja[playerid] = 0;
				}

			}
            SetPVarInt(playerid, "editandoh", 0);
	        salvarMoveis(casaid);
		}
  		if(GetPVarInt(playerid, "editando") == 999)
		{
			new p = GetPVarInt(playerid, "editPortao"), Str[105+MAX_PLAYER_NAME];
			//Posicoes
			PortaoInfo[p][portaoX]          = x;
			PortaoInfo[p][portaoY]          = y;
			PortaoInfo[p][portaoZ]          = z;
			//Rotacao
			PortaoInfo[p][portaoRX]         = rx;
			PortaoInfo[p][portaoRY]         = ry;
			PortaoInfo[p][portaoRZ]         = rz;
			DestroyDynamicObject(PortaoInfo[p][portaoObject]);
			PortaoInfo[p][portaoObject]     = CreateDynamicObject(980, x, y, z, rx, ry, rz);
			DestroyDynamic3DTextLabel(PortaoInfo[p][portaoText]);
			format(Str, sizeof Str, "{ffffff}[Portao {836FFF}Rocket {FFFFFF}] {FFFFFF}Dono do portao: {00FF00}%s\n{FF0000}/abrirportao [senha]{FFFFFF} para abrir", PortaoInfo[p][portaoNick]);
			PortaoInfo[p][portaoText]       = CreateDynamic3DTextLabel(Str, COR_LIGHTBLUE, x, y, z, 25.0);
			SetPVarInt(playerid, "editando", 0);
			salvarPortoes();
		}
	}
	return 1;
}
CMD:roupinhasdoapx(playerid)
{
	if(PlayerInfo[playerid][pPnumber] == 0)
	{
		SendClientMessage(playerid, 0xFFFFFFFF, "Voce nao tem um celular");
		return 1;
	}
    if(OlhandoTDSkinsTDD[playerid] == 0)
	{
		MostrarTDSkinsTDD(playerid);
	} else if(OlhandoTDSkinsTDD[playerid] == 1)
	{
		TirarTDSkinsTDD(playerid);
	}
	return 1;
}
CMD:celular(playerid)
{
	if(PlayerInfo[playerid][pPnumber] == 0)
	{
		SendClientMessage(playerid, 0xFFFFFFFF, "Voce nao tem um celular");
