					SendClientMessage(playerid, COR_GRAD1, "  Sua empresa esta longe de voc�.");
					return true;
				}
			}
			if (borse < 100)
			{
				if (cashdeposit > BizzInfo[borse][bTill] || cashdeposit < 1)
				{
					SendClientMessage(playerid, COR_GRAD2, " Voc� nao tem essa quantia.");
					return true;
				}
				if (PlayerToPoint(100, playerid,BizzInfo[borse][bExitX],BizzInfo[borse][bExitY],BizzInfo[borse][bExitZ]))
				{
					SendClientMessage(playerid, COR_GRAD1, "Sua empresa esta longe de voc�.");
					return true;
				}
				else
				{
					GivePlayerMoneyEx(playerid,cashdeposit);
					BizzInfo[borse][bTill] -= cashdeposit;
					format(stringZCMD, sizeof(stringZCMD), "   Voc� retirou R$%d de sua empresa - restante: R$%d ", cashdeposit,BizzInfo[borse][bTill]);
					SendClientMessage(playerid, COR_GRAD1, stringZCMD);
					SalvarEmpresa(borse);
