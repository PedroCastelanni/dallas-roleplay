	return 1;
}


TPL::LoadOrgs()
{
	new string[128];
	new idx = 1;
	new naocarregou = 1;
	while (idx < sizeof(InfoOrg))
	{
	    format(string,sizeof(string),"SELECT * FROM `organizacoes` WHERE `ID`=%d",idx);
     	Resultado = db_query(Conexao,string);
		if(db_num_rows(Resultado) > 0)
	    {
	        db_get_field_assoc(Resultado, "Lider", InfoOrg[idx][Lider], 255);
	        db_get_field_assoc(Resultado, "SubLider", InfoOrg[idx][SubLider], 255);
			db_get_field_assoc(Resultado, "Membro1", InfoOrg[idx][Membro1], 255);
            db_get_field_assoc(Resultado, "Membro2", InfoOrg[idx][Membro2], 255);
            db_get_field_assoc(Resultado, "Membro3", InfoOrg[idx][Membro3], 255);
            db_get_field_assoc(Resultado, "Membro4", InfoOrg[idx][Membro4], 255);
