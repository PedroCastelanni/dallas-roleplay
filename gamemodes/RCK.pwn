    if(dialogid == 3030)
	{
		if(response)
		{
			static
				strradar[100];
			GetPlayerPos(playerid, PosX,PosY,PosZ);
			GetPlayerFacingAngle(playerid, Angulo);
			IdRadarLivre(playerid);
			InfoRadar[radarid[playerid]][lPosX] = PosX;
			InfoRadar[radarid[playerid]][lPosY] = PosY;
			InfoRadar[radarid[playerid]][lPosZ] = PosZ-1.5;
			InfoRadar[radarid[playerid]][lAngulo] = Angulo;
			InfoRadar[radarid[playerid]][lVelocidade] = vel;
		    ObjetoRadar[0][radarid[playerid]] = CreateObject(18880, InfoRadar[radarid[playerid]][lPosX], InfoRadar[radarid[playerid]][lPosY], InfoRadar[radarid[playerid]][lPosZ], 0.0, 0.0, InfoRadar[radarid[playerid]][lAngulo]);
		    ObjetoRadar[1][radarid[playerid]] = CreateObject(18880, InfoRadar[radarid[playerid]][lPosX], InfoRadar[radarid[playerid]][lPosY], InfoRadar[radarid[playerid]][lPosZ], 0.0, 0.0, InfoRadar[radarid[playerid]][lAngulo] + 180.0);
			format(strradar, sizeof(strradar),"{FFFFFF}Radar\n{FFFFFF}Velocidade permitida: {FF0000}[%d] {FFFF00}KM/H\n{FFFFFF}Multa {3CB371}R$2.800",InfoRadar[radarid[playerid]][lVelocidade]);
			TRadar[radarid[playerid]] = Text3D:Create3DTextLabel(strradar, -1, InfoRadar[radarid[playerid]][lPosX], InfoRadar[radarid[playerid]][lPosY], InfoRadar[radarid[playerid]][lPosZ]+1, 50.0, 0);
			format(lString, sizeof(lString),"Radar ID: %d criado.",radarid[playerid]);
			SendClientMessage(playerid, 0x004C00FF, lString);
			SetPlayerPos(playerid, PosX+1,PosY+1,PosZ+1);
			CriandoRadar = 0;
			SalvarRadares();
		}
		else
		{
			CriandoRadar = 0;
		    SendClientMessage(playerid, 0xFFFFFFFF,"Voc� Nao crio o radar!");
		}
	}
		
    // ====================== //by cleyson
      //Portamalas//
    if(dialogid == Dig_MalaCentral){
	    new pVeiculo = PorM_Players[0][playerid];
	    if(listitem == QntSlots){
	        if(pTrancarPM[pVeiculo] > 0){
	            pTrancarPM[pVeiculo] = 0;
	            SendClientMessage(playerid, 0x33CC33FF, "{FFFFFF}VOCE {00FF00}DESTRANCOU {FFFFFF}SEU PORTA-MALAS");
	        }else{
	            pTrancarPM[pVeiculo] = playerid+1;
	            SendClientMessage(playerid, 0xFF0000FF, "{FFFFFF}VOCE {FF0000}TRANCOU {FFFFFF}SEU PORTA-MALAS");
	        }
	        AbrirFecharMala(0,pVeiculo);
	        return 1;
	    }
	    new RCKeral[9000];
	    if(listitem == QntSlots+1) return AbrirFecharMala(0,pVeiculo);
	    if(!response){
	            PorM_Players[1][playerid] = listitem;
	            PorM_Players[2][playerid] = 1;
	            strcat(RCKeral, "{FF0000}Resetar porta-malas\n");//
	            strcat(RCKeral, "{00FF00}Adicionar>  {FFFFFF}Armas/Itens\n");//
	            strcat(RCKeral, "{00FF00}Adicionar>  {FFFFFF}Colete (quantidade)\n");//
	            strcat(RCKeral, "{00FF00}Adicionar>  {FFFFFF}Grana\n");//
	            return ShowPlayerDialog(playerid, Dia_SelcItem, DIALOG_STYLE_LIST , "{00FF00}PORTA MALAS", RCKeral, "Colocar", "Cancelar");
	    }else{
	        if(PortaMala[listitem][ID_Item][pVeiculo] == 0){ AbrirFecharMala(0,pVeiculo); return  SendClientMessage(playerid, 0xFF0000FF, "{00FF00}[SLOT VAZIO]{FFFFFF} ESSE SLOT NAO POSSUI NENHUM ITEM"); }
	        if(PortaMala[listitem][ID_Item][pVeiculo] >= 46){
	            PorM_Players[1][playerid] = listitem;
	            PorM_Players[2][playerid] = 0;
	            return ShowPlayerDialog(playerid, Dig_QuantiaPegar, DIALOG_STYLE_INPUT , "{00FFFF}PORTA-MALAS", "{FFFFFF}NESCESSARIO COLOCAR A QUANTIDADE PARA RETIRAR", "Retirar", "Cancelar");
	        }
	        else if(PortaMala[listitem][ID_Item][pVeiculo] >= 1 && PortaMala[listitem][ID_Item][pVeiculo] <= 45){
		        format(string, sizeof(string), "{FFFFFF}VOCE COLETOU A ARMA %s COM %i DE MUNICOES", InfoNomeItem[PortaMala[listitem][ID_Item][pVeiculo]], PortaMala[listitem][Quantidade][pVeiculo]);
		        SendClientMessage(playerid, 0x33CC33FF, string);
		        GivePlayerWeapon(playerid,PortaMala[listitem][ID_Item][pVeiculo],PortaMala[listitem][Quantidade][pVeiculo]);
	            PortaMala[listitem][Quantidade][pVeiculo] = 0;
	            PortaMala[listitem][ID_Item][pVeiculo] = 0;
	        }
	        AbrirFecharMala(0,pVeiculo);
	        return 1;
	    }
	}
	if(dialogid == Dia_SelcItem){
        if(response){
            	new pVeiculo = PorM_Players[0][playerid], pSlot = PorM_Players[1][playerid];
            	if(listitem == 0){//LIMPAR SLOT
			        PortaMala[pSlot][ID_Item][pVeiculo] = 0;
			        PortaMala[pSlot][Quantidade][pVeiculo] = 0;
			        SendClientMessage(playerid, 0x33CC33FF, "{00FF00}[RESETADO] SEU SLOT FOI LIMPO!!!");
			        AbrirFecharMala(0,pVeiculo);
					return 1;
            	}
                else if(listitem == 1){//ARMA
                    if(GetPlayerWeapon(playerid) == 0){ AbrirFecharMala(0,pVeiculo); return SendClientMessage(playerid, 0xFF0000FF, "{FF0000}[ERRO]{FFFFFF} VOCE DEVE ESTA SEGURANDO UMA ARMA"); }
                    if(PortaMala[pSlot][ID_Item][pVeiculo] != 0 && PortaMala[pSlot][ID_Item][pVeiculo] != GetPlayerWeapon(playerid)){ AbrirFecharMala(0,pVeiculo); return SendClientMessage(playerid, 0xFF0000FF, "{FF0000}[SLOT CHEIO]{FFFFFF} ESSE SLOT JA ESTA CHEIO POSSUI UM {FFFF00}ITEM");}
			        format(string, sizeof(string), "Voce colocou a arma %s com %i municoes no Porta-Malas!", InfoNomeItem[GetPlayerWeapon(playerid)], GetPlayerAmmo(playerid));
			        SendClientMessage(playerid, 0x33CC33FF, string);
			        PortaMala[pSlot][ID_Item][pVeiculo] = GetPlayerWeapon(playerid);
			        PortaMala[pSlot][Quantidade][pVeiculo] = GetPlayerAmmo(playerid);
			        SetPlayerAmmo(playerid,GetPlayerWeapon(playerid),0);
			        for(new i = 0; i < QntSlots; i++) PorM_Players[i][playerid] = 0;
			        AbrirFecharMala(0,pVeiculo);
			        return 1;
                }
                else if(listitem >= 2){//COLETE
                    PorM_Players[3][playerid] = listitem;
		            return ShowPlayerDialog(playerid, Dig_QuantiaPegar, DIALOG_STYLE_INPUT , "{00FF00}PORTA MALAS", "{FFFFFF}OBRIGATORIO A {00FF00}QUANTIDADE {FFFFFF}QUE DESEJA COLOCAR", "Colocar", "Cancelar");
                }
                return 1;
        }
        return 1;
	}
	if(dialogid == Dig_QuantiaPegar){
        if(response){
            new pSlot = PorM_Players[1][playerid], pItem = PorM_Players[3][playerid],pVeiculo = PorM_Players[0][playerid];
            AbrirFecharMala(0,pVeiculo);
            if(PorM_Players[2][playerid] == 1){//POR
                if(pItem == 2){//Colete
                    if(PortaMala[pSlot][ID_Item][pVeiculo] != 0 && PortaMala[pSlot][ID_Item][pVeiculo] != 47){AbrirFecharMala(0,pVeiculo); return SendClientMessage(playerid, 0xFF0000FF, "{FF0000}[SLOT CHEIO]{FFFFFF} ESSE SLOT JA ESTA CHEIO POSSUI UM {FFFF00}ITEM"); }
                    new Float:Colete; GetPlayerArmour(playerid,Colete);
                    if(Colete < strval(inputtext)) return SendClientMessage(playerid, 0xFF0000FF, "{FF0000}[COLETE INSUFICIENTE]{FFFFFF}VOCE NAO POSSUI COLETE OU A QUANTIDADE QUE DESEJA COLOCAR");
                    SetPlayerArmour(playerid,Colete-strval(inputtext));
			        PortaMala[pSlot][ID_Item][pVeiculo] = 47;
			        PortaMala[pSlot][Quantidade][pVeiculo] += strval(inputtext);
			        format(string, sizeof(string), "{FFFFFF}VOCE COLOCOU %i% DE COLETE NO PORTA-MALAS", strval(inputtext));
			        SendClientMessage(playerid, 0x33CC33FF, string);
                }
                else if(pItem == 3){//Dinheiro
                    if(PortaMala[pSlot][ID_Item][pVeiculo] != 0 && PortaMala[pSlot][ID_Item][pVeiculo] != 46){ AbrirFecharMala(0,pVeiculo); return SendClientMessage(playerid, 0xFF0000FF, "{FF0000}[SLOT CHEIO]{FFFFFF} ESSE SLOT JA ESTA CHEIO POSSUI UM {FFFF00}ITEM");}
                    if(GetPlayerMoney(playerid) < strval(inputtext)){ AbrirFecharMala(0,pVeiculo); return SendClientMessage(playerid, 0xFF0000FF, "{FF0000}[SEM GRANA]{FFFFFF} VOCE NAO POSSUI ESSE DINHEIRO EM MAO"); }
                    GivePlayerMoneyEx(playerid,-strval(inputtext));
			        PortaMala[pSlot][ID_Item][pVeiculo] = 46;
			        PortaMala[pSlot][Quantidade][pVeiculo] += strval(inputtext);
			        format(string, sizeof(string), "{FFFFFF}VOCE COLOCOU R$%i NO PORTA-MALAS!", strval(inputtext));
			        SendClientMessage(playerid, 0x33CC33FF, string);
                }
            }else{//PEGAR
                if(PortaMala[pSlot][Quantidade][pVeiculo] < strval(inputtext)){ AbrirFecharMala(0,pVeiculo); return SendClientMessage(playerid, 0xFF0000FF, "{FF0000}[ERRO]{FFFFFF}NAO A QUANTIDADE SUFICIENTE NO SEU PORTA-MALAS"); }
                pItem = PortaMala[pSlot][ID_Item][pVeiculo];
                if(pItem == 47){//Colete
                    new Float:Colete; GetPlayerArmour(playerid,Colete);
                    SetPlayerArmour(playerid,Colete+strval(inputtext));
                    if(Colete + strval(inputtext) > 100) SetPlayerArmour(playerid,100);
			        PortaMala[pSlot][Quantidade][pVeiculo] -= strval(inputtext);
			        format(string, sizeof(string), "{FFFFFF}VOCE RETIROU %i% DO COLETE QUE ESTAVA NO PORTA-MALAS", strval(inputtext));
			        SendClientMessage(playerid, 0x33CC33FF, string);
                }
                else if(pItem == 46){//Dinheiro
                    GivePlayerMoneyEx(playerid,strval(inputtext));
			        PortaMala[pSlot][Quantidade][pVeiculo] -= strval(inputtext);
			        format(string, sizeof(string), "{FFFFFF}VOCE RETIROU {3CB371}R$%i {FFFFFF}DO PORTA-MALAS!", strval(inputtext));
			        SendClientMessage(playerid, 0x33CC33FF, string);
                }
			    if(PortaMala[pSlot][Quantidade][pVeiculo] <= 0){
		            PortaMala[pSlot][Quantidade][pVeiculo] = 0;
		            PortaMala[pSlot][ID_Item][pVeiculo] = 0;
		        }
            }
            for(new i = 0; i < 4; i++) PorM_Players[i][playerid] = 0;
            return 1;
        }
        return 1;
    }
    
    if(dialogid == DIALOG_ACESSORIOMOBILE)
    {
    	if(!response) return 1;

    	if(PlayerInfo[playerid][pCoins] < 100)
		{
			SendClientMessage(playerid, COR_AMARELO, "{FF00FF}{ACESSORIOS]{ffffff} voce precisa ter pelo menos 100 coins para comprar acessorios");
