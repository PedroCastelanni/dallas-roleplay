                   ShowPlayerDialog(playerid, 567, DIALOG_STYLE_MSGBOX, "Multas do Servidor", "CM - Contra M�o\n\nDB - Dirigindo B�bado\n\nDP - Dire��o Perigosa\n\nEI - Estacionamento Indevido\n\nFD - Farol Desligado\n\nVD - Ve�culo Danificado\n\nTNC - Trafegando na Cal�ada", "Ok", "");
			       return 1;
