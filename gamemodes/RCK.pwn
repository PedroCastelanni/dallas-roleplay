	CMD:setarevento(playerid, params[])
	{
	    if(IsPlayerConnected(playerid))
	    {
			if(sscanf(params, "u", sscanfid))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /setarevento [ id ]");
				return 1;
			}
			if (PlayerInfo[playerid][pAdmin] >= 3)
			{
			 	if(PlayerInfo[sscanfid][pJailed] != 0)
			 	{
			 	    return SendClientMessage(playerid, COR_GREY, "Este jogador est� preso, voc� n�o pode setar ele no evento !");
			 	}
			 	if(TipoEvento == 0 && TendoQuarentena == 0)
			 	{
