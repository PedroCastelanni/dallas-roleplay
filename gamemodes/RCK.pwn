				new lolz[25];
				if(PlayerInfo[playerid][pAdmin] == 1)lolz = "Aprendiz";
				if(PlayerInfo[playerid][pAdmin] == 2)lolz = "Est�giario";
				if(PlayerInfo[playerid][pAdmin] == 3)lolz = "Auxiliar";
