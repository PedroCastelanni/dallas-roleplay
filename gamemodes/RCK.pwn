		strcat(str, string);
		format(string, sizeof(string),"'%s','%s','%s','%s','%s')",
		InfoOrg[idx][Membro36],
		InfoOrg[idx][Membro37],
		InfoOrg[idx][Membro38],
		InfoOrg[idx][Membro39],
		InfoOrg[idx][Membro40]);
		strcat(str, string);
		MySQLLog(str);
        db_free_result(db_query(Conexao, str));
        format(str, sizeof(str),"");
		idx++;
	}
	return 1;
}
TPL::LoadCandidatos()
{
	new arquivo[128];
	new idx = 1;
	while (idx < sizeof(InfoCandtiados))
	{
	    format(arquivo, sizeof(arquivo), Pasta_Candidatos,idx);
		strmid(InfoCandtiados[idx][Candidato1], DOF2_GetString(arquivo,"Candidato1"), 0, strlen(DOF2_GetString(arquivo,"Candidato1")), 255);
