		cActor[playerid][cWorld] = GetPlayerVirtualWorld(playerid);
  		format(string, sizeof(string), "{FF0000} Cadaver De: {FFFFFF}%s\n{B22222}Morto por: {FFFFFF}%s", cActor[playerid][cName], PlayerName(killerid));
		cActor[playerid][cLabelID] = Create3DTextLabel(string, 0xFFFFFFFF, cActor[playerid][cPos][0], cActor[playerid][cPos][1], cActor[playerid][cPos][2], 10.0, cActor[playerid][cWorld], 1);
		AtirouCorpo[playerid] = 0;
        //SetTimerEx("CriarCorpo", 3000, false, "i", playerid);
	}
    return 1;
}
TPL::CriarCorpo(playerid, animname[32])
{
	cActor[playerid][cActorID] = CreateActor(cActor[playerid][cSkinID],0,0,0,0);
	SetActorHealth(cActor[playerid][cActorID], 0);
	SetActorPos(cActor[playerid][cActorID], cActor[playerid][cPos][0],cActor[playerid][cPos][1],cActor[playerid][cPos][2]);
	SetActorFacingAngle(cActor[playerid][cActorID], cActor[playerid][cPos][3]);
 	ApplyActorAnimation(cActor[playerid][cActorID], "PED", animname, 4.1, 0, 1, 1, 1, 0);
    SetTimerEx("RemoverCorpo", 30000, false, "i", playerid);
}
