	CMD:acessorios(playerid)
	{
        MEGAString[0]=EOS;
        new string[128];
        new arquivo[64];
        format(arquivo, sizeof(arquivo), Pasta_CAcessorio,PlayerName(playerid));
        new xstring[20];
        new ystring[20];
        strcat(MEGAString, "Slot Nome\tLocal do Corpo\n");
        for(new x;x<MAX_PLAYER_ATTACHED_OBJECTS-1;x++)
        {
            if(IsPlayerAttachedObjectSlotUsed(playerid, x))
			{
			    format(xstring, sizeof(xstring), "boneid%d", x);
				new LocalCorpo = DOF2_GetInt(arquivo, xstring);
				new NomeLocal[21];
				switch(LocalCorpo)
				{
                    case 1: NomeLocal = "Espinha";
                    case 2: NomeLocal = "Cabe�a";
                    case 3: NomeLocal = "Bra�o Esquerdo";
                    case 4: NomeLocal = "Bra�o Direto";
                    case 5: NomeLocal = "M�o Esquerda";
                    case 6: NomeLocal = "M�o Direita";
                    case 7: NomeLocal = "Coxa esquerda";
                    case 8: NomeLocal = "Coxa Direita";
                    case 9: NomeLocal = "P� Esquerdo";
                    case 10: NomeLocal = "P� Direito";
                    case 11: NomeLocal = "Panturrilha Direita";
                    case 12: NomeLocal = "Panturrilha Esquerda";
                    case 13: NomeLocal = "Antebra�o Esquerdo";
                    case 14: NomeLocal = "Antebra�o Direito";
                    case 15: NomeLocal = "Clav�cula Esquerda";
                    case 16: NomeLocal = "Clav�cula Direita";
                    case 17: NomeLocal = "Pesco�o";
                    case 18: NomeLocal = "Mand�bula";
				}
			    format(ystring, sizeof(ystring), "modelid%d", x);
			    new IDObjeto = DOF2_GetInt(arquivo, ystring);
			    format(string, sizeof(string), "{FFFFFF}%d {00e7c6}%s\t{FFFFFF}%s\n", x, NomeDoAcessorio(IDObjeto), NomeLocal);
			    strcat(MEGAString, string);
			}
            else
			{
			    format(string, sizeof(string), "{FFFFFF}%d {00e7c6}Nenhum\n", x);
			    strcat(MEGAString, string);
			}
        }
        ShowPlayerDialog(playerid, 1742, 5, \
        "Seus Acess�rios", MEGAString, "Editar", "Cancelar");
        return 1;
    }
