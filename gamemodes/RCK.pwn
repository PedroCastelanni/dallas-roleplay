			{
				SendClientMessage(playerid,0x9E50FFAA," Voc� n�o pode usar esse comando na cadeia!");
				return 1;
			}
			foreach(new i: Player)
			{
				if(IsPlayerConnected(i))
				{
					if(Mobile[i] == playerid)
					{
						Mobile[playerid] = i; //caller connecting
