				SendFamilyMessage(12, TEAM_AZTECAS_COR, stringZCMD);
				SendFamilyMessage(13, TEAM_AZTECAS_COR, stringZCMD);
				SendFamilyMessage(17, TEAM_AZTECAS_COR, stringZCMD);
