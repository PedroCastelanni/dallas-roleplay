	CMD:trazer(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    new plo, world;
			if(sscanf(params, "u", plo))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /trazer [ id ]");
				return 1;
			}
			new Float:plocx,Float:plocy,Float:plocz;
			world = GetPlayerVirtualWorld(playerid);
			new idinterior = GetPlayerInterior(playerid);
			if(PlayerInfo[plo][pJailed] != 0)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode trazer um Preso");
				return 1;
			}
			if(Roubando[plo] == 1)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� nao pode traser este player ele esta roubando");
				return 1;
			}
			if (IsPlayerConnected(plo))
			{
				if(plo != INVALID_PLAYER_ID)
				{
					if(strcmp(PlayerName(plo),"Apxgui", true) == 0)
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode trazer o Apxgui!");
						return 1;
					}
					if (PlayerInfo[playerid][pAdmin] >= 1)
					{
						if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1340)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
							return 1;
						}
						if(PlayerInfo[plo][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] < 1340)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode trazer um Administrador Dono !");
							return 1;
						}
						if(IsPlayerNPC(plo)) return 1;
						DevolverInterior[plo] = GetPlayerInterior(plo);
						GetPlayerPos(plo, DevolverX,DevolverY, DevolverZ);
						GetPlayerPos(playerid, plocx, plocy, plocz);
						if(InteriorAtual[playerid] > 0)
						{
							SetPlayerInterior(plo,InteriorAtual[playerid]);
							InteriorAtual[plo] = InteriorAtual[playerid];
							LocalAtual[plo] = LocalAtual[playerid];
						}
						if(InteriorAtual[playerid] == 0)
						{
							SetPlayerInterior(plo,0);
						}
						if(plocz > 930.0 && InteriorAtual[playerid] == 0) //the highest land point in sa = 526.8
						{
							SetPlayerInterior(plo,1);
							InteriorAtual[plo] = 1;
						}
						SetPlayerInterior(plo, idinterior);
						SetPlayerVirtualWorld(plo,world);
						if (GetPlayerState(plo) == 2)
						{
							TelePos[plo][0] = 0.0;
							TelePos[plo][1] = 0.0;
							new tmpcar = GetPlayerVehicleID(plo);
							LinkVehicleToInterior(tmpcar, idinterior);
							SetVehiclePos(tmpcar, plocx, plocy+4, plocz);
							SetVehicleVirtualWorld(tmpcar,world);
						}
						else
						{
							SetPlayerPos(plo,plocx,plocy+2, plocz);
						}
						SendClientMessage(plo, COR_GRAD1, "Voc� foi teletransportado pelo Admin!");
						format(stringZCMD, sizeof(stringZCMD), "Admin %s Trouxe %s.", PlayerName(playerid), PlayerName(plo));
						ProxDetector(30.0, playerid, stringZCMD, COR_VERDE,COR_VERDE,COR_VERDE,COR_VERDE,COR_VERDE);
					}
					else
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� autorizado a usar este comando!");
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Esse n�o � um jogador ativo.");
			}
		}
		return 1;
	}
