	CMD:versenha(playerid, playa[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(isnull(playa))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /versenha [nomejogador]");
				return 1;
			}
			if(PlayerInfo[playerid][pAdmin] >= 1342)
			{
				new Query[65];
				format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(playa));
				Resultado = db_query(Conexao,Query);
				new VerSenha[64];
				db_get_field_assoc(Resultado, "Senha", VerSenha, 64);
				if(db_num_rows(Resultado) == 0)
				{
					SendClientMessage(playerid, COR_GRAD1, "Conta Inexistente!");
					return true;
				}
				else
				{
					format(stringZCMD,sizeof(stringZCMD), "Jogador: %s - Senha:[%s].", playa, PlayerInfo[playerid][pSenha]);
					SendClientMessage(playerid, COR_AMARELO, stringZCMD);
				}
				return 1;
			}
		}
		return 1;
	}
