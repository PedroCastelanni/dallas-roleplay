stock LideresFamiliaLog(string[])
{
	new entry[128];
	format(entry, sizeof(entry), "%s\n",string);
	new File:hFile;
	hFile = fopen("Logs/LideresFamilia.log", io_append);
	fwrite(hFile, entry);
	fclose(hFile);
	return 1;
}
stock SendMessageToOthersAdmins(playerid, color, const message[])
{
	new ret=0;
	for (new i=0; i<MAX_PLAYERS; ++i)
	{
		if (IsPlayerConnected(i) && i!=playerid && PlayerInfo[i][pAdmin] > 0)
		{
			SendClientMessage(i, color, message);
			ret++;
		}
	}
	return ret;
}
TPL::VozDePrisaoo(playerid, copid)
{
	if (!ProxDetectorS(50.0, playerid, copid))
	{
		KillTimer(PutaGorda[playerid]);
		if(VozDePrisao[playerid] == 1)
		{
			SendClientMessage(playerid, COR_LIGHTRED, "***O policial que lhe deu voz de pris�o perdeu voc� de vista, agora voc� est� livre!");
			VozDePrisao[playerid] = 0;
		}
	}
	return true;
}
