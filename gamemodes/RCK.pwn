								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou um veiculo vip:[%d] no(a) player: %s.", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 21://
							{
								PlayerInfo[sscanfid][pCarFixo] = quantidade;
								PlayerInfo[sscanfid][pOldCarFixo] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou um veiculo fixo:[%d] no(a) player: %s.", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 22://
							{
								if(PlayerInfo[playerid][pAdmin] != 1342) return 1;
								PlayerInfo[sscanfid][pCoins] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou bitcoins:[%d] no(a) player: %s.", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
