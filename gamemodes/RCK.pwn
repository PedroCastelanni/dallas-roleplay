					if (strcmp(playername, InfoOrg[i][Lider], true) == 0)
					{
						strmid(InfoOrg[i][Lider], x_Nick, 0, strlen(x_Nick), MAX_PLAYER_NAME);
						//new DBResult:Resultado; //mysql_escape_string(x_Nick, DB_Escape(x_Nick));
						format(string, sizeof(string), "UPDATE `organizacoes` SET `Lider` = '%s' WHERE `ID` = '%d'", DB_Escape(x_Nick), i);
