	CMD:tvon(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pAdmin] < 1)
			{
				SendClientMessage(playerid, COR_GREEN, "Voc� n�o � um Administrador");
				return 1;
			}
			if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			if(PlayerInfo[playerid][pAdmin] >= 1)
			{
				if(WatchingTV[playerid] < 1)
				{
					GetPlayerPos(playerid, Unspec[playerid][Coords][0],Unspec[playerid][Coords][1],Unspec[playerid][Coords][2]);
				}
			}
			if(Spectate[playerid] == 255 && PlayerInfo[playerid][pAdmin] >= 1)
			{
				GetPlayerPos(playerid, Unspec[playerid][sPx], Unspec[playerid][sPy], Unspec[playerid][sPz]);
				Unspec[playerid][sPint] = InteriorAtual[playerid];
				Unspec[playerid][sLocal] = LocalAtual[playerid];
				LocalAtual[playerid] = 255;
				gTeam[playerid] = 0;
			}
			if(sscanf(params, "u", sscanfid)) return SendClientMessage(playerid, COR_BRANCO, "Use /tvon [playerid]");
			if(PlayerInfo[playerid][pAdmin] >= 1)
			{
				new world;
				world = GetPlayerVirtualWorld(sscanfid);
				if(IsPlayerConnected(sscanfid))
				{
					if(sscanfid != INVALID_PLAYER_ID)
					{
						if(PlayerInfo[sscanfid][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] < 1340)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode ficar de TV em um Admin Dono !");
							return 1;
						}
						Spectate[playerid] = sscanfid;
						new Float:health;
						GetPlayerHealth(Spectate[playerid], health);
						GetPlayerName(Spectate[playerid], giveplayerZCMD, sizeof(giveplayerZCMD));
						new cash =  GetPlayerMoneyEx(Spectate[playerid]);
						if (PlayerInfo[playerid][pAdmin] >= 1)
						{
							SetPlayerToTeamColor(playerid);
							SetPlayerVirtualWorld(playerid,world);
							PlayerInfo[playerid][pSpawn] = 0;
							format(stringZCMD, sizeof(stringZCMD), "Info: (%d) %s R$%d H:%.0f",Spectate[playerid],giveplayerZCMD,cash,health);
							TogglePlayerSpectating(playerid, 1);
							if(IsPlayerInAnyVehicle(sscanfid))
							{
								PlayerSpectateVehicle(playerid, GetPlayerVehicleID(sscanfid));
							}
							else
							{
								PlayerSpectatePlayer(playerid, sscanfid);
							}
						}
						SendClientMessage(playerid, COR_AMARELO2, stringZCMD);
						WatchingTV[playerid] = 1;
					}
				}
				else
				{
					SendClientMessage(playerid, COR_BRANCO, "Use /tvon [playerid]");
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GREEN, "Voc� n�o tem permiss�o para usar esse comando!");
				return 1;
			}
		}
		return 1;
	}
