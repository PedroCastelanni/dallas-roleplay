	for(new i; i < 43; i++)
	{
		TextDrawShowForPlayer(playerid, TDLojaVipText[i]);
	}
	SelectTextDraw(playerid, 0x0080FFC8);
    SetPlayerAttachedObject(playerid, Slot_LojaVipText, 330, 6);
