		    if(CameraInfo[cameraman] != playerid)
		    {
			    if(CameraInfo[cameraman] != INVALID_PLAYER_ID)
			    {
	                SendClientMessage(playerid, COR_GREY, "Alguem est� de Camera-Man!Pe�a que ele saia.");
					return 1;
			    }
			}
	        OnAir(playerid,0);
		}
        return 1;
	}
