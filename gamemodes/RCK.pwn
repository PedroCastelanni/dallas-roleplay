			return 1;
	}
    CMD:logar(playerid, params[])
	{
	    if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
	    {
	        new tmppass[64];
	        new loginstring[255];
			if(gPlayerLogged[playerid] == 1)
			{
				SendClientMessage(playerid, COR_DBLUE, "[RCK]: Voc� j� est� logado.");
				return 1;
			}
			if(sscanf(params, "s[128]", tmppass))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /logar [Senha]");
				format(loginstring,sizeof(loginstring),"{FFFFFF}COLOQUE SUA {FF0000}SENHA {FFFFFF}ABAIXO PARA LOGAR NO SERVIDOR\n\n{00FF00}REGISTRADO {FFFFFF}%s", PlayerName(playerid));
				ShowPlayerDialog(playerid, 1, DIALOG_STYLE_PASSWORD,"Login Necess�rio",loginstring,"Logar","Esperar");
				return 1;
			}
			if(plogando[playerid] == 3)
			{
				 plogando[playerid] = 0;
				 Kick(playerid);
			}
			plogando[playerid] += 1;
			Encrypt(tmppass);
			OnPlayerLogin(playerid,tmppass);
		}
		return 1;
	}
    CMD:bug(playerid, params[])
