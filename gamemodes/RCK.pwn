						SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
						InviteOffer[para1] = playerid;
						InviteJob[para1] = lolz;
						format(gstring,sizeof(gstring),"{00BFFF}Respons�vel Fam�lia {FFFFFF}%s\n{00BFFF}Est� Convidando Voc�\npara a Fam�lia {FFFFFF}%s\n{00BFFF}Deseja Aceitar ?",PlayerName(playerid), InfoFamilia[PlayerInfo[playerid][pFamilia]][NomeFamilia]);
						ShowPlayerDialog(para1,1113,DIALOG_STYLE_MSGBOX,"Convite",gstring,"Sim","N�o");
					}
				}//not connected
			}
			else
			{

				SendClientMessage(playerid, COR_GREY, "Somente l�deres podem usar este comando !");
			}
		}
		return 1;
	}
	CMD:demitirf(playerid, params[])
