		{2642.4084,-1526.0519,1400.9495},
		{2640.7488,-1522.0944,1400.9656},
		{2641.1128,-1517.8917,1401.0172},
		{2641.5732,-1513.1461,1402.3065},
		{2643.0833,-1509.0205,1403.8866},
		{2640.7966,-1508.6284,1403.7914},
