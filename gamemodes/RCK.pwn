	if(hour == 9 && minute >= 0 && minute <= 59) { SetWorldTime(7); SetWeather(10); }
	if(hour == 10 && minute >= 0 && minute <= 59) { SetWorldTime(10); SetWeather(1); }
	if(hour == 11 && minute >= 0 && minute <= 59) { SetWorldTime(11); SetWeather(1); }
	if(hour == 12 && minute >= 0 && minute <= 59) { SetWorldTime(12); SetWeather(1); }
	if(hour == 13 && minute >= 0 && minute <= 59) { SetWorldTime(13); SetWeather(1); }
	if(hour == 14 && minute >= 0 && minute <= 59) { SetWorldTime(14); SetWeather(1); }
	if(hour == 15 && minute >= 0 && minute <= 59) { SetWorldTime(15); SetWeather(1); }
	if(hour == 16 && minute >= 0 && minute <= 59) { SetWorldTime(16); SetWeather(1); }
	if(hour == 17 && minute >= 0 && minute <= 59) { SetWorldTime(20); SetWeather(1); }
