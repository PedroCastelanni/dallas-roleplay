	CMD:parma(playerid)
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
        new f = MAX_OBJ+1;
		for(new a = 0; a < MAX_OBJ; a++)
		{
		    if(IsPlayerInRangeOfPoint(playerid, 1.8, dItemData[a][ObjtPos][0], dItemData[a][ObjtPos][1], dItemData[a][ObjtPos][2]))
		    {
		        f = a;
		        break;
		    }
		}
		if(f > MAX_OBJ) return 1;
		if(gettime() < GetPVarInt(playerid, #VarFlood8))
		    return 1;
		SetPVarInt(playerid, #VarFlood8, gettime()+2);
        GivePlayerWeaponEx(playerid, dItemData[f][ObjtData][0], dItemData[f][ObjtData][1]);
        DestroyDroppedObject(f);
        ApplyAnimation(playerid,"BOMBER","BOM_Plant_2Idle",4.1,0,1,1,0,0);
		new buffer[85];
		format(buffer, sizeof(buffer), "Voc� pegou um(a) %s.", Nomesdasarmas[dItemData[f][ObjtData][0]]);
  		SendClientMessage(playerid, 0x33AA3300, buffer);
		format(buffer, sizeof(buffer), "*%s pegou um(a) %s do ch�o.", PlayerName(playerid), Nomesdasarmas[dItemData[f][ObjtData][0]]);
		ProxDetector(30.0, playerid, buffer, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		printf("%s", buffer);
  		return 1;
    }
	CMD:pitem(playerid)
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
        new f = MAX_OBJ+1;
		for(new a = 0; a < MAX_OBJ; a++)
		{
		    if(IsPlayerInRangeOfPoint(playerid, 1.8, dItemData[a][ObjtPos][0], dItemData[a][ObjtPos][1], dItemData[a][ObjtPos][2]))
		    {
		        f = a;
		        break;
		    }
		}
		if(f > MAX_OBJ) return 1;

		if(gettime() < GetPVarInt(playerid, #VarFlood8))
		    return 1;
		SetPVarInt(playerid, #VarFlood8, gettime()+2);

        for(new i=0; i<75; i++)
		{
		    if(InventarioInfo[playerid][i][iSlot] == 19382)
		    {
		        InventarioInfo[playerid][i][iSlot] = dItemData[f][ObjtData][0];
		        InventarioInfo[playerid][i][iUnidades] = dItemData[f][ObjtData][1];
				break;
		    }
		}

		new str[256];
		format(str, sizeof str, "* Voc� pegou um item: %s, com %d unidade(s)", NomeItemID(dItemData[f][ObjtData][0]), dItemData[f][ObjtData][1]);
		SendClientMessage(playerid, 0x00ccccFF, str);
        DestroyDroppedObjectItem(f);

        ApplyAnimation(playerid,"BOMBER","BOM_Plant_2Idle",4.1,0,1,1,0,0);


  		return 1;
    }
	CMD:caixinha(playerid){

        if(PlayerToPoint(2.0,playerid,1480.2086,-1639.5801,14.1484) || IsPlayerConnected(playerid))
  		{
  		    if(ContarJogadores() < PlayersCaixinha && PlayerInfo[playerid][pCaixinha] != char)
			{
				format(stringZCMD, sizeof(stringZCMD), "N�o atingimos o n�mero de jogadores(%d) necess�rio para desbloquear os presentes.", PlayersCaixinha);
				SendClientMessage(playerid, -1, stringZCMD);
				SendClientMessage(playerid,COR_GRO,"Convide seus amigos para jogar, assim voc� e eles poder�o ganhar presentes!");
				return 1;
			}
			if(PlayerInfo[playerid][pCaixinha] == char) return SendClientMessage(playerid, COR_BRANCO, "Voc� j� pegou sua caixa surpresa, volte no proximo payday.");
    		new str1[50], string[256];
	    	new TipoCaixinha;
      		new RandomCaixa = random(120);
	    	if(RandomCaixa == 120) TipoCaixinha = 19057;
	    	else if(RandomCaixa >= 45 && RandomCaixa <= 79) TipoCaixinha = 19055;
	    	else if(RandomCaixa >= 95 && RandomCaixa <= 98) TipoCaixinha = 19056;
            else TipoCaixinha = 19054;
	        if(TipoCaixinha == 19054) format(str1, sizeof(str1), "{a0522d}Caixinha Pequena");
	        if(TipoCaixinha == 19055) format(str1, sizeof(str1), "{a4a4a4}Caixinha Media");
	        if(TipoCaixinha == 19056) format(str1, sizeof(str1), "{FFFF00}Caixinha Grande");
	        if(TipoCaixinha == 19057) format(str1, sizeof(str1), "{FFFF00}Caixinha Platina");
			for(new i=0; i<75; i++)
			{
				if(InventarioInfo[playerid][i][iSlot] == 19382)
				{
				    InventarioInfo[playerid][i][iSlot] = TipoCaixinha;
				    InventarioInfo[playerid][i][iUnidades] = 1;
					PlayerInfo[playerid][pCaixinha] = char;
					format(string, sizeof(string), "[Caixa Supresa]: {FFFFFF}%s pegou um Presente %s.{FFFFFF} (/infocaixa)",PlayerName(playerid), str1);
					SendClientMessageToAll(COR_TITULO,string);
					SendClientMessage(playerid, COR_BRANCO, "Para pegar seu presente abra seu invent�rio pressionando ( {ff3399}N {FFFFFF}). Para informa��es das caixas digite: /infocaixa.");
					break;
				}
			}
		}
		return 1;
	}
