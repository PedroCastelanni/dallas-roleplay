SaveWeaponsToFile(playerid) //salvamento de armas
{
	new i, path[50], string[128], weaponid, ammo;
    path = GetPlayerFormattedName(playerid);
    if (!DOF2_FileExists(path)) DOF2_CreateFile(path);
	for (i=0; i<13; ++i)
	{
	    GetPlayerWeaponData(playerid,i,weaponid,ammo);
	    format(string,sizeof(string),"Weapon - %d",i);
	    DOF2_SetInt(path,string,weaponid);
	    format(string,sizeof(string),"AmmoID - %d",i);
	    DOF2_SetInt(path,string,ammo == 65535 ? 0 : ammo);
	    DOF2_SaveFile();
	}
}
TPL::LoadWeaponsToFile(playerid)
{
	new i, path[50], string[128], weaponid, ammo;
    path = GetPlayerFormattedName(playerid);
    ResetPlayerWeaponsEx(playerid);
    if(PlayerInfo[playerid][pJailed] == 0)
    {
	    if(PlayerInfo[playerid][pMembro] == 0 && PlayerInfo[playerid][pLider] == 0)
	    {
			for (i=0; i<13; ++i)
			{
		    	format(string,sizeof(string),"Weapon - %d",i);
		    	weaponid = DOF2_GetInt(path,string);
		    	format(string,sizeof(string),"AmmoID - %d",i);
		    	ammo = DOF2_GetInt(path,string);
		    	GivePlayerWeaponEx(playerid,weaponid,ammo);
			}
		}
	}
	LogouAgora[playerid] = true;
	DOF2_RemoveFile(path);
}
GetPlayerFormattedName(playerid)
{
	new name[24], full[50];
 	GetPlayerName(playerid,name,sizeof(name));
 	format(full,sizeof(full),"%s/%s.txt","Armas",name);
 	return full;
}
TPL::VerificarGanhador(playerid) //jogos vorazes
{
	if(QuantidadeEvento == 1)
	{
	    foreach(new i: Player)
	    {
			if(TanoEventoJogosVorazes[i] == 1)
			{
				format(gstring, sizeof(gstring), "[Jogos Vorazes] %s foi o �nico sobrevivente nos jogos vorazes e recebeu R$30.000 e 2 de respeito.",PlayerName(i));
				SendClientMessageToAll(COR_AMARELO,gstring);
				SetPlayerWorldBounds(i, 20000.0000,-20000.0000,20000.0000,-20000.0000);
				SetPlayerSkin(i, PlayerInfo[i][pSkin]);
				TanoEventoJogosVorazes[i] = 0;
				PlayerInfo[i][pWinner] += 1;
				GivePlayerMoneyEx(i, 30000);
				NaPorraDoEvento[i] = false;
                KillTimer(TempoVida[i]);
				PlayerInfo[i][pExp] += 2;
				QuantidadeEvento = 0;
				SetPlayerSpawn(i);
				//setarhora pra o player
			}
	    }
	}
	return 1;
}
