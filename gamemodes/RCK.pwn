IsNumeric(const string[])
{
	for (new i = 0, j = strlen(string); i < j; ++i)
	{
		if (string[i] > '9' || string[i] < '0') return 0;
	}
	return 1;
}
ReturnUser(text[], playerid = INVALID_PLAYER_ID)
{
	new pos = 0;
	while (text[pos] < 0x21)
	{
		if (text[pos] == 0) return INVALID_PLAYER_ID;
		pos++;
	}
	new userid = INVALID_PLAYER_ID;
	if (IsNumeric(text[pos]))
	{
		userid = strval(text[pos]);
		if (userid >=0 && userid < MAX_PLAYERS)
		{
			if(!IsPlayerConnected(userid))
			{
				userid = INVALID_PLAYER_ID;
			}
			else
			{
				return userid;
			}
		}
	}
	new len = strlen(text[pos]);
	new count = 0;
	new name[MAX_PLAYER_NAME];
	foreach(new i: Player)
	{
		if (IsPlayerConnected(i))
		{
			GetPlayerName(i, name, sizeof (name));
			if (strcmp(name, text[pos], true, len) == 0)
			{
				if (len == strlen(name))
				{
					return i;
				}
				else
				{
					count++;
					userid = i;
				}
			}
		}
	}
	if (count != 1)
	{
		if (playerid != INVALID_PLAYER_ID)
		{
			if (count)
			{
				SendClientMessage(playerid, 0xFF0000AA, "Multiple users found, please narrow earch");
			}
			else
			{
				SendClientMessage(playerid, 0xFF0000AA, "No matching user found");
			}
		}
		userid = INVALID_PLAYER_ID;
	}
	return userid;
}
TPL::Atualizar3Dtexts()
{
	for(new h = 0; h < sizeof(HouseInfo); h++)
	{
     	Delete3DTextLabel(HouseLabel[h]);
	    DestroyPickup(HousePickup[h]);
		if(HouseInfo[h][hOwned] == 0)
		{
            HousePickup[h] = AddStaticPickup(1273, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], -1);
			format(gstring, sizeof(gstring), "{4B0082}Casa {FFFFFF}Rocket\n{4B0082}Pre�o: {FFFFFF}R$%d\n{4B0082}Modelo: {FFFFFF}%s\n{FFFFFF}UpDay: {4B0082}%d\n{FFFFFF}Para Comprar, Digite: {4B0082}/cpcasa.",HouseInfo[h][hValue],HouseInfo[h][hDiscription],HouseInfo[h][hLevel]);
			HouseLabel[h] = Create3DTextLabel(gstring,0x00FF00FF,HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez]+0.5,15.0,0);
		}
		if(HouseInfo[h][hOwned] == 1)
		{
			if(HouseInfo[h][hRentabil] == 0)
			{
                HousePickup[h] = AddStaticPickup(19522, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], -1);
				format(gstring, sizeof(gstring), "{4B0082}Dono da Casa: {FFFFFF}%s\n{4B0082}Mensalidade da casa: {FFFFFF}R$%d\n{4B0082}Nivel: {FFFFFF}%d\n{FFFFFF}Para Alugar, Digite:{4B0082}/alugarquarto",HouseInfo[h][hOwner],HouseInfo[h][hRent],HouseInfo[h][hLevel]);
				HouseLabel[h] = Create3DTextLabel(gstring,0x00FF00FF,HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez]+0.5,15.0,0);
			}
			else
			{
                HousePickup[h] = AddStaticPickup(19522, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], -1);
				format(gstring, sizeof(gstring), "{4B0082}Dono da Casa: {FFFFFF}%s\n{4B0082}Mensalidade da casa: {FFFFFF}R$%d\n{4B0082}Nivel: {FFFFFF}%d\n{FFFFFF}Para Alugar, Digite:{4B0082}/alugarquarto",HouseInfo[h][hOwner],HouseInfo[h][hRent],HouseInfo[h][hLevel]);
				HouseLabel[h] = Create3DTextLabel(gstring,0x00FF00FF,HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez]+0.5,15.0,0);
			}
		}
	}
	for(new h = 0; h < sizeof(BizzInfo); h++)
	{
    	Delete3DTextLabel(BizzLabel[h]);
		DestroyPickup(BizzPickup[h]);
		if(BizzInfo[h][bOwned] == 0)
		{
		    BizzPickup[h] = AddStaticPickup(19134, 23, BizzInfo[h][bEntranceX], BizzInfo[h][bEntranceY], BizzInfo[h][bEntranceZ], -1);
			format(gstring, sizeof(gstring), "{FFFFFF}%s\n{4B0082}Esta empresa esta a venda\n{4B0082}Valor: {FFFFFF}R$%d {4B0082}UpDay: %d\n{4B0082}Para comprar digite {FFFFFF}/compraremp",BizzInfo[h][bMessage],BizzInfo[h][bBuyPrice],BizzInfo[h][bLevelNeeded]);
			BizzLabel[h] = Create3DTextLabel(gstring,Verde3D,BizzInfo[h][bEntranceX], BizzInfo[h][bEntranceY], BizzInfo[h][bEntranceZ]+0.5,20.0,0);
		}
		if(BizzInfo[h][bOwned] == 1)
		{
		    BizzPickup[h] = AddStaticPickup(19134, 23, BizzInfo[h][bEntranceX], BizzInfo[h][bEntranceY], BizzInfo[h][bEntranceZ], -1);
   			format(gstring, sizeof(gstring), "{FFFFFF}%s\n{4B0082}Dono: {FFFFFF}%s\n{4B0082}Extor: {FFFFFF}%s\n{4B0082}Taxa de Entrada: {FFFFFF}R$%d\n{FFFFFF}Para Entrar, Aperte {FFFFFF}F.",BizzInfo[h][bMessage],BizzInfo[h][bOwner],BizzInfo[h][bExtortion],BizzInfo[h][bEntranceCost],BizzInfo[h][bLevelNeeded]);
   			BizzLabel[h] = Create3DTextLabel(gstring,Verde3D,BizzInfo[h][bEntranceX], BizzInfo[h][bEntranceY], BizzInfo[h][bEntranceZ]+0.5,20.0,0);
		}
	}
	for(new h = 0; h < sizeof(SBizzInfo); h++)
	{
    	Delete3DTextLabel(SBizzLabel[h]);
  		DestroyPickup(SBizzPickup[h]);
		if(SBizzInfo[h][sbOwned] == 0)
		{
		    SBizzPickup[h] = AddStaticPickup(19134, 23, SBizzInfo[h][sbEntranceX], SBizzInfo[h][sbEntranceY], SBizzInfo[h][sbEntranceZ], -1);
			format(gstring, sizeof(gstring), "{FFFFFF}%s\n{4B0082}Esta empresa esta a venda\n{4B0082}Valor: {FFFFFF}R$%d {4B0082}UpDay: %d\n{4B0082}Para comprar digite {FFFFFF}/compraremp",SBizzInfo[h][sbMessage],SBizzInfo[h][sbBuyPrice],SBizzInfo[h][sbLevelNeeded]);
			SBizzLabel[h] = Create3DTextLabel(gstring,Verde3D,SBizzInfo[h][sbEntranceX], SBizzInfo[h][sbEntranceY], SBizzInfo[h][sbEntranceZ]+0.5,20.0,0);
		}
		if(SBizzInfo[h][sbOwned] == 1)
		{
		    SBizzPickup[h] = AddStaticPickup(19134, 23, SBizzInfo[h][sbEntranceX], SBizzInfo[h][sbEntranceY], SBizzInfo[h][sbEntranceZ], -1);
			format(gstring, sizeof(gstring), "{FFFFFF}%s\n{4B0082}Dono: {FFFFFF}%s\n{4B0082}Extor: {FFFFFF}%s\n{4B0082}Taxa de Entrada: {FFFFFF}R$%d\n{4B0082}Para Entrar, Aperte {FFFFFF}F.",SBizzInfo[h][sbMessage],SBizzInfo[h][sbOwner],SBizzInfo[h][sbExtortion],SBizzInfo[h][sbEntranceCost],SBizzInfo[h][sbLevelNeeded]);
			SBizzLabel[h] = Create3DTextLabel(gstring,Verde3D,SBizzInfo[h][sbEntranceX], SBizzInfo[h][sbEntranceY], SBizzInfo[h][sbEntranceZ]+0.5,20.0,0);
		}
	}
	new FormatPerigoso[600];
	for(new h = 0; h < sizeof(FBizzInfo); h++)
	{
			if(FBizzInfo[h][fbOwned] == 0)
			{
				format(FormatPerigoso, sizeof(FormatPerigoso),
			 	"%s\n\
			 	{4B0082}Vende-se 'fazenda'\n\
			 	{4B0082}Preco a pagar: {FFFFFF}R$%s\n\
			 	{4B0082}UpDay: {FFFFFF}%d\n\
			 	{4B0082}Produtos: {FFFFFF}%d/%d\n\
				{4B0082}Valor por produto: {FFFFFF}R$%s\n\
			 	{4B0082}Use o comando para comprar {FFFFFF}/comprarfazenda",
			 	FBizzInfo[h][fbMessage],
			 	ConvertMoney(FBizzInfo[h][fbBuyPrice]),
			 	FBizzInfo[h][fbLevelNeeded],
			 	FBizzInfo[h][fbProducts],FBizzInfo[h][fbMaxProducts],
			 	ConvertMoney(FBizzInfo[h][fbPriceProd]));

                Update3DTextLabelText(FBizzLabel[h], Verde3D, FormatPerigoso);
			}
			if(FBizzInfo[h][fbOwned] == 1)
			{
				format(FormatPerigoso, sizeof(FormatPerigoso),
			 	"%s\n\
			 	{4B0082}Dono da Fazenda: %s\n\
			 	{4B0082}Extorcao: {FFFFFF}%s\n\
			 	{4B0082}Produtos: {FFFFFF}%d/%d\n\
				{4B0082}Valor por produto: {FFFFFF}R$%s\n\
			 	{4B0082}Fundos: {FFFFFF}R$%s",
			 	FBizzInfo[h][fbMessage],
			 	FBizzInfo[h][fbOwner],
			 	FBizzInfo[h][fbExtortion],
			 	FBizzInfo[h][fbProducts],FBizzInfo[h][fbMaxProducts],
			 	ConvertMoney(FBizzInfo[h][fbPriceProd]),
			 	ConvertMoney(FBizzInfo[h][fbTill]));

			 	Update3DTextLabelText(FBizzLabel[h], COR_AZULBB, FormatPerigoso);
			}
	}
	for(new g=0; g<MAX_GARAGENS; g++)
	{
	    format(gstring, sizeof(gstring),
 		"{4B0082}GARAGEM ID: {FFFFFF}%d\n\
 		{FFFFFF}%s\n\
 		{4B0082}Entrada\n\
 		{4B0082}Status: {FFFFFF}%s\n\
 		{4B0082}Dono: {FFFFFF}%s",
 		g,
 		LabelString[g],
 		GetLockGaragem(g),
 		NameString[g]);

 		UpdateDynamic3DTextLabelText(LabelEntrada[g], COR_AZULBB, gstring);

   	}
}
TPL::ContarJogadores()
{
	new	Jogadores = 0;
	foreach(new i: Player)
	{
	    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
	    {
			Jogadores++;
		}
	}
	return Jogadores;
}
