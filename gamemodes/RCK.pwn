		{
			if(PlayerToPoint(3.0, playerid,1535.5697,-1637.5358,13.5469) || PlayerToPoint(3.0, playerid,1611.2460,-1713.0765,13.5469) || PlayerToPoint(3.0, playerid,1804.5630,-1167.7408,23.8281) || PlayerToPoint(3.0, playerid,638.0870,-1229.1331,18.0796) || PlayerToPoint(3.0, playerid,638.0259,-1227.5466,18.1406)
			|| PlayerToPoint(3.0, playerid,638.0941,-1229.1331,18.0803) || PlayerToPoint(3.0, playerid,1663.4932,-1666.4585,21.4375) || PlayerToPoint(3.0, playerid,1808.7209,-1598.2458,13.5469) || PlayerToPoint(3.0, playerid,1806.7490,-1599.9321,13.5469) || PlayerToPoint(3.0, playerid,822.2245,-2046.6091,12.8672) || PlayerToPoint(3.0, playerid,850.1055,-2036.3551,12.8672))
			{
			    new phonenumb;
				if(sscanf(params, "d", phonenumb))
				{
					SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /orelhao [N� TELEFONE]");
					return 1;
				}
				GetPlayerName(playerid, sendername, sizeof(sendername));
				format(stringZCMD, sizeof(stringZCMD), "* %s disca algum numero no telefone.", sendername);
				ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
				if(phonenumb == 0)
				{
					SendClientMessage(playerid, COR_GRAD2, "Voc� est� ligando para Ninguem");
					return 1;
				}
				if(phonenumb == PlayerInfo[playerid][pPnumber])
				{
					SendClientMessage(playerid, COR_GRAD2, "Voce n�o pode ligar para si mesmo");
					return 1;
				}
				if(Mobile[playerid] != 255)
				{
					SendClientMessage(playerid, COR_GRAD2, "Voce ja est� em uma liga��o...");
					return 1;
				}
				foreach(new i: Player)
				{
					if(IsPlayerConnected(i))
					{
						if(PlayerInfo[i][pPnumber] == phonenumb && phonenumb != 0)
						{
							sscanfid = i;
							Mobile[playerid] = sscanfid; //caller connecting
							if(IsPlayerConnected(sscanfid))
							{
								if(sscanfid != INVALID_PLAYER_ID)
								{
