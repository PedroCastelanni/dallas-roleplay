	CMD:setarportao(playerid, params[]){
		if(PlayerInfo[playerid][pAdmin] < 1340)
			return SendClientMessage(playerid, COR_GRAD1, " Voc� n�o est� autorizado a usar este comando !");
		static Float:pos[4], id, senha[MAX_PLAYER_NAME];
		if(sscanf(params, "us[20]", id, senha))
			return SendClientMessage(playerid, COR_GREY, "{0099ff}�{ffffff} USE: /criarportao [playerid] [senha]");
		if(!IsPlayerConnected(id))
	        return SendClientMessage(playerid, COR_GREY, " Este jogador n�o esta conectado !");
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		GetPlayerFacingAngle(playerid, pos[3]);
	    SetPVarInt(playerid, "editPortao", createPortao(pos[0], pos[1], pos[2]+1.0, 0.0, 0.0, pos[3], PlayerName(id), senha));
		SetPlayerPos(playerid, pos[0], pos[1], pos[2]+6.0);
		if(GetPVarInt(playerid, "editPortao") == -1)
		    return SendClientMessage(playerid, COR_GREY, " O limite de port�es foi atindigo, este port�o n�o pode ser criado !");
		EditDynamicObject(playerid, PortaoInfo[GetPVarInt(playerid, "editPortao")][portaoObject]);
		SetPVarInt(playerid, "editando", 999);
		SendClientMessage(playerid, COR_LIGHTBLUE, " Edite a posi��o do port�o.");
	    salvarPortoes();
		return 1;
	}
