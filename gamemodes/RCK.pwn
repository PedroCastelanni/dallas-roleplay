	CMD:ccontrato(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pMembro] != 8 && PlayerInfo[playerid][pLider] != 8 && PlayerInfo[playerid][pMembro] != 26 && PlayerInfo[playerid][pLider] != 26)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o est� autorizado a usar esse comando!");
				return 1;
			}
			if(GoChase[playerid] == 999)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o tem um contrato !");
				return 1;
			}
			GetPlayerName(playerid,playernameZCMD,sizeof(playernameZCMD));
			new Giver[MAX_PLAYER_NAME];
			GetPlayerName(GoChase[playerid], Giver, sizeof(Giver));
			if(GetPlayerOrg(playerid) == 8)
			{
				format(gstring,128,"* Hitman %s, cancelou o contrato de matar: %s[%d].",PlayerName(playerid),Giver,GoChase[playerid]);
				SendFamilyMessage(8, COR_AMARELO, gstring);
				PlayerInfo[hitmanid][pHeadValue] = 0;
				GetChased[hitmanid] = 999;
				GotHit[hitmanid] = 0;
			}
			else if(GetPlayerOrg(playerid) == 26)
			{
				format(gstring,128,"* Assassin %s, cancelou o contrato de matar: %s[%d].",PlayerName(playerid),Giver,GoChase[playerid]);
				SendFamilyMessage(26, COR_AMARELO, gstring);
				PlayerInfo[assid][pHeadValue] = 0;
				GetChased[assid] = 999;
				GotAss[assid] = 0;
			}
			GameTextForPlayer(playerid, "~r~contrato cancelado", 5000, 1);
			GoChase[playerid] = 999;
			return 1;
		}
		return 1;
	}
	CMD:contrato(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new money2;
			if(sscanf(params, "ud", sscanfid , moneysZCMD))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /contrato [ID/Nome] [Quantia]");
				return 1;
			}
			if(moneysZCMD < 2000 || moneysZCMD > 15000) { SendClientMessage(playerid, COR_GREY, "Seu contrato n�o pode ser menos que 2000 nem maior que 15000"); return 1; }
			if (IsPlayerConnected(sscanfid))
			{
				if(sscanfid != INVALID_PLAYER_ID)
				{

					if(PlayerInfo[sscanfid][pHeadValue] > 15000)
					{
						SendClientMessage(playerid, COR_LIGHTBLUE, "Est� jogador j� possui R$[15000] de contrato, o m�ximo que se pode colocar � R$[15000].");
						return 1;
					}
					if(Dormindo[sscanfid] == true) // sistema de dormir
					{
						SendClientMessage(playerid, COR_GREY, "Voc� n�o pode por contrato em jogadores dormindo!");
					}
					if(PlayerInfo[sscanfid][pLevel] == 2)
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode por contrato em novatos !");
						return 1;
					}
					if(GetPlayerOrg(playerid) == 8)
					{
						SendClientMessage(playerid, COR_GREY,"Voc� � um hitman, n�o pode por contratos !");
						return true;
					}
					if(GetPlayerOrg(playerid) == 26)
					{
						SendClientMessage(playerid, COR_GREY,"Voc� � um assassin, n�o pode por contratos !");
						return true;
					}
					if(GetPlayerOrg(sscanfid) == 8)
					{
						SendClientMessage(playerid, COR_GREY,"Voc� � n�o pode colocar contrato em um hitman !");
						return true;
					}
					if(GetPlayerOrg(sscanfid) == 26)
					{
						SendClientMessage(playerid, COR_GREY,"Voc� � n�o pode colocar contrato em um assassins !");
						return true;
					}
					else if(PlayerInfo[sscanfid][pAdmin] > 0)
					{
						SendClientMessage(playerid, COR_GREY, "Voc� n�o pode colocar contratos em administradores!");
						return true;
					}
					if(IsACop(sscanfid) && moneysZCMD <= 4000)
					{
						SendClientMessage(playerid, COR_GREY, "Contratos em cops devem ser maiores que R$4000!");
						return true;
					}
					if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Nao pode colocar contrato em si mesmo!"); return 1; }
					GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
					GetPlayerName(playerid, sendername, sizeof(sendername));
					money2 = GetPlayerMoneyEx(playerid);
					if (moneysZCMD > 0 && money2 >= moneysZCMD)
					{
						GivePlayerMoneyEx(playerid, (0 - moneysZCMD));
						PlayerInfo[sscanfid][pHeadValue]+=moneysZCMD;
						//if(IsPlayerInLS(sscanfid)) //
						if(Contrato1paracada == true)
						{
							format(stringZCMD, sizeof(stringZCMD), "%s colocou um contrato em %s, por R$[%d].",sendername, giveplayerZCMD, moneysZCMD);
							SendFamilyMessage(8, COR_AMARELO, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "* Voc� colocou um contrato em %s, por R$[%d], foi para os Hitmans.",giveplayerZCMD, moneysZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							Contrato1paracada = false;
						}
						//else if(IsPlayerInLV(sscanfid))
						else if(Contrato1paracada == false)
						{
							format(stringZCMD, sizeof(stringZCMD), "%s colocou um contrato em %s, por R$[%d].",sendername, giveplayerZCMD, moneysZCMD);
							SendFamilyMessage(26, COR_AMARELO, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "* Voc� colocou um contrato em %s, por R$[%d], foi para os Assassins.",giveplayerZCMD, moneysZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							Contrato1paracada = true;
						}
						else
						{
							new cont = 1 + random(1);
							if(cont == 1)
							{
								format(stringZCMD, sizeof(stringZCMD), "%s colocou um contrato em %s, por R$[%d].",sendername, giveplayerZCMD, moneysZCMD);
								SendFamilyMessage(8, COR_AMARELO, stringZCMD);
								format(stringZCMD, sizeof(stringZCMD), "* Voc� colocou um contrato em %s, por R$[%d], foi para os Hitmans.",giveplayerZCMD, moneysZCMD);
								SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							}
							else if(cont == 2)
							{
								format(stringZCMD, sizeof(stringZCMD), "%s colocou um contrato em %s, por R$[%d].",sendername, giveplayerZCMD, moneysZCMD);
								SendFamilyMessage(26, COR_AMARELO, stringZCMD);
								format(stringZCMD, sizeof(stringZCMD), "* Voc� colocou um contrato em %s, por R$[%d], foi para os Assassins.",giveplayerZCMD, moneysZCMD);
								SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							}
						}
						PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
					}
					else
					{
						SendClientMessage(playerid, COR_GRAD1, "   Voc� n�o possui essa grana.");
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Esse n�o � um jogador ativo.");
			}
		}
		return 1;
	}
	CMD:venderminerio(playerid)
	{
		if(PlayerToPoint(2, playerid,990.2281,-78.3008,21.6394))
		{
			if(CarryingOre[playerid] > 0)
			{
		 		new string[128], cash = CarryingOre[playerid]*5000;
		   		format(string, sizeof(string), "MINERADOR: {FFFFFF}Voc� vendeu {F39C12}1 {FFFFFF}min�rio e ganhou {2ECC71}$%d.", cash);
		     	SendClientMessage(playerid, 0x2ECC71FF, string);
		        GivePlayerMoney(playerid, cash);
		        for(new x; x < sizeof(DropPoints); x++)
				{
		  			if(IsValidDynamicMapIcon(PointIcons[playerid][x]))
			    	{
		      			DestroyDynamicMapIcon(PointIcons[playerid][x]);
		       			PointIcons[playerid][x] = -1;
				    }
				}
				Player_CleanUp(playerid, 1);
			}
		}
		return 1;
	}
	CMD:infominerio(playerid)
	{
	    if(PlayerInfo[playerid][pEmprego] != 16) return SendClientMessage(playerid, COR_GRAD1, "Voc� n�o � um minerador!");
		new id = Player_GetClosestVein(playerid);
		if(id == -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERRO: {FFFFFF}Voc� n�o est� perto de um minerio.");
	 	new string[128], type = VeinData[id][Type];
	  	format(string, sizeof(string), "Nome\t{%06x}%s\nValor\t{2ECC71}$%d\nValor do minerio\t{2ECC71}$%d\nTempo De Minera��o\t%.2f seconds", OreData[type][Color] >>> 8, OreData[type][NameOres], OreData[type][ValueOres], (OreData[type][ValueOres] * VeinData[id][AmountOres]), Vein_CalculateTime(id) / 1000);
		ShowPlayerDialog(playerid, DIALOG_ORE_INFO, DIALOG_STYLE_TABLIST, "Min�rio Informa��o", string, "Close", "");
		return 1;
	}
	CMD:minerar(playerid, params[])
	{
	    if(PlayerInfo[playerid][pEmprego] != 16) return SendClientMessage(playerid, COR_GRAD1, "Voc� n�o � um minerador!");
		if(CarryingOre[playerid] != -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERRO: {FFFFFF}Voc� j� est� carregando um min�rio.");
		new id = Player_GetClosestVein(playerid);
		if(id == -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Voc� n�o est� perto de nenhuma minerio.");
		if(VeinData[id][BeingMined]) return SendClientMessage(playerid, 0xE74C3CFF, "ERRO: {FFFFFF}O minerio que voc� quer mina est� sendo minada por outra pessoa.");
		if(VeinData[id][AmountOres] < 1) return SendClientMessage(playerid, 0xE74C3CFF, "ERRO: {FFFFFF}O minerio que voc� quer minerar est� vazia.");
		MiningVein[playerid] = id;
		MiningTimer[playerid] = SetTimerEx("Player_Mine", UPDATE_RATE, true, "i", playerid);
		SetPlayerAttachedObject(playerid, ATTACH_INDEX, 19631, 6, 0.048, 0.029, 0.103, -80.0, 80.0, 0.0);
		TogglePlayerControllable(playerid, 0);
		SetPlayerArmedWeapon(playerid, 0);
		ApplyAnimation(playerid, "BASEBALL", "Bat_1", 4.1, 1, 0, 0, 1, 0, 1);
		new string[64];
		format(string, sizeof(string), "~n~~y~~h~Mineirando %s...", OreData[ VeinData[id][Type] ][NameOres]);
	 	GameTextForPlayer(playerid, string, floatround(Vein_CalculateTime(id)) + 1000, 3);
		VeinData[id][BeingMined] = true;
		Vein_Update(id);
		return 1;
	}
	CMD:pegarminerio(playerid){
	        if(PlayerInfo[playerid][pEmprego] != 16) return SendClientMessage(playerid, COR_GRAD1, "Voc� n�o � um minerador!");
			new id = Player_GetClosestOre(playerid);
			if(id == -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERRO: {FFFFFF}Voc� n�o est� perto de nada.");
			Player_GiveOre(playerid, DroppedOres[id][Type]);
			Ore_Destroy(id);
			return 1;
	}
//Fim Dos Comandos
stock PertoMaconha(playerid)
{
	new count = 0;

	for(new mac = 0; mac < MAX_MACONHA; mac++)
    {
        if(!MaconhaInfo[mac][PodeUsar] && IsPlayerInRangeOfPoint(playerid, 200.0, MaconhaInfo[mac][mX],MaconhaInfo[mac][mY],MaconhaInfo[mac][mZ]))
		{
		    count++;
		}
    }

	return count;
}


TPL::MaconhaQueimar(playerid, mac)
{
	SetTimerEx("MaconhaQueimar2", 17000, false, "id", playerid, mac);
	ClearAnimations(playerid);
	PlantandoMaconha[playerid] = false;
	SendClientMessage(playerid, COR_GRAD1, "Saia de perto, a planta��o ir� queimar...");
	return true;
}
TPL::MaconhaQueimar2(playerid, mac)
{
	format(gstring, sizeof gstring, "O Policial: %s queimou uma planta��o de maconha.",PlayerName(playerid));
	SendClientMessageToAll(COR_EXE, gstring);
	DestroyObject(MaconhaInfo[mac][Object]);
	Delete3DTextLabel(MaconhaInfo[mac][TT]);
	CreateExplosion(MaconhaInfo[mac][mX], MaconhaInfo[mac][mY], MaconhaInfo[mac][mZ], 10, 1.0);
	MaconhaInfo[mac][mX] = 0.0;
	MaconhaInfo[mac][mY] = 0.0;
	MaconhaInfo[mac][mZ] = 0.0;
	MaconhaInfo[mac][PodeUsar] = true;
	ClearAnimations(playerid);
	PlantandoMaconha[playerid] = false;
	return true;
}



TPL::MaconhaColher(playerid, mac)
{
	format(gstring, sizeof gstring, "Voc� colheu esta planta��o de maconha, nela continha %d gramas prontas.",MaconhaInfo[mac][GramasProntas]);
	SendClientMessage(playerid, COR_GRO, gstring);
	for(new i=0; i<75; i++)
	{
		if(InventarioInfo[playerid][i][iSlot] == 19382)
		{
			InventarioInfo[playerid][i][iSlot] = 1578;
	 		InventarioInfo[playerid][i][iUnidades] = MaconhaInfo[mac][GramasProntas];
			break;
		}
	}
	DestroyObject(MaconhaInfo[mac][Object]);
	Delete3DTextLabel(MaconhaInfo[mac][TT]);
	MaconhaInfo[mac][mX] = 0.0;
	MaconhaInfo[mac][mY] = 0.0;
	MaconhaInfo[mac][mZ] = 0.0;
	MaconhaInfo[mac][PodeUsar] = true;
	ClearAnimations(playerid);
	PlantandoMaconha[playerid] = false;

	SetPlayerAttachedObject(playerid,Slot_Maconha,2901,1,0.028999,-0.207999,-0.054999,2.300004,176.100006,-1.300000,0.489999,0.528999,0.575000);
	KillTimer(Timer_Object_Maconha[playerid]);
	Timer_Object_Maconha[playerid] = SetTimerEx("TPL_RetirarObjeto", 2*60000, 0, "d", playerid);
	return true;
}
TPL::TPL_RetirarObjeto(playerid)
{
	RemovePlayerAttachedObject(playerid, Slot_Maconha);
	return 0;
}
TPL::CheckPichar(playerid)
{
        new string[100];
        if(GetPlayerState(playerid) == 1)
        {
            if(GetPlayerWeapon(playerid) == 41)
            {
				if(IsInPiching(playerid))
				{
    				if(Pichando[playerid] > 0)
        			{
           				Pichando[playerid]++;
           				if(IsAPishing(playerid))
				  		{
							format(gstring, sizeof(gstring), "	~p~Pichando:~w~ ~w~%d/10", Pichando[playerid] );
						}
						if(IsAGOV(playerid))
    					{
    					    format(gstring, sizeof(gstring), "	~y~Limpando:~w~ ~w~%d/10", Pichando[playerid] );
    					}
			            SetTimerEx("CheckPichar", 400, false, "i", playerid);
			            if(Pichando[playerid] == 10)
               			{
			            	Pishar(MuroID[playerid],GetPlayerOrg(playerid));
			            	new Float:x, Float:y, Float:z;
						    GetMuro(playerid,MuroID[playerid]);
				            x = MuroPos[playerid][0];
				            y = MuroPos[playerid][1];
				            z = MuroPos[playerid][2];
				            DestroyDynamic3DTextLabel(DonoMuro[MuroID[playerid]]);
				            format(string, sizeof string, "{0099ff}� Picha��o de: {FFFFFF}%s\n{0099ff}ORG: {FFFFFF}%s", PlayerName(playerid), NomeORG(playerid));
	        				DonoMuro[MuroID[playerid]] = CreateDynamic3DTextLabel(string, COR_LIGHTBLUE, x, y, z, 15.0);
			                GivePlayerMoneyEx(playerid, 500);
		                 	Pichando[playerid] = 0;
		                    SendClientMessage(playerid, COR_AMARELO, "Voce Pichou o Muro!");
		                    inPi[playerid] = 0;
		                    DisablePlayerCheckpoint(playerid);
		                    new location[MAX_ZONE_NAME];
					  		GetPlayer2DZone(playerid, location, MAX_ZONE_NAME);
					  		if(IsAPishing(playerid))
					  		{
					  		    if(!IsAGOV(playerid))
                      			{
				                    format(string, sizeof string, "[RCK PICHA��ES]: %s e os %s Picharam um Muro Perto de %s.", PlayerName(playerid), NomeORG(playerid), location);
			                    	SendClientMessageToAll(GetPlayerColor(playerid), string);
		                      		GameTextForPlayer(playerid, "~p~Muro Pichado~n~~w~Bonus: ~g~R$500", 1000, 1);
	                      		}
                      		}
                      		if(IsAGOV(playerid))
                      		{
	                      		format(string, sizeof string, "[RCK PICHA��ES]: %s e o %s Limparam a Picha��o de um Muro Perto de %s.", PlayerName(playerid), NomeORG(playerid), location);
		                    	SendClientMessageToAll(GetPlayerColor(playerid), string);
		                    	GameTextForPlayer(playerid, "~y~Muro Limpo~n~~w~Bonus: ~g~R$500", 1000, 1);
	                    	}
						}
      				}
				}
   			}
		}
		return 1;
}
stock IsPlayerInAnyLanchonete(playerid){

	if(IsPlayerInRangeOfPoint(playerid, 2.0, 375.5736,-68.2086,1001.5151)
	|| IsPlayerInRangeOfPoint(playerid, 2.0, 368.7890,-6.8570,1001.8516)
	|| IsPlayerInRangeOfPoint(playerid, 2.0, 374.0000,-119.6410,1001.4922))
	{
	    return 1;
	}
	return 0;
}
TPL::ProxDetector(Float:radi, playerid, string[],col1,col2,col3,col4,col5)
{
	if(IsPlayerConnected(playerid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy, Float:tempposz;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		//radi = 2.0; //Trigger Radius
		foreach(new i: Player)
		{
			if(IsPlayerConnected(i))
			{
				if(!BigEar[i])
				{
					GetPlayerPos(i, posx, posy, posz);
					tempposx = (oldposx -posx);
					tempposy = (oldposy -posy);
					tempposz = (oldposz -posz);
					//printf("DEBUG: X:%f Y:%f Z:%f",posx,posy,posz);
					if (((tempposx < radi/16) && (tempposx > -radi/16)) && ((tempposy < radi/16) && (tempposy > -radi/16)) && ((tempposz < radi/16) && (tempposz > -radi/16)))
					{
						SendClientMessage(i, col1, string);
					}
					else if (((tempposx < radi/8) && (tempposx > -radi/8)) && ((tempposy < radi/8) && (tempposy > -radi/8)) && ((tempposz < radi/8) && (tempposz > -radi/8)))
					{
						SendClientMessage(i, col2, string);
					}
					else if (((tempposx < radi/4) && (tempposx > -radi/4)) && ((tempposy < radi/4) && (tempposy > -radi/4)) && ((tempposz < radi/4) && (tempposz > -radi/4)))
					{
						SendClientMessage(i, col3, string);
					}
					else if (((tempposx < radi/2) && (tempposx > -radi/2)) && ((tempposy < radi/2) && (tempposy > -radi/2)) && ((tempposz < radi/2) && (tempposz > -radi/2)))
					{
						SendClientMessage(i, col4, string);
					}
					else if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
					{
						SendClientMessage(i, col5, string);
					}
				}
				else
				{
					SendClientMessage(i, col1, string);
				}
			}
		}
	}//not connected
	return 1;
}
TPL::CrimInRange(Float:radi, playerid,copid)
{
	if(IsPlayerConnected(playerid)&&IsPlayerConnected(copid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);
		GetPlayerPos(copid, posx, posy, posz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)))
		{
			return 1;
		}
	}
	return 0;
}
//SISTEMA DE GARAGEM
stock GetLockGaragem(garageid)
{
	new lock[64];
	if(Garagem[garageid][cnLock] == 0)
	{
		lock = "{00F600}Aberto";
	}
	else if(Garagem[garageid][cnLock] == 1)
	{
		lock = "{F60000}Fechado";
	}
	else if(Garagem[garageid][cnLock] == 2)
	{
		lock = "{F6F600}Abrindo";
	}
	else if(Garagem[garageid][cnLock] == 3)
	{
		lock = "{F6F600}Fechando";
	}
	return lock;
}
public CarregarGaragens()
{
	new string[256];
    new arquivo[64];
    for(new g=0; g<MAX_GARAGENS; g++)
	{
	    format(arquivo, sizeof(arquivo), "Garagens/Garagem%d.txt", g);
        if(DOF2_FileExists(arquivo))
   		{
   		    if(Deletado[g] == false)
   		    {
   		    	new word = g + 10;
    			Garagem[g][cnX] = DOF2_GetFloat(arquivo, "X");
     			Garagem[g][cnY] = DOF2_GetFloat(arquivo, "Y");
      			Garagem[g][cnZ] = DOF2_GetFloat(arquivo, "Z");
      			Garagem[g][cnLock] = DOF2_GetInt(arquivo, "Lock");
      			pickupentradagaragem[g] = CreateDynamicPickup(pickupgaragem, 23, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ], -1,-1,-1,50.0);
      			format(NameString[g], 64, "%s", DOF2_GetString(arquivo, "Dono", NameString[g]));
      			LabelString[g] = DOF2_GetString(arquivo, "Comentario", LabelString[g]);
  	    		format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Entrada\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", g, LabelString[g], GetLockGaragem(g), NameString[g]);
   				LabelEntrada[g] = CreateDynamic3DTextLabel(string, 0xFFFFFFFF, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ], 30.0, 0, 1 );
   				format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Sa�da\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", g, LabelString[g], GetLockGaragem(g), NameString[g]);
   				LabelSaida[g] = CreateDynamic3DTextLabel(string, 0xFFFFFFFF, COORDENADASGARAGEM, 30.0, word, 1 );
			}
 		}
	}
	return 1;
}

public SalvarGaragens()
{
    new arquivo[64];
    for(new g=0; g<MAX_GARAGENS; g++)
    {
   		format(arquivo, sizeof(arquivo), "Garagens/Garagem%d.txt", g);
        if(DOF2_FileExists(arquivo))
   		{
   		    if(Deletado[g] == false)
   		    {
   				DOF2_CreateFile(arquivo);
				DOF2_SetFloat(arquivo, "X", Garagem[g][cnX]);
				DOF2_SetFloat(arquivo, "Y", Garagem[g][cnY]);
				DOF2_SetFloat(arquivo, "Z", Garagem[g][cnZ]);
				DOF2_SetInt(arquivo, "Lock", Garagem[g][cnLock]);
				DOF2_SetString(arquivo, "Comentario", LabelString[g]);
  				DOF2_SetString(arquivo, "Dono", NameString[g]);
			}
			DOF2_SaveFile();
		}
	}
	return 1;
}

public CriarGaragem(playerdono[64], garageid, Float:gx, Float:gy, Float:gz, coment[128], bool:lock)
{
 	new string[256];
 	new arquivo[64];
  	format(arquivo, sizeof(arquivo), "Garagens/Garagem%d.txt", garageid);
  	if(!DOF2_FileExists(arquivo))
  	{
		if(!GarageToPoint(7.0, garageid, gx, gy, gz))
		{
 	 		DOF2_CreateFile(arquivo);
 	  		new word = garageid + 10;
   			Garagem[garageid][cnX] = gx;
   			Garagem[garageid][cnY] = gy;
   			Garagem[garageid][cnZ] = gz;
   			Garagem[garageid][cnLock] = lock;
     		NameString[garageid] = playerdono;
   			LabelString[garageid] = coment;
   			pickupentradagaragem[garageid] = CreateDynamicPickup(pickupgaragem, 23, gx, gy, gz,-1,-1,-1,50.0);
   			format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Entrada\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", garageid, LabelString[garageid], GetLockGaragem(garageid), NameString[garageid]);
   			LabelEntrada[garageid] = CreateDynamic3DTextLabel(string, 0xFFFFFFFF, gx, gy, gz, 30.0, 0, 1 );
   			format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Sa�da\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", garageid, LabelString[garageid], GetLockGaragem(garageid), NameString[garageid]);
   			LabelSaida[garageid] = CreateDynamic3DTextLabel(string, 0xFFFFFFFF, COORDENADASGARAGEM, 30.0, word, 1 );
   			SalvarGaragens();
		}
	}
	return 1;
}

public DeletarGaragem(garageid)
{
    new arquivo[64];
    new string[128];
    format(arquivo, sizeof(arquivo), "Garagens/Garagem%d.txt", garageid);
   	if(DOF2_FileExists(arquivo))
	{
	    foreach(new i: Player)
		{
			for(new vei = 0; vei < MAX_VEHICLES; vei++)
			{
			    if(garageid == GetVehicleVirtualWorld(vei)-10)
 		    	{
   					if(!IsPlayerInVehicle(i, vei))
  		   			{
   	   					SetVehicleVirtualWorld(vei, 0);
   	   					SetVehicleToRespawn(vei);
					}
   				}
			}
		    if(garageid == GetPlayerVirtualWorld(i)-10)
    	    {
	   	        if(GetPlayerState(i) == PLAYER_STATE_ONFOOT)
				{
					SetPlayerPos(i, Garagem[garageid][cnX], Garagem[garageid][cnY], Garagem[garageid][cnZ]);
	    			SetPlayerVirtualWorld(i, 0);
	    			SetPlayerInterior(i, 0);
	    			format(string, sizeof(string), "A Garagem %d{00AB00} foi deletada.", garageid);
		    		SendClientMessage(i, 0x00AB00AA, string);
				}
				else
				{
					new tmpcar = GetPlayerVehicleID(i);
					SetVehiclePos(tmpcar, Garagem[garageid][cnX], Garagem[garageid][cnY], Garagem[garageid][cnZ]);
					SetVehicleVirtualWorld(tmpcar, 0);
					SetPlayerVirtualWorld(i, 0);
					SetPlayerInterior(i, 0);
					format(string, sizeof(string), "A Garagem %d{00AB00} foi deletada.", garageid);
		    		SendClientMessage(i, 0x00AB00AA, string);
				}
			}


		}
		Deletado[garageid] = true;
	    DestroyDynamic3DTextLabel(LabelSaida[garageid]);
	    DestroyDynamic3DTextLabel(LabelEntrada[garageid]);
	    DestroyDynamicPickup(pickupentradagaragem[garageid]);
		DOF2_RemoveFile(arquivo);
	    SalvarGaragens();
	}
	return 1;
}

public SetGaragemComent(garageid, coment[128])
{
    new arquivo[64];
    new string[256];
    format(arquivo, sizeof(arquivo), "Garagens/Garagem%d.txt", garageid);
   	if(!DOF2_FileExists(arquivo))
   	{
		return 1;
	}
	else
	{
	    if(Deletado[garageid] == false)
        {
	    	LabelString[garageid] = coment;
	    	format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Entrada\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", garageid, coment, GetLockGaragem(garageid), NameString[garageid]);
			UpdateDynamic3DTextLabelText(LabelEntrada[garageid], 0xFFFFFFFF, string);
			format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Sa�da\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", garageid, coment, GetLockGaragem(garageid), NameString[garageid]);
	 		UpdateDynamic3DTextLabelText(LabelSaida[garageid], 0xFFFFFFFF, string);
	 		SalvarGaragens();
		}
	}
	return 1;
}

