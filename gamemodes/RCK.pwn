	CMD:dance(playerid, params[])
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
		{
			if(isnull(params))
			{
				SendClientMessage(playerid,0xFF0000FF,">USE /dance [1-4]");
				return 1;
			}
			animationplayed = strval(params);
			if(animationplayed < 1 || animationplayed > 4)
			{
				SendClientMessage(playerid,0xFF0000FF,">USE /dance [1-4]");
				return 1;
			}
			if(animationplayed == 1)
			{
				SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE1);
				ComAnim[playerid] = true;
			}
			else if(animationplayed == 2)
			{
				SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE2);
				ComAnim[playerid] = true;
			}
			else if(animationplayed == 3)
			{
				SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE3);
				ComAnim[playerid] = true;
			}
			else if(animationplayed == 4)
			{
				SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE4);
				ComAnim[playerid] = true;
			}
		}
		return 1;
	}
	//teste
	CMD:descricao(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		if(PlayerInfo[playerid][pAdmin] >= 1342)
		{
			if(isnull(params))
			{
				SendClientMessage(playerid, COR_BRANCO, "|____________ Editar ____________|");
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /descricao [nome] (Use para casas e empresas)");
				return 1;
			}
			for(new i = 0; i < sizeof(HouseInfo); ++i)
			{
				if (PlayerToPoint(3, playerid,HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
				{
					format(stringZCMD, sizeof(stringZCMD), "Descri��o da Casa: %d mudada para %s", i, params);
					SendClientMessage(playerid, COR_GRAD2, stringZCMD);
					strmid(HouseInfo[i][hDiscription], params, 0, strlen(params), 999);
					SaveCasa(i);
				}
			}
			for(new i = 0; i < sizeof(BizzInfo); ++i)
			{
				if (PlayerToPoint(3, playerid,BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ]))
				{
					format(stringZCMD, sizeof(stringZCMD), "Descri��o da Empresa(Empresa com interior): %d mudada para %s", i, params);
					SendClientMessage(playerid, COR_GRAD2, stringZCMD);
					strmid(BizzInfo[i][bMessage], params, 0, strlen(params), 255);
					SalvarEmpresa(i);
				}
			}
			for(new i = 0; i < sizeof(SBizzInfo); ++i)
			{
				if (PlayerToPoint(3, playerid,SBizzInfo[i][sbEntranceX], SBizzInfo[i][sbEntranceY], SBizzInfo[i][sbEntranceZ]))
				{
					format(stringZCMD, sizeof(stringZCMD), "Descri��o da SEmpresa(Empresa sem interior): %d mudada para %s", i, params);
					SendClientMessage(playerid, COR_GRAD2, stringZCMD);
					strmid(SBizzInfo[i][sbMessage], params, 0, strlen(params), 255);
					SalvarSEmpresa(i);
				}
			}
			for(new i = 0; i < sizeof(FBizzInfo); i++)
			{
				if (PlayerToPoint(3, playerid,FBizzInfo[i][fbEntranceX], FBizzInfo[i][fbEntranceY], FBizzInfo[i][fbEntranceZ]))
				{
					format(stringZCMD, sizeof(stringZCMD), "Descri��o da Fazenda: %d mudada para %s", i, params);
					SendClientMessage(playerid, COR_GRAD2, stringZCMD);
					strmid(FBizzInfo[i][fbMessage], params, 0, strlen(params), 255);
					SalvarFEmpresa(i);
				}
			}
			Atualizar3Dtexts();
		}
		return 1;
	}
	CMD:trazercasa(playerid, params[])
	{
        if(PlayerInfo[playerid][pAdmin] < 1342) return SendClientMessage(playerid, COR_GRAD1, "Voce nao tem autorizacao para usar esse comando.");
	    new idcasa;
		if(sscanf(params, "d", idcasa))
		{
			SendClientMessage(playerid,COR_GREY,"{0099ff}�{ffffff} USE: /trazercasa [ID]");
			return 1;
		}
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);
		HouseInfo[idcasa][hEntrancex] = x;
		HouseInfo[idcasa][hEntrancey] = y;
		HouseInfo[idcasa][hEntrancez] = z;
		return 1;
	}
