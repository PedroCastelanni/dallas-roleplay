				}
				else
				{
					if(IsPlayerConnected(CopsrondaCall)) { if(CopsrondaCall == playerid) { CopsrondaCall = 999; } }
					foreach(new i: Player)
					{
						if(IsPlayerConnected(i))
						{
							if(CopsrondaAccepted[i] < 999)
