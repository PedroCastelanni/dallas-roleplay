	CMD:algemar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(!IsACop(playerid) && PlayerInfo[playerid][pMembro] != 7 && PlayerInfo[playerid][pLider] != 7 && PlayerInfo[playerid][pEmprego] != 7)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o � um Oficial !");
				return 1;
			}
			if(sscanf(params, "u", sscanfid))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /algemar [id]");
				return true;
			}
			if(IsPlayerConnected(sscanfid))
			{
				if(sscanfid != INVALID_PLAYER_ID)
				{
					if(gTeam[sscanfid] == 2 || IsACop(sscanfid))
					{
						SendClientMessage(playerid, COR_GREY, "Voc� n�o pode algemar COPs !");
						return true;
					}
					if(Algemado[sscanfid] == 1)
					{
						SendClientMessage(playerid, COR_GREY, "O Jogador j� esta algemado !");
						return true;
					}
					if(WantedLevel[sscanfid] == 0)
					{
						SendClientMessage(playerid, COR_GREY, "O Jogador n�o est� procurado !");
						return 1;
					}
					if(GetPlayerState(sscanfid) == 2)
					{
						SendClientMessage(playerid, COR_GREY, "Voc� n�o pode algemar o motorista do veiculo!");
						return 1;
					}
					if(GetPlayerState(playerid) == 2 && !IsPlayerInAnyVehicle(sscanfid))
					{
						SendClientMessage(playerid, COR_GREY, "Voc� est� dentro de um veiculo, e por isso voc� n�o pode alguemar que est� fora !");
						return 1;
					}
					else if(SeRendeu[sscanfid] == 0)
					{
						SendClientMessage(playerid, COR_GREY, "Esse jogador n�o se rendeu ! (Mandar /hd ou /hi)");
						return 1;
					}
					if(PlayerInfo[playerid][pEmprego] == 7)
					{
						if(!PlayerToPoint(30.0,playerid,1770.6527,-1573.1688,1734.9430))
						{
							SendClientMessage(playerid, COR_GREY, "Voc� s� pode algemar jogadores dentro da penitenci�ria !");
							return 1;
						}
					}
					if (ProxDetectorS(2.0, playerid, sscanfid))
					{
						if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voc� nao pode se algemar!"); return true; }
						{
							GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
							GetPlayerName(playerid, sendername, sizeof(sendername));
							format(stringZCMD, sizeof(stringZCMD), "* Voc� foi algemado por: %s.", PlayerName(playerid));
							SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "* Voc� algemou %s.", giveplayerZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "* Oficial: %s algemou o suspeito: %s.", sendername ,giveplayerZCMD);
							ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
							GameTextForPlayer(sscanfid, "~r~Algemado", 2500, 3);
							PlayerCuffed[sscanfid] = 2;
							SetPlayerAttachedObject(sscanfid, 9, 19418, 6, -0.031999, 0.024000,-0.024000,-7.900000,-32.000011,-72.299987, 1.115998, 1.322000, 1.406000);
							SetPlayerSpecialAction(sscanfid, 24);
							Algemado[sscanfid] = 1;
							SeRendeu[sscanfid] = 0;
							if(ProcuraOffer[sscanfid] == playerid)
							{
								ProcuraOffer[sscanfid] = 999;
								format(gstring, sizeof(gstring), "[Procurando] %s[%d] que voc� estava procurando foi algemado, para cancelar a busca, use: /procuraroff.", PlayerName(playerid), playerid);
								SendClientMessage(sscanfid, COR_AMARELO, gstring);
							}
						}
					}
					else
					{
						SendClientMessage(playerid, COR_GREY, " O Jogador est� longe de Voc� !");
						return true;
					}
				}
				else
				{
					SendClientMessage(playerid, COR_GREY, "Esse n�o � um jogador ativo !");
					return true;
				}
			}
		}
		return true;
	}
