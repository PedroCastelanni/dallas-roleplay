              if(PegouFeno[playerid] == 1)
              {
                   return 1;
              }
              if(PegaSemente[playerid] == 1)
              {
                   PegaSemente[playerid] = 0;
              }
              else
              {
                   PegaSemente[playerid] --;
              }
              PegouFeno[playerid] = 1;
              DestroyDynamicPickup(FenoPlantado5[playerid]);
              ApplyAnimation(playerid, "BOMBER","BOM_Plant_In",4.0,0,0,0,0,0);
              SetPlayerAttachedObject(playerid, 9, 2901, 1, 0.000000, -0.313611, 0.021003, 0.445490, 86.754409, 355.370239, 0.926815, 1.000000, 1.000000);
              SendClientMessage(playerid, COR_BRANCO, "Voc� pegou um pacote de colheitas, v� no menu dos Agricultors e entregue.");
		 }
	}
	if(pickupid == MedKitDados[playerid][MedKits])
	{
		MedKitDados[playerid][TimerReceber] = SetTimerEx("AumentarVidaMed",2000,false,"i",playerid);
	}
	if(!RoubandoCaixa[playerid])
    {
	    for(new i; i < MAX_CAIXAS; i++)
	    {
	        if(!CaixaInfo[i][Caixa_Roubada])continue;
	        for(new p; p < MAX_PICKUPS_ROUBO; p++)
	        {
	        	if(pickupid == Pickups_Roubo[i][p])
				{
    				if(IsACop(playerid) || PlayerInfo[playerid][pMembro] == 7 || PlayerInfo[playerid][pLider] == 7)
					{
						GameTextForPlayer(playerid, "~g~USE: /consertarcaixa para conserta-lo!", 1000, 1);
						continue;
					}
					new keys, ud, lr;
				    GetPlayerKeys(playerid, keys, ud, lr);
				    if(keys & KEY_YES)
				    {
						GranaRoubo(playerid, i);
						DestroyDynamicPickup(pickupid);
						Pickups_Roubo[i][p] = -1;
					}
					else
					{
						GameTextForPlayer(playerid, "~b~~h~Segure |~w~Y~b~~h~| para roubar o ~b~~h~dinheiro", 1000, 1);
					}
				}
			}
		}
	}
    return true;
}
TPL::ConsertarCaixa(playerid, caixa_id)
{
	if(GetPlayerCaixa(playerid) != GetPVarInt(playerid, "Consertando"))
	{
	    SetPVarInt(playerid, "Consertando", 0);
	    return GameTextForPlayer(playerid, "~r~Voce nao esta no caixa que estava consertando", 5000, 1);
	}
	if(CaixaInfo[caixa_id][Caixa_Roubada] && IsPlayerConnected(playerid))
	{
	    new string[128];
	    format(string, sizeof string, "*Voc� consertou este caixa eletronico, e ganhou 10 por cento do dinheiro que estava no ch�o! (R$%d)", CaixaInfo[caixa_id][Caixa_Dinheiro]/10);
	    SendClientMessage(playerid, COR_LIGHTBLUE, string);
	    GivePlayerMoneyEx(playerid, CaixaInfo[caixa_id][Caixa_Dinheiro]/10);
	    format(string, sizeof string, "[%s]: %s conseguiu consertar um caixa eletr�nico da cidade!", NomeORG(playerid), PlayerName(playerid));
	    SendClientMessageToAll(GetPlayerColor(playerid), string);
	    ClearAnimations(playerid);
    	RestoreCaixa(caixa_id);
    	TogglePlayerControllable(playerid, 1);
    	SetPVarInt(playerid, "Consertando", 0);
	}
	return 1;
}
public OnPlayerCommandPerformed(playerid, cmdtext[], success)
{
	if (strcmp("/mycommand", cmdtext, true, 10) == 0)
	{
		// Do something here
		return 1;
	}

	if(!success)
	{
	    if(strcmp(cmdtext,"/sairduelo", true) == 0) return 1;
	    if(strcmp(cmdtext,"/sairarena", true) == 0) return 1;
		new Str[256];
        format(Str, sizeof(Str), "{B22222}[?]{FFFFFF} Infelizmente esse comando nao existe em nosso servidor use /god para chamar um admin {FF0000}'%s'", cmdtext);
        SendClientMessage(playerid,	0xFFFFFFFF, Str);
	}
	return 1;
}

