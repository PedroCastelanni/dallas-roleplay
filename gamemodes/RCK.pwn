	CMD:teste(playerid, params[])
	{
	        SetPlayerHealth(playerid, 0.0);
			new RandomCaixa = random(120);
	 		if(RandomCaixa == 120) TipoCaixinhaSurpresa = 19057;
	 		else if(RandomCaixa >= 45 && RandomCaixa <= 79) TipoCaixinhaSurpresa = 19055;
	  		else if(RandomCaixa >= 95 && RandomCaixa <= 98) TipoCaixinhaSurpresa = 19056;
	    	else TipoCaixinhaSurpresa = 19054;
	    	new str1[10];
	     	if(TipoCaixinhaSurpresa == 19054) format(str1, sizeof(str1), "Bronze");
	      	if(TipoCaixinhaSurpresa == 19055) format(str1, sizeof(str1), "Prata");
	        if(TipoCaixinhaSurpresa == 19056) format(str1, sizeof(str1), "Ouro");
	        if(TipoCaixinhaSurpresa == 19057) format(str1, sizeof(str1), "Platina");
			format(gstring, sizeof(gstring), "[{FFFFFF}SPAWN SURPRESA{3498DB}]: Foi Spawnado uma{ffffff} Caixa %s {3498DB}no Morro!", str1);
	        SendClientMessageToAll(0x3498DBFF, gstring);
			new Float: x, Float: y, Float: z;
		    GetPlayerPos(playerid, x, y, z);
			CaixinhaSurpresa = CreateDynamicPickup(TipoCaixinhaSurpresa, 1, x, y, z+1);
			foreach(new i: Player)
			{
			    GetPlayerPos(i, x, y, z);
				PlayerPlaySound(i, 5202, x, y, z);
			}
			return 1;
	}
	CMD:criarroubo(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] == 1342)
        {
            new Float: x, Float: y, Float: z, Float: a;
		 	GetPlayerPos(playerid, x, y, z);
			GetPlayerFacingAngle(playerid, a);
		 	x += (1.25 * floatsin(-a, degrees));
			y += (1.25 * floatcos(-a, degrees));
			CreateDynamicObject(19618, x, y, z-0.55, 0.0, 0.0, a, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
            printf("%f, %f, %f, 0.0, 0.0, %f, %d, %d",x, y, z-0.55,a, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
			a += 90.0;
			x += (0.42 * floatsin(-a, degrees)) + (-0.22 * floatsin(-(a - 90.0), degrees));
			y += (0.42 * floatcos(-a, degrees)) + (-0.22 * floatcos(-(a - 90.0), degrees));
			CreateDynamicObject(19619, x, y, z-0.55, 0.0, 0.0, a + 270.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
			printf("%f, %f, %f, 0.0, 0.0, %f, %d, %d",x, y, z-0.55,a + 270.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
		}
		return 1;
	}
	CMD:criargaragem(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] == 1342)
        {
            for(new g=0; g<MAX_GARAGENS; g++)
    		{
		  		new Float:x, Float:y, Float:z;
				GetPlayerPos(playerid, x, y, z);
				EditandoGaragem[playerid] = g;
				if(!GarageToPoint(7.0, EditandoGaragem[playerid], x, y, z))
				{
					ShowPlayerDialog(playerid, 4002, DIALOG_STYLE_MSGBOX, "Criar Garagem","Clique em 'Meu Nome' para voc� ser o Dono ou em 'Editar' para mudar o Dono", "Meu Nome", "Editar");
       				CriarGaragem("", g, x, y, z, "", true);
					break;
				}
			}
		}
		return true;
	}
	CMD:deletargaragem(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] == 1342)
        {
        	for(new g=0; g<MAX_GARAGENS; g++)
    		{
				if(PlayerToPointG(3.0, playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]))
				{
				    if(Deletado[g] == false)
				    {
						DeletarGaragem(g);
					}
				}
			}
		}
		return true;
	}
	CMD:fechargaragem(playerid, params[])
	{
     	new string[256];
     	new playername[MAX_PLAYER_NAME];
	    for(new g=0; g<MAX_GARAGENS; g++)
    	{
			if(PlayerToPointG(3.0, playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]) || PlayerToPointG(3.0, playerid, COORDENADASGARAGEM) && g == GetPlayerVirtualWorld(playerid)-10)
			{
				GetPlayerName(playerid,playername,24);
				if(!strcmp(NameString[g],playername,true) || PlayerInfo[playerid][pAdmin] == 1342)
				{
				    if(Deletado[g] == false)
				    {
  						if(Garagem[g][cnLock] == 0)
	    				{
							SetTimerEx("FecharGaragem", 5000, false, "ii", playerid, g);
							Garagem[g][cnLock] = 3;
							SendClientMessage(playerid, 0x00AB00AA, "O Port�o est� {F6F600}Fechando{00AB00}.");
							format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Entrada\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", g, LabelString[g], GetLockGaragem(g), NameString[g]);
							UpdateDynamic3DTextLabelText(LabelEntrada[g], 0xFFFFFFFF, string);
 							format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Sa�da\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", g, LabelString[g], GetLockGaragem(g), NameString[g]);
							UpdateDynamic3DTextLabelText(LabelSaida[g], 0xFFFFFFFF, string);
							break;
						}
						else
						{
						    format(string, sizeof(string), "O Port�o j� est� %s{AD0000}.", GetLockGaragem(g));
						    SendClientMessage(playerid, 0xAD0000AA, string);
						}
					}
				}
				else
				{
					SendClientMessage(playerid, 0xAD0000AA, "Voc� n�o � Dono desta Garagem.");
				}
			}
		}
	    return true;
	}
