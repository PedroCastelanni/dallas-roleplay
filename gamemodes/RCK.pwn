	CMD:explodir(playerid, params[])
	{
		GetPlayerName(playerid, sendername, sizeof(sendername));
		if(sscanf(params, "u", sscanfid))
		{
			SendClientMessage(playerid, COR_GREY, "/explodir [id]");
			return 1;
		}
		GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
		GetPlayerName(playerid, sendername, sizeof(sendername));
		if(IsPlayerConnected(sscanfid))
		{
			if(PlayerInfo[playerid][pAdmin] >= 3)
			{
				if(PlayerInfo[sscanfid][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] != 1342)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode explodir um Admin Dono !");
					return 1;
				}
				if(IsPlayerConnected(sscanfid))
				{
					if(strcmp(PlayerName(sscanfid),"Apxgui", true) == 0 )
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode explodir o Apxgui!");
						format(gstring, sizeof(gstring), "%d", playerid);
						ForT:explodir(sscanfid, gstring);
						return 1;
					}
					format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi explodido por %s",giveplayerZCMD, sendername);
					ABroadCast(COR_LIGHTRED,stringZCMD,1);
					SetPlayerHealth(sscanfid, 10);
					new Float:boomx, Float:boomy, Float:boomz;
					GetPlayerPos(sscanfid,boomx, boomy, boomz);
					CreateExplosion(boomx, boomy , boomz, 7, 10);
					new PlayerName2[30];
					GetPlayerName(playerid, PlayerName2, 30);
					printf("[Admins] %s usou /explode em %s", PlayerName2, giveplayerZCMD);
				}
				else
				{
					SendClientMessage(playerid, COR_GREY, "Esse jogador n�o est� online.");
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o est� autorizado a usar este comando!");
			}
		}
		else
		{
			SendClientMessage(playerid, COR_GREY, "Voc� deve estar logado para usar o comando!");
		}
		return 1;
	}
