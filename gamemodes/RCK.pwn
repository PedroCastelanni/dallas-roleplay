				DivulgouLog(stringZCMD);
				return 1;
			}
            format(stringZCMD, sizeof(stringZCMD), "{FF0000}[Solicitou um admin]{FFFFFF} %s(ID:%d): %s", sendername, playerid, (result));
			ABroadCast(0x33AA33AA,stringZCMD,1);
			SendClientMessage(playerid, 0x228B22FF, "{FF0000}[!]{FFFFFF} Voce entrou na fila aguarde um admin atender voce...");
			SendClientMessage(playerid, COR_LIGHTRED, "{FF0000}[!]{FFFFFF} que falar no chat global (instagram) use /ig [texto]");
