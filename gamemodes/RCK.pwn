			format(stringZCMD, sizeof(stringZCMD), "[RCK LOGIN]:{FFFFFF} O �ltimo login de %s, foi em %s.", Nome, getUltimoLogin(Nome));
			SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
		}
		return true;
	}
	CMD:desbanip(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] >= 1)
		{
			if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			if(sscanf(params, "s[24]", params))
			{
				SendClientMessage(playerid,COR_GRAD1,"{0099ff}�{ffffff} USE: /desbanip [Ip do Jogador]");
				return 1;
			}
			new gstring2[264];
			format(gstring, 128, Pasta_IPBanidos, params);
			format(gstring2, 128, Pasta_IPBanidosTemp, params);
			GetPlayerName(playerid, sendername, sizeof(sendername));
			if(DOF2_FileExists(gstring))
			{
				//desban rcon(samp.ban).
				format(stringZCMD, 30, "unbanip %s", params);
				SendRconCommand(stringZCMD);
				SendRconCommand("reloadbans");
				//
				fremove(gstring);
				format(stringZCMD, 128, "AdmCmd: O admin %s desbaniu o IP %s", sendername,params);
				ABroadCast(COR_AMARELO,stringZCMD,1);
				Desbanlog(stringZCMD);
				return 1;
			}
			else if(DOF2_FileExists(gstring2))
			{
				//desban rcon(samp.ban).
				format(stringZCMD, 30, "unbanip %s", params);
				SendRconCommand(stringZCMD);
				SendRconCommand("reloadbans");
				//
				fremove(gstring2);
				format(stringZCMD, 128, "AdmCmd: O admin %s desbaniu o IP (temporariamente banido) %s", sendername,params);
				ABroadCast(COR_AMARELO,stringZCMD,1);
				Desbanlog(stringZCMD);
				return 1;
			}
			else
			{
				//desban rcon(samp.ban).
				format(stringZCMD, 30, "unbanip %s", params);
				SendRconCommand(stringZCMD);
				SendRconCommand("reloadbans");
				//
				format(stringZCMD, 128, "IP:[%d] n�o encontrado no banco de dados, ou acabou de ser desban pelo rcon!", params);
				SendClientMessage(playerid, COR_GRAD1, stringZCMD);
				return 1;
			}
		}
		return 1;
	}
	CMD:desbanconta(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] >= 4)
		{
			if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			if(isnull(params))
			{
				SendClientMessage(playerid,COR_GRAD1,"{0099ff}�{ffffff} USE: /desbanir [Nick do Jogador]");
				return 1;
			}
			new arquivo[64];
			format(arquivo, sizeof(arquivo), Pasta_Banidos, params);
			new arquivo2[64];
			format(arquivo2, sizeof(arquivo2), Pasta_BanidosTemp,params);
			GetPlayerName(playerid, sendername, sizeof(sendername));
			if(DOF2_FileExists(arquivo))
			{
				format(stringZCMD, 128, "AdminAviso: O admin %s desbaniu %s.", sendername,params);
				ABroadCast(COR_AMARELO,stringZCMD,1);
				DOF2_RemoveFile(arquivo);
				Desbanlog(stringZCMD);
			}
			else if(DOF2_FileExists(arquivo2))
			{
				format(stringZCMD, 128, "AdmCmd: %s desbaniu (temporariamente banido) %s.", sendername,params);
				ABroadCast(COR_AMARELO,stringZCMD,1);
				DOF2_RemoveFile(arquivo2);
				Desbanlog(stringZCMD);
			}
			else
			{
				format(stringZCMD, 128, "Nick:[%s] n�o encontrado no banco de dados !", params);
				SendClientMessage(playerid, COR_GRAD1, stringZCMD);
				return 1;
			}
		}
		return 1;
	}
	CMD:pegarlider(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pAdmin] < 1339)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o est� autorizado a usar este comando !");
				return 1;
			}
			if(AdminTrabalhando[playerid] < 1  && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			new level;
			if(sscanf(params, "d", level))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /pegarlider [org]");
				return 1;
			}
			if(level > 27 || level < 1) { SendClientMessage(playerid, COR_GREY, "Lideres de 1 a 28"); return 1; }
			if(PlayerInfo[playerid][pLider] != 0 && PlayerInfo[playerid][pMembro] != 0)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� j� participa de uma organiza��o!");
				return 1;
			}
			if(IsPlayerConnected(playerid))
			{
				if(playerid != INVALID_PLAYER_ID)
				{
					skincop[playerid] = GetPlayerSkin(playerid);
					if(level == 1) { PlayerInfo[playerid][pSkin] = 265; }//Policia Militar
					else if(level == 2){ PlayerInfo[playerid][pSkin] = 285; }//BOPE
					else if(level == 3) { PlayerInfo[playerid][pSkin] = 73; }//Exercito
					else if(level == 4) { PlayerInfo[playerid][pSkin] = 275; }//SA:MU
					else if(level == 5) { PlayerInfo[playerid][pSkin] = 115; }//Tropa da Franca
					else if(level == 6) { PlayerInfo[playerid][pSkin] = 249; }//Taliban
					else if(level == 7) { PlayerInfo[playerid][pSkin] = 147; }//Prefeito
					else if(level == 8) { PlayerInfo[playerid][pSkin] = 294; }//Hitmans
					else if(level == 9) { PlayerInfo[playerid][pSkin] = 227; }//Rede Globo
					else if(level == 10) { PlayerInfo[playerid][pSkin] = 61; }//Taxistas
					else if(level == 11) { PlayerInfo[playerid][pSkin] = 143; }//PCC
					else if(level == 12) { PlayerInfo[playerid][pSkin] = 17; }//Rota
					else if(level == 13){ PlayerInfo[playerid][pSkin] = 285; }//PRF
					else if(level == 14) { PlayerInfo[playerid][pSkin] = 50; }//Mecanicos
					else if(level == 15) { PlayerInfo[playerid][pSkin] = 270; }//Groove
					else if(level == 16) { PlayerInfo[playerid][pSkin] = 123; }//AlQaeda
					else if(level == 17) { PlayerInfo[playerid][pSkin] = 186; }//Policia Civil
					else if(level == 18) { PlayerInfo[playerid][pSkin] = 104; }//Ballas
					else if(level == 19) { PlayerInfo[playerid][pSkin] = 108; }//Vagos
					else if(level == 20) { PlayerInfo[playerid][pSkin] = 120; }//Mafia Yakuza
					else if(level == 21) { PlayerInfo[playerid][pSkin] = 100; }//Peaky Blinders
					else if(level == 22) { PlayerInfo[playerid][pSkin] = 113; }//Mafia Cosa Nostra
					else if(level == 23) { PlayerInfo[playerid][pSkin] = 19; }//CV
					else if(level == 24) { PlayerInfo[playerid][pSkin] = 261; }//Mayans
					else if(level == 25) { PlayerInfo[playerid][pSkin] = 295; }//Milicia
					else if(level == 26) { PlayerInfo[playerid][pSkin] = 294; }//Assassins
					else if(level == 27) { PlayerInfo[playerid][pSkin] = 21; }//Tropa Da Enguica 
					else if(level == 28) { PlayerInfo[playerid][pSkin] = 293; }//Tropa Da Turquia
					else if(level == 29) { PlayerInfo[playerid][pSkin] = 22; }//Tropa Da Turquia
					else if(level == 30) { PlayerInfo[playerid][pSkin] = 30; }//Tropa Da Turquia
					else if(level == 31) { PlayerInfo[playerid][pSkin] = 48; }//Tropa Da Turquia
                    else if(level == 32) { PlayerInfo[playerid][pSkin] = 144; }//Tropa Da Turquia
                    else if(level == 33) { PlayerInfo[playerid][pSkin] = 299; }//Tropa Da Turquia
					PlayerInfo[playerid][pLider] = level;
					SendClientMessage(playerid, COR_LIGHTBLUE,"Promovido Com sucesso !");
					MedicBill[playerid] = 0;
					gTeam[playerid] = 11;
					PlayerInfo[playerid][pTeam] = 11;
					PlayerInfo[playerid][pCargo] = 6;
					liderhide[playerid] = 1;
					lideradmin[playerid] = 1;
					SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
					SetPlayerSpawn(playerid);
				}
			}
		}
		return 1;
	}
    CMD:lider(playerid, params[])
