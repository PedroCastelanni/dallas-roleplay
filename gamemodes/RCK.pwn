public OnPlayerEnterCheckpoint(playerid)
{
    if(IsPlayerInAnyVehicle(playerid)) {
		SendClientMessage(playerid,0xFF0000AA,"{00FF00}[DESTINO] {FFFFFF}voce chegou a seu destino");
		DisablePlayerCheckpoint(playerid);
	    return 1;
    }
	if(TerroristBomb[playerid] == 1){ 
		TerroristBomb[playerid] = 2;
 		SetPlayerCheckpoint(playerid,1834.9899,-2095.9141,13.5469,3);
 		ClearAnimations(playerid);
  		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
  		SendClientMessage(playerid,COR_COSA, "{FF0000}[ROTAS 1/6]:{FFFFFF}Voce entregou 12g de maconha para um traficante, ainda sobra 5 rotas");
    	return 1;
   	}
	if(TerroristBomb[playerid] == 2){
		TerroristBomb[playerid] = 3;
		SetPlayerCheckpoint(playerid,-1450.0970,-1510.9258,101.7578,3);
		ClearAnimations(playerid);
 		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
 		SendClientMessage(playerid,COR_COSA, "{FF0000}[ROTAS 2/6]:{FFFFFF}Voce entregou 6g de maconha para um traficante, ainda sobra 4 rotas");
   		return 1;
   	}
	if(TerroristBomb[playerid] == 3){
		TerroristBomb[playerid] = 4;
		SetPlayerCheckpoint(playerid,2303.5710,170.3244,26.4844,3);
		ClearAnimations(playerid);
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
		SendClientMessage(playerid,COR_COSA, "{FF0000}[ROTAS 3/6]:{FFFFFF}Voce entregou 21g de maconha para um traficante, ainda sobra 3 rotas");
	   	return 1;
    }
	if(TerroristBomb[playerid] == 4){
		TerroristBomb[playerid] = 5;
		SetPlayerCheckpoint(playerid,1337.7419,1968.0848,10.8127,3);
		ClearAnimations(playerid);
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
		SendClientMessage(playerid,COR_COSA, "{FF0000}[ROTAS 4/6]:{FFFFFF}Voce entregou 8g de maconha para um traficante, ainda sobra 2 rotas");
		return 1;
 	}
	if(TerroristBomb[playerid] == 5){
		TerroristBomb[playerid] = 6;
		SetPlayerCheckpoint(playerid,1834.9899,-2095.9141,13.5469,3);
		ClearAnimations(playerid);
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
		SendClientMessage(playerid,COR_COSA, "{FF0000}[ROTAS 5/6]:{FFFFFF} Voce entregou 2g de maconha para um traficante, ainda sobra 1 rota");
		return 1;
 	}
	if(TerroristBomb[playerid] == 6){
		TerroristBomb[playerid] = 7;
		SetPlayerCheckpoint(playerid,2499.5530,-947.0037,82.4708,3);
		ClearAnimations(playerid);
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
		SendClientMessage(playerid,COR_COSA, "{A020F0}[ROTAS FINALIZADA]: {FFFFFF}VOLTE NO TRAFICANTE PARA RECEBER SEU DINHEIRO FEITO PELAS ROTAS");
		return 1;
 	}
	if(TerroristBomb[playerid] == 7){
		TerroristBomb[playerid] = 0;
		GivePlayerMoneyEx(playerid,50000);
		TraficDinherr(playerid);
	}
	return 1;

    if(pesquisando[playerid] == 1 || PlayerToPoint(4.0,playerid,-335.3820,-1030.0096,59.1960))
    {
		 if(IsPlayerInAnyVehicle(playerid))
         {
		      DisablePlayerCheckpoint(playerid);
		      pesquisando[playerid] = 2;
		      SetPlayerCheckpoint(playerid, -1110.8894,-1619.7051,76.3672, 8.0);
		      SendClientMessage(playerid, COR_BRANCO, "[Agricultor]: Agora s� lhe faltam 5 fazendas !");
		      return 1;
		 }
    }
    else if(pesquisando[playerid] == 2 || PlayerToPoint(4.0,playerid,-1110.8894,-1619.7051,76.3672))
    {
         if(IsPlayerInAnyVehicle(playerid))
         {
		      DisablePlayerCheckpoint(playerid);
		      pesquisando[playerid] = 3;
		      SetPlayerCheckpoint(playerid, -415.6438,-1753.8879,6.5089, 8.0);
		      SendClientMessage(playerid, COR_BRANCO, "[Agricultor]: Agora s� lhe faltam 4 fazendas !");
		      return 1;
		 }
    }
    else if(pesquisando[playerid] == 3 || PlayerToPoint(4.0,playerid,-415.6438,-1753.8879,6.5089))
    {
         if(IsPlayerInAnyVehicle(playerid))
         {
		      DisablePlayerCheckpoint(playerid);
		      pesquisando[playerid] = 4;
		      SetPlayerCheckpoint(playerid, -579.5408,-1469.6305,10.5640, 8.0);
		      SendClientMessage(playerid, COR_BRANCO, "[Agricultor]: Agora so faltam 3 checkpoints !");
		      return 1;
		 }
    }
    else if(pesquisando[playerid] == 4 || PlayerToPoint(4.0,playerid,-579.1841,-1468.8634,10.4911))
    {
         if(IsPlayerInAnyVehicle(playerid))
         {
		      DisablePlayerCheckpoint(playerid);
		      pesquisando[playerid] = 5;
		      SetPlayerCheckpoint(playerid, -382.0521,-1426.2626,26.0867, 8.0);
		      SendClientMessage(playerid, COR_BRANCO, "[Agricultor]: Agora so falta 2 checkpoint !");
		      return 1;
		 }
    }
    else if(pesquisando[playerid] == 5 || PlayerToPoint(4.0,playerid,-382.0521,-1426.2626,26.0867))
    {
         if(IsPlayerInAnyVehicle(playerid))
         {
		      DisablePlayerCheckpoint(playerid);
		      pesquisando[playerid] = 6;
		      SetPlayerCheckpoint(playerid, -104.0589,45.2188,3.1172, 8.0);
		      SendClientMessage(playerid, COR_BRANCO, "[Agricultor]: Agora so falta 1 checkpoint !");
		      return 1;
		 }
    }
    else if(pesquisando[playerid] == 6 || PlayerToPoint(2.0,playerid,-104.0589,45.2188,3.1172))
    {
         if(IsPlayerInAnyVehicle(playerid))
         {
              new vid = GetPlayerVehicleID(playerid);
		      DisablePlayerCheckpoint(playerid);
		      pesquisando[playerid] = 0;
		      DisablePlayerCheckpoint(playerid);
		      PlayerInfo[playerid][pSalario] += 1200;
		      SetVehicleToRespawn(vid);
		      SendClientMessage(playerid, COR_BRANCO, " [Agricultor]: Voc� completou a pesquisa e [R$1.200] foram adicionados em seu sal�rio !");
		 }
    }
    if(rouboucarro[playerid] == 1 || PlayerToPoint(2.0,playerid,2749.9712,-2226.4041,16.1875))
    {
        if(IsPlayerInAnyVehicle(playerid))
        {
		     new vid = GetPlayerVehicleID(playerid);
			 if(vid == 571) return SendClientMessage(playerid, COR_LIGHTBLUE, "Voc� n�o est� em um carro.");
		     SendClientMessage(playerid, COR_LIGHTBLUE, "Voc� vendeu o carro roubado e R$[4000] foram adicionados em seu sal�rio.");
		     SetPlayerCriminal(playerid,255, "Roubo de Ve�culo");
		     GameTextForPlayer(playerid,"~r~carro roubado vendido !", 5000, 1);
		     PlayerInfo[playerid][pSalario] += 4000;
		     rouboucarro[playerid] = 0;
             SetVehicleToRespawn(vid);
        }
	}
	if(Mjornal2[playerid] == 1 || PlayerToPoint(4.0,playerid,1441.7911,2360.0532,10.8203))
    {
        if(!IsPlayerInAnyVehicle(playerid))
        {
			 new string[100];
			 SetPlayerCheckpoint(playerid, -1948.3756,558.6743,35.1719, 2.0);
		     format(string, sizeof(string), "%s completou a tarefa de buscar e entregar jornais!", PlayerName(playerid));
             SendEmpregoMessage(12, 0xFFEC8BFF, string);
             format(string, sizeof(string), "Voc� fez seu trabalho completo como carteiro e [R$850] foram adicionados em seu sal�rio !");
             SendClientMessage(playerid, COR_GRAD1, string);
             SendClientMessage(playerid, COR_GRAD1, "Volte at� a sua HQ para marcar outra entrega. !");
             PlayerInfo[playerid][pSalario] += 850;
             RemovePlayerAttachedObject(playerid,9);
             DisablePlayerCheckpoint(playerid);
             Mjornal2[playerid] = 0;
        }
	}
	if(TaxiCallTime[playerid] > 0 && TaxiAccepted[playerid] < 999)
	{
	    TaxiAccepted[playerid] = 999;
		GameTextForPlayer(playerid, "~w~Chegou ao destino", 5000, 1);
		TaxiCallTime[playerid] = 0;
		DisablePlayerCheckpoint(playerid);
	}
	else if(BusCallTime[playerid] > 0 && BusAccepted[playerid] < 999)
	{
	    BusAccepted[playerid] = 999;
		GameTextForPlayer(playerid, "~w~Chegou ao destino", 5000, 1);
		BusCallTime[playerid] = 0;
		DisablePlayerCheckpoint(playerid);
	}
	else if(PizzaCallTime[playerid] > 0 && PizzaAccepted[playerid] < 999)
	{
	    PizzaAccepted[playerid] = 999;
		GameTextForPlayer(playerid, "~w~Chegou ao destino", 5000, 1);
		PizzaCallTime[playerid] = 0;
		DisablePlayerCheckpoint(playerid);
	}
	else if(MedicCallTime[playerid] > 0 && MedicAccepted[playerid] < 999)
	{
	    MedicAccepted[playerid] = 999;
		GameTextForPlayer(playerid, "~w~Chegou ao destino", 5000, 1);
		MedicCallTime[playerid] = 0;
		DisablePlayerCheckpoint(playerid);
	}
	else if(MechanicCallTime[playerid] > 0 && MechanicAccepted[playerid] < 999)
	{
	    MechanicAccepted[playerid] = 999;
		GameTextForPlayer(playerid, "~w~Chegou ao destino", 5000, 1);
		MechanicCallTime[playerid] = 0;
		DisablePlayerCheckpoint(playerid);
	}
	else if(CopsrondaCallTime[playerid] > 0 && CopsrondaAccepted[playerid] < 999)
	{
	    CopsrondaAccepted[playerid] = 999;
		GameTextForPlayer(playerid, "~w~Chegou ao destino", 5000, 1);
		CopsrondaCallTime[playerid] = 0;
		DisablePlayerCheckpoint(playerid);
   	}
	else
	{
		switch (gPlayerCheckpointStatus[playerid])
		{
			case CHECKPOINT_HOME:
		    {
				PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
				DisablePlayerCheckpoint(playerid);
				gPlayerCheckpointStatus[playerid] = CKPOINT_NENHUM;
				GameTextForPlayer(playerid, "~w~Chegou em~n~~y~Casa", 5000, 1);
		    }
		}
	}
	DisablePlayerCheckpoint(playerid);
	return 1;
}
public OnPlayerEnterRaceCheckpoint(playerid)
{
	 new Float: lataria, Float:X,Float:Y,Float:Z;
	 new vid = GetPlayerVehicleID(playerid);
     GetVehicleHealth(vid, lataria);
     GetPlayerPos(playerid, X,Y,Z);
     new carro = GetPlayerVehicleID(playerid);
	 if(iniciarrally[playerid] == 1)
	 {
		 if(!IsPlayerInVehicle(playerid, carro))
		 {
	   		 SendClientMessage(playerid, COR_GREY, "Voc� deve estar em um ve�culo do evento rally !");
	   		 return 1;
		 }
	     else if(CorridaGanha[playerid] == 1)
		 {
			  SendClientMessage(playerid, COR_BRANCO, "A corrida de rally acabou, voc� n�o foi o vencedor !");
			  DisablePlayerRaceCheckpoint(playerid);
			  NaPorraDoEvento[playerid] = false;
			  CorridaGanha[playerid] = 0;
			  iniciarrally[playerid] = 0;
			  SetVehicleToRespawn(GetPlayerVehicleID(playerid));
			  LimiteEvento = 0;
			  CPEvento1[playerid] = 0;
			  SetPlayerSpawn(playerid);
			  return 1;
  	     }
  	     else if(CPEvento1[playerid] == 21-2)
  	     {
			  new string[156];
              format(string, sizeof(string), "Participante: %s ganhou a corrida de rally e recebeu 40 mil.", PlayerName(playerid));
              SendClientMessageToAll(COR_LIGHTBLUE, string);
              SendClientMessage(playerid, COR_BRANCO, "Voc� foi o vencedor da corrida de rally !");
              NaPorraDoEvento[playerid] = false;
              SetVehicleToRespawn(GetPlayerVehicleID(playerid));
              GivePlayerMoneyEx(playerid, 40000);
              LimiteEvento = 0;
              CPEvento1[playerid] = 0;
              iniciarrally[playerid] = 0;
              DisablePlayerRaceCheckpoint(playerid);
              PlayerInfo[playerid][pWinner] += 1;
              foreach(new i: Player)
 	          {
                   CorridaGanha[i] = 1;
              }
              LimiteEvento = 0;
              CorridaGanha[playerid] = 0;
              SetPlayerSpawn(playerid);
  	     }
	     else if(IsPlayerInVehicle(playerid, carro))
	     {
             DisablePlayerRaceCheckpoint(playerid);
             if(CPEvento1[playerid] == 20-2)
             {
			     SetPlayerRaceCheckpoint(playerid, 1, CorridaRally[CPEvento1[playerid]+1][0],CorridaRally[CPEvento1[playerid]+1][1],CorridaRally[CPEvento1[playerid]+1][2],CorridaRally[CPEvento1[playerid]+2][0],CorridaRally[CPEvento1[playerid]+2][1],CorridaRally[CPEvento1[playerid]+2][1],4.0);
			 }
