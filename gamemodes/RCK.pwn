	CMD:deagle(playerid)
	{
	    if(PlayerInfo[playerid][pSocio] >= 1)
		{
		    new Float:Vida;
            GetPlayerHealth(playerid, Vida);
			if(WantedLevel[playerid] != 0)
			{
				SendClientMessage(playerid, COR_AMARELO, "Voc� n�o pode entrar na arena com niveis de procura !");
				return 1;
			}
			if(PlayerInfo[playerid][pJailed] != 0)
    	    {
	   			SendClientMessage(playerid,COR_AMARELO,"Voc� n�o entrar no duelo preso !");
	   			return 1;
    	    }
    	    if(Vida <= 50)
    	    {
				 SendClientMessage(playerid, COR_AMARELO, "Voc� deve ter mais da metade da vida para entrar na arena deagle !");
				 return 1;
    	    }
    	    if(PlayerInfo[playerid][pGunLic] == 0)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o possui licen�as de armas !");
				return 1;
			}
		    if(!PlayerToPoint(2, playerid,2695.5972,-1704.6400,11.8438))
            {
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� no icone de duelo.");
				return 1;
            }
            new rand;
			TDM[playerid] = 1;
			SetPlayerInterior(playerid, 1);
			SetPlayerVirtualWorld(playerid, 200);
			rand = random(sizeof(SpawnArena12));
			SetPlayerPos(playerid, SpawnArena12[rand][0], SpawnArena12[rand][1], SpawnArena12[rand][2]);
			SetPlayerFacingAngle(playerid, SpawnArena12[rand][3]);
			format(stringZCMD, sizeof(stringZCMD), "(DEAGLE ARENA):{FFFFFF} %s entrou na arena de Desert Eagle.", PlayerName(playerid));
			ProxDetector(100.0, playerid, stringZCMD,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE);
			SendClientMessage(playerid, -1, "� Voc� entrou na arena de Desert Eagle. Para sair, digite /sairarena.");
            ResetPlayerWeapons(playerid);
			GivePlayerWeaponEx(playerid, 24, 9999);
			SetPlayerArmour(playerid,100);
			SetPlayerHealth(playerid,100);
		}
		else
		{
			 SendClientMessage(playerid, COR_GRAD1, "Voc� n�o � um s�cio.");
			 return 1;
		}
		return 1;
	}
