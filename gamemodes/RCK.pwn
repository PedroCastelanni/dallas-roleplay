		format(stringZCMD, sizeof(stringZCMD), "* %s est� dan�ando o Cr�u RCKOWNED ^^!.", sendername);
		ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		ApplyAnimation(playerid,"CHOPPA","CHOPPA_back",4.1,1,1,1,1,1);
