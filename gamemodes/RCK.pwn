					            NaPorraDoEvento[sscanfid] = true;
					            TaNoQuarentena[sscanfid] = 1;
					            pClassiQuarentena[sscanfid] = 0;
					            ContagemQuarentena[sscanfid] = 41;
					            SetPlayerSkin(sscanfid, 162);
