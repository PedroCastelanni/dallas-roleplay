stock DestruirMedKit(playerid)
{
	DestroyDynamicPickup(MedKitDados[playerid][MedKits]);
	DestroyObject(MedKitDados[playerid][MedKitObject]);
	Delete3DTextLabel(MedKitDados[playerid][LabelMed]);
	MedKitDados[playerid][MedPlayer] = false;
	return 1;
}
stock ReturnPlayerZone(playerid)
{
	new location[MAX_ZONE_NAME];
	GetPlayer2DZone(playerid, location, MAX_ZONE_NAME);
    return location;
}
stock VeiculoOcupado(vid)
{
     for(new i; i < GetMaxPlayers(); ++i)
     {
          if(!IsPlayerConnected(i)) continue;
          if(GetPlayerVehicleID(i) == vid) return true;
     }
     return false;
}
stock IsVehicBernccupied(vehicleid)
{
	for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++) if(IsPlayerInVehicle(i, vehicleid)) return true;
	return false;
}
