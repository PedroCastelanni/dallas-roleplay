		ABroadCast(COR_AMARELO,stringZCMD,1);
		BanLog(stringZCMD);
		return 1;
	}
	CMD:banfundador23(playerid, params[])  return ForT:banfundador(playerid, params);
	CMD:banfundador(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new dias, mes, ano;
			new result[64];
			if(sscanf(params, "uddis[64]", sscanfid, dias, mes, ano, result))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /banir [ID] [Dia] [Mes] [Ano] [Motivo]");
				return 1;
			}
			if(PlayerInfo[playerid][pAdmin] >= 2)
			{
				if(sscanfid != INVALID_PLAYER_ID)
				{
					if(IsPlayerNPC(sscanfid)) return 1;
					if(PlayerInfo[sscanfid][pAdmin] >= 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
					{
						if(sscanfid != playerid)
						{
							format(stringZCMD, sizeof(stringZCMD), "ID [%d] N�o est� Online.", sscanfid);
							SendClientMessage(playerid, COR_GRAD1, stringZCMD);
							return 1;
						}
					}
					if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
						return 1;
					}
					if(strcmp(PlayerName(sscanfid),"Apxgui", true) == 0 )
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode banir o Apxgui, se insistir vc ficar� sem NET!");
						format(gstring, sizeof(gstring), "/kick %d AUTOMATICO [Tentou banir Apxgui].", playerid);
						ForT:kick(playerid, gstring);
						return 1;
					}
					GetPlayerName(playerid, sendername, sizeof(sendername));
					if(pban[playerid] >= 3 && PlayerInfo[playerid][pAdmin] < 1339)
					{
						BanTPL(playerid, "Baniu mais de 3", "Automatico");
						return 1;
					}
					if(dias == 0 && mes == 0 && ano == 0)
					{
						getdate(year, month, day);
						pban[playerid] += 1;
						format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi banido permanentemente por %s, Motivo[%s]", PlayerName(sscanfid), sendername, (result),day,month,year);
						BanLog(stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi banido permanentemente por %s, Motivo[%s]", PlayerName(sscanfid), sendername, (result));
						SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
						printf("ADMIN CMD: %s foi banido permanentemente por %s, Motivo: %s", PlayerName(sscanfid), sendername, (result));
						SendClientMessage(sscanfid, COR_AMARELO, "|________________Instru��es para Revis�o de Ban________________|");
						SendClientMessage(sscanfid, COR_AL, "Tire uma SS da tela apertando F8 imediatamente ap�s ser banido");
						SendClientMessage(sscanfid, COR_AL, "E acesse o nosso forum: https://discord.gg/SNrbT9QRhw");
						SendClientMessage(sscanfid, COR_LIGHTRED, "Aten��o: Voc� s� ser� desbanido se for inocente !");
						PlayerInfo[sscanfid][pDiaBanTemp] = dias;
						PlayerInfo[sscanfid][pMesBanTemp] = mes;
						PlayerInfo[sscanfid][pAnoBanTemp] = ano;
						OnPlayerSave(sscanfid);
						BanTPL(sscanfid, result, sendername);
					}
					else if(dias > 0 && mes > 0 && ano > 0)
					{
						getdate(year, month, day);
						pban[playerid] += 1;
						format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi banido temporariamente por %s, Motivo[%s], Desban[%d/%d/%d]", PlayerName(sscanfid), sendername, (result), dias, mes, ano);
						BanTempLog(stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi banido temporariamente por %s, Motivo[%s], Desban[%d/%d/%d]", PlayerName(sscanfid), sendername, (result), dias, mes, ano);
						SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
						printf("ADMIN CMD: %s foi banido temporariamente por %s, Motivo[%s] Desban[%d/%d/%d]", PlayerName(sscanfid), sendername, (result), dias, mes, ano);
						SendClientMessage(sscanfid, COR_AMARELO, "|________________Instru��es para Revis�o de Ban________________|");
						SendClientMessage(sscanfid, COR_AL, "Tire uma SS da tela apertando F8 imediatamente ap�s ser banido");
						SendClientMessage(sscanfid, COR_AL, "E acesse o nosso forum: https://discord.gg/SNrbT9QRhw");
						SendClientMessage(sscanfid, COR_LIGHTRED, "Aten��o: Voc� s� ser� desbanido se for inocente !");
						PlayerInfo[sscanfid][pDiaBanTemp] = dias;
						PlayerInfo[sscanfid][pMesBanTemp] = mes;
						PlayerInfo[sscanfid][pAnoBanTemp] = ano;
						OnPlayerSave(sscanfid);
						BanTemp(sscanfid, result, PlayerName(playerid));
					}
					return 1;
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "ID [0] N�o est� Online.");
				return 1;
			}
		}
		return 1;
	}
