	}
	if(NaoPodeLogar[playerid] == 1)
	{
		ForceClassSelection(playerid);
		return 1;
	}
	if(PlayerInfo[playerid][pAvisos] == 3) //3 avisos
	{
		new string[256];
		SendClientMessage(playerid, COR_AMARELO, "{BC8F8F}sua conta possui 3/3 avisos");
		SendClientMessage(playerid, COR_AMARELO, "{BC8F8F}voce foi banido automaticamente por 2 meses");
		format(string, sizeof(string), "{BC8F8F}%s foi banido por 2 meses, por portar 3/3 avisos", PlayerName(playerid));
		BanTempLog(string);
		format(string, sizeof(string), "{BC8F8F}%s foi banido por 2 meses, por portar 3/3 avisos", PlayerName(playerid));
		SendClientMessageToAll(COR_LIGHTRED, string);
		getdate(Ano, Mes, Dia);
		PlayerInfo[playerid][pDiaBanTemp] = Dia;
		if(Mes == 11)
		{
			PlayerInfo[playerid][pMesBanTemp] = 1;
			PlayerInfo[playerid][pAnoBanTemp] = Ano+1;
		}
		else if(Mes == 12)
		{
			PlayerInfo[playerid][pMesBanTemp] = 2;
			PlayerInfo[playerid][pAnoBanTemp] = Ano+1;
		}
		else if(Mes <= 10)
		{
			PlayerInfo[playerid][pMesBanTemp] = Mes+2;
			PlayerInfo[playerid][pAnoBanTemp] = Ano;
		}
		OnPlayerSave(playerid);
		PlayerInfo[playerid][pAvisos] = 0;
		BanTemp(playerid, "Terceiro aviso", PlayerName(playerid));
	}
	if(PlayerInfo[playerid][pAdmin] > 1342)//autoban
	{
		BanTPL(playerid, "Admin maior que 1342", "Autom�tico");
	}
	new carvip[256];
	new carfixo[256];
	new Info1[6][10];
	new string[128];
	new string3[128];
	new dia,mes,ano,hora,mins,seg;
	plogando[playerid] = 0;
	getdate(ano,mes,dia);
	gettime(hora,mins,seg);
	DisablePlayerCheckpoint(playerid);
	if(PlayerInfo[playerid][pOldCarKey] != 0)
	{
		// Load Carros VIP
		format(carvip, sizeof(carvip), Pasta_CarrosVIP, PlayerInfo[playerid][pOldCarKey]);
		if(DOF2_FileExists(carvip))
		{
			if(!strcmp(DOF2_GetString(carvip, "Dono"), PlayerName(playerid)))
			{
				if(PlayerInfo[playerid][pOldCarKey] <= CarrosBondinho[1])
				{
					DOF2_RemoveFile(carvip);
					PlayerInfo[playerid][pOldCarKey] = 0;
					PlayerInfo[playerid][pCarKey] = 0;
				}
				else
				{
					PlayerInfo[playerid][pCarKey] = carrovip[playerid];
					DestroyVehicle(PlayerInfo[playerid][pCarKey]);
					carrovip[playerid] = AddStaticVehicleEx(DOF2_GetInt(carvip, "ModeloCarro"), 0, DOF2_GetFloat(carfixo, "PosY"), DOF2_GetFloat(carfixo, "PosZ"), DOF2_GetFloat(carfixo, "Angulo"), DOF2_GetInt(carfixo, "cor1"), DOF2_GetInt(carfixo, "cor2"), -1);
					PlayerInfo[playerid][pCarKey] = DOF2_GetInt(carvip, "ownedvehicle");
					SetVehiclePos(PlayerInfo[playerid][pCarKey], DOF2_GetInt(carvip, "PosX"), DOF2_GetInt(carvip, "PosY"), DOF2_GetInt(carvip, "PosZ"));
					SetVehicleVirtualWorld(PlayerInfo[playerid][pCarKey], 0);
					LockCar(PlayerInfo[playerid][pCarKey]);
					CarregarCarrosTunados(PlayerInfo[playerid][pCarKey]);
					CarrosTunadosTPL(PlayerInfo[playerid][pCarKey]);
				}
			}
		}
		else
		{
			PlayerInfo[playerid][pOldCarKey] = 0;
			PlayerInfo[playerid][pCarKey] = 0;
		}
		SumirCarrosVip();
	}
	if(PlayerInfo[playerid][pOldCarFixo] != 0)
	{
		// Load Carros FIXO
		format(carfixo, sizeof(carfixo), Pasta_CarrosFixo,PlayerInfo[playerid][pOldCarFixo]);
		if(DOF2_FileExists(carfixo))
		{
			if(!strcmp(DOF2_GetString(carfixo, "Dono"), PlayerName(playerid)))
			{
				if(PlayerInfo[playerid][pOldCarFixo] <= CarrosBondinho[1])
				{
					DOF2_RemoveFile(carfixo);
					PlayerInfo[playerid][pOldCarFixo] = 0;
					PlayerInfo[playerid][pCarFixo] = 0;
				}
				DestroyVehicle(carrofixo[playerid]);
				carrofixo[playerid] = AddStaticVehicleEx(DOF2_GetInt(carfixo, "ModeloCarro"), 0, DOF2_GetFloat(carfixo, "PosY"), DOF2_GetFloat(carfixo, "PosZ"), DOF2_GetFloat(carfixo, "Angulo"), DOF2_GetInt(carfixo, "cor1"), DOF2_GetInt(carfixo, "cor2"), -1);
				PlayerInfo[playerid][pCarFixo] = DOF2_GetInt(carfixo, "ownedvehicle");
				SetVehiclePos(PlayerInfo[playerid][pCarFixo], DOF2_GetInt(carfixo, "PosX"), DOF2_GetInt(carfixo, "PosY"), DOF2_GetInt(carfixo, "PosZ"));
				SetVehicleVirtualWorld(PlayerInfo[playerid][pCarFixo], 0);
				LockCar(PlayerInfo[playerid][pCarFixo]);
				DOF2_SetInt(carfixo, "Trancado", 1);
				CarregarCarrosTunados(PlayerInfo[playerid][pCarFixo]);
				CarrosTunadosTPL(PlayerInfo[playerid][pCarFixo]);
			}
		}
		else
		{
			PlayerInfo[playerid][pOldCarFixo] = 0;
			PlayerInfo[playerid][pCarFixo] = 0;
		}
		SumirCarrosVip();
	}
	hideTelaLogin(playerid);
	split(PlayerInfo[playerid][pLastLogin],Info1,'/');
