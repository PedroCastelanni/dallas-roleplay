	CMD:apxguidarrgb98(playerid,params[])
	{
    new id, string[190];
	if(PlayerInfo[playerid][pAdmin] >= 1342)
	if(sscanf(params,"d", id)) return SendClientMessage(playerid, -1, "[ERRO] Use: /darrgb [ID]");
	if(!IsPlayerConnected(id)) return SendClientMessage(playerid, -1, "[ERRO] O id nao esta Online");
	if(TaRgb[id] == true) return SendClientMessage(playerid, -1, "[ERRO] Este player ja esta com tag RGB ativado");
	format(string, sizeof(string), "{00FF00}[TAG RGB RARA] {FFFFFF}O staff {FFFF00}%s {FFFFFF}deu a Tag {FF0000}RGB RARA {FFFFFF}para o jogador(a) {FFFF00}%s", GetPlayerNome(playerid), GetPlayerNome(id));
	SendClientMessage(playerid, -1, string);
	SendClientMessage(id, -1, string);
	KillRgb[id] = SetTimerEx("Trocargb", 2000, true, "i", id);
	TaRgb[id] = true;
	return 1;
	}
	CMD:apxguitirourgb98(playerid,params[])
	{
    new id, string[190];
	if(PlayerInfo[playerid][pAdmin] >= 1342)
	if(sscanf(params,"d", id)) return SendClientMessage(playerid, -1, "[ERRO] Use: /tirarrgb [ID]");
	if(!IsPlayerConnected(id)) return SendClientMessage(playerid, -1, "[ERRO] O id nao esta Online");
	if(TaRgb[id] == false) return SendClientMessage(playerid, -1, "[ERRO] Este player nao esta com tag RGB ativado");
	format(string, sizeof(string), "{00FF00}[INFO] {FFFFFF}O(A) {FFFF00}%s {FFFFFF}tirou a Tag {FF00FF}RGB {FFFFFF}do player {FFFF00}%s", GetPlayerNome(playerid), GetPlayerNome(id));
	SendClientMessage(playerid, -1, string);
	SendClientMessage(id, -1, string);
	KillTimer(KillRgb[id]);
	TaRgb[id] = false;
	SetPlayerColor(id, 0xFFFFFFFF);
	return 1;
	}
