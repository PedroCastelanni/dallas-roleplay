TPL::VerificaTitulos(playerid)
{
	new string[190];
	if(IsPlayerConnected(playerid) && gPlayerLogged[playerid])
	{
	    	// sistema de titulos
	    	if(TanoEventoJogosVorazes[playerid] == 1 || TaNoQuarentena[playerid] == 1)
	    	{
				SetPlayerChatBubble(playerid, "", COR_TITULO, 45.0, 100000);
				return 1;
			}
			if(WantedLevel[playerid] != 0 && Roubando[playerid] == 1 && EstaAFK[playerid] == 0)
	        {
			     SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
	             format(string, sizeof(string), "Roubo[%d] Procurado:[%d]",Contagem[playerid], WantedLevel[playerid]);
	             SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 100000);
	        }
	        if(strfind(PlayerInfo[playerid][pATitulo], "", true) != -1 && Roubando[playerid] == 0 && EstaAFK[playerid] == 0)
		    {
				 if(WantedLevel[playerid] != 0 && Roubando[playerid] == 0)
				 {
			          SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
	                  format(string, sizeof(string), "P:[%d]",WantedLevel[playerid]);
	                  SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 100000);
	             }
	             if(PlayerInfo[playerid][pJailed] != 0)
	             {
	                  if(PlayerInfo[playerid][pPenitenciaria] == 1)
					  {
			               format(string, sizeof(string), "[ID:%d][Seg:%d][LS]",playerid, PlayerInfo[playerid][pJailTime]);
			               SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 10000);
			          }
	             }
		    }
		    else
			{
	      		if(Roubando[playerid] == 0 && EstaAFK[playerid] == 0)
		        {
					 if(WantedLevel[playerid] == 0)
					 {
		                  SetPlayerChatBubble(playerid, PlayerInfo[playerid][pATitulo], COR_TITULO, 45.0, 10000);
		             }
		             else if(WantedLevel[playerid] != 0)
		             {
		                  SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
				          format(string, sizeof(string), "%s[P:%d]", PlayerInfo[playerid][pATitulo], WantedLevel[playerid]);
				          SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 10000);
		             }
		             if(PlayerInfo[playerid][pJailed] != 0)
		             {
						  if(PlayerInfo[playerid][pPenitenciaria] == 1)
						  {
				               format(string, sizeof(string), "%s[ID:%d][Seg:%d][LS]", PlayerInfo[playerid][pATitulo],playerid, PlayerInfo[playerid][pJailTime]);
				               SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 10000);
				          }
		             }
		        }
			}
	}
	return 1;
}
TPL::ColocarAureola(playerid)
{
	SetPlayerAttachedObject(playerid,9,2992,2,0.306000,-0.012000,0.009000,0.000000,-95.299942,-1.399999,1.000000,1.000000,1.000000);
	SetPlayerAttachedObject(playerid,10,2992,2,0.313000,-0.007000,0.032999,-0.299999,83.700019,0.000000,1.000000,1.000000,1.000000);
  	return 1;
}
TPL::TirarAureola(playerid)
{
    RemovePlayerAttachedObject(playerid, 9);
	RemovePlayerAttachedObject(playerid, 10);
}
TPL::CarregarItens(playerid)
{
	//----------------- Carregar Itens ----------------------//
	if (!LogouAgora[playerid])
	{
		LoadWeaponsToFile(playerid); //carregar armas
	 	CreateTextDraws(playerid);
		//SetStatusBar(playerid, 0, Player_PayDay[playerid], -PlayerInfo[playerid][pPayDay]);
		new sfome[10];
		format(sfome, sizeof(sfome), "%d%", PlayerInfo[playerid][pPayDay]);
	 	if(PlayerInfo[playerid][pTutorial] == 1 && PlayerInfo[playerid][pJailed] == 0)
	 	{
	 		ShowPlayerDialog(playerid, 1240, DIALOG_STYLE_MSGBOX, "{4B0082}Anti-Crash", "{FFFFFF}Voce deseja voltar na ultima posicao onde estava?\nAperte em {4682B4}'voltar' {FFFFFF}para voce voltar a onde estava", "Voltar", "Nao");
		}
		if(PlayerInfo[playerid][pSFOME] == 1)
		{
			TextDrawHideForPlayer(playerid, FomeSedeTDTD[0]);
			TextDrawHideForPlayer(playerid, FomeSedeTDTD[1]);
			TextDrawHideForPlayer(playerid, FomeSedeTDTD[2]);
			TextDrawHideForPlayer(playerid, FomeSedeTDTD[3]);
			PlayerTextDrawHide(playerid, FomePosetagem[playerid]);
			PlayerTextDrawHide(playerid, SedePosetagem[playerid]);
		}
	}
	if(TemSkinPermanente[playerid] > 0)
	{
	    new arquivo[64];
		format(arquivo, sizeof(arquivo), Pasta_Acessorio,PlayerName(playerid));
		if(DOF2_FileExists(arquivo))
		{
			new Skin;
			Skin = DOF2_GetInt(arquivo, "Skin Permanente");
			if(GetPlayerSkin(playerid) != Skin)
			{
				SetPlayerSkin(playerid, Skin);
			}
		}
	}
   // == [ Carregar Itens Comprados ] == //
	new arquivo[64];
	new string[20];
 	format(arquivo, sizeof(arquivo), Pasta_CAcessorio,PlayerName(playerid));
 	if(DOF2_FileExists(arquivo))
	{
	    for(new x;x<MAX_PLAYER_ATTACHED_OBJECTS-1;x++)
        {
			    format(string, sizeof(string), "modelid%d",x);
				new modelid = DOF2_GetInt(arquivo, string);
				if(modelid != 0)
				{
					format(string, sizeof(string), "boneid%d",x);
					new bone = DOF2_GetInt(arquivo, string);
					format(string, sizeof(string), "fOffsetX%d",x);
					new Float:fOffsetX = DOF2_GetFloat(arquivo, string);
					format(string, sizeof(string), "fOffsetY%d",x);
					new Float:fOffsetY = DOF2_GetFloat(arquivo, string);
					format(string, sizeof(string), "fOffsetZ%d",x);
					new Float:fOffsetZ = DOF2_GetFloat(arquivo, string);
					format(string, sizeof(string), "fRotX%d",x);
					new Float:fRotX = DOF2_GetFloat(arquivo, string);
					format(string, sizeof(string), "fRotY%d",x);
					new Float:fRotY = DOF2_GetFloat(arquivo, string);
					format(string, sizeof(string), "fRotZ%d",x);
					new Float:fRotZ = DOF2_GetFloat(arquivo, string);
					format(string, sizeof(string), "fScaleX%d",x);
					new Float:fScaleX = DOF2_GetFloat(arquivo, string);
					format(string, sizeof(string), "fScaleY%d",x);
					new Float:fScaleY = DOF2_GetFloat(arquivo, string);
					format(string, sizeof(string), "fScaleZ%d",x);
					new Float:fScaleZ = DOF2_GetFloat(arquivo, string);
	                SetPlayerAttachedObject(playerid, x, modelid, bone, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ, 0xffffffff, 0xffffffff);
				}
		}
	}
	if(TaEscutando[playerid] > 0) SetPlayerAttachedObject(playerid, 9, 19421, 2, 0.050000, -0.014999, 0.000000, 95.000000, 183.000000, 89.000000, 1, 1, 1, 0xffffffff);
	if(AdminTrabalhando[playerid] > 0) ColocarAureola(playerid);
}

TPL:: mostrarTelaMobile(playerid)
{
	    new box[600]; //cloze edite aqui
		format(box, sizeof(box), "\
		{FFFFFF}Verifica��o de Identidade\n{FFFFFF}Confirme suas informa��es para acessar o servidor:\n\n{FFFFFF}Nome do jogador: {4B0082}%s\n{FFFFFF}N�mero do passaporte: {4B0082}%d", PlayerName(playerid), playerid);
		ShowPlayerDialog(playerid, DIALOG_PLATAFORMA, DIALOG_STYLE_MSGBOX, "{4B0082}Rocket City", box, "Sair", "Confirmar");
		// by CLEYSON
}

TPL:: mostrarTelaLogin(playerid)
{
    if(CarregandoTelaLogin[playerid] < 101)
	{
		CarregandoTelaLogin[playerid]++;
		new newtext[25];
		format(newtext, sizeof(newtext), "%d%", CarregandoTelaLogin[playerid]);
		PlayerTextDrawSetString(playerid, loadTela6[playerid], newtext);
	}
	if(CarregandoTelaLogin[playerid] >= 101)
	{
		PlayerTextDrawHide(playerid, loadTela6[playerid]);
		KillTimer(TimerLogin[playerid]);
	    TextDrawHideForPlayer(playerid, login[0]);
	    TextDrawHideForPlayer(playerid, login[1]);
	    TextDrawHideForPlayer(playerid, login[2]);
        TextDrawHideForPlayer(playerid, login[3]);
	    TextDrawHideForPlayer(playerid, login[4]);
        TextDrawHideForPlayer(playerid, login[5]);
        TextDrawHideForPlayer(playerid, login[6]);
	    TextDrawHideForPlayer(playerid, login[7]);
	    TextDrawHideForPlayer(playerid, login[8]);
        TextDrawHideForPlayer(playerid, login[9]);
	    TextDrawHideForPlayer(playerid, login[10]);
		mostrarTelaMobile(playerid) //by cleyson
		//SetTimerEx("mostrarTelaMobile", 200, false, "d", playerid);
		//showTelaLogin(playerid);
    }
	return 1;
}

