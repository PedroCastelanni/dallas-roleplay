	 //------------------------------------------------------------------------------
	 //playerid
	 KillTimer(TempoMostrarLife[playerid]);
	 format(string,sizeof(string),"~>~ ~r~~h~%s~n~         ~r~~h~-%0.0f DMG~n~~p~Arma: ~w~~h~%s", PlayerName(issuerid), amount, NomeArma(weapon));
	 PlayerTextDrawSetString(playerid, textinfodamage[playerid][1], string);
	 PlayerTextDrawShow(playerid, textinfodamage[playerid][0]);
	 PlayerTextDrawShow(playerid, textinfodamage[playerid][1]);
	 TempoMostrarLife[playerid] = SetTimerEx("HideTextoLife", 1000, 0, "i", playerid);
	 MostrandoVida[playerid] = 1;
	 //------------------------------------------------------------------------------
     if(PlayerInfo[issuerid][pSino] == 1 || PlayerInfo[issuerid][pSino] == 3)
	 {
	    PlayerPlaySound(issuerid, 17802, 0.0, 0.0, 0.0); // Ding Sound
	 }
     if(PlayerInfo[playerid][pSino] == 2 || PlayerInfo[playerid][pSino] == 3)
	 {
	    PlayerPlaySound(playerid, 17802, 0.0, 0.0, 0.0); // Ding Sound
	 }
     return 1;
}
TPL::HideTextoLife(playerid)
{
	if(MostrandoVida[playerid])
	{
    	PlayerTextDrawHide(playerid, textinfodamage[playerid][0]);
		PlayerTextDrawHide(playerid, textinfodamage[playerid][1]);
	    MostrandoVida[playerid] = 0;
	    TempoMostrarLife[playerid] = -1;
	}
	return true;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	new string[256];
	switch(weaponid){ case 0..18, 39..54: return 1;}//invalid weapons
	//Anti CBern Crasher
 	new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    if(weaponid < 22 || weaponid > 38)
	{
 		if(PlayerInfo[playerid][pLevel] < 6)
	    {
   			format(string, sizeof(string), "ANTIXITER: %s[%d] estava tentando crashar jogadores(cBern) e foi banido automaticamente!", PlayerName(playerid),playerid);
  	   		SendClientMessageToAll(COR_LIGHTRED,string);
  	   		BanTPL(playerid, "CBern crasher", "Autom�tico");
			BanLog(string);
			AntiXiterLog(string);
	    }
	    if(PlayerInfo[playerid][pLevel] > 5)
	    {
			format(string, sizeof(string), "ANTIXITER: %s[%d] parece est� utilizando cBern de crasher players, /tvon nele r�pido!", PlayerName(playerid),playerid);
			ABroadCast(COR_LIGHTRED,string,1);
			AntiXiterLog(string);
		}
		return 0;
	}
    if(!(-20000.0 <= z <= 20000.0))
	{
	    if(PlayerInfo[playerid][pLevel] < 6)
	    {
   			format(string, sizeof(string), "ANTIXITER: %s[%d] estava tentando crashar jogadores(cBern) e foi banido automaticamente!", PlayerName(playerid),playerid);
  	   		SendClientMessageToAll(COR_LIGHTRED,string);
  	   		BanTPL(playerid, "CBern crasher", "Autom�tico");
			BanLog(string);
			AntiXiterLog(string);
	    }
	    if(PlayerInfo[playerid][pLevel] > 5)
	    {
			format(string, sizeof(string), "ANTIXITER: %s[%d] parece est� utilizando cBern de crasher players, /tvon nele r�pido!", PlayerName(playerid),playerid);
			ABroadCast(COR_LIGHTRED,string,1);
			AntiXiterLog(string);
		}
	}
	// anti rapid fire
	if(weaponid != 38)
    {
         if((gettime() - shotTime[playerid]) < 1)
         {
             shot[playerid]+=1;
         }
         else
   	     {
            shot[playerid]=0;
         }
         if(shot[playerid] > 10)
         {
	        format(string, sizeof(string), "ANTIXITER: %s[%d] suspeito de rapid fire, /tvon nele r�pido!", PlayerName(playerid),playerid);
	     	ABroadCast(COR_LIGHTRED,string,1);
	     	AntiXiterLog(string);
         }
         shotTime[playerid] = gettime();
    }
    // anti auto cbug
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && weaponid == 24)
	{
		fAutoC[playerid] ++;
		if(gettime() > GetPVarInt(playerid, "UmSegundo"))
		{
			SetPVarInt(playerid, "UmSegundo", gettime() + 1);
			fAutoC[playerid] = 0;
        }
		else
		{
			if(fAutoC[playerid] > 4)
			{
	        	format(string, sizeof(string), "ANTIXITER: %s[%d] parece estar usando auto cbug, /tvon nele r�pido!", PlayerName(playerid),playerid);
		        ABroadCast(COR_LIGHTRED,string,1);
				fAutoC[playerid] = 0;
				AntiXiterLog(string);
			}
		}
	}
	return 1;
}
TPL::VerificarEntradas(playerid)
{
	 new Float:cx, Float:cy, Float:cz;
	 GetPlayerPos(playerid, cx, cy, cz);
	 GetPlayerName(playerid, sendername, sizeof(sendername));
	 if (PlayerToPoint(3, playerid,1570.3828,-1333.8882,16.4844))
	 {//Pegar Paraquedas no Pr�dio
	      SetPlayerPos(playerid, 1545.0068,-1366.5094,327.2868);
	      GameTextForPlayer(playerid, "~b~predio paraquedas", 5000, 1);
	 }
	 else if(PlayerToPoint(3.0, playerid,1554.9537,-1675.6584,16.1953))
	 {//ENTRADA HQ PM / Departamento de Policia
          if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid, "https://dl.dropboxusercontent.com/s/bydtchwsfaji3xy/playstory%20policia%20militar.mp3",262.3406,71.1922,1003.2422,30,1);
		  GameTextForPlayer(playerid, "~w~Departamento de Policia", 5000, 1);
		  SetPlayerInterior(playerid, 6);
		  InteriorAtual[playerid] = 1;
		  SetPlayerVirtualWorld(playerid,0);
