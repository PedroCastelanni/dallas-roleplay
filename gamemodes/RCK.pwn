	CMD:promover(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    new para1;
			new level;
			if(sscanf(params, "ud", para1, level))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /promover [ID/Nick] [Cargos (1-5)]");
				return 1;
			}
			if(level > 5 || level < 1) { SendClientMessage(playerid, COR_GREY, "Cargos de 1 a 5, Cargo 5 � Sub-L�der!"); return 1; }
			if (PlayerInfo[playerid][pLider] > 0)
			{
				if(IsPlayerConnected(para1))
				{
					if(PlayerInfo[para1][pMembro] == PlayerInfo[playerid][pLider])
					{
						if(para1 != INVALID_PLAYER_ID)
						{
							GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
							GetPlayerName(playerid, sendername, sizeof(sendername));
							PlayerInfo[para1][pCargo] = level;
							format(stringZCMD, sizeof(stringZCMD), "Voc� foi promovido pelo l�der %s para o cargo %d.", sendername, level);
							SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
							ResetPlayerWeaponsEx(para1);
							format(stringZCMD, sizeof(stringZCMD), "Voc� promoveu %s para o cargo %d.", giveplayerZCMD,level);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							new org = PlayerInfo[playerid][pLider];
							if(level == 5)
							{
								if(strcmp(InfoOrg[org][SubLider],"Ninguem",true)==0)
								{
									DemitirInfoOrg(giveplayerZCMD);
									ConviteInfoOrg(giveplayerZCMD, org, 5);
								}
								else
								{
									SendClientMessage(playerid, COR_GRAD1, "Voc� j� possui um sub-lider, use /limparvaga primeiro !");
									return 1;
								}
							}
							if(strcmp(InfoOrg[org][SubLider],giveplayerZCMD,true)==0)
							{
								if(level < 5)
								{
									DemitirInfoOrg(giveplayerZCMD);
									ConviteInfoOrg(giveplayerZCMD, org, level);
								}
							}
							return 1;
						}
						if(PlayerInfo[para1][pMembro] != PlayerInfo[playerid][pLider])
						{
							SendClientMessage(playerid, COR_GREY, "N�o pode promover quem n�o � da sua org.");
							return 1;
						}
					}
				}//not connected
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o � um l�der !");
			}
		}
		return 1;
	}
	CMD:settime(playerid, params[])
