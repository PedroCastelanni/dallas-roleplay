			SetPlayerInterior(playerid, 0);
			SetPlayerColor(playerid, 0x4169E1FF);
			return 1;
		}
		case 32: //tdt
		{
			SetPlayerPos(playerid, 1804.1328,-826.0939,92.3628);
			SetPlayerHealth(playerid, 100);
			SetPlayerFacingAngle(playerid,276.0815);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
			SetPlayerInterior(playerid, 0);
			SetPlayerColor(playerid, COR_GROTA);
			return 1;
		}
		case 33: //Desmanche 1
		{
			SetPlayerPos(playerid, 1295.2968,174.4727,20.9106);
			SetPlayerHealth(playerid, 100);
			SetPlayerFacingAngle(playerid,60.5459);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
			SetPlayerInterior(playerid, 0);
			SetPlayerColor(playerid, COR_TDL);
			return 1;
		}
	}
	//------------------------------------Nascimento Empregos e Civis-----------------------------//
	switch(PlayerInfo[playerid][pEmprego])
	{
	    case 3: // Segunra�as
	    {
   			SetPlayerInterior(playerid, 0);
			InteriorAtual[playerid] = 0;
			SetPlayerPos(playerid,2035.5109,-1279.1993,20.9761);
			SetPlayerFacingAngle(playerid,181.4693);
			SetPlayerHealth(playerid, 100);
			return 1;
	    }
	    case 4:
    	{
			SetPlayerPos(playerid,1774.1322,-1704.8979,13.5213); // Motorista de Uber
			SetPlayerFacingAngle(playerid, 3.1437);
            SetPlayerSkin(playerid, 183);
			SetPlayerHealth(playerid, 100);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
			return 1;
		}
		case 2:
		{
			if(PlayerInfo[playerid][pSocio] > 0)
			{
				if(GetPlayerOrg(playerid) != 0)return 1;
			}
			SetPlayerPos(playerid,1658.1134,-1394.9524,13.5469); // advogados
			SetPlayerFacingAngle(playerid, 91.1808);
			SetPlayerHealth(playerid, 100);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
			AdvogadoOnline += 1;
		}
		case 7:
		{
			SetPlayerPos(playerid,1775.2545,-1571.6923,1742.4496); // Agente Penitenci�rio
			SetPlayerFacingAngle(playerid, 181.4693);
			GivePlayerWeaponEx(playerid, 3, 1);
			GivePlayerWeaponEx(playerid, 41, 900);
			SetPlayerHealth(playerid, 100);
			SetPlayerInterior(playerid,5);
			SetPlayerVirtualWorld(playerid, 0);
			InteriorAtual[playerid] = 24;
			return 1;
		}
		case 6:
		{
			SetPlayerPos(playerid,993.1486,2431.3240,10.9830); // petroleiro
			SetPlayerFacingAngle(playerid, 7.8302);
			SetPlayerSkin(playerid, 133);
			SetPlayerHealth(playerid, 100);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
		}
		case 8:
		{
			SetPlayerPos(playerid,2200.0781,-1969.9874,13.7841); // Lixeiro Ls
			SetPlayerFacingAngle(playerid, 181.4693);
			SetPlayerHealth(playerid, 100);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
			return true;
		}
		case 10:
		{
			SetPlayerPos(playerid,-237.5395,-1338.7030,8.6599); // Agricultor
			SetPlayerFacingAngle(playerid, 178.9645);
			SetPlayerHealth(playerid, 100);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
			return 1;
		}
		case 11:
		{
			SetPlayerPos(playerid,815.3347,-1091.4911,25.7898); // Coveiro
			SetPlayerFacingAngle(playerid, 177.2215);
			SetPlayerSkin(playerid, 70);
			SetPlayerHealth(playerid, 100);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
			return 1;
		}
		case 12:
		{
			SetPlayerPos(playerid,1441.7911,2360.0532,10.8203); // Carteiro
			SetPlayerFacingAngle(playerid, 181.4693);
			SetPlayerHealth(playerid, 100);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
			return 1;
		}
		case 15:
		{
  			SetPlayerPos(playerid,377.2911,-115.3470,1001.4922); // Pizzaboy Ls
		  	SetPlayerFacingAngle(playerid, 88.9771);
		  	SetPlayerSkin(playerid, 155);
      	  	SetPlayerHealth(playerid, 100);
	      	SetPlayerInterior(playerid,5);
		  	SetPlayerVirtualWorld(playerid,0);
            InteriorAtual[playerid] = 30;
          	return true;
		}
		case 16:
		{
  			SetPlayerPos(playerid,1003.9560,-91.6045,22.4495); // Minerador
		  	SetPlayerFacingAngle(playerid, 28.0772);
      	  	SetPlayerHealth(playerid, 100);
	      	SetPlayerInterior(playerid,0);
		  	SetPlayerVirtualWorld(playerid,0);
          	return true;
		}
  		default://=======================(SPAWN CIVIL)==========================
	    {
	  		if(AdminTrabalhando[playerid] >= 1)
		  		SetPlayerPos(playerid,1683.2220,-2333.2524,13.5930); // Nascimento Admin
			else
			SetPlayerPos(playerid,1585.5582,-2286.6345,13.5396); // Nascimento Civil
			SetPlayerFacingAngle(playerid, 91.4261);
			SetPlayerInterior(playerid,0);
			SetPlayerHealth(playerid, 100);
			SetPlayerVirtualWorld(playerid,0);
			InteriorAtual[playerid] = 0;
	    }
 	}
	if(TesteMoto[playerid] == 1 || TesteCarro[playerid] == 1 || TesteHeli[playerid] == 1 || TesteBarco[playerid] == 1 || TesteTruck[playerid] == 1)
	{
	    SendClientMessage(playerid, -1, "Voce morreu e perdeu o teste de licen�as,tente novamente !");
		TesteCarro[playerid] = 0;
	    TesteMoto[playerid] = 0;
	    TesteHeli[playerid] = 0;
	    TesteBarco[playerid] = 0;
	    TesteTruck[playerid] = 0;
	    return 1;
	}
	if(TaNoQuarentena[playerid] == 1)
	{
	    new QuantidadeHumanos, QuantidadeInfectados;

	    foreach(new i: Player)
		{
			if(EquipeQuarentena[i] == 2) QuantidadeInfectados++;
			if(EquipeQuarentena[i] == 1) QuantidadeHumanos++;
		}

  		if(EquipeQuarentena[playerid] == 1)
	    {
	        NaPorraDoEvento[playerid] = false;
	       // ContagemQuarentena[playerid] = 0;
	        EquipeQuarentena[playerid] = 0;
	        TextDrawHideForPlayer(playerid, TextDrawCQ);
	        pClassiQuarentena[playerid] = 0;
	        SetHoraPlayer(playerid);
            TimeQuarentena5 = SetTimer("VerificarHumanos", 1000, false);

	    }
	    if(EquipeQuarentena[playerid] == 2)
	    {
	        NaPorraDoEvento[playerid] = false;
	        EquipeQuarentena[playerid] = 0;
	   //     ContagemQuarentena[playerid] = 0;
	        TextDrawHideForPlayer(playerid, TextDrawCQ);
	        pClassiQuarentena[playerid] = 0;
	        SetHoraPlayer(playerid);
            TimeQuarentena4 = SetTimer("VerificarInfectados", 1000, false);
		}
	}
	if(TanoEventoJogosVorazes[playerid] == 1)
	{
		if(QuantidadeEvento == 0 && TanoEventoJogosVorazes[playerid] == 1)
		{
			return 1;
		}
		else
		{
			QuantidadeEvento--; //evento jogos vorazes
			format(gstring, sizeof(gstring), "[Jogos Vorazes] %s morreu no evento, restam [%d] sobreviventes.",PlayerName(playerid), QuantidadeEvento);
			SendClientMessageToAll(COR_VERDE,gstring);
			SetPlayerWorldBounds(playerid,20000.0000,-20000.0000,20000.0000,-20000.0000);
			TanoEventoJogosVorazes[playerid] = 0;
			NaPorraDoEvento[playerid] = false;
			VerificarGanhador(playerid);
			return 1;
		}
	}
	VerBan(playerid);
	VerBanTemp(playerid);
	VerBanSerial(playerid);
	SetCameraBehindPlayer(playerid);
	return 1;
}
TPL::VerificarHumanos(playerid)
{
	new QuantidadeHumanos;
	foreach(new i: Player)
	{
	    if(EquipeQuarentena[i] == 1) QuantidadeHumanos++;
	}
	format(gstring, sizeof(gstring), "[Quarentena] %s(Humano) morreu no evento, restam [%d] infectados.",PlayerName(playerid),QuantidadeHumanos);
    MensagemQuarentena(COR_GREEN, gstring);
    TaNoQuarentena[playerid] = 0;
    EquipeQuarentena[playerid] = 0;
    if(QuantidadeHumanos == 0) InfectadosGanharam(playerid);
    KillTimer(TimeQuarentena5);
}
TPL::VerificarInfectados(playerid)
{
    new QuantidadeInfectados;

    foreach(new i: Player)
	{
		if(EquipeQuarentena[i] == 2) QuantidadeInfectados++;
	}
    format(gstring, sizeof(gstring), "[Quarentena] %s(Infectado) morreu no evento, restam [%d] infectados.",PlayerName(playerid),QuantidadeInfectados);
    MensagemQuarentena(COR_GREEN, gstring);
    TaNoQuarentena[playerid] = 0;
    EquipeQuarentena[playerid] = 0;
	if(QuantidadeInfectados == 0) HumanosGanharam(playerid);
    KillTimer(TimeQuarentena4);
}
public OnPlayerDeath(playerid, killerid, reason)
{
    TerroristBomb[playerid] = 0;
	DisablePlayerCheckpoint(playerid);

	new string[256];
	new Float:px,Float:py,Float:pz;
	new NomePlayerMatou[MAX_PLAYER_NAME];
	new NomePlayerMorreu[MAX_PLAYER_NAME];
	PlayerInfo[playerid][pDeaths]++;
	if(enjaulado[playerid] == 1)
	{
	     format(string, sizeof(string), "[SEQUESTRO] Os sequestradores mataram o ref�m %s. Fim do Sequestro!", PlayerName(playerid));
		 SendClientMessageToAll(COR_DBLUE, string);
         SequestroAcontecendo = false;
         sequestradoid[playerid] = 0;
         sequestradolocal[playerid] = 0;
         PLO += 100;
		 DepositarOrgGrana(7,100);
	}
	if(IniciouCombate[playerid] != 0) IniciouCombate[playerid] = 0;
	GetPlayerName(killerid, NomePlayerMatou, sizeof(NomePlayerMatou));
	GetPlayerName(playerid, NomePlayerMorreu, sizeof(NomePlayerMorreu));
	NaPorraDoEvento[playerid] = false;
	if(PlayerInfo[playerid][pSocio] < 1 && NaPorraDoEvento[playerid] == false)
	{
		if(TendoGuerra == 1 && GetPlayerOrg(playerid) == 3) return 1;
		if(TendoGuerra == 1 && GetPlayerOrg(playerid) == 6) return 1;
		if(TendoGuerra == 1 && GetPlayerOrg(playerid) == 16) return 1;
		SetarHospital[playerid] = 1;
	}
	DestruirMedKit(playerid);
	KillTimer(TempoRecuperandoSe[playerid]);
	KillTimer(TimerHospital[playerid]);
	gPlayerSpawned[playerid] = 0;
	MenuTR[playerid] = 0;
	EscutandoSom[playerid] = 0;
	DonoFesta[playerid] = 0;
	LocalAtual[playerid] = 999;
	GetPlayerPos(playerid, px, py, pz);
	spawnado[playerid] = 0;
	KillTimer(TempoContagem[playerid]);
	Inenforcer[playerid] = 0;
	Incargobob[playerid] = 0;
	Watching[playerid] = 0;
	Goto[playerid] = 0;
    iniciarrally[playerid] = 0;
    iniciarcross[playerid] = 0;
    iniciartrilha[playerid] = 0;
    iniciarbarco[playerid] = 0;
    iniciarkart[playerid] = 0;
    corridamaluca[playerid] = 0;
    iniciartrato[playerid] = 0;
    CPEvento1[playerid] = 0;
    CPEvento2[playerid] = 0;
    CPEvento3[playerid] = 0;
    CPEvento4[playerid] = 0;
    CPEvento5[playerid] = 0;
    CPEvento6[playerid] = 0;
    CPEvento7[playerid] = 0;
    HouseEntered[playerid] = 999;
    protecao[playerid] = 0;
    enjaulado[playerid] = 0;
	Sequestrado[playerid] = 0;
	JoinedHay[playerid] = 0;
    RemovePlayerAttachedObject(playerid,9);
    DoubleKill[killerid] = 1;
    dkill[killerid] = SetTimerEx("DouKill", 10000, 1, "i", killerid);
	if(PlayerInfo[playerid][pHeadValue] == 0)
	{
		 if(killerid != playerid)
		 {
			  if(killerid != INVALID_PLAYER_ID)
			  {
	               SendDeathMessage(killerid, playerid, reason);
	          }
	     }
	}
	//Guerra Morro
	if(GuerraMorro[gGuerra])
	{
		gPlayerSpawned[playerid] = 0;
		gCheckPontos(playerid, killerid);
		new Liberar = random(15);
		if(Liberar == 8)
		{
			new RandomCaixa = random(120);
	 		if(RandomCaixa == 120) TipoCaixinhaSurpresa = 19057;
	 		else if(RandomCaixa >= 45 && RandomCaixa <= 79) TipoCaixinhaSurpresa = 19055;
	  		else if(RandomCaixa >= 95 && RandomCaixa <= 98) TipoCaixinhaSurpresa = 19056;
	    	else TipoCaixinhaSurpresa = 19054;
	    	new str1[10];
	     	if(TipoCaixinhaSurpresa == 19054) format(str1, sizeof(str1), "Bronze");
	      	if(TipoCaixinhaSurpresa == 19055) format(str1, sizeof(str1), "Prata");
	        if(TipoCaixinhaSurpresa == 19056) format(str1, sizeof(str1), "Ouro");
	        if(TipoCaixinhaSurpresa == 19057) format(str1, sizeof(str1), "Platina");
			format(string, sizeof(string), "[{FFFFFF}SPAWN SURPRESA{3498DB}]: Foi Spawnado uma{ffffff} Caixa %s {3498DB}no Morro!", str1);
	        SendClientMessageToAll(0x3498DBFF, string);
			new Float: x, Float: y, Float: z;
		    GetPlayerPos(playerid, x, y, z);
			CaixinhaSurpresa = CreateDynamicPickup(TipoCaixinhaSurpresa, 1, x, y, z+1.5);
			foreach(new i: Player)
			{
			    GetPlayerPos(i, x, y, z);
				PlayerPlaySound(i, 5202, x, y, z);
			}
		}
  	}
    //TDM
	if(TDM[killerid] == 1 && TDM[playerid] == 1)
	{
        format(string,sizeof(string),"(DEAGLE ARENA): {FFFFFF}%s matou %s.",PlayerName(killerid),PlayerName(playerid));
        ProxDetector(100.0, playerid, string,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE);
		SetPlayerArmour(killerid, 100);
		SetPlayerHealth(killerid, 100);
		return 1;
	}
    //Evento 1X1
    if(killerid == Playersx1[0] || killerid == Playersx1[1])
	{
	    if((killerid == Playersx1[0] && playerid == Playersx1[1]) || (killerid == Playersx1[1] && playerid == Playersx1[0]))
		{
	        SendClientMessageToAll(COR_DBLUE, "|__________________[ Evento De X1 ]__________________|");
			format(string, sizeof(string), "[EVENTO X1]: Player %s venceu %s com o tempo de %s", PlayerName(killerid), PlayerName(playerid), ConvertTime(gettime()-tempox1));
			SendClientMessageToAll(COR_VERDE, string);
	        Playersx1[0] = 999;
	        Playersx1[1] = 999;
	        return 1;
	    }
	}
    //Evento X1
    if(Tanoevento[playerid] == 1 && Tanoevento[killerid])
    {
    	format(gstring, sizeof(gstring), "[EVENTO X1]: Player %s Matou %s No Evento de x1 e Ganhou 5000R$.", PlayerName(killerid),PlayerName(playerid));
   		ProxDetector(100.0, playerid, gstring,COR_AZTECAS,COR_AZTECAS,COR_AZTECAS,COR_AZTECAS,COR_AZTECAS);
   		GivePlayerMoneyEx(killerid, 5000);
 	}
 	//Anti Fake-Kill
	if(killerid == INVALID_PLAYER_ID) return 1;
	if(GetPVarInt(playerid, "Morte") > gettime()) //Bern by Equipe BGS
	{
	    if(AvisoFakeKill[playerid] <= 5)
	    {
	        format(string, 128, "ANTIXITER: %s[%d] parece estar usando fake kill, /tvon nele r�pido !",PlayerName(playerid),playerid);
	        ABroadCast(COR_LIGHTRED,string,1);
	        AvisoFakeKill[playerid] += 1;
		}
		else if(AvisoFakeKill[playerid] >= 6 && NaPorraDoEvento[playerid] == false)
		{
	 		format(string, 128, "ANTIXITER: %s[%d] estava usando fake kill e foi banido automaticamente !",PlayerName(playerid),playerid);
			SendClientMessageToAll(COR_LIGHTRED, string);
			AntiXiterLog(string);
			BanTPL(playerid, "Fake Kill", "Autom�tico");
			return 1;
		}
		else
  		format(string, 128, "ANTIXITER: %s[%d] parece estar usando fake kill, /tvon nele r�pido !",PlayerName(playerid),playerid);
    	ABroadCast(COR_LIGHTRED,string,1);
	}
    //Evento quarentena
    if(TaNoQuarentena[playerid] == 1 && TaNoQuarentena[killerid] == 1 && EquipeQuarentena[playerid] == 2 && EquipeQuarentena[killerid] == 1)
   	{
  		MorteEvento[killerid] += 1;
		MorteEvento[playerid] = 0;

		ProxDetector(100.0, playerid, gstring,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE);
	    if(pClassiQuarentena[playerid] == BOOMER)
	    {
		    foreach(new i: Player)
		    {
		        if(TaNoQuarentena[i] >= 0)
		        {
	 				new Float:boomx, Float:boomy, Float:boomz;
					GetPlayerPos(killerid,boomx, boomy, boomz);
					CreateExplosion(boomx, boomy , boomz, 7, 10);
			    	if(ProxDetectorS(10.0, playerid, i))
			    	{
			    	    format(string, sizeof(string), "[Quarentena] Infectado %s morreu como boomer, quem estava pr�ximo a ele foi infectado.",ProxDetectorS(10.0, i, playerid))//NomePlayerMorreu);
			    	    MensagemQuarentena(COR_LIGHTRED, string);
	   					format(string, sizeof(string), "[Quarentena] Voc� infectou o jogador %s ao explodir e ganhou R$[4000].",PlayerName(playerid));
						SendClientMessage(killerid,COR_LIGHTRED, string);
						GivePlayerMoneyEx(killerid, 4000);
						EquipeQuarentena[i] = 2;
						PlacarQuarentena(playerid);
			    	}
			    }
		    }
	    }
        if(MorteEvento[killerid] == 1 || MorteEvento[killerid] == 2)
        {

        	format(string, sizeof(string), "[Quarentena] Humano %s matou o infectado %s  - Ganhou:[R$4000] [1] bala de bazuka e [30] de vida.",NomePlayerMatou, NomePlayerMorreu);
   			MensagemQuarentena(COR_GREEN, string);
   			GivePlayerMoneyEx(killerid, 4000);
      		GivePlayerHealth(killerid, 30);
      		GivePlayerWeaponEx(killerid, 36, 1);//checada no seta�ao do cara,
      		PlacarQuarentena(playerid);
      		pClassiQuarentena[playerid] = 0;
			return 1;
        }
       	if(MorteEvento[killerid] == 3)
        {

        	format(string, sizeof(string), "[Quarentena] Humano %s matou o infectado %s  - Ganhou:[R$4000] [1] bala de bazuka e [30] de vida.",NomePlayerMatou, NomePlayerMorreu);
   			MensagemQuarentena(COR_GREEN, string);
   			PlacarQuarentena(playerid);
            format(string, sizeof(string), "[Quarentena] Humano %s matou 3 infectados  - Ganhou:R$[5000], [2] bazukas, [1] katana(mata rapido) e recuperou sua vida.",NomePlayerMatou);
			MensagemQuarentena(COR_LIGHTBLUE, string);
   			GivePlayerMoneyEx(killerid, 4000);
      		SetPlayerHealth(killerid, 100);
      		GivePlayerWeaponEx(killerid, 36, 2);
      		GivePlayerWeaponEx(killerid, 8, 1);
      		SetPlayerSkin(killerid, SkinRandomHumano[random(16)]);
      		pClassiQuarentena[playerid] = 0;
			return 1;
        }
        if(MorteEvento[killerid] == 4)
        {

        	format(string, sizeof(string), "[Quarentena] Humano %s matou o infectado %s  - Ganhou:[R$4000] [1] bala de bazuka e [30] de vida.",NomePlayerMatou, NomePlayerMorreu);
   			MensagemQuarentena(COR_GREEN, string);
   			PlacarQuarentena(playerid);
   			GivePlayerMoneyEx(killerid, 4000);
      		GivePlayerHealth(killerid, 30);
      		GivePlayerWeaponEx(killerid, 36, 1);
      		pClassiQuarentena[playerid] = 0;
			return 1;
        }
        if(MorteEvento[killerid] == 5)
        {
        	format(string, sizeof(string), "[Quarentena] Humano %s matou o infectado %s  - Ganhou:[R$4000] [1] bala de bazuka e [30] de vida.",NomePlayerMatou, NomePlayerMorreu);
   			MensagemQuarentena(COR_GREEN, string);
   			PlacarQuarentena(playerid);
            format(string, sizeof(string), "[Quarentena] Humano %s matou 5 infectados  - Ganhou:[R$6000], [3] bazucas e recuperou sua vida.", NomePlayerMatou);
			MensagemQuarentena(COR_LIGHTBLUE, string);
   			GivePlayerMoneyEx(killerid, 4000);
      		SetPlayerHealth(killerid, 100);
      		GivePlayerWeaponEx(killerid, 36, 3);
      		SetPlayerSkin(killerid, SkinRandomHumano[random(16)]);
      		pClassiQuarentena[playerid] = 0;
			return 1;
        }
    }
    //Evento jogos vorazes
    if(TendoJogosVorazes == 1 && TanoEventoJogosVorazes[playerid] == 1 && TanoEventoJogosVorazes[killerid] == 1)
   	{
  		MorteEvento[killerid] += 1;
		MorteEvento[playerid] = 0;
        if(MorteEvento[killerid] == 1)
        {
        	format(string, sizeof(string), "[Jogos Vorazes] %s matou %s  - Ganhou:[R$2000], Recuperou[20], Balas de Rifle[1].",NomePlayerMatou, NomePlayerMorreu);
   			SendClientMessageToAll(COR_GREEN,string);
   			GivePlayerMoneyEx(killerid, 2000);
      		SetPlayerArmour(killerid, 20);
      		GivePlayerWeaponEx(killerid, 33, 1);
			//QuantidadeEvento --; j� est� na Public SetPlayerSpawn
			//TanoEventoJogosVorazes[playerid] = 0; j� est� na Public SetPlayerSpawn
			//SetTimer("VerificarGanhador", 250, false); j� est� na Public SetPlayerSpawn
			return 1;
        }
        else
		{
		    return 0;
   		}
    }
    // Evento War Zone
    if(TanoWarZone[playerid] == 1 && TanoWarZone[killerid] == 1)
