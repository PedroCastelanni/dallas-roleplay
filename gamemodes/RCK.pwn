	ABroadCast(COR_LIGHTRED,gstring,1);
    MEGAString[0] = EOS;
    PlayerInfo[playerid][pFome] = 100;
    PlayerInfo[playerid][pSede] = 100;
	strcat(MEGAString, "Deseja que o sistema de fome/sede seja ativado?\nCom o sistema de fome/sede ativado, voc� receber�\n");
    strcat(MEGAString, "+1 Respeito por Payday(Sal�rio) por estar sendo RP.\nCaso queira ativar ou desativar depois,\nBasta usar o cmando /menuRCK > Configura��es.\n");
	ShowPlayerDialog(playerid, 170, DIALOG_STYLE_MSGBOX, "Sistema De Fome/Sede", MEGAString, "ON","OFF");
