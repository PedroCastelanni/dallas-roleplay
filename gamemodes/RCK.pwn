				format(xgstring, sizeof(xgstring), "{FFFFFF}PERSONAGEM: {FF0000}[%s] {FFFFFF}IDTAB:[%i]", sendername, playerid);
			}
			format(string, sizeof(string), "{FFFFFF}Level[%d] Sexo[%s] Dinheiro[%s] Banco[%s] {FFFF00}VIP{FFFFFF}[%d] Coins[%d]\n\n", level, atext, ConvertMoney(cash), ConvertMoney(Conta), diasvip, PlayerInfo[targetid][pCoins]);
	        strcat(MEGAString, string);
			format(string, sizeof(string), "{FF4500}Conta{FFFFFF}[%s] {FF4500}Casado com[%s] Horas Jogadas[%d] Celular[%d] Cr�ditos[%d] Avisos[%d]\n\n", drank, married,ptime,pnumber,creditos,PlayerInfo[targetid][pAvisos]);
	        strcat(MEGAString, string);
			format(string, sizeof(string), "{FF4500}Respeito[%d/%d] Crimes[%d] Procura[%d] Matou[%d] Morreu[%d] Doen�a[%s] T�tulo[%s]\n\n",exp,expquantidade, crimes,WantedLevel[targetid],matou, morreu, dtext, titulo);
	        strcat(MEGAString, string);
			format(string, sizeof(string), "{FF4500}Emprego[%s] Organiza��o[%s] Cargo[%d] Pontos Carteira[%d/20] Fam�lia[%s] Troca Nick[%d]\n\n",jtext,NomeORG(targetid),PlayerInfo[targetid][pCargo], PlayerInfo[targetid][pPontos],InfoFamilia[GetPlayerFamilia(playerid)][NomeFamilia], MudarNick[playerid]);
	        strcat(MEGAString, string);
			format(string, sizeof(string), "{FF4500}Maconha[%d] Cocaina[%d] Crack[%d] Lsd[%d] Mats[%d] S-Maconha[%d] S-Cocaina[%d] S-Crack[%d] S-Lsd[%d] S-Mats[%d]\n\n",Drogas,Drogas2,Drogas3,Drogas4,mats,SafeDrogas,SafeDrogas2,SafeDrogas3,SafeDrogas4,smats);
	        strcat(MEGAString, string);
			format(string, sizeof(string), "{FF4500}Casa[%d] Empresa[%d] Fazenda[%d] Ve�culos[0%d/02] Carro Aluguel[id:%d] T�tulo Personalizado[%s]\n\n",Housekey,bizkey,fazkey,Veiculos,HireCar[targetid], xtextt);
	        strcat(MEGAString, string);
			format(string, sizeof(string), "{FF0000}Dinamites[%s] Decodificador[%s] Gal�o[%s] Kit Reparo[%s]\n\n", textdina, textdecod, textgalao, textkitcarro);
	        strcat(MEGAString, string);
