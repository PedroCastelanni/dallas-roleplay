		GetVehicleHealth(vid, vida);
		if(IsPlayerInAnyVehicle(playerid))
		{
			if(GetPlayerState(playerid) != 2)
			{
				SendClientMessage(playerid, COR_LIGHTBLUE, "Voc� n�o � o motorista deste ve�culo !");
