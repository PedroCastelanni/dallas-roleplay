			{
				SendClientMessage(playerid, COR_LIGHTBLUE, "Seu ve�culo est� sem gasolina, use um gal�o !");
				return 1;
			}
			if(EngineCarro[vid] == 1  && GetPlayerState(playerid) == 2 && GetPlayerSpeed(playerid, true) > 1)
			{
				SendClientMessage(playerid, COR_LIGHTBLUE, "{FF0000}[ERRO}{FFFFFF} voce tem que para o veiculo para ligar/desligar o motor");
				return 1;
			}
			if(GetPlayerState(playerid) == 2 && Quebrado[vid] == 1)
			{
				SendClientMessage(playerid, COR_LIGHTBLUE, "Seu ve�culo est� quebrado, n�o pode mecher no motor !");
				return 1;
            }
            if(AluguelCarros1(vid) || AluguelCarros2(vid) || AluguelCarros3(vid) || AluguelCarros4(vid) || BarcosAluguel(vid) || AeroAluguel(vid))
			{
