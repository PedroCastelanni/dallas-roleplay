stock strtok(const string[], &index)
{
	new length = strlen(string);
	while ((index < length) && (string[index] <= ' '))
	{
		index++;
	}
	new offset = index;
	new result[20];
	while ((index < length) && (string[index] > ' ') && ((index - offset) < (sizeof(result) - 1)))
	{
		result[index - offset] = string[index];
		index++;
	}
	result[index - offset] = EOS;
	return result;
}
stock SaveLastPosition(vehicleid)
{
    new Float:SaveCoord_X, Float:SaveCoord_Y, Float:SaveCoord_Z;
    GetVehiclePos(vehicleid, SaveCoord_X, SaveCoord_Y, SaveCoord_Z);
	sVehicle_X[vehicleid]=SaveCoord_X;
	sVehicle_Y[vehicleid]=SaveCoord_Y;
	sVehicle_Z[vehicleid]=SaveCoord_Z;
}
TPL::split(const strsrc[], strdest[][], delimiter)
{
	new i, li;
	new aNum;
	new len;
	while(i <= strlen(strsrc)){
	    if(strsrc[i]==delimiter || i==strlen(strsrc)){
	        len = strmid(strdest[aNum], strsrc, li, i, 128);
	        strdest[aNum][len] = 0;
	        li = i+1;
	        aNum++;
		}
		++i;
	}
	return 1;
}
TPL::OnPlayerRegister(playerid, password[])
{
	if(IsPlayerConnected(playerid))
	{
	    if(AccountExists(PlayerName(playerid)))
		{
      		SendClientMessage(playerid, COR_BRANCO, "ERRO, Sua conta ja existe no nosso banco de dados!");
		    Kick(playerid);
		    return 1;
		}
		hideTelaLogin(playerid);
        new string[200];
        format(string, sizeof(string), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(PlayerName(playerid)));
  		Resultado = db_query(Conexao,string);
		if(db_num_rows(Resultado) == 0)
		{
			format(string, sizeof(string), "INSERT INTO contas (`Nome`, `Senha`) VALUES('%s', '%s')", DB_Escape(PlayerName(playerid)), DB_Escape(password));
   			db_free_result(db_query(Conexao, string));
			printf("%s", string);
			gPlayerAccount[playerid] = 1;
  		    OnPlayerSave(playerid);
  		    PlayerInfo[playerid][pFome] = 100;
			PlayerInfo[playerid][pSede] = 100;
			if(MudarSenhaAceito[playerid] == 1) { MudarSenhaAceito[playerid] = 0; return 1; }
  	        InterpolateCameraPos(playerid, -2235.281494, 1246.057739, 790.175903, -2238.119140, 1251.406372, 789.115722, 10000);
            InterpolateCameraLookAt(playerid, -2237.549072, 1250.420898, 789.270019, -2243.100830, 1251.505615, 788.700988, 10000);
      	    new loginstring[255];
			new loginname[64];
			GetPlayerName(playerid,loginname,sizeof(loginname));
			SendClientMessage(playerid, COR_BALLAS, "{00FF00}Parabens{808080} sua conta foi criada com sucesso {FFFFFF}bom roleplay");
			format(loginstring,sizeof(loginstring),"{FFFFFF}Coloque sua {FF0000}senha {FFFFFF}abaixo\n\n{00FF00}REGISTRADO {FFFFFF}%s", PlayerName(playerid));
			ShowPlayerDialog(playerid, 1, DIALOG_STYLE_PASSWORD,"{FF0000}Login Necess�rio",loginstring,"Logar","Esperar");
			PlayerPlaySound(playerid, 1098, 0.0, 0.0, 0.0);
		}
	}
	return 1;
}
TPL::OnPlayerLogin(playerid,password[])
{
	VerBan(playerid);
	VerBanTemp(playerid);
	VerBanSerial(playerid);
	if(NaoPodeLogar[playerid] == 1)
	{
		ForceClassSelection(playerid);
		return true;
	}
	
	new tmp2[256];
	new string2[150], pName[MAX_PLAYER_NAME];//keystring[256],
	pName = PlayerName(playerid);
	format(string2, sizeof(string2), "SELECT * FROM `contas` WHERE `Nome`='%s' AND `Senha`='%s'",DB_Escape(pName),DB_Escape(password));
	Resultado = db_query(Conexao,string2);
	if(db_num_rows(Resultado) == 0)
	{
		db_free_result(Resultado);
		SetPlayerCameraPos(playerid,1483.8164,-1727.4125,13.3828);
		SetPlayerCameraLookAt(playerid,1481.0267,-1772.1371,19.4570);
		SendClientMessage(playerid, COR_AMARELO, "{FF0000}[SENHA ERRADA]:{FFFFFF}CASO ESQUECEU SUA {FF0000}SENHA {FFFFFF}ENTREM EM CONTATO EM NOSSO DISCORD PARA RECUPERAR");
		Kick(playerid);
		new loginstring[255];
		new loginname[64];
		GetPlayerName(playerid,loginname,sizeof(loginname));
		format(loginstring,sizeof(loginstring),"{FFFFFF}COLOQUE SUA {FF0000}SENHA {FFFFFF}ABAIXO PARA LOGAR NO SERVIDOR\n\n{00FF00}REGISTRADO {FFFFFF}%s,", PlayerName(playerid));
		ShowPlayerDialog(playerid, 1, DIALOG_STYLE_PASSWORD,"Login Necess�rio",loginstring,"Logar","Sair");
		gPlayerLogTries[playerid]++;
		if(gPlayerLogTries[playerid] == 5)
		{
			Kick(playerid);
			new str[64];
			format(str, sizeof(str), "%s Errou a senha 5 vezes!");
			ErrouSenha(str);
		}
		return 1;
	}
	//mysql_retrieve_row();
	new field[10];
 	db_get_field_assoc(Resultado, "AntiBug", PlayerInfo[playerid][pAntiBug], 128);
	db_get_field_assoc(Resultado, "Senha", PlayerInfo[playerid][pSenha], 128);
	db_get_field_assoc(Resultado, "Titulo", PlayerInfo[playerid][pATitulo], 128);
