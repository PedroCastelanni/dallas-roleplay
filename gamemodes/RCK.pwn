	CMD:autorizacao(playerid, params[])
	{
		if(PlayerInfo[playerid][pEmprego] == 2)
		{
			if(LicencaAdvogado[playerid] == 5)
			{
				SendClientMessage(playerid, COR_BRANCO, "Voce j� tem 5 autoriza��es!");
				return 1;
			}
			if(PlayerInfo[playerid][pLawSkill] >= 301)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 5, n�o precisa de autoriza��o!");
				return 1;
			}
			new name[MAX_PLAYER_NAME];
			GetPlayerName(playerid, name, sizeof(name));
			if(PlayerToPoint(5.0,playerid,1654.6290,-1394.4536,13.5469))
			{
				if(playerid != INVALID_PLAYER_ID)
				{
					GivePlayerMoneyEx(playerid, -200);
					LicencaAdvogado[playerid] += 1;
					format(stringZCMD, sizeof(stringZCMD), "* Advogado: %s  comprou uma licen�a para liberar um preso por R$200.",PlayerName(playerid));
					ProxDetector(30.0, playerid, stringZCMD, COR_AZTECAS,COR_AZTECAS,COR_AZTECAS,COR_AZTECAS,COR_AZTECAS);
					format(stringZCMD, sizeof(stringZCMD), "Voc� pegou + uma licen�a para soltar um presos, voc� tem agora: [%d/5] licen�as.", LicencaAdvogado[playerid]);
					SendClientMessage(playerid, COR_GRAD1, stringZCMD);
				}
			}
		}
		else
		{
			SendClientMessage(playerid, COR_GREY, "Voc� n�o � um Advogado");
		}
		return 1;
	}
