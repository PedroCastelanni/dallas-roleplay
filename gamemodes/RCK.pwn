	CMD:convidarf(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    new para1;
			if(sscanf(params, "u", para1))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /convidarf [playerid/Parte-do-Nick]");
				return 1;
