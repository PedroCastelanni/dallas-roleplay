	CMD:ficha(playerid, params[])
	{
		if(OnDuty[playerid] != 1)
		{
			SendClientMessage(playerid, COR_GREY, "Voc� n�o Bateu o cart�o!");
			return 1;
		}
		if (IsACop(playerid))
		{
			if(PlayerToPoint(2, playerid,252.5212,69.6307,1003.6406) || PlayerToPoint(2,playerid,255.0129,76.0857,1003.6406)
			|| PlayerToPoint(2,playerid,240.6702,112.7933,1003.2188) || PlayerToPoint(2, playerid,302.6840,-1529.6685,24.9219) || PlayerToPoint(2, playerid,2688.4722,-2443.8438,13.4729) || PlayerToPoint(2, playerid,326.4964,306.9705,999.1484) || PlayerToPoint(1, playerid,914.5157,-1235.1240,17.2109)
			|| PlayerToPoint(2, playerid,229.7716,165.0986,1003.0234) || PlayerToPoint(2, playerid,1709.7360,-1642.6481,20.2188) || PlayerToPoint(2, playerid,2497.8533,2389.3938,4.2109) || PlayerToPoint(2, playerid,2080.9387,-1376.1432,300.5588) || PlayerToPoint(2, playerid,2251.4067,2490.9138,10.9908))
			{
				format(gstring,sizeof(gstring),"Digite o ID do jogador para ver a ficha");
				ShowPlayerDialog(playerid, 10, DIALOG_STYLE_INPUT,"Ver Fichas !", gstring,"Confirmar","Cancelar");
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� tem que estar em um carro da policia ou em alguma HQ da policia!");
				return 1;
			}
		}
		return 1;
	}
	CMD:suspeito(playerid, params[])  return ForT:su(playerid, params);
	CMD:su(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    new result[64];
			if(sscanf(params, "us[64]", sscanfid, result))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: (/su)speito [id] [Descri��o do Crime]");
				return 1;
			}
			if(!IsACop(playerid) && PlayerInfo[playerid][pEmprego] != 7)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o � um Oficial !");
				return 1;
			}
			if(OnDuty[playerid] != 1 && PlayerInfo[playerid][pEmprego] != 7)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o Bateu o cart�o!");
				return 1;
			}
			if(gPlayerInGuerra(playerid) || IsPlayerInSkate(playerid) || IsPlayerInPark(playerid) || IsPlayerInCasarao(playerid) || IsPlayerInMotel(playerid) || IsPlayerInMata(playerid) || IsPlayerInEstacao(playerid) || IsPlayerInChuck(playerid))
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode usar este comando agora !");
				return 1;
			}
			if (IsACop(playerid) || PlayerInfo[playerid][pEmprego] == 7)
			{
				if(IsPlayerConnected(sscanfid))
				{
					if(IsACop(sscanfid))
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode dar su em Policiais!");
						return 1;
					}
					if(PlayerInfo[playerid][pEmprego] == 7)
					{
						if(PlayerInfo[sscanfid][pEmprego] == 2)
						{
							SendClientMessage(playerid, COR_AMARELO, "Voc� n�o pode duvidar de um Advogado !");
							return 1;
						}
						if(!PlayerToPoint(30.0,playerid,1770.6527,-1573.1688,1734.9430))
						{
							SendClientMessage(playerid, COR_AMARELO, "Voc� s� pode duvidar de jogadores dentro da penitenci�ria !");
							return 1;
						}
					}
					if(PlayerInfo[sscanfid][pAdmin] == 1342)
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode dar su em um Fundador !");
						return 1;
					}
					if(PlayerInfo[sscanfid][pLider] == 7)
					{
						SendClientMessage(playerid, COR_AMARELO, "Voc� n�o pode duvidar do Governador !");
						return 1;
					}
					if(GetTickCount() - TempoSu[sscanfid] < 4000)
					{
						SendClientMessage(playerid, COR_GRAY, "Este jogador levou um su a pouco tempo, espere 4 segundos!");
						return 1;
					}
					if(PlayerInfo[playerid][pJailed] != 0 && PlayerInfo[playerid][pCargo] < 5)
					{
						SendClientMessage(playerid, COR_GRAY, "Voc� n�o pode dar su em quem est� preso, s� sub-lider ou lider !");
						return 1;
					}
					if(sscanfid != INVALID_PLAYER_ID)
					{
						if(GetDistanceBetweenPlayers(playerid,sscanfid) <= 70)
						{
							GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
							GetPlayerName(playerid, sendername, sizeof(sendername));
							if(!CrimesServidor(result)) { SendClientMessage(playerid, COR_GREY, "Este tipo de su, n�o � considerado um crime"); return 1; }
							if(gPlayerInGuerra(playerid) && IsPlayerInSkate(playerid) && IsPlayerInPark(playerid) && IsPlayerInCasarao(playerid) && IsPlayerInMotel(playerid) && IsPlayerInMata(playerid) && IsPlayerInEstacao(playerid) && IsPlayerInTerritorio(playerid))
							{
								if(strcmp(!result,"Cumplice",true) == 0)
								{
									SendClientMessage(playerid, COR_GRAY, "Voc� est� em um territ�rio, s� poder� usar o /su cumplice!");
									return 1;
								}
							}
							if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voc� n�o pode se dar su!"); return 1; }
							if(strcmp(result,"DOP",true) == 0) { result = "Desobedi�ncia a ordem policial"; }
							if(strcmp(result,"TH",true) == 0) { result = "Tentativa de homic�dio"; }
							if(strcmp(result,"PIA",true) == 0) { result = "Porte Ilegal de Armas"; }
							if(strcmp(result,"SEQ",true) == 0) { result = "Sequestro"; }
							if(strcmp(result,"RP",true) == 0) { result = "Resist�ncia a Pris�o"; }
							if(strcmp(result,"vandalismo",true) == 0) { result = "Atentado Violento ao Pudor"; }
							if(strcmp(result,"DSC",true) == 0) { result = "Dirigndo sem Carteira"; }
							format(gstring, sizeof(gstring), "* Voc� colou o jogador %s como suspeito. Crime: %s",giveplayerZCMD,result);
							SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
							SetPlayerCriminal(sscanfid,playerid, result);
							TempoSu[sscanfid] = GetTickCount();
							return 1;
						}
						else
						{
							SendClientMessage(playerid, COR_LIGHTBLUE, "Este jogador est� muito longe de voc� !");
							return 1;
						}
					}
				}
				else
				{
					SendClientMessage(playerid, COR_GRAD1, "Esse jogador n�o est� conectado.");
					return 1;
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� n�o � um Oficial !");
				return 1;
			}
		}
		return 1;
	}
	CMD:trancar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new carid;
			if (gTeam[playerid] == 2 || gTeam[playerid] == 1)
			{
				if(GetPlayerInterior(playerid) > 0)
				{
					SendClientMessage(playerid, COR_GREY, "Voc� n�o pode usar este comando agora !");
					return 1;
				}
				if(gLastCar[playerid] == 0 && PlayerInfo[playerid][pPHousekey] == 999)
				{
					SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem um carro de casa/alugado.");
					return 1;
				}
				else if(gLastCar[playerid] != 0 && gLastCar[playerid] != PlayerInfo[playerid][pCarroCasa])
				{
					if (HireCar[playerid] != gLastCar[playerid] && HireCar[playerid] > 0)
					{
						gLastDriver[HireCar[playerid]] = 300;
						gCarLock[HireCar[playerid]] = 0;
						UnLockCar(HireCar[playerid]);
					}
					HireCar[playerid] = gLastCar[playerid];
				}
			}
			if (PlayerInfo[playerid][pPHousekey] == 999)
			{
				if(HireCar[playerid] == 0)
				{
					SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem um carro.");
					return 1;
				}
			}
			carid = PlayerInfo[playerid][pCarroCasa];
			if(HireCar[playerid] > 0 && !SwitchKey[playerid])
			{
				carid = HireCar[playerid];
			}
			//new driver = gLastDriver[carid];
			new lockstatus = VTrancado[carid];
			new Float:cx,Float:cy,Float:cz;
			GetVehiclePos(carid, cx, cy, cz);
			switch (lockstatus)
			{
				case 0:
				{
					if(HireCar[playerid] == 0 && PlayerInfo[playerid][pPHousekey] == 999)
					{
						SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem um carro !");
						return 1;
					}
					if(HireCar[playerid] == carid && !SwitchKey[playerid])
					{
						GameTextForPlayer(playerid, "~w~Veiculo do Aluguel ~r~Fechado", 2500, 3);
						PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
						VTrancado[carid] = 1;
						gCarLock[HireCar[playerid]] = 1;
						LockCar(carid);
					}
					else if(PlayerInfo[playerid][pCarroCasa] == carid)
					{
						GameTextForPlayer(playerid, "~w~Veiculo da casa ~r~Fechado", 2500, 3);
						PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
						VTrancado[carid] = 1;
						LockCar(carid);
						return 1;
					}
				}
				case 1:
				{
					if(HireCar[playerid] == 0 && PlayerInfo[playerid][pPHousekey] == 999)
					{
						SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem um carro !");
						return 1;
					}
					if(HireCar[playerid] == carid && !SwitchKey[playerid])
					{
						GameTextForPlayer(playerid, "~w~Veiculo do aluguel ~g~Aberto", 2500, 3);
						PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
						VTrancado[carid] = 0;
						UnLockCar(carid);
					}
					if (PlayerInfo[playerid][pCarroCasa] == carid)
					{
						GameTextForPlayer(playerid, "~w~Veiculo da casa ~g~Aberto", 2500, 3);
						PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
						VTrancado[carid] = 0;
						UnLockCar(carid);
						return 1;
					}
				}
				default:
				{
					SendClientMessage(playerid, COR_GRAD2, "Erro");
				}
			}
			if(carid == 256)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem um carro!");
			}
		}
		return 1;
	}
	CMD:chave(playerid, params[])
	{
