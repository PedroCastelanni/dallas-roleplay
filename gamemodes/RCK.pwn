stock gPlayerInGuerra(playerid)
{
    if(!GuerraMorro[gGuerra])return 0;
    new Float:x,Float:y,Float:z;
    GetPlayerPos(playerid, x, y, z);
    if(x >= 2058.892089 && y >= -1149.080200 && x <= 2492.892089 && y <= -827.080200) return 1;
