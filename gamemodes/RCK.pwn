public OnVehicleDamageStatusUpdate(vehicleid, playerid) //sistema de estepe
{
	//sistema de estepe
	new panels, doors, lights, tires;
	GetVehicleDamageStatus(vehicleid, panels, doors, lights, tires);
	if(VehicleTireState[vehicleid] != tires && tires == 1)
	{
		VehicleTireState[vehicleid] = 1;
	}
	else if(VehicleTireState[vehicleid] != tires && tires == 2)
	{
	    VehicleTireState[vehicleid] = 2;
	}
	else if(VehicleTireState[vehicleid] != tires && tires == 2)
	{
	    VehicleTireState[vehicleid] = 3;
	}
	else if(VehicleTireState[vehicleid] != tires && tires == 2)
	{
	    VehicleTireState[vehicleid] = 4;
	}
	return 1;
}
public OnVehicleSpawn(vehicleid)
{
    new arquivo[64];
	format(arquivo, sizeof(arquivo), Pasta_CarrosVIP, vehicleid);
	if(DOF2_FileExists(arquivo))
	{
		 if(IsPlayerOnline(DOF2_GetString(arquivo, "Dono")))
		 {
             SetVehiclePos(vehicleid, DOF2_GetInt(arquivo, "PosX"), DOF2_GetInt(arquivo, "PosY"), DOF2_GetInt(arquivo, "PosZ"));
			 SetVehicleVirtualWorld(vehicleid, 0);
			 CarregarCarrosTunados(vehicleid);
			 CarrosTunadosTPL(vehicleid);
			 SetVehicleNumberPlate(vehicleid, "{000000}CARRO VIP");
		 }
	}
 	new arquivo2[64];
	format(arquivo2, sizeof(arquivo2), Pasta_CarrosFixo, vehicleid);
	if(DOF2_FileExists(arquivo2))
	{
		 if(IsPlayerOnline(DOF2_GetString(arquivo2, "Dono")))
		 {
			 SetVehiclePos(vehicleid, DOF2_GetInt(arquivo2, "PosX"), DOF2_GetInt(arquivo2, "PosY"), DOF2_GetInt(arquivo2, "PosZ"));
			 SetVehicleVirtualWorld(vehicleid, 0);
			 CarregarCarrosTunados(vehicleid);
			 CarrosTunadosTPL(vehicleid);
			 SetVehicleNumberPlate(vehicleid, "{000000}CARRO FIXO");
		 }
	}
	PlacaCarros(vehicleid);
	if(PmCarro(vehicleid) || BopeCarro(vehicleid) || ExercitoCarro(vehicleid) || SamuCarro(vehicleid) || AztecasCarro(vehicleid) || TalibanCarros(vehicleid) || GovernoCarros(vehicleid) || HitmansCarros(vehicleid) || GloboCarros(vehicleid) || TaxistaCarros(vehicleid)
	|| PFCarros(vehicleid) || CNCarros(vehicleid) || YakuzaCarros(vehicleid) || GrooveCarros(vehicleid) || AlqaedaCarros(vehicleid) || PCCarros(vehicleid) || BallasCarros(vehicleid) || VagosCarros(vehicleid) || CVCarros(vehicleid)
	|| PccCarros(vehicleid) || SonsCarros(vehicleid) || MayansCarros(vehicleid) || RotaCarros(vehicleid) || MecanicosCarros(vehicleid) || PRFCarros(vehicleid) || AssassinsCarros(vehicleid))
	{
		 SetVehicleVirtualWorld(vehicleid, 0);
		 LinkVehicleToInterior(vehicleid, 0);
		 veiculospawn[vehicleid] = 0;
		 if(LixeiroCarros(vehicleid))
		 {
        	new string[96];
		 	LoadedTrash[vehicleid] = 0;
		 	format(string, sizeof(string), "Lixos:{ffffff} [%02d/%d]", LoadedTrash[vehicleid], TRASH_LIMIT);
		  	Update3DTextLabelText(FactoryLabel[vehicleid], COR_LIGHTBLUE, string);
  			Attach3DTextLabelToVehicle(FactoryLabel[vehicleid], vehicleid, 0.0, 0.0, 0.0+1);
   		 }
	}
	EngineCarro[vehicleid] = 0;
	Quebrado[vehicleid] = 0;
	somligado[vehicleid] = 0;
	if(sirene[vehicleid] != 0 && sirene2[vehicleid] != 0)
	{
		DestroyDynamicObject(sirene[vehicleid]);
	    DestroyDynamicObject(sirene2[vehicleid]);
    }
	CarrosFixados(vehicleid);
	return true;
}
public OnVehicleMod(playerid, vehicleid, componentid)
{
	new TPLComponentes = ComponemtesTPL(componentid);
	if(GetPlayerInterior(playerid) < 1 && GetPlayerInterior(playerid) > 3 && PlayerInfo[playerid][pAdmin] < 1339)
	{
		new string[128];
		new playerName[MAX_PLAYER_NAME];
		GetPlayerName(playerid, playerName, MAX_PLAYER_NAME);
		format(string, sizeof(string), "ANTI-HACK: {FFFFFF}%s talvez esteja usando algum hack de mods (pegou o componente %d para o veiculo %s).", playerName, componentid, Nomedosveiculos[GetVehicleModel(vehicleid) - 400]);
		ABroadCast(COR_LIGHTRED,string,1);
	}
	new vehicleide = GetVehicleModel(vehicleid); //Lucas by Equipe Beta teste samp f�rum
    new modok = islegalcarmod(vehicleide, componentid);
    if (!modok)
    {
        new string[100];
  		format(string, sizeof(string), "ANTIXITER: %s[%d] foi kickado por usar cBern de crasher dentro de um ve�culo, fique de olho!", PlayerName(playerid),playerid);
 		ABroadCast(COR_LIGHTRED,string,1);
 		AntiXiterLog(string);
	 	Kick(playerid);
        return 0;
    }
 	new arquivo[64];
	format(arquivo, sizeof(arquivo), Pasta_CarrosVIP, vehicleid);
	if(DOF2_FileExists(arquivo))
	{
		switch (TPLComponentes)
		{
			case 1: { CarrosTunados[vehicleid][Tunamento1] = componentid; SalvarCarrosTunados(vehicleid); }
			case 2: { CarrosTunados[vehicleid][Tunamento2] = componentid; SalvarCarrosTunados(vehicleid); }
			case 3: { CarrosTunados[vehicleid][Tunamento3] = componentid; SalvarCarrosTunados(vehicleid); }
			case 4: { CarrosTunados[vehicleid][Tunamento4] = componentid; SalvarCarrosTunados(vehicleid); }
