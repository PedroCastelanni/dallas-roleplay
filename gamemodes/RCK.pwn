						GetPlayerName(playerid, sendername, sizeof(sendername));
						ResetPlayerWeaponsEx(playa);
						Equipado[playa] = 0;
						printf("ADMIN CMD: %s retirou as armas de %s",sendername,  giveplayerZCMD);
						format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s teve as armas retiradas por: %s",giveplayerZCMD ,sendername);
						ABroadCast(COR_LIGHTRED,stringZCMD,1);
					}
				}
			}
			else
