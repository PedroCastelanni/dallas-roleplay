				if(PlayerInfo[playerid][pSex] == 1) { SetPlayerSkin(playerid, 119); } else { SetPlayerSkin(playerid, 41); }
				pCheckInfoOrg[playerid] = 0;
				SpawnPlayer(playerid);
				liderhide[playerid] = 0;
