public OnGameModeInit()
{
 	Conexao = db_open("RCK.db");
 	if((Conexao = db_open("RCK.db")) == DB:0)
    {
        print("[SERVER]: Erro ao carregar o Banco De Dados!");
        return SendRconCommand("exit");
    }
    else
    {
        print("[SERVER]: Banco De Dados Carregado Com Sucesso!");
	}
	SetTimer("ChamadaJBL", 1000, true);
    for(new j; j < MAX_JBL; j++)
    {
        InfoJBL[JblUsed][j] = -1;
        InfoJBL[xJBL][j] = -1; InfoJBL[yJBL][j] = -1; InfoJBL[zJBL][j] = -1;
        InfoJBL[TextJBL][j] = CreateDynamic3DTextLabel("{FFFFFF}JBL", -1, -999.0, -98383.3, -9292.0, 10.0);
    }
    TendoRoubo = false;
    TemSomLigado = 0;
    CHitman = 0;
    CAssassins = 0;
    TipoEvento = 0;
    PlayersCaixinha = 0;
    ChatNoob = false;
    BonusTPL = true;
    Contrato1paracada = true;
    DisputaLosAstecas = 0;
	DisputaGrooveStreet = 0;
	DisputaBallas = 0;
	DisputaLosVagos = 0;
	DisputaCV = 0;
	DisputaPCC = 0;
    DisputaTDE = 0;
    DisputaTDL = 0;
    DisputaGrota = 0;
    DisputaR7 = 0;
	DisputaTdt = 0;
	DisputaEnguica = 0;
	DisputaYakuza = 0;
	DisputaCN = 0;
	DisputaTaliban = 0;
	DisputaAlqaeda = 0;
    DisputaSons = 0;
    DisputaMayans = 0;
    fallTimer = -1;
	TimerHay = -1
	timerx1 = -1;
	Playersx1[0] = 999;
	Playersx1[1] = 999;
	CameraInfo[cameraman] = INVALID_PLAYER_ID;
    getdate(v[0], v[1], v[2]);
	gettime(v[3], v[4], v[5]);
    print("\n---------------------------------------------------------");
	printf("sERVIDOR ONLINE: [%02d/%02d/%d %02d:%02d:%02d]", v[2], v[1], v[0], v[3], v[4], v[5]);
	print("---------------------------------------------------------\n");
	SetHora();
    print("______________________________________________________________________");
	print("{836FFF}Rocket                             ");
	print("______________________________________________________________________");
	//==============================================================================//
    foreach(new i: Player)
	{
		strmid(StrPasswrd[i], "Vazio", 0, strlen("Vazio"), 255);
	}
	LoadGays();
    CarregarAdmins();
	ResetElevatorQueue();
	Elevator_Initialize();
	ResetElevatorQueue2();
	Elevator_Initialize2();
	carregarPortoes();
	carregarGrafites();
	carregarCaixas();
	Vein_Generate();
	RODAPERCKTEXT();
	MapsTPL();
	FomeSedeTDTDAtualizado();
	CarregarRadioTDVozTD();
	//ranks
    createrank("nivel");
    createrank("horasjogadas");
    createrank("kills");
    createrank("mortes");
    createrank("banco");
    createrank("crimes");
    createrank("materiais");
    createrank("maconha");
    createrank("cocaina");
    createrank("crack");
    createrank("lsd");
    createrank("contratos");
    createrank("maisativo");
    createrank("pixador");
    //MSelection
    OculosLista = LoadModelSelectionMenu("mSelections/OculosLista.txt");
    BandanaLista = LoadModelSelectionMenu("mSelections/BandanaLista.txt");
    BoneLista = LoadModelSelectionMenu("mSelections/BoneLista.txt");
    RelogioLista = LoadModelSelectionMenu("mSelections/RelogioLista.txt");
    skinlist = LoadModelSelectionMenu("mSelections/skins.txt");
    ComprarSkinList = LoadModelSelectionMenu("mSelections/skins.txt");
    AcessoriosLista = LoadModelSelectionMenu("mSelections/AcessoriosLista.txt");
    carrosviplist = LoadModelSelectionMenu("mSelections/carrosvips.txt");
    housecarfreelist = LoadModelSelectionMenu("mSelections/carroscasafree.txt");
    housecarviplist = LoadModelSelectionMenu("mSelections/carroscasavip.txt");
    housecarsoclist = LoadModelSelectionMenu("mSelections/carroscasasocio.txt");
    MoveisList = LoadModelSelectionMenu("mSelections/moveis.txt");
    CozinhaList = LoadModelSelectionMenu("mSelections/moveis_cozinha.txt");
    QuartoList = LoadModelSelectionMenu("mSelections/moveis_quarto.txt");
    BanheiroList = LoadModelSelectionMenu("mSelections/moveis_banheiro.txt");
    SalaList = LoadModelSelectionMenu("mSelections/moveis_sala.txt");
    DecoracaoList = LoadModelSelectionMenu("mSelections/moveis_decoracao.txt");

	//---------------------Atores--------------------//
    //barraca 1
    Atorconce[0] = CreateActor(116, 2499.5530,-947.0037,82.4708,171.8019);
    SetActorInvulnerable(Atorconce[0], true);
    // Ator Banco 1
    AtorBanco[0] = CreateActor(116, 2734.9304,-2014.3604,13.5547,173.0553);
    SetActorInvulnerable(AtorBanco[0], true);
    PreloadActorAnimations(AtorBanco[0]);
    // Ator Banco 2
    AtorBanco[1] = CreateActor(108, 1834.9899,-2095.9141,13.5469,119.6665);
    SetActorInvulnerable(AtorBanco[1], true);
    PreloadActorAnimations(AtorBanco[1]);
    // Ator Banco 3
    AtorBanco[2] = CreateActor(109, -1450.0970,-1510.9258,101.7578,273.8043);
    SetActorInvulnerable(AtorBanco[2], true);
    PreloadActorAnimations(AtorBanco[2]);
    // Ator Banco 4
    AtorBanco[3] = CreateActor(106, 2303.5710,170.3244,26.4844,76.8608);
    SetActorInvulnerable(AtorBanco[3], true);
