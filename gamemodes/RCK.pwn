				PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
				PlayerTextDrawShow(playerid, invPreview[playerid][i]);
			}
		}
	}
	if(InventarioPagina[playerid] == 4){
		for(new i=45; i != 60; i++){
			if(InventarioInfo[playerid][i][iUnidades] > 0){
