TPL::MudarNome(playerid)
{
	if(PlayerInfo[playerid][pFamilia] == 0)
	{
		new arquivo3[64];
		new playername[MAX_PLAYER_NAME];
		format(arquivo3, sizeof(arquivo3), "Familias/ExNomes/%s.cfg",PlayerName(playerid));
		new x_Nick[64];
		strmid(x_Nick, DOF2_GetString(arquivo3,"Ex-Nome"), 0, strlen(DOF2_GetString(arquivo3,"Ex-Nome")), 255);
		new Query[75+MAX_PLAYER_NAME];
	    format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(x_Nick));
	    Resultado = db_query(Conexao,Query);
	    if(db_num_rows(Resultado) > 0)
	    {
			format(gstring, sizeof(gstring), "[RCK TROCA DE NICK AUTOM�TICA]: Voc� saiu de sua fam�lia e ja existe alguem com seu nome antigo [%s], fale com algum admin", x_Nick);
			SendClientMessage(playerid, COR_GREY,gstring);
			return 1;
		}
		format(Query, sizeof(Query), "UPDATE `contas` SET `Nome` = '%s' WHERE `Nome` = '%s'", DB_Escape(x_Nick), DB_Escape(PlayerName(playerid)));
		Resultado = db_query(Conexao,Query);
		//mysql_store_result();
		for(new i = 0; i < sizeof(BizzInfo); i++)
		{
			if(strcmp(playername,BizzInfo[i][bOwner],true)==0)
			{
				strmid(BizzInfo[i][bOwner], x_Nick, 0, strlen(x_Nick), 255);
			}
		}
		for(new i = 0; i < sizeof(SBizzInfo); i++)
		{
			if(strcmp(playername,SBizzInfo[i][sbOwner],true)==0)
			{
				strmid(SBizzInfo[i][sbOwner], x_Nick, 0, strlen(x_Nick), 255);
			}
		}
		for(new h = 0; h < sizeof(HouseInfo); h++)
		{
			if(strcmp(playername,HouseInfo[h][hOwner],true)==0)
			{
				new house[255];
				format(house, sizeof(house), Pasta_Casas, h);
				if(DOF2_FileExists(house))
				{
					DOF2_SetString(house, "Dono", x_Nick);
					DOF2_SaveFile();
					strmid(HouseInfo[h][hOwner],DOF2_GetString(house, "Dono"),0, strlen(DOF2_GetString(house, "Dono")), 255);
					Delete3DTextLabel(HouseLabel[h]);
					format(gstring, sizeof(gstring), TextCasa,x_Nick,HouseInfo[h][hRentabil],HouseInfo[h][hDiscription]);
					HouseLabel[h] = Create3DTextLabel(gstring,0x00FF00FF,HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez]+0.5,13.0, 0);
				}
			}
		}
		new novo[255];
  		new borse = PlayerInfo[playerid][pPFazkey];
		format(novo, sizeof(novo), Pasta_FEmpresas, borse);
		if(PlayerInfo[playerid][pPFazkey] < 255)
		{
			strmid(FBizzInfo[borse][fbOwner], novo, 0, strlen(novo), 255);
			Atualizar3Dtexts();
			SalvarFEmpresa(borse);
		}
		for(new i = 0; i < sizeof(AdmInfo); i++)
		{
			if(strcmp(playername,AdmInfo[i][AdminNick],true)==0)
			{
				strmid(AdmInfo[i][AdminNick], x_Nick, 0, strlen(x_Nick), 999);
			}
		}
		if (GetPlayerOrg(playerid) != 0)
		{
			new string[64];
			for (new i = 1; i < sizeof(InfoOrg); i++)
			{
				if (PlayerInfo[playerid][pMembro] > 0 || PlayerInfo[playerid][pLider] > 0)
