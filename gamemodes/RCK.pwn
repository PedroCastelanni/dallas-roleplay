	CMD:pservico(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(sscanf(params, "u", sscanfid))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /pservico [id]");
				return 1;
			}
			if(GetPlayerOrg(playerid) == 10)
			{
				if(TaxiCall < 999)
				{
					if(PediuServico[TaxiCall] == 0)
					{
						SendClientMessage(playerid, COR_GRAD1, "* O Player n�o solicitou nenhum servico !");
						return 1;
					}
					if(IsPlayerConnected(TaxiCall))
					{
						GetPlayerName(playerid, sendername, sizeof(sendername));
						GetPlayerName(TaxiCall, giveplayerZCMD, sizeof(giveplayerZCMD));
						format(stringZCMD, sizeof(stringZCMD), "* Voce aceitou a chamada do(a) %s, A marca estar� vis�vel at� voc� chegar.",giveplayerZCMD);
						SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "[Taxista]: %s[%d] aceitou o seu pedido, aguarde no local solicitado, seja RP !",sendername,playerid);
						SendClientMessage(TaxiCall, COR_LIGHTRED, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "Taxista: [%s] aceitou o pedido do cliente [%s] !", PlayerName(playerid), giveplayerZCMD);
						SendFamilyMessage(10,0x6666ccFF,stringZCMD);
						GameTextForPlayer(playerid, "~p~SIGA O CHECKPOINT", 5000, 1);
						new Float:X,Float:Y,Float:Z;
						GetPlayerPos(TaxiCall, X,Y,Z);
						SetPlayerCheckpoint(playerid, X,Y,Z, 6);
						TaxiCallTime[playerid] = 1;
						TaxiAccepted[playerid] = TaxiCall;
						PediuServico[TaxiCall] = 0;
						TaxiCall = 999;
						return 1;
					}
					else
					{
						SendClientMessage(playerid, COR_GREY, "N�o tem nenhuma chamada de taxi no momento !");
						return 1;
					}
				}
			}
			if(GetPlayerOrg(playerid) == 4)
			{
				if(MedicCall < 999)
				{
					if(PediuServicoMed[MedicCall] == 0)
