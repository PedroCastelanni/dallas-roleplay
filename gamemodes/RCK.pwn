						   Resultado = db_query(Conexao,arquivo);
						   //mysql_store_result();
					       return 1;
				      }
				      if(strcmp(InfoOrg[org][Membro40],"Ninguem",true)==0)
				      {
				           strmid(InfoOrg[org][Membro40], nome, 0, strlen(nome), MAX_PLAYER_NAME);
				           //new DBResult:Resultado; //mysql_escape_string(nome, DB_Escape( ));
						   format(arquivo, sizeof(arquivo), "UPDATE `organizacoes` SET `Membro40` = '%s' WHERE `ID` = '%d'", nome, org);
						   Resultado = db_query(Conexao,arquivo);
						   //mysql_store_result();
					       return 1;
          }
			      }
		  	 }
	     }
	}
	return 0;
}
