 }
	for(new i; i < sizeof(RODAPERCK); i++)
	{
        TextDrawShowForPlayer(playerid, RODAPERCK[i]);
 }
	PlayerTextDrawShow(playerid,FomePosetagem[playerid]);
	PlayerTextDrawShow(playerid,SedePosetagem[playerid]);
    NaPorraDoEvento[playerid] = false;
    Sequestrado[playerid] = 0;
    enjaulado[playerid] = 0;
    PlayerMutado[playerid] = 0;
	if(PlayerInfo[playerid][pTrazerChuck] == 1)
	{
  	    GivePlayerWeaponEx(playerid, 8, 1);
		GivePlayerWeaponEx(playerid, 24, 1299);
		SetPlayerSkin(playerid,34);
		SetPlayerArmour(playerid, 100);
		SetPlayerHealth(playerid, 100);
		PlayerInfo[playerid][pTrazerChuck] = 1;
		SetPlayerColor(playerid,0x3333FFFF);
        new rand;
        SetPlayerInterior(playerid, 10);
        rand = random(sizeof(gChuckArena));
	    SetPlayerPos(playerid, gChuckArena[rand][0], gChuckArena[rand][1], gChuckArena[rand][2]);
		SetPlayerFacingAngle(playerid, gChuckArena[rand][3]);
		PrimeiroChuck[playerid] = 0;
		SendClientMessage(playerid, COR_VERDE, "Voc� nasceu na arena de paintball, quanto mais voc� matar, mais dinheiro ir� ganhar !");
		NaPorraDoEvento[playerid] = true;
		return 1;
	}

	if(PrimeiroChuck[playerid] == 1)
	{
  	    GivePlayerWeaponEx(playerid, 38, 9999999);
		GivePlayerWeaponEx(playerid, 24, 9999999);
		GivePlayerWeaponEx(playerid, 8, 1);
		SetPlayerSkin(playerid,34);
		SetPlayerArmour(playerid, 100);
		SetPlayerHealth(playerid, 100);
		PlayerInfo[playerid][pTrazerChuck] = 1;
