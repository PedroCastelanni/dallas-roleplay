}
public OnPlayerUpdate(playerid)
{
        CheckRadar(playerid);

    new string[190];
	if(IsPlayerConnected(playerid) && gPlayerLogged[playerid])
	{
	    new cashstr[128];
		format(cashstr,sizeof(cashstr),"%d",PlayerInfo[playerid][pCoins]);
		PlayerTextDrawSetString(playerid, TDCoins[playerid], cashstr);
	    //Tempo AFK
    	TempoAFK[playerid] = gettime();
		if(TaNoQuarentena[playerid] == 1)
		{
	        format(string,sizeof(string),"HUMANOS WIN %d", ContagemQuarentena[playerid]);
			TextDrawSetString(TextDrawCQ, string);
		}
		if(TanoWarZone[playerid] == 1)
		{
			// === [ TextDraw ] === //
			anime = GetPlayerAnimationIndex(playerid);
			//	printf("%d",anime);
			if ((anime== 1544) || (anime== 1250) ||  ((anime>=  1538) && (anime<= 1542)))
  	{
				if(EquipeWarZone[playerid] == 1)
				{
	   				SetPlayerSkin(playerid, skinsRed[random(7)]);
				    SetPlayerPos(playerid, -2520.7698,1215.6158,37.4283);
				}
				if(EquipeWarZone[playerid] == 2)
				{
	   				SetPlayerSkin(playerid, skinsBlue[random(6)]);
				    SetPlayerPos(playerid, -2021.0950,-772.6932,30.1719);
				}
				if(EquipeWarZone[playerid] == 3)
				{
	   				SetPlayerSkin(playerid, skinsGreen[random(7)]);
				    SetPlayerPos(playerid, -2405.7529,-601.1105,132.6484);
				}
			}

			if(ContagemRed > ContagemGreen && ContagemRed > ContagemBlue)
			{
				TextDrawBackgroundColor(TextDrawRED, COR_VERMELHO);
				TextDrawBackgroundColor(TextDrawBLUE, COR_VERMELHO);
				TextDrawBackgroundColor(TextDrawGREEN, COR_VERMELHO);

				TextDrawShowForPlayer(playerid, TextDrawGREEN);
				format(string,sizeof(string),"RED %d |", ContagemRed);
				TextDrawSetString(TextDrawGREEN, string);

				TextDrawShowForPlayer(playerid, TextDrawRED);
	  			format(string,sizeof(string),"BLUE %d |", ContagemBlue);
				TextDrawSetString(TextDrawRED, string);

				TextDrawShowForPlayer(playerid, TextDrawBLUE);
 				format(string,sizeof(string),"GREEN %d", ContagemGreen);
				TextDrawSetString(TextDrawBLUE, string);

			}
			else if(ContagemGreen > ContagemBlue && ContagemGreen > ContagemRed)
			{
				TextDrawBackgroundColor(TextDrawRED, COR_GREEN);
				TextDrawBackgroundColor(TextDrawBLUE, COR_GREEN);
				TextDrawBackgroundColor(TextDrawGREEN, COR_GREEN);

				TextDrawShowForPlayer(playerid, TextDrawGREEN);
				format(string,sizeof(string),"GREEN %d |", ContagemGreen);
				TextDrawSetString(TextDrawGREEN, string);

				TextDrawShowForPlayer(playerid, TextDrawRED);
	  			format(string,sizeof(string),"BLUE %d |", ContagemBlue);
				TextDrawSetString(TextDrawRED, string);

				TextDrawShowForPlayer(playerid, TextDrawBLUE);
 				format(string,sizeof(string),"RED %d", ContagemRed);
				TextDrawSetString(TextDrawBLUE, string);
			}
			else if(ContagemBlue > ContagemGreen && ContagemBlue > ContagemRed)
			{
				TextDrawBackgroundColor(TextDrawRED, COR_AZUL);
				TextDrawBackgroundColor(TextDrawBLUE, COR_AZUL);
				TextDrawBackgroundColor(TextDrawGREEN, COR_AZUL);

				TextDrawShowForPlayer(playerid, TextDrawGREEN);
				format(string,sizeof(string),"BLUE %d |", ContagemBlue);
				TextDrawSetString(TextDrawGREEN, string);

				TextDrawShowForPlayer(playerid, TextDrawRED);
	  			format(string,sizeof(string),"Green %d |", ContagemGreen);
				TextDrawSetString(TextDrawRED, string);

				TextDrawShowForPlayer(playerid, TextDrawBLUE);
 				format(string,sizeof(string),"RED %d", ContagemRed);
				TextDrawSetString(TextDrawBLUE, string);
			}
		}
		//prioridade Bern
		if(GetPlayerInterior(playerid) > 0 && NaPorraDoEvento[playerid] == false)
		{
		    if(GetPlayerWeapon(playerid) == 16 || GetPlayerWeapon(playerid) == 17 || GetPlayerWeapon(playerid) == 18 || GetPlayerWeapon(playerid) == 35 || GetPlayerWeapon(playerid) == 37 || GetPlayerWeapon(playerid) == 39)
		    {
				SendClientMessage(playerid,0x9E50FFAA,"E Proibido usar armas incendi�rias em Interiores, os admins foram avisados.");
				new fodase;
				SER[playerid] = 0;
				if(SER[playerid] == 0)
				{
				    if(GetPlayerWeapon(playerid) == 16)
				    {
				        Arma16[playerid] = 1;
			        	GetPlayerWeaponData(playerid, GetWeaponSlot(16), fodase, Balas16[playerid]);
						SetPlayerAmmo(playerid, 16, 0);
					}
					if(GetPlayerWeapon(playerid) == 17)
					{
					    Arma17[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(17), fodase, Balas17[playerid]);
                        SetPlayerAmmo(playerid, 17, 0);
					}
					if(GetPlayerWeapon(playerid) == 18)
					{
					    Arma18[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(18), fodase, Balas18[playerid]);
						SetPlayerAmmo(playerid, 18, 0);
					}
					if(GetPlayerWeapon(playerid) == 35)
					{
					    Arma35[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(35), fodase, Balas35[playerid]);
						GivePlayerWeapon(playerid, 35, 0);
						SetPlayerAmmo(playerid, 35, 0);
					}
					if(GetPlayerWeapon(playerid) == 37)
					{
					    Arma37[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(37), fodase, Balas37[playerid]);
						GivePlayerWeapon(playerid, 37, 0);
						SetPlayerAmmo(playerid, 37, 0);
					}
					if(GetPlayerWeapon(playerid) == 39)
					{
					    Arma39[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(39), fodase, Balas39[playerid]);
						GivePlayerWeapon(playerid, 39, 0);
						SetPlayerAmmo(playerid, 39, 0);
					}
					SER[playerid] = 1;
				}
			}
		}
		else if(IsPlayerInCasarao(playerid) || IsPlayerInMotel(playerid) || IsPlayerInEstacao(playerid) || IsPlayerInSkate(playerid) || IsPlayerInPark(playerid) || gPlayerInGuerra(playerid))
		{
		    if(GetPlayerWeapon(playerid) == 16 || GetPlayerWeapon(playerid) == 17 || GetPlayerWeapon(playerid) == 18 || GetPlayerWeapon(playerid) == 35 || GetPlayerWeapon(playerid) == 37 || GetPlayerWeapon(playerid) == 39)
		    {
		        SendClientMessage(playerid,0x9E50FFAA,"E Proibido usar armas incendi�rias em territ�rios, os admins foram avisados.");
                new fodase;
				SER[playerid] = 0;
				if(SER[playerid] == 0)
				{
				    if(GetPlayerWeapon(playerid) == 16)
				    {
				        Arma16[playerid] = 1;
			        	GetPlayerWeaponData(playerid, GetWeaponSlot(16), fodase, Balas16[playerid]);
						SetPlayerAmmo(playerid, 16, 0);
					}
					if(GetPlayerWeapon(playerid) == 17)
					{
					    Arma17[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(17), fodase, Balas17[playerid]);
                        SetPlayerAmmo(playerid, 17, 0);
					}
					if(GetPlayerWeapon(playerid) == 18)
					{
					    Arma18[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(18), fodase, Balas18[playerid]);
						SetPlayerAmmo(playerid, 18, 0);
					}
					if(GetPlayerWeapon(playerid) == 35)
					{
					    Arma35[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(35), fodase, Balas35[playerid]);
						GivePlayerWeapon(playerid, 35, 0);
						SetPlayerAmmo(playerid, 35, 0);
					}
					if(GetPlayerWeapon(playerid) == 37)
					{
					    Arma37[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(37), fodase, Balas37[playerid]);
						GivePlayerWeapon(playerid, 37, 0);
						SetPlayerAmmo(playerid, 37, 0);
					}
					if(GetPlayerWeapon(playerid) == 39)
					{
					    Arma39[playerid] = 1;
					    GetPlayerWeaponData(playerid, GetWeaponSlot(39), fodase, Balas39[playerid]);
						GivePlayerWeapon(playerid, 39, 0);
						SetPlayerAmmo(playerid, 39, 0);
					}
					SER[playerid] = 1;
				}
			}
		}
		else if(GetPlayerInterior(playerid) == 0 && NaPorraDoEvento[playerid] == false)
		{
			    if(SER[playerid] == 1)
			    {
				    if(Arma16[playerid] == 1)
				    {
				        GivePlayerWeapon(playerid, 16, Balas16[playerid]);
				        Arma16[playerid] = 0;
				        Balas16[playerid] = 0;
				    }
				    if(Arma17[playerid] == 1)
				    {
				        GivePlayerWeapon(playerid, 17, Balas17[playerid]);
				        Arma17[playerid] = 0;
				        Balas17[playerid] = 0;
				    }
				    if(Arma18[playerid] == 1)
				    {
				        GivePlayerWeapon(playerid, 18, Balas18[playerid]);
				        Arma18[playerid] = 0;
				        Balas18[playerid] = 0;
				    }
				    if(Arma35[playerid] == 1)
				    {
				        GivePlayerWeapon(playerid, 35, Balas35[playerid]);
				        Arma35[playerid] = 0;
				        Balas35[playerid] = 0;
				    }
				    if(Arma37[playerid] == 1)
				    {
				        GivePlayerWeapon(playerid, 37, Balas37[playerid]);
				        Arma37[playerid] = 0;
				        Balas37[playerid] = 0;
				    }
				    if(Arma39[playerid] == 1)
				    {
				        GivePlayerWeapon(playerid, 39, Balas39[playerid]);
				        Arma39[playerid] = 0;
				        Balas39[playerid] = 0;
				    }
				    SER[playerid] = 0;
				}
		}
    }
    SetPVarInt(playerid, "ESC", gettime()); //Bern by Equipe TPL
	if(GetPlayerVehicleID(playerid) != 0)
 	{
		if(GetPlayerVehicleID(playerid) != GetPVarInt(playerid, "Veiculo_Anterior"))
		{
			if(GetPVarInt(playerid, "Troca_Veiculo") > gettime())
			{
			    if(PlayerInfo[playerid][pLevel] <= 4)
			    {
			 		format(string, sizeof(string), "ANTIXITER: %s[%d] estava puxando carros e foi banido automaticamente!", PlayerName(playerid),playerid);
			 		ABroadCast(COR_LIGHTRED,string,1);
			 		BanTPL(playerid, "Car Spam", "Autom�tico");
				}
				else
				{
	 				format(string, sizeof(string), "ANTIXITER: %s[%d] parece est� puxando carros do servidor, /tvon nele r�pido !", PlayerName(playerid),playerid);
			 		ABroadCast(COR_LIGHTRED,string,1);
				}
			}
			SetPVarInt(playerid, "Veiculo_Anterior", GetPlayerVehicleID(playerid));
			SetPVarInt(playerid, "Troca_Veiculo", gettime() + 2);
		}
	}
    	//Lucas by Equipe samp f�rumfor
   	if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        new Float:vec[3];
        GetPlayerCameraFrontVector(playerid, vec[0], vec[1], vec[2]);
        new bool:possible_crasher = false;
        for (new i = 0; !possible_crasher && i < sizeof(vec); ++i)
            if (floatabs(vec[i]) > 10.0)
                possible_crasher = true;

        if (possible_crasher)
            return 0;
    }
    // laser de armas
    if (GetPVarInt(playerid, "laser"))
	{
		RemovePlayerAttachedObject(playerid, 9);
  		if ((IsPlayerInAnyVehicle(playerid)) || (IsPlayerInWater(playerid))) return 1;
    	switch (GetPlayerWeapon(playerid))
		{
			case 23:
			{
				if (IsPlayerAiming(playerid))
	 			{
					if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
  					{
 						SetPlayerAttachedObject(playerid, 9, GetPVarInt(playerid, "color"), 6, 0.108249, 0.030232, 0.118051, 1.468254, 350.512573, 364.284240);
     				}
					else
					{
						SetPlayerAttachedObject(playerid, 9, GetPVarInt(playerid, "color"), 6, 0.108249, 0.030232, 0.118051, 1.468254, 349.862579, 364.784240);
  					}
   				}
	   			else
	   			{
					if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
			 		{
						SetPlayerAttachedObject(playerid, 9, GetPVarInt(playerid, "color"), 6, 0.078248, 0.027239, 0.113051, -11.131746, 350.602722, 362.384216);
 					}
			  		else
				  	{
 						SetPlayerAttachedObject(playerid, 9, GetPVarInt(playerid, "color"), 6, 0.078248, 0.027239, 0.113051, -11.131746, 350.602722, 362.384216);
     				}
				}
			}
