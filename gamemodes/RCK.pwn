					return 1;
				}
				if(PlayerInfo[playerid][pJailed] == 0)
				{
					SendClientMessage(playerid, COR_AMARELO, "Voc� precisa estar preso para poder usar este comando!");
					return 1;
				}
				if(PlayerInfo[playerid][pJailed] == 2 || PlayerInfo[playerid][pJailed] == 3)
				{
					SendClientMessage(playerid, COR_AMARELO,"Voc� precisa estar preso em locais espec�ficos para usar este comando!");
					return 1;
				}
				GetPlayerName(playerid, sendername, sizeof(sendername));
				if(GetPlayerVirtualWorld(playerid) == 0)
				{
					format(stringZCMD, sizeof(stringZCMD), "** %s Necessita de um Advogado na Penitenci�ria LS - ID [%d].", sendername, playerid);
				}
				else
