	CMD:lvagaf(playerid, params[])return ForT:limparvagaf(playerid,params);
	CMD:limparvagaf(playerid, vaga[])
	{
		if(PlayerInfo[playerid][pLFamilia] < 1)
		{
			SendClientMessage(playerid, COR_GRAD2, "Somente l�deres podem usar este comando!");
			return 1;
		}
		if(sscanf(vaga, "s[24]", vaga))
			return SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /limparvagaf [Vaga]");
        new Vaga2 = strval(vaga);
		new org = GetPlayerFamilia(playerid);
		new id;
		format(stringZCMD,sizeof(stringZCMD),"SELECT * FROM `familias` WHERE `ID`=%d", org);
		Resultado = db_query(Conexao,stringZCMD);
		//mysql_store_result();
		if(strcmp(vaga,"sub",true)==0)
		{
			if(IsPlayerOnline(InfoFamilia[org][SubLider]))
			{
				id=GetPlayerID(InfoFamilia[org][SubLider]);
				DemitirFamilia(playerid, id);
			}
			strmid(InfoFamilia[org][SubLider], "Ninguem", 0, strlen("Ninguem"), 255);
			format(stringZCMD, sizeof(stringZCMD), "UPDATE `familias` SET `SubLider`='Ninguem' WHERE `ID`='%d'", org);
			Resultado = db_query(Conexao,stringZCMD);
			SendClientMessage(playerid, COR_LIGHTBLUE,"Voc� Limpou a Vaga do Sub L�der");
			return 1;
		}
		new Maximo_Membros = 0;
		format(stringZCMD,sizeof(stringZCMD),"SELECT * FROM `familias` WHERE `ID`=%d", org);
		Resultado = db_query(Conexao,stringZCMD);
		if(db_num_rows(Resultado) > 0)
  		{
  		    //mysql_retrieve_row();
  		    new result[10];
  		    new Tipo;
  		    db_get_field_assoc(Resultado, "Tipo", result, sizeof(result));
  		    Tipo = strval(result);
			if(Tipo == 0) Maximo_Membros = 15;
			if(Tipo == 1) Maximo_Membros = 20;
			if(Tipo == 2) Maximo_Membros = 30;
			if(Tipo == 3) Maximo_Membros = 40;
		}
		if(Vaga2 > 0 && Vaga2 <= Maximo_Membros)// id da vaga
		{
		    Vaga2--;
		    if(!isnull(InfoFMembros[org][Vaga2])){
			    id=GetPlayerID(InfoFMembros[org][Vaga2]);
			    if(IsPlayerOnline(InfoFMembros[org][Vaga2])) DemitirFamilia(playerid, id);
		    }
		    strmid(InfoFMembros[org][Vaga2], "Ninguem", 0, strlen("Ninguem"), 255);
		   	format(stringZCMD, sizeof(stringZCMD), "UPDATE `familias` SET `Membro%d`='Ninguem' WHERE `ID`='%d'", Vaga2, org);
			Resultado = db_query(Conexao,stringZCMD);
		   	format(stringZCMD, 128, "Voc� Limpou a Vaga %d", Vaga2+1);
		   	SendClientMessage(playerid, COR_AMARELO2,stringZCMD);
		   	return true;
		}
		return 1;
	}
	CMD:membrosf(playerid, params[])return ForT:fmembros(playerid,params);
