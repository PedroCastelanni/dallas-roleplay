  		format(ActualMembro[19],30, InfoOrg[org][Membro19]);
  		format(ActualMembro[20],30, InfoOrg[org][Membro20]);
  		format(ActualMembro[21],30, InfoOrg[org][Membro21]);
  		format(ActualMembro[22],30, InfoOrg[org][Membro22]);
