TPL:: SaveORGS()
{
	new idx = 1;
	new string[200];
	new str[2000];
	while (idx < sizeof(InfoOrg))
	{
	    format(string, sizeof(string), "SELECT * FROM `organizacoes` WHERE ID=%d",idx);
     	Resultado = db_query(Conexao,string);
	    if(db_num_rows(Resultado) > 0)
		{
		    format(string, sizeof(string),"DELETE FROM `organizacoes` WHERE `ID` ='%d'",idx);
		    Resultado = db_query(Conexao,string);
		}
        format(string, sizeof(string),"INSERT INTO `organizacoes`(`ID`, `Nome`, `Lider`, `SubLider`, `Membro1`, `Membro2`, `Membro3`, `Membro4`, `Membro5`, ");
		strcat(str, string);
		format(string, sizeof(string),"`Membro6`, `Membro7`, `Membro8`, `Membro9`, `Membro10`, `Membro11`, `Membro12`, `Membro13`, `Membro14`, `Membro15`, `Membro16`, ");
		strcat(str, string);
		format(string, sizeof(string),"`Membro17`, `Membro18`, `Membro19`, `Membro20`, `Membro21`, `Membro22`, `Membro23`, `Membro24`, `Membro25`, `Membro26`, ");
        strcat(str, string);
		format(string, sizeof(string),"`Membro27`, `Membro28`, `Membro29`, `Membro30`, `Membro31`, `Membro32`, ");
        strcat(str, string);
		format(string, sizeof(string),"`Membro33`, `Membro34`, `Membro35`, `Membro36`, `Membro37`, `Membro38`, `Membro39`, `Membro40`) VALUES (%d,", idx);
        strcat(str, string);
		format(string, sizeof(string),"'%s','%s','%s','%s','%s','%s','%s','%s',",
		GetOrgName(idx),
		InfoOrg[idx][Lider],
		InfoOrg[idx][SubLider],
	    InfoOrg[idx][Membro1],
		InfoOrg[idx][Membro2],
		InfoOrg[idx][Membro3],
		InfoOrg[idx][Membro4],
		InfoOrg[idx][Membro5]);
		strcat(str, string);
		format(string, sizeof(string),"'%s','%s','%s','%s','%s',",
		InfoOrg[idx][Membro6],
		InfoOrg[idx][Membro7],
		InfoOrg[idx][Membro8],
		InfoOrg[idx][Membro9],
		InfoOrg[idx][Membro10]);
		strcat(str, string);
