TPL::IniciarContagemHumanos(playerid)
{
	new string[100];
 	if(TaNoQuarentena[playerid] == 1)
 	{
		SendClientMessage(playerid, -1, "{DE6811}[Quarentena] Os infectados foram escolhidos, o tempo do evento est� passando, objetivo = Sobreviver.");
		if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid, "http://fuckloverp.com.br/musicas/quarentena1.mp3");
		ContagemQuarentena[playerid] = 600;
		TextDrawShowForPlayer(playerid, TextDrawCQ);
 		TogglePlayerControllable(playerid, 1);
 		format(string,sizeof(string),"HUMANOS WIN %d", ContagemQuarentena[playerid]);
		TextDrawSetString(TextDrawCQ, string);
   		//RandomSetarInfectados(playerid);
   		AtualizarEquipe(playerid);
	}
	KillTimer(TimeQuarentena); //MATAR CONTAGEM.
	return 1;
}
TPL::PlacarQuarentena(playerid)
{
	new QuantidadeHumanos = 0;
	new QuantidadeInfectados = 0;
	foreach(new i: Player)
	{
	    if(EquipeQuarentena[i] == 1) QuantidadeHumanos++;
	    if(EquipeQuarentena[i] == 2) QuantidadeInfectados++;
	}
	if(QuantidadeHumanos == 0)TimeQuarentena2 = SetTimer("InfectadosGanharam", 2000, false);
	if(QuantidadeInfectados == 0)TimeQuarentena3 = SetTimer("HumanosGanharam", 2000, false)
	format(gstring, sizeof(gstring), "[Quarentena] Placar Atual: {21AB13}Humanos [%d] {FFFFFF}x {DE6811}[%d] Infectados.",QuantidadeHumanos, QuantidadeInfectados);
	MensagemQuarentena(COR_GREEN, gstring);
	return 1;
}
TPL::InfectadosGanharam(playerid)
{
	new QuantidadeHumanos;
	foreach(new i: Player)
	{
		if(EquipeQuarentena[i] == 1) QuantidadeHumanos++;

	    if(QuantidadeHumanos == 0)
	    {
		    if(EquipeQuarentena[i] == 2)
		    {
			    format(gstring, sizeof(gstring), "[Quarentena] Voc�s infectaram todos no evento e venceram. Recebeu [20.000].");
			    SendClientMessage(i, COR_VERMELHO, gstring);
				RemovePlayerAttachedObject(i,0);
				RemovePlayerAttachedObject(i,1);
				RemovePlayerAttachedObject(i,2);
				RemovePlayerAttachedObject(i,3);
				TextDrawHideForPlayer(i, TextDrawCQ);
				SetPlayerSkin(i, PlayerInfo[i][pSkin]);
				ContagemQuarentena[i] = 0;
				TaNoQuarentena[i] = 0;
				EquipeQuarentena[i] = 0;
				PlayerInfo[i][pWinner] += 1;
				NaPorraDoEvento[i] = false;
				KillTimer(TempoVida[i]);
				GivePlayerMoneyEx(i, 20000);
				PlayerInfo[i][pExp] += 2;
				pClassiQuarentena[i] = 0;
				TendoQuarentena = 0;
				TaNoQuarentena[playerid] = 0;
				SetPlayerSpawn(i);
				SetHora();
		    }
    		if(EquipeQuarentena[i] == 1)
		    {
				TextDrawHideForPlayer(i, TextDrawCQ);
				SetPlayerSkin(i, PlayerInfo[i][pSkin]);
				ContagemQuarentena[i] = 0;
				TaNoQuarentena[i] = 0;
				EquipeQuarentena[i] = 0;
				NaPorraDoEvento[i] = false;
				KillTimer(TempoVida[i]);
				pClassiQuarentena[i] = 0;
				SetPlayerSpawn(i);
		    }
		}
	}
	KillTimer(TimeQuarentena2);
	format(gstring, sizeof(gstring), "[Quarentena] Todos os humanos foram infectados. Os infectados ganharam: R$20.000.");
	SendClientMessageToAll(COR_AMARELO, gstring);
	return 1;
}
TPL::HumanosGanharam(playerid)
{
	new QuantidadeInfectados;
	foreach(new i: Player)
	{
		if(EquipeQuarentena[i] == 2) QuantidadeInfectados++;

	    if(QuantidadeInfectados == 0)
	    {
		    if(EquipeQuarentena[i] == 1)
		    {
			    format(gstring, sizeof(gstring), "[Quarentena] Voc�s mataram todos os infectados e sobreviveram. Recebeu [30.000] e 1 respeito.");
			    SendClientMessage(i, COR_VERMELHO, gstring);
				SetPlayerSkin(i, PlayerInfo[i][pSkin]);
				TextDrawHideForPlayer(i, TextDrawCQ);
				ContagemQuarentena[i] = 0;
				TaNoQuarentena[i] = 0;
				PlayerInfo[i][pWinner] += 1;
				NaPorraDoEvento[i] = false;
				KillTimer(TempoVida[i]);
				GivePlayerMoneyEx(i, 30000);
				NaPorraDoEvento[i] = false;
				pClassiQuarentena[i] = 0;
				EquipeQuarentena[i] = 0;
				TendoQuarentena = 0;
				TaNoQuarentena[playerid] = 0;
				SetPlayerSpawn(i);
				SetHora();
		    }
    		if(EquipeQuarentena[i] == 2)
		    {
				TextDrawHideForPlayer(i, TextDrawCQ);
				SetPlayerSkin(i, PlayerInfo[i][pSkin]);
				ContagemQuarentena[i] = 0;
				TaNoQuarentena[i] = 0;
				EquipeQuarentena[i] = 0;
				NaPorraDoEvento[i] = false;
				KillTimer(TempoVida[i]);
				pClassiQuarentena[i] = 0;
				SetPlayerSpawn(i);
		    }
		}
	}
	KillTimer(TimeQuarentena3);
	format(gstring, sizeof(gstring), "[Quarentena] Todos os infectados foram eliminados. Os humanos ganharam: R$30.000 e 1 respeito.");
	SendClientMessageToAll(COR_AMARELO, gstring);
	return 1;
}
TPL::EvitarFloodQuarentena()
{
	new string[105];
	if(LiberadoEnviar == 0)
	{
		format(string, sizeof(string), "[Quarentena] Os humanos sobreviveram 10 minutos contra os infectados, ganharam: R$40.000 e 2 respeitos.");
		SendClientMessageToAll(COR_AMARELO, string);
		LiberadoEnviar = 1;
	}
	return 1;
}
TPL::AtualizarEquipe(playerid)
{
	foreach(new i: Player)
	{
		if(EquipeQuarentena[i] == 1)
		{
		    GivePlayerWeaponEx(i, 33, 250);
		    GivePlayerWeaponEx(i, 25, 250);
		    GivePlayerWeaponEx(i, 22, 2000);
		    SetPlayerSkin(i, SkinRandomHumano[random(16)]);
		}
		else if(EquipeQuarentena[i] == 2)
		{
  			SetPlayerColor(i, COR_CV);
  			SetPlayerAttachedObject(i, 10, 2906, 5, -0.2, 0.0, 0.0, 0, 0.0, -90, 1.0, 1.0, 1.0);
			SetPlayerAttachedObject(i, 9, 2906, 6, -0.2, 0.0, 0.0, 0, 345, 270, 1.0, 1.0, 1.0);
			SetPlayerAttachedObject(i, 2, 2908, 2, 0.05,0.06, 0.0, 180, 0.0, 90, 1.1, 1.1, 1.1);
			SetPlayerAttachedObject(i, 3, 2905, 12, 0.1, 0.05, 0.0, 0.0, 0.0, -70, 1.0, 1.0, 1.0);
  			SetPlayerSkin(i, 162);
		}
	}
	LiberarInfectar = true;
	return 1;
}
TPL::RedWins()
{
	foreach(new i: Player)
	{
		if(TanoWarZone[i] == 1)
		{
	        SendClientMessage(i, COR_AMARELO, "[War Zone] O Evento chegou ao fim, o time vermelho venceu e os membros receberam: R$20.000 e 1 respeito.");
			if(MaletaAnexada[i] == 1) StopPlayerHoldingObject(i);
		    TextDrawHideForPlayer(i, TextDrawRED);
	     	TextDrawHideForPlayer(i, TextDrawBLUE);
	      	TextDrawHideForPlayer(i, TextDrawGREEN);
	        ContandoRed = 0;
	        ContandoBlue = 0;
	        ContandoGreen = 0;
			ResetPlayerWeaponsEx(i);
	        TanoWarZone[i] = 0;
	        NaPorraDoEvento[i] = false;
	        KillTimer(TempoVida[i]);
	     	MaletaAnexada[i] = 0;
			DisablePlayerCheckpoint(i);
	     	DestroyDynamicObject(maletaid);
	     	ContagemGreen = 0;
	     	ContagemRed = 0;
	        ContagemBlue = 0;
	        SetPlayerSkin(i, PlayerInfo[i][pSkin]);
	        IniciarContagemWarZone = 0;
	        LimiteRed = 0;
			LimiteBlue = 0;
			LimiteGreen = 0;
	        SetPlayerSpawn(i);
	        if(EquipeWarZone[i] == 1)
	        {
	            SendClientMessage(i, COR_LIGHTBLUE, "[Event Zones] O Time vermelho ganhou o evento e voc� ganhou R$15.000 e 1 respeito !");
				PlayerInfo[i][pExp] += 1;
				GivePlayerMoneyEx(i, 20000);
				PlayerInfo[i][pWinner] += 1;
	        }
	        EquipeWarZone[i] = 0;
		}
	}
}
