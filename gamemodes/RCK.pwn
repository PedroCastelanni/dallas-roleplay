					{
						unwanted[GetPlayerVehicleID(i)] = true;
					}
				}
				for(new x; x != MAX_VEHICLES; x++)
				{
					if(!unwanted[CarrosGROTA[x]])
					{
						SetVehicleToRespawn(CarrosGROTA[x]);
					}
				}
				return 1;

			}
			else if(org == 33)
			{
				format(stringZCMD, sizeof(stringZCMD), "[RCK]: Todos os carros da Tropa Do Lacoste foram para seus locais de inicio. By: %s.", PlayerName(playerid));
				ABroadCast(0x80FF8096, stringZCMD, 1);
				foreach(new i: Player)
				{
					if(IsPlayerConnected(i) && IsPlayerInAnyVehicle(i))
					{
						unwanted[GetPlayerVehicleID(i)] = true;
					}
				}
				for(new x; x != MAX_VEHICLES; x++)
				{
					if(!unwanted[CarrosTDL[x]])
					{
						SetVehicleToRespawn(CarrosTDL[x]);
					}
				}
				return 1;

			}
		}

		else
		{
			SendClientMessage(playerid,COR_GRAD5,"Voc� n�o tem permiss�o para usar esse comando!");
		}
		return 1;
	}
	CMD:respawncarros(playerid, params[])  return ForT:rc(playerid, params);
	CMD:rc(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pAdmin] < 3)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� autorizado a usar este comando !");
				return 1;
			}
			if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			new plyName[MAX_PLAYER_NAME];
			GetPlayerName(playerid, plyName, MAX_PLAYER_NAME);
			new name[MAX_PLAYER_NAME];
			GetPlayerName(playerid, name, sizeof(name));
			new bool:IsUsed[MAX_VEHICLES];
			foreach(new i: Player)
			{
				if(IsPlayerInAnyVehicle(i))
				{
					IsUsed[GetPlayerVehicleID(i)] = true;
				}
			}
			IsUsed[CarrosOnibus[0]] = true;
			IsUsed[CarrosOnibus[1]] = true;
			for(new x = 0, mv = GetVehiclePoolSize(); x < mv; x++)
			{
				if(!IsUsed[x]) SetVehicleToRespawn(x);
   			}
			GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
			format(stringZCMD, sizeof(stringZCMD), "{836FFF}[Veiculos respawndos]:{FFFFFF} os veiculos do servidor foram respawnados em suas (base/hq) pelo staff: {FF0000}[%s].", playernameZCMD);
			SendClientMessageToAll(0x80FF8096,stringZCMD);
		}
		return 1;
	}
	CMD:HomemBomba(playerid, params[])
	{
		if(PlayerInfo[playerid][pJailed] != 0)
		{
			SendClientMessage(playerid,COR_AMARELO," Voc� n�o pode usar homem bomba na cadeia!");
			return 1;
		}
		if(WantedLevel[playerid] != 0)
		{
			SendClientMessage(playerid, COR_GREY, "Voc� est� procurado,n�o pode usar este comando!");
			return 1;
		}
		if(PlayerInfo[playerid][pMembro] != 6 && PlayerInfo[playerid][pLider] != 6 && PlayerInfo[playerid][pMembro] != 16 && PlayerInfo[playerid][pLider] != 16 && PlayerInfo[playerid][pMembro] != 30 && PlayerInfo[playerid][pLider] != 30)
		{
			SendClientMessage(playerid, COR_LIGHTRED, "Voc� n�o � do Taliban/estado islamico");
			return 1;
		}
		if(phbomba == 1)
		{
			SendClientMessage(playerid,COR_GRAD2,"J� usaram homembomba,aguarde 20 segundos!");
			return 1;
		}
		GetPlayerName(playerid, sendername, sizeof(sendername));
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pMembro] == 6 || PlayerInfo[playerid][pLider] == 6 || PlayerInfo[playerid][pMembro] == 16 || PlayerInfo[playerid][pLider] == 16)
			{
				SetPlayerHealth(playerid, 0);
				new Float:x, Float:y, Float:z;
				GetPlayerPos(playerid, x, y, z);
				CreateExplosion(x, y, z, 7, 25);
				printf("[Terrorista] Usou Homem Bomba");
				format(stringZCMD, sizeof(stringZCMD), "Terrorista %s Usou Homem Bomba! ID[%d]", sendername, playerid);
				ABroadCast(COR_AMARELO,stringZCMD,1);
				format(stringZCMD, 128, "Terrorista: %s Usou Homem Bomba !.",sendername);
				ProxDetector(70.0, playerid, stringZCMD, COR_VERMELHO,COR_VERMELHO,COR_VERMELHO,COR_VERMELHO,COR_VERMELHO);
				phbomba = 1;
				Tempohbomba = SetTimer("hbomba", 20000, 0);
			}
		}
		else
		{
			SendClientMessage(playerid, COR_VERMELHO, "Voc� n�o est� autorizado a usar este comando!");
		}
		return 1;
	}
