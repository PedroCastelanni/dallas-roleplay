			GrafiteInfo[x][grafiteRZ] = DOF2_GetFloat(file, "GrafiteRZ");
			GrafiteInfo[x][grafiteCor] = DOF2_GetInt(file, "GrafiteCor");
			GrafiteInfo[x][grafiteFonte] = DOF2_GetInt(file, "GrafiteFonte");
			format(GrafiteInfo[x][grafiteNick], MAX_PLAYER_NAME, DOF2_GetString(file, "GrafiteNick"));
            format(GrafiteInfo[x][grafiteTexto],MAX_PLAYER_NAME, DOF2_GetString(file, "GrafiteTexto"));
	        GrafiteInfo[x][grafiteObject]     = CreateObject(19482, GrafiteInfo[x][grafiteX],
									                                   GrafiteInfo[x][grafiteY],
																	   GrafiteInfo[x][grafiteZ],
																	   GrafiteInfo[x][grafiteRX],
																	   GrafiteInfo[x][grafiteRY],
																	   GrafiteInfo[x][grafiteRZ]);
            format(Str, sizeof Str, "{0099ff}� Gr�fite de: {FFFFFF}%s", GrafiteInfo[x][grafiteNick]);
	        GrafiteInfo[x][grafiteText]       = CreateDynamic3DTextLabel(Str, COR_LIGHTBLUE, GrafiteInfo[x][grafiteX], GrafiteInfo[x][grafiteY], GrafiteInfo[x][grafiteZ]+1, 25.0);
			new Cor;
			if(GrafiteInfo[x][grafiteCor] == 1) Cor = -256;
			if(GrafiteInfo[x][grafiteCor] == 2) Cor = -16468988;
			if(GrafiteInfo[x][grafiteCor] == 3) Cor = -16730675;
			if(GrafiteInfo[x][grafiteFonte] == 1)
			{
				SetObjectMaterialText(GrafiteInfo[x][grafiteObject], GrafiteInfo[x][grafiteTexto],0,OBJECT_MATERIAL_SIZE_256x256,"Arial",24,1,Cor,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
   			}
			if(GrafiteInfo[x][grafiteFonte] == 2)
			{
				SetObjectMaterialText(GrafiteInfo[x][grafiteObject], GrafiteInfo[x][grafiteTexto],0,OBJECT_MATERIAL_SIZE_256x256,"Comic Sans MS",24,1,Cor,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
			}
			if(GrafiteInfo[x][grafiteFonte] == 3)
			{
				SetObjectMaterialText(GrafiteInfo[x][grafiteObject], GrafiteInfo[x][grafiteTexto],0,OBJECT_MATERIAL_SIZE_256x256,"Italic",24,1,Cor,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
			}
			if(GrafiteInfo[x][grafiteFonte] == 4)
			{
				SetObjectMaterialText(GrafiteInfo[x][grafiteObject], GrafiteInfo[x][grafiteTexto],0,OBJECT_MATERIAL_SIZE_256x256,"Copperplate Gothic Bold",24,1,Cor,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
			}

		}
	}
}

salvarGrafites(){

	static file[78];
	for(new x; x != MAX_GRAFTEXT; x++){
	    if(GrafiteInfo[x][grafiteCreated]){
		    format(file, sizeof file, "Grafites/Grafite%d.ini", x);
		    if(!DOF2_FileExists(file)){
				DOF2_CreateFile(file);
		    }
			DOF2_SetFloat(file, "GrafiteX", GrafiteInfo[x][grafiteX]);
			DOF2_SetFloat(file, "GrafiteY", GrafiteInfo[x][grafiteY]);
			DOF2_SetFloat(file, "GrafiteZ", GrafiteInfo[x][grafiteZ]);
			DOF2_SetFloat(file, "GrafiteRX", GrafiteInfo[x][grafiteRX]);
			DOF2_SetFloat(file, "GrafiteRY", GrafiteInfo[x][grafiteRY]);
			DOF2_SetFloat(file, "GrafiteRZ", GrafiteInfo[x][grafiteRZ]);
			DOF2_SetInt(file, "GrafiteCor", GrafiteInfo[x][grafiteCor]);
			DOF2_SetInt(file, "GrafiteFonte", GrafiteInfo[x][grafiteFonte]);
			DOF2_SetString(file, "GrafiteNick", GrafiteInfo[x][grafiteNick]);
            DOF2_SetString(file, "GrafiteTexto", GrafiteInfo[x][grafiteTexto]);
			DOF2_SaveFile();
		}
	}
}
