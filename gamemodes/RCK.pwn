				SendClientMessage(playerid, COR_GRAD1, "Voc� j� pode entregar outro lixo !");
				for(new x; x < sizeof(FactoryData); x++)
				{
  					new string[128], vehicleid = GetPlayerVehicleID(playerid), cash = LoadedTrash[vehicleid] * TRASH_BAG_VALUE;
  					format(string, sizeof(string), "[Lixeiro]: {FFFFFF}Voc� vendeu {F39C12}%d {FFFFFF}sacos de lixo e ganhou {2ECC71}$%d.", LoadedTrash[vehicleid], cash);
				    SendClientMessage(playerid, 0x2ECC71FF, string);
				    PlayerInfo[playerid][pSalario] += cash;
				    FactoryData[x][FactoryCurrent] += LoadedTrash[vehicleid];
				    LoadedTrash[vehicleid] = 0;
      				format(string, sizeof(string), "Lixos:{ffffff} [%02d/%d]", LoadedTrash[vehicleid], TRASH_LIMIT);
					Update3DTextLabelText(FactoryLabel[vehicleid], COR_LIGHTBLUE, string);
  					Attach3DTextLabelToVehicle(FactoryLabel[vehicleid], vehicleid, 0.0, 0.0, 0.0+1);
				    break;
				}
				DisablePlayerCheckpoint(playerid);
				RemovePlayerAttachedObject(playerid, 9);
				return true;
			}
		}
		return 1;
	}
