TPL::SendVIPMessage(color, string[])
{
    foreach(new i: Player)
	{
		if(IsPlayerConnected(i))
		{
		    if (PlayerInfo[i][pVIP] > 0)
		    {
				if(PlayerInfo[i][pChatVipDesativado] == 0)
				{
				     SendClientMessage(i, color, string);
				}
			}
		}
	}
}
