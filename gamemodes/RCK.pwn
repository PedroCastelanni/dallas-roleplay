	CMD:votarfamilia(playerid, params[])return ForT:votarf(playerid,params);
	CMD:votarf(playerid, params[])
	{
		new votoid;
		if(sscanf(params, "d", votoid))
		{
			return SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /votarf [ID]");
		}
		if(PlayerInfo[playerid][pSocio] == 0)
		{

			return SendClientMessage(playerid, -1, "Voc� n�o est� autorizado a usar este comando(apenas vips/s�cios) !");
		}
		if(votoid < 1 || votoid > 20)
		{

			return SendClientMessage(playerid, COR_GRAD2, "O id da fam�lia deve ser entre 1 a 20 !");
		}
		new arquivo[64],arquivo2[64];
		format(arquivo, sizeof(arquivo), "Votos Familia/Ja Votou/Ja Votou.txt");
		format(arquivo2, sizeof(arquivo2), "Votos Familia/Familia_%d.ini", votoid);
		if(DOF2_GetInt(arquivo, PlayerName(playerid)) == 1)
		{

			return SendClientMessage(playerid, -1, "Voc� j� votou em uma fam�lia neste m�s.");
		}
		if(InfoFamilia[votoid][DiasFamilia] == 0)
		{
			return SendClientMessage(playerid, -1, "Essa fam�lia que voc� est� tentando votar n�o � vip.");
		}
		format(arquivo2, sizeof(arquivo2), "Votos Familia/Familia_%d.ini", votoid);
		if(DOF2_FileExists(arquivo2))
		{
			// DOF2_CreateFile(arquivo);
			DOF2_SetInt(arquivo, PlayerName(playerid), 1);
			new conta = DOF2_GetInt(arquivo2, "Total votos") + 1;
			DOF2_SetInt(arquivo2, "Total votos", conta);
			DOF2_SaveFile();
			format(stringZCMD, sizeof(stringZCMD), "Voc� votou na fam�lia id: [%d] com sucesso !",votoid);
			SendClientMessage(playerid, -1, stringZCMD);
			return 1;
		}
		return 1;
	}
