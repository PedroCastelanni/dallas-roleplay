					{
						if(proplev < 1) { return 1; }
						BizzInfo[i][bTill] = proplev;
						format(stringZCMD, sizeof(stringZCMD), "Voc� Ajustou os Fundos da Empresa para: %d", proplev);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
						SalvarEmpresa(i);
					}
					else if(strcmp(x_Emprego,"chave",true) == 0)
					{
