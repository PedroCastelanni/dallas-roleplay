    if(dialogid == DIALOG_SKINMOBILE)
    {
    	if(!response) return 1;

    	if(!IsNumeric(inputtext)) return SendClientMessage(playerid, -1, "{FF0000}Digite uma id valida de 0 a 30");
        if(strval(inputtext) < 0 || strval(inputtext) > 30) return SendClientMessage(playerid, -1, "{FF0000}Digite uma id valida de 0 a 299");

        SendClientMessage(playerid, COR_LIGHTBLUE, "* Voc� comprou nova skin por R$15000. A roupa est� no seu invent�rio, coloque-a quando quizer!");
		GivePlayerMoney(playerid,-15000);
		SBizzInfo[6][sbTill] += 15000;
		ExtortionSBiz(6, 15000);
		for(new i=0; i<75; i++)
	    {
            if(InventarioInfo[playerid][i][iSlot] == 19382)
	        {
	           	InventarioInfo[playerid][i][iSlot] = strval(inputtext);
	        	InventarioInfo[playerid][i][iUnidades] = 1;
	            break;
         	}
        }
       	return 1;
    }

    if(dialogid == DIALOG_SKINPERMAMOBILE)
    {
    	if(!response) return 1;

    	if(!IsNumeric(inputtext)) return SendClientMessage(playerid, -1, "{FF0000}Digite uma id valida de 0 a 299");
        if(strval(inputtext) < 0 || strval(inputtext) > 299) return SendClientMessage(playerid, -1, "{FF0000}Digite uma id valida de 0 a 299");

		SendClientMessage(playerid, COR_LIGHTBLUE, "Skin Modificada !");
		SetPlayerSkin(playerid, strval(inputtext));
		new arquivo[64];
		format(arquivo, sizeof(arquivo), Pasta_Acessorio,PlayerName(playerid));
		if(DOF2_FileExists(arquivo))
		{
			DOF2_SetInt(arquivo, "Skin Permanente", strval(inputtext));
		}
		else
		{
			DOF2_CreateFile(arquivo);
			DOF2_SetInt(arquivo, "Skin Permanente", strval(inputtext));
		}
		return 1;
	}

