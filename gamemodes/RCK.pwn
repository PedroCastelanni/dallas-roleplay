public OnPlayerEditObject(playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ)
{
 	new Float:oldX, Float:oldY, Float:oldZ, Float:oldRotX, Float:oldRotY, Float:oldRotZ;
	for(new x; x != MAX_GRAFTEXT; x++)
	{
 		if(GrafiteInfo[x][grafiteCreated] && !strcmp(PlayerName(playerid), GrafiteInfo[x][grafiteNick], true))
		{
			GetObjectPos(GrafiteInfo[x][grafiteObject], oldX, oldY, oldZ);
			GetObjectRot(GrafiteInfo[x][grafiteObject], oldRotX, oldRotY, oldRotZ);
		}
		if(!playerobject)
		{
	 		if(!IsValidObject(GrafiteInfo[x][grafiteObject])) return 1;
	   		MoveObject(GrafiteInfo[x][grafiteObject], fX, fY, fZ, 10.0, fRotX, fRotY, fRotZ);
		}
		break;
	}
 	if(response == EDIT_RESPONSE_FINAL)
  	{
  	    if(EditandoGrafite[playerid] == 1)
  	    {
  	        for(new g; g != MAX_GRAFTEXT; g++){
			    if(GrafiteInfo[g][grafiteCreated] &&
			    !strcmp(PlayerName(playerid), GrafiteInfo[g][grafiteNick], true)){
			        DestroyDynamic3DTextLabel(GrafiteInfo[g][grafiteText]);
			        static Str[105+MAX_PLAYER_NAME];
		            GrafiteInfo[g][grafiteX]          = fX;
		            GrafiteInfo[g][grafiteY]          = fY;
		            GrafiteInfo[g][grafiteZ]          = fZ;
		            GrafiteInfo[g][grafiteRX]         = fRotX;
		            GrafiteInfo[g][grafiteRY]         = fRotY;
		            GrafiteInfo[g][grafiteRZ]         = fRotZ;
			        format(GrafiteInfo[g][grafiteNick], MAX_PLAYER_NAME, PlayerName(playerid));
			        format(Str, sizeof Str, "{0099ff}� Gr�fite de: {FFFFFF}%s", PlayerName(playerid));
			        GrafiteInfo[g][grafiteText]       = CreateDynamic3DTextLabel(Str, COR_LIGHTBLUE, fX, fY, fZ+1, 15.0);
                    EditandoGrafite[playerid] = 0;
					SendClientMessage(playerid,-1,"Agora use o spray para pixar a parede!");
					GivePlayerWeapon(playerid, 41, 5000);
					salvarGrafites();
					break;
			    }
			}
		}
  	}
  	return 1;
}
public OnVehiclePaintjob(playerid, vehicleid, paintjobid)
{
	CarrosTunados[vehicleid][Pintura] = paintjobid;
	PME += 200;
    PDU += 200;
    DepositarOrgGrana(7,200);
 	return 1;
}

public OnVehicleRespray(playerid, vehicleid, color1, color2)
{
    if(GetPVarInt(playerid, "pintura_Recente") > gettime()) //Bern by Equipe BGS
	{
		new string[80];
 		format(string, sizeof(string), "ANTIXITER: %s[%d] foi kickado por floodar pinturas em veiculos, fique de olho!", PlayerName(playerid),playerid);
 		ABroadCast(COR_LIGHTRED,string,1);
 		AntiXiterLog(string);
 		Kick(playerid);
	}
    PMC += 500;
    PDU += 500;
    DepositarOrgGrana(7,500);
	SetPVarInt(playerid, "pintura_Recente", gettime() + 1);
	CarrosTunados[vehicleid][COR1] = color1;
	CarrosTunados[vehicleid][COR2] = color2;
 	return 1;
}
TPL::PlacaCarros(vehicleid)
{
     new modeloo = GetVehicleModel(vehicleid);
	 SetVehicleNumberPlate(vehicleid, "{FF1493}TPL");
     if(AdminsCarros(vehicleid))
     {
          Vuln[vehicleid] = MaxVuln;
          RepairVehicle(vehicleid);
          SetVehicleNumberPlate(vehicleid, "{ff3399}ADMINS");
          if(modeloo == 522 || modeloo == 581 || modeloo == 586 || modeloo == 521 || modeloo == 468 || modeloo == 463 || modeloo == 461 || modeloo == 462 || modeloo == 448)
	      {
         		Vuln[vehicleid] = MaxVulnMoto;
	      }
     }
     else if(SonsCarros(vehicleid))
     {
     	  Vuln[vehicleid] = MaxVuln;
          RepairVehicle(vehicleid);
          SetVehicleNumberPlate(vehicleid, "{570000}SONS");
          if(modeloo == 522 || modeloo == 581 || modeloo == 586 || modeloo == 521 || modeloo == 468 || modeloo == 463 || modeloo == 461 || modeloo == 462 || modeloo == 448)
	      {
         		Vuln[vehicleid] = MaxVulnMoto;
	      }

     }
     else if(MayansCarros(vehicleid))
     {
     	  Vuln[vehicleid] = MaxVuln;
