				GetPlayerName(playerid, sendername, sizeof(sendername));
				format(stringZCMD, sizeof(stringZCMD), "** %s Necessita de um Mecanico. Use /servicos para ver a lista de servi�os dispon�veis.", sendername);
				SendFamilyMessage(14, TEAM_AZTECAS_COR, stringZCMD);
				SendClientMessage(playerid, COR_LIGHTBLUE, "* Voc� chamou um Mecanico... Agora espere por uma resposta.");
				PediuServicoMec[playerid] = 1;
				MechanicCall = playerid;
