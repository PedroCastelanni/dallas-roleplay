					format(stringZCMD, sizeof(stringZCMD), "  Voc� retirou R$%d de sua empresa - restante: R$%d ", cashdeposit,SBizzInfo[borse-100][sbTill]);
					SendClientMessage(playerid, COR_GRAD1, stringZCMD);
