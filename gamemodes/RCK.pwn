		            format(string, sizeof(string), "Voc� imobilizou o suspeito: %s.", PlayerName(playerid));
			        SendClientMessage(issuerid, COR_LIGHTBLUE, string);
			        format(string, sizeof(string), "Voc� foi imobilizado pelo Oficial: %s.", PlayerName(issuerid));
			        SendClientMessage(playerid, COR_LIGHTBLUE, string);
                    SetTimerEx("TempoImobilizado", 3000, 0, "i", playerid);
                    GameTextForPlayer(playerid, "~r~IMOBILIZADO", 2500, 3);
