  		format(ActualMembro[24],30, InfoOrg[org][Membro24]);
  		format(ActualMembro[25],30, InfoOrg[org][Membro25]);
        format(ActualMembro[26],30, InfoOrg[org][Membro26]);
  		format(ActualMembro[27],30, InfoOrg[org][Membro27]);
  		format(ActualMembro[28],30, InfoOrg[org][Membro28]);
  		format(ActualMembro[29],30, InfoOrg[org][Membro29]);
