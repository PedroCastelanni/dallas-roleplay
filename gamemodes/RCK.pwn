TPL::PickupAgricultor(playerid)
{
     new vid = GetPlayerVehicleID(playerid);
     new modelo = GetVehicleModel(vid);
     if(IsPlayerConnected(playerid))
     {
          if(PlayerToPoint(3.0, playerid, plantax1[playerid], plantay1[playerid], plantaz1[playerid]))
          {
               if(!IsPlayerInVehicle(playerid, vid))
               {
                    return 1;
               }
               if(modelo != 532)
               {
                    return 1;
               }
               PegaPlanta[playerid] -= 1;
               tempocolheita[playerid] = 1;
               DestroyDynamicPickup(Planta1[playerid]);
               FenoPlantado1[playerid] = CreateDynamicPickup(2901, 23, plantax1[playerid], plantay1[playerid], plantaz1[playerid]);
          }
          else if(PlayerToPoint(3.0, playerid, plantax2[playerid], plantay2[playerid], plantaz2[playerid]))
          {
               if(!IsPlayerInVehicle(playerid, vid))
               {
                    return 1;
               }
               if(modelo != 532)
               {
                    return 1;
               }
               PegaPlanta[playerid] -= 1;
               tempocolheita[playerid] = 2;
               DestroyDynamicPickup(Planta2[playerid]);
               FenoPlantado2[playerid] = CreateDynamicPickup(2901, 23, plantax2[playerid], plantay2[playerid], plantaz2[playerid]);
          }
          else if(PlayerToPoint(3.0, playerid, plantax3[playerid], plantay3[playerid], plantaz3[playerid]))
          {
               if(!IsPlayerInVehicle(playerid, vid))
               {
                    return 1;
               }
               if(modelo != 532)
               {
                    return 1;
               }
               PegaPlanta[playerid] -= 1;
               tempocolheita[playerid] = 3;
               DestroyDynamicPickup(Planta3[playerid]);
               FenoPlantado3[playerid] = CreateDynamicPickup(2901, 23, plantax3[playerid], plantay3[playerid], plantaz3[playerid]);
          }
          else if(PlayerToPoint(3.0, playerid, plantax4[playerid], plantay4[playerid], plantaz4[playerid]))
          {
               if(!IsPlayerInVehicle(playerid, vid))
               {
                    return 1;
               }
               if(modelo != 532)
               {
                    return 1;
               }
               PegaPlanta[playerid] -= 1;
               tempocolheita[playerid] = 4;
               DestroyDynamicPickup(Planta4[playerid]);
               FenoPlantado4[playerid] = CreateDynamicPickup(2901, 23, plantax4[playerid], plantay4[playerid], plantaz4[playerid]);
          }
          else if(PlayerToPoint(3.0, playerid, plantax5[playerid], plantay5[playerid], plantaz5[playerid]))
          {
               if(!IsPlayerInVehicle(playerid, vid))
               {
                    return 1;
               }
               if(modelo != 532)
               {
                    return 1;
               }
               PegaPlanta[playerid] -= 1;
               tempocolheita[playerid] = 5;
               DestroyDynamicPickup(Planta5[playerid]);
               FenoPlantado5[playerid] = CreateDynamicPickup(2901, 23, plantax5[playerid], plantay5[playerid], plantaz5[playerid]);
          }
          if(tempocolheita[playerid] == 5)
          {
               PegaPlanta[playerid] = 0;
               tempocolheita[playerid] = 0;
		       KillTimer(colheitapickup[playerid]);
          }
     }
     return 1;
}
