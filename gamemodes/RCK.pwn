	new path[50],StrCAR[64], SCCarid;
	path = SaveCarNomePlay(playerid);
	format(StrCAR, sizeof(StrCAR), "CarID_%i", SlcCAR);
	SCCarid = DOF2_GetInt(path,StrCAR);
	format(StrCAR, sizeof(StrCAR), "Cor_%i", SlcCAR);
	SvCarCOR[SlcCAR][playerid] = DOF2_GetInt(path,StrCAR);
	if(IsPlayerInRangeOfPoint(playerid,2.0,1649.0010,-1084.7375,23.6207))
	{
		DestroyVehicle(SVCarPLAYER[SlcCAR][playerid]);
		SVCarPLAYER[SlcCAR][playerid] = AddStaticVehicleEx(SCCarid,1654.3490,-1074.3341,23.8984,186.9367,SvCarCOR[SlcCAR][playerid],SvCarCOR[SlcCAR][playerid],-1);
	    SetVehicleHealth(SVCarPLAYER[SlcCAR][playerid], 650.0);
		PutPlayerInVehicle(playerid, SVCarPLAYER[SlcCAR][playerid], 0);
	}
	if(IsPlayerInRangeOfPoint(playerid,2.0,1922.4371,-1792.9435,13.3828))
	{
	    DestroyVehicle(SVCarPLAYER[SlcCAR][playerid]);
		SVCarPLAYER[SlcCAR][playerid] = AddStaticVehicleEx(SCCarid,1922.4371,-1792.9435,13.3828,271.8903,SvCarCOR[SlcCAR][playerid],SvCarCOR[SlcCAR][playerid],-1);
	    SetVehicleHealth(SVCarPLAYER[SlcCAR][playerid], 650.0);
		PutPlayerInVehicle(playerid, SVCarPLAYER[SlcCAR][playerid], 0);
	}
	if(IsPlayerInRangeOfPoint(playerid,2.0,1561.2938,-2315.4622,13.5483))
	{
		DestroyVehicle(SVCarPLAYER[SlcCAR][playerid]);
		SVCarPLAYER[SlcCAR][playerid] = AddStaticVehicleEx(SCCarid,1561.2938,-2315.4622,13.5483,95.2546,SvCarCOR[SlcCAR][playerid],SvCarCOR[SlcCAR][playerid],-1);
        SetVehicleHealth(SVCarPLAYER[SlcCAR][playerid], 650.0);
		PutPlayerInVehicle(playerid, SVCarPLAYER[SlcCAR][playerid], 0);
	}
	if(IsPlayerInRangeOfPoint(playerid,2.0,1361.6919,-1643.2339,13.3828))
	{
		DestroyVehicle(SVCarPLAYER[SlcCAR][playerid]);
		SVCarPLAYER[SlcCAR][playerid] = AddStaticVehicleEx(SCCarid,1361.6919,-1643.2339,13.3828,265.9813,SvCarCOR[SlcCAR][playerid],SvCarCOR[SlcCAR][playerid],-1);
	    SetVehicleHealth(SVCarPLAYER[SlcCAR][playerid], 650.0);
	    PutPlayerInVehicle(playerid, SVCarPLAYER[SlcCAR][playerid], 0);
	}
	return 1;
}

CMD:destruirid(playerid, params[])
{
	new counter = 0;
	new result;
	for(new i; i != MAX_VEHICLES; i++)
	{

		new dist = ChecarveiculoTPL(5, playerid, i);
		if(dist)
		{
			result = i;
			counter++;
		}
	}
	switch(counter)
	{

		case 0:
		{
			SendClientMessage(playerid, -1, "{9370DB}!{FFFFFF} nao foi encontrado nenhum veiculo por perto!");
		}
		case 1:
		{
            for(new i; i != QntSlotCar; i++)
            {
                for(new t; t != MAX_PLAYERS; t++)
                {
                    new string[100];
				    DestroyVehicle(SVCarPLAYER[i][t]);
				    SVCarPLAYER[i][t] = 0;
				}
            }
		}
	}
	return true;
}

