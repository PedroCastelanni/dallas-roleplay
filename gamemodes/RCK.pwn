	CMD:playerson(playerid, params[])
	{
    	new str[100], strDialog[4000], Cont, Nome[MAX_PLAYER_NAME];
    	format(str, sizeof(str), "ID\tNome\tLevel\tORG\n");
    	strcat(strDialog, str);

    	// Primeiro Usu�rio no topo, no caso quem digitou o comando.
    	GetPlayerName(playerid, Nome, sizeof(Nome));
    	format (str, sizeof str, "%d\t%s\t%d\t%s%s\n", playerid, Nome, PlayerInfo[playerid][pLevel], GetCorORG(GetPlayerOrg(playerid)), NomeORG(playerid));
    	strcat(strDialog, str);
    	Cont++;

    	// Listando os que possivelmente est�o online
     	foreach(new i : Player)
    	{
        	if(playerid == i)
            	continue;

        	GetPlayerName(i, Nome, sizeof(Nome));
        	format(str, sizeof str, "%d\t%s\t%d\t%s%s\n", i, Nome, PlayerInfo[i][pLevel], GetCorORG(GetPlayerOrg(i)), NomeORG(i));
        	strcat(strDialog, str);
        	Cont++;
    	}

    	new titulo[42];
    	format(titulo, sizeof(titulo), "Jogadores Online ({00d900}%d{ffffff})", Cont);
    	ShowPlayerDialog(playerid, 9992, DIALOG_STYLE_TABLIST_HEADERS, titulo, strDialog, "Enviar SMS", "Cancelar");
    	return 1;
	}
