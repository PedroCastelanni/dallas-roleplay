	CMD:jetpack(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(GetTickCount() - TempoPegarJetpack[playerid] < 5000)
			return SendClientMessage(playerid,COR_GRAD1,"Voc� s� pode usar este comando a cada 5 segundos !");

			if(NaPorraDoEvento[playerid] == true)
			return SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode pegar durante o evento !");

			if(PlayerInfo[playerid][pJailed] != 0)
			return SendClientMessage(playerid,COR_COSA,"Voc� n�o pode pegar seu jetpack na cadeia");

			if(WantedLevel[playerid] > 0)
			return SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode pegar seu jetpack estando procurado.");

			if(GetPlayerInterior(playerid) > 0)
			return SendClientMessage(playerid, COR_AMARELO, "Voc� n�o pode pegar o seu jetpack estando em interior.");

			if(PlayerInfo[playerid][pGunLic] == 0)
			return SendClientMessage(playerid, COR_GRAD1, "Voc� n�o possui licencas de armas por isso nao pode usar jetpack !");

			if(PlayerInfo[playerid][pSocio] >= 1)
			{
				TempoPegarJetpack[playerid] = GetTickCount();
				SetPlayerSpecialAction(playerid, 2);
				GivePlayerWeaponEx(playerid, 22, 2000);
				GetPlayerName(playerid, sendername, sizeof(sendername));
				new drank[20];
				if(PlayerInfo[playerid][pSocio] == 1) { drank = "Esmeralda"; }
				else if(PlayerInfo[playerid][pSocio] == 2) { drank = "Black Rubi"; }
				else if(PlayerInfo[playerid][pSocio] == 3) { drank = "Patrocinador"; }
				SendClientMessage(playerid,COR_GREEN,"Voc� pegou o seu Jet Pack!");
				if(PlayerInfo[playerid][pSocio] < 3)
				{
					format(stringZCMD, sizeof(stringZCMD), "[%s]: %s Pegou Seu Jet Pack.", drank, sendername);
					ProxDetector(30.0, playerid, stringZCMD, 0x33aa33ff,0x33aa33ff,0x33aa33ff,0x33aa33ff,0x33aa33ff);
				}
				else
				{
					format(stringZCMD, sizeof(stringZCMD), "[%s]: %s Pegou Seu Jet Pack.", drank, sendername);
					ProxDetector(30.0, playerid, stringZCMD, 0xffcc00ff,0xffcc00ff,0xffcc00ff,0xffcc00ff,0xffcc00ff);
				}
				return 1;
			}
			//else return SendClientMessage(playerid, COR_AMARELO, "Voc� n�o � um s�cio ou n�o tem jetpack permanente.");
		}
		return 1;
	}
	CMD:mudarsexo(playerid, params[])
	{
		if(IsPlayerInAnyVehicle(playerid))
		{
			if(GetPlayerOrg(playerid) != 4)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o � m�dico!");
				return 1;
			}
			new vehicleid = GetPlayerVehicleID(playerid);
			new modeloo = GetVehicleModel(vehicleid);
			if(modeloo != 416 && modeloo != 407 && modeloo != 468)
			{
				SendClientMessage(playerid,COR_VERMELHO,"* Voc� n�o est� em uma ambulancia");
				return 1;
			}
			new playa;
			new money;
			if(sscanf(params, "ud", playa, money))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /mudarsexo [id] [preco]");
				return 1;
			}
			if(money < 1 || money > 5000) { SendClientMessage(playerid, COR_GREY, "Preco minimo 1, preco maximo 5000!"); return 1; }
			if(IsPlayerConnected(playa))
			{
				if(playa != INVALID_PLAYER_ID)
				{
					if(ProxDetectorS(8.0, playerid, playa) && IsPlayerInAnyVehicle(playa))
					{
						if(playa == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode mudar seu sexo !"); return 1; }
						GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						format(stringZCMD, sizeof(stringZCMD), "* Voc� ofereceu ao jogador: %s para mudar o sexo dele por R$[%d].",giveplayerZCMD,money);
						SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "* M�dico %s ofereceu mudar seu sexo por R$[%d], (Digite /aceitar sexo) para aceitar.",sendername,money);
						SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
						SexoOffer[playa] = playerid;
						SexoPrice[playa] = money;
					}
					else
					{
						SendClientMessage(playerid, COR_GREY, "Este jogador nao esta perto de Voc� ou nao esta no carro.");
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GREY, "* Voc� n�o est� em uma ambulancia !");
			}
		}
		return 1;
	}
