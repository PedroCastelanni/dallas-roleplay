	        strcat(MEGAString, string);
			ShowPlayerDialog(playerid, DSFUNCAO, DIALOG_STYLE_MSGBOX, xgstring, MEGAString, "Fechar","");
		}
		else if(PlayerInfo[playerid][pTipoRG] == 0)
		{
		    if(targetid == playerid)
			{
				GetPlayerName(playerid, sendername, MAX_PLAYER_NAME);
				format(xgstring, sizeof(xgstring), "{FFFF00}Personagem: %s", sendername);
				SendClientMessage(playerid, COR_AMARELO, xgstring);
			}
			else
