	CMD:ligar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerMutado[playerid] == 1)
			{
				SendClientMessage(playerid, TEAM_CYAN_COR, "Voc� n�o pode falar, pois foi calado !");
				return 1;
			}
			new phonenumb;
			if(sscanf(params, "d", phonenumb))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /ligar [Telefone]");
				return 1;
			}
			if(PlayerInfo[playerid][pConnectTime] <  1)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� deve ter 1+ horas jogadas, para efetuar liga��es !");
				return 1;
			}
			if(PlayerInfo[playerid][pPnumber] == 0)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem um celular");
				return 1;
			}
			if(PlayerInfo[playerid][pJailed] != 0)
			{
				SendClientMessage(playerid,COR_AMARELO," Voc� n�o pode ligar na cadeia !");
				return 1;
			}
			if(PlayerInfo[playerid][pCreditos] < 2)
			{
				SendClientMessage(playerid, COR_GREY, "Voce n�o tem cr�ditos suficientes, compre mais na 24-7!");
				return 1;
			}
			GetPlayerName(playerid, sendername, sizeof(sendername));
			format(stringZCMD, sizeof(stringZCMD), "* %s pega o celular e faz uma liga��o.", sendername);
			ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
			SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
			SetPlayerAttachedObject(playerid,9,18870,2,0.033999,0.015000,-0.112999,-2.000003,-1.100000,38.400005,1.000000,1.000000,1.000000);
			if(phonenumb == 0)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� est� ligando para Ninguem !");
				RemovePlayerAttachedObject(playerid, 9);
				return 1;
			}
			if(phonenumb == PlayerInfo[playerid][pPnumber])
			{
				SendClientMessage(playerid, COR_GRAD2, "Voce n�o pode ligar para s� mesmo !");
				RemovePlayerAttachedObject(playerid, 9);
				return 1;
			}
			if(Mobile[playerid] != 255)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� ja est� em uma liga��o !");
				RemovePlayerAttachedObject(playerid, 9);
				return 1;
			}
			foreach(new i: Player)
			{
				if(IsPlayerConnected(i))
				{
					if(PlayerInfo[i][pPnumber] == phonenumb && phonenumb != 0)
					{
						sscanfid = i;
						Mobile[playerid] = sscanfid; //caller connecting
						if(IsPlayerConnected(sscanfid))
						{
							if(sscanfid != INVALID_PLAYER_ID)
							{
								if(PhoneOnline[sscanfid] > 0)
								{
									SendClientMessage(playerid, COR_GREY, "O celular chamado est� fora da �rea de cobertura ou est� desligado !");
									RemovePlayerAttachedObject(playerid, 9);
									return 1;
								}
								if(PlayerInfo[sscanfid][pJailed] != 0)
								{
									SendClientMessage(playerid,COR_GRAD2,"O jogador que voc� tentou ligar est� preso, n�o pode receber liga��es !");
									RemovePlayerAttachedObject(playerid, 9);
									return 1;
								}
								if(Sequestrado[sscanfid] == 1)
								{
									SendClientMessage(playerid, COR_GRAD1, "O jogador que voc� tentou igar est� calado ou sequestrado, n�o pode receber liga��es !");
									RemovePlayerAttachedObject(playerid, 9);
									return 1;
								}
								if (Mobile[sscanfid] == 255)
								{
									format(stringZCMD, sizeof(stringZCMD), "[Celular] %s est� ligando para o seu celular, use: /at.", sendername);
									SendClientMessage(sscanfid, COR_AMARELO, stringZCMD);
									GetPlayerName(sscanfid, sendername, sizeof(sendername));
									PlayerPlaySound(playerid, 39047, 0.0, 0.0, 10.0);
									RingTone[sscanfid] = 10;
									format(stringZCMD, sizeof(stringZCMD), "* %s's est� tocando o celular.", sendername);
									PlayerPlaySound(sscanfid, 39052, 0.0, 0.0, 0.0);
									PlayerPlaySound(playerid, 39052, 0.0, 0.0, 0.0);
									format(stringZCMD, sizeof(stringZCMD), "* %s pega o celular e faz uma liga��o.", sendername);
									ProxDetector(30.0, i, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
									SendClientMessage(playerid, COR_BALLAS, "[RCK]: Use 'T' para falar, digite /des para desligar");
									CellTime[playerid] = 1;
									GameTextForPlayer(playerid,"~r~ -2 Creditos", 5000, 1);
									PlayerInfo[playerid][pCreditos] -= 2;
									SBizzInfo[7][sbTill] += 1000;
									ExtortionSBiz(7, 1000);
									new Conta = CofreOrg[7][Dinheiro] + 500;
									DepositarGranaOrg(7, Conta);
									return 1;
								}
							}
						}
					}
				}
			}
			SendClientMessage(playerid, COR_GRAD2, "O N�mero que voc� ligou est� ocupado !");
		}
		return 1;
	}
	CMD:sms(playerid, params[])
	{
		if(PlayerMutado[playerid] == 1)
		{
			SendClientMessage(playerid, TEAM_CYAN_COR, "Voc� n�o pode falar, pois foi calado !");
			return 1;
		}
		if(IsPlayerConnected(playerid))
		{
			if(gPlayerLogged[playerid] == 0)
			{
				SendClientMessage(playerid, COR_GREY, "Voce n�o est� logado!");
				return 1;
			}
			if(PlayerInfo[playerid][pConnectTime] <  1)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� deve ter 1+ horas jogadas, para efetuar liga��es !");
				return 1;
			}
			if(PlayerInfo[playerid][pCreditos] < 1)
			{
				SendClientMessage(playerid, COR_GREY, "Voce n�o tem cr�ditos suficientes compre mais na 24-7!");
				return 1;
			}
			if(PlayerInfo[playerid][pJailed] != 0)
			{
				SendClientMessage(playerid,COR_AMARELO," Voc� n�o pode manda sms na cadeia !");
				return 1;
			}
			if(PlayerInfo[playerid][pPnumber] == 0)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem um celular, compre um na 24/7 !");
				return 1;
			}
			GetPlayerName(playerid, sendername, sizeof(sendername));
			format(stringZCMD, sizeof(stringZCMD), "* %s pegou o celular e enviou um sms.", sendername);
			ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
			new result[64], phonenumb;
			if(sscanf(params, "ds[64]", phonenumb, result))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /sms [telefone] [texto]");
				return true;
			}
			foreach(new i: Player)
			{
				if(IsPlayerConnected(i))
				{
					if(PlayerInfo[i][pPnumber] == phonenumb && phonenumb != 0)
					{
						sscanfid = i;
						Mobile[playerid] = sscanfid; //caller connecting
						if(IsPlayerConnected(sscanfid))
						{
							if(sscanfid != INVALID_PLAYER_ID)
							{
								if(GetTickCount() - TempoChatSMS[playerid] < 3000)
								{
									SendClientMessage(playerid,COR_GRAD1,"Voc� s� pode escrever uma mensagem a cada 3 segundos.");
									return 1;
								}
								if(PhoneOnline[sscanfid] > 0)
								{
									SendClientMessage(playerid, COR_GREY, "Falha ao enviar o sms!");
									return 1;
								}
								if(PlayerInfo[sscanfid][pJailed] != 0)
								{
									SendClientMessage(playerid,COR_GRAD2,"O jogador que voc� tentou enviar sms est� preso, n�o pode receber mensagens !");
									return 1;
								}
								if(TentouDivulgar(result))
								{
									GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
									format(stringZCMD, 128, "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
									ABroadCast(COR_AMARELO,stringZCMD,1);
									DivulgouLog(stringZCMD);
									return 1;
								}
								if(sscanfid != playerid)
								{
									new gmsg[255];
									format(gmsg, sizeof(gmsg), "PLAYER(%s[%d]) - Para(%s[%d]) SMS: %s", PlayerName(playerid), playerid, PlayerName(sscanfid), sscanfid, (result));
									SpyAll(COR_AMARELO, gmsg);
								}
								TempoChatSMS[playerid] = GetTickCount();
								format(stringZCMD, sizeof(stringZCMD), "SMS: %s, enviou: %s - CEL:[%d]", result,sendername,PlayerInfo[playerid][pPnumber]);
								SendClientMessage(sscanfid, COR_AMARELO, stringZCMD);
								SendClientMessage(playerid,  COR_AMARELO, stringZCMD);
								SMSLog(stringZCMD);
								format(stringZCMD, sizeof(stringZCMD), "SmsAviso: %s[%d], enviou: %s - Para: %s[%d]",PlayerName(playerid),playerid,result,PlayerName(sscanfid),sscanfid);
								SpySMS(COR_AMARELO, playerid, stringZCMD);
								GetPlayerName(sscanfid, sendername, sizeof(sendername));
								RingTone[sscanfid] = 20;
								SendClientMessage(playerid, COR_BRANCO, "SMS Enviado.");
								print(stringZCMD);
								GameTextForPlayer(playerid,"~r~ -1 Credito", 5000, 1);
								PlayerInfo[playerid][pCreditos] -= 1;
								SBizzInfo[7][sbTill] += 50;
								ExtortionSBiz(7, 50);
								new Conta = CofreOrg[7][Dinheiro] + 25;
								DepositarGranaOrg(7, Conta);
								PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
								Mobile[playerid] = 255;
								format(stringZCMD, sizeof(stringZCMD), "[%d/%d/%d] [%d:%d:%d] SMS: %s, enviou: %s para %s", v[2], v[1], v[0], v[3], v[4], v[5], result,playernameZCMD,sendername);
								return 1;
							}
						}
					}
				}
			}
			SendClientMessage(playerid, COR_GRAD2, " Falha ao enviar a mensagem!");
		}
		return 1;
	}
