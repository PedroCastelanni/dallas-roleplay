	CMD:darprocurado(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pAdmin] < 1340)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o tem autoriza��o para usar esse comando.");
				return 1;
			}
			if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			new para1;
			new procura;
			if(sscanf(params, "ud", para1, procura))
			{
				SendClientMessage(playerid, COR_GREY, "/darprocurado [id] [n�vel]");
				return 1;
			}
			if(IsPlayerConnected(para1))
			{
				if(para1 != INVALID_PLAYER_ID)
				{
					WantedLevel[para1] += procura;
					SetPlayerWantedLevelEx(para1, WantedLevel[para1]);
					format(stringZCMD, sizeof(stringZCMD), "{9370DB}!{FFFFFF} %s setou [%d] de procurado no(a) %s.",PlayerName(playerid), procura, PlayerName(para1));
					ABroadCast(COR_LIGHTRED, stringZCMD,1);
					format(stringZCMD, sizeof(stringZCMD), "Voc� foi setado com [%d] n�vel de procura pelo Administrador %s.", procura);
					SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
				}
			}
		}
		return 1;
	}
	CMD:retirarprocura(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] < 1340)
		{
			SendClientMessage(playerid, COR_GRAD1, "Voc� n�o tem autoriza��o para usar esse comando.");
			return 1;
		}
		if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
		{
			SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
			return 1;
		}
		new para1;
		new rprocura;
		if(sscanf(params, "ud", para1, rprocura))
		{
			SendClientMessage(playerid, COR_GREY, "/retirarprocura [id] [quantia]");
			return 1;
		}
		if(WantedLevel[para1] == 0)
		{
			SendClientMessage(playerid, COR_GRAD1, "Este jogador n�o est� procurado !");
			return 1;
		}
		if(IsPlayerConnected(para1))
		{
			if(para1 != INVALID_PLAYER_ID)
			{
				WantedLevel[para1] -= rprocura;
				SetPlayerWantedLevelEx(para1, WantedLevel[para1]);
				if(WantedLevel[para1] > 0)
				{
					format(stringZCMD, sizeof(stringZCMD), "P:[%d]",WantedLevel[playerid]);
					SetPlayerChatBubble(para1, stringZCMD, COR_VERMELHO, 45.0, 100000);
				}
				else if(WantedLevel[para1] == 0)
				{
					SetPlayerChatBubble(para1, "*", COR_VERMELHO, 1, 1);
				}
				OnPlayerUpdate(para1);
				format(stringZCMD, sizeof(stringZCMD), "{9370DB}!{FFFFFF} %s removeu [%d] de procurado no %s.",PlayerName(playerid), rprocura, PlayerName(para1));
				ABroadCast(COR_LIGHTRED, stringZCMD,1);
				format(stringZCMD, sizeof(stringZCMD), "* Voc� limpou [%d] nivel de procura do jogador %s.",rprocura, giveplayerZCMD);
				SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
				format(stringZCMD, sizeof(stringZCMD), "* Admin %s: retirou [%d] nivel de procura da sua ficha.",PlayerName(playerid), rprocura);
				SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
			}
		}
		return 1;
	}
	CMD:habilidades(playerid, x_nr[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(isnull(x_nr))
			{
				SendClientMessage(playerid, COR_BRANCO, "|_________________ Habilidades Skill _________________|");
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /Habilidades [numero]");
				SendClientMessage(playerid, COR_GREY, "| 1: Detetive");
				SendClientMessage(playerid, COR_GREY, "| 2: Advogado");
				SendClientMessage(playerid, COR_GREY, "| 3: Vendedor de Drogas");
				SendClientMessage(playerid, COR_BRANCO, "|__________________________________________________|");
				return 1;
			}
			if(strcmp(x_nr,"1",true) == 0)//Detetive
			{
				new level = PlayerInfo[playerid][pDetSkill];
				if(level >= 0 && level <= 50) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 1."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisa procurar mais %d para passar de n�vel.", 10 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 51 && level <= 100) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 2."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisa procurar mais %d para passar de n�vel.", 20 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 101 && level <= 150) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 3."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisa procurar mais %d para passar de n�vel.", 30 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 151 && level <= 200) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 4."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisa procurar mais %d para passar de n�vel.", 40 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 201) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 5(M�ximo)."); }
			}
			else if(strcmp(x_nr,"2",true) == 0)//Advogado
			{
				new level = PlayerInfo[playerid][pLawSkill];
				if(level >= 0 && level <= 50) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 1."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisa soltar mais %d pessoas para passar de n�vel.", 50 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 51 && level <= 100) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 2."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisa soltar mais %d pessoas para passar de n�vel.", 100 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 101 && level <= 200) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 3."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisa soltar mais %d pessoas para passar de n�vel.", 200 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 201 && level <= 300) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 4."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisa soltar mais %d pessoas para passar de n�vel.", 400 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 301) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 5(M�ximo)."); }
			}
			else if(strcmp(x_nr,"3",true) == 0)//Vendedor de Drogas
			{
				new level = PlayerInfo[playerid][pDrogasSkill];
				if(level >= 0 && level <= 50) { SendClientMessage(playerid, COR_AMARELO, "Level de venda de drogas = 1."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisar vender mais %d drogas para passar de nivel.", 50 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 51 && level <= 100) { SendClientMessage(playerid, COR_AMARELO, "Level de venda de drogas = 2."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisar vender mais %d drogas para passar de nivel.", 100 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
				else if(level >= 101 && level <= 150) { SendClientMessage(playerid, COR_AMARELO, "Level de venda de drogas = 3."); format(stringZCMD, sizeof(stringZCMD), "Voc� precisar vender mais %d drogas para passar de nivel.", 200 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
