TPL::CobrarImposto()
{
		new valorimposto;
		valorimposto = 2200;
		for(new i = 0; i < MAX_HOUSES; ++i)
	 	{
	 	    if(HouseInfo[i][hOwned] == 1)
			{
			    if(HouseInfo[i][hTakings] > valorimposto)
			    {
			        HouseInfo[i][hTakings] -= valorimposto;
					DepositarGranaOrg(7, valorimposto);
			    }
			    else
			    {
                    VenderCasa();
                    SaveCasas();
			    }
			}
		}
		//VenderEmp();
    	//SalvarEmpresas();
     	//SalvarSEmpresas();
	    return 1;
}
TPL::VenderCasa()
{
     new valorimposto;
     valorimposto = 2200;
     for(new i = 0; i < MAX_HOUSES; ++i)
     {
          if(HouseInfo[i][hOwned] == 1)
		  {
		       if(HouseInfo[i][hTakings] < valorimposto)
		       {
                    new File:hFile;
                    new string[128];
	                hFile = fopen("Logs/CasaVendida.log", io_append);
	                format(string, sizeof(string), "A casa de %s foi vendida por falta de dinheiro no cofre.\n", HouseInfo[i][hOwner]);
	                fwrite(hFile, string);
	                fclose(hFile);
	                HouseInfo[i][hTakings] = 0;
   		            HouseInfo[i][hHel] = 0;
                    HouseInfo[i][hArm] = 0;
                    HouseInfo[i][hHealthx] = 0;
                    HouseInfo[i][hHealthy] = 0;
                    HouseInfo[i][hHealthz] = 0;
                    HouseInfo[i][hArmorrx] = 0;
                    HouseInfo[i][hArmorry] = 0;
                    HouseInfo[i][hArmorrz] = 0;
                    HouseInfo[i][hLock] = 1;
                    HouseInfo[i][hOwned] = 0;
                    HouseInfo[i][hVec] = 475;
                    HouseInfo[i][hVcol1] = -1;
                    HouseInfo[i][hVcol2] = -1;
                    strmid(HouseInfo[i][hOwner], "O estado", 0, strlen("O estado"), 999);
  	                new casavendida[255];
                    format(casavendida, sizeof(casavendida), "RCK SERVER: A Casa %d foi vendida automaticamente por falta de dinheiro no cofre !", HouseInfo[i][hWorld]);
                    SendClientMessageToAll(COR_LIGHTRED, casavendida);
                    Atualizar3Dtexts();
               }
         }
     }
     return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
     if(success)
     {
          new pip[16];
          new string[128];
          foreach(new i: Player)
          {
               GetPlayerName(i, sendername, sizeof(sendername));
               GetPlayerIp(i, pip, sizeof(pip));
               if(!strcmp(ip, pip, true))
               {
                    if(strcmp(sendername,"Apxgui", true) == 0)
                    {
                        format(string, sizeof(string), "Bem Vindo, %s, Logado com Sucesso !", sendername);
                        SendClientMessage(i, COR_BRANCO, string);
                        return true;
                    }
                    else
                    {
                         format(string, sizeof(string), "%s teve o ip banido por tentar logar na rcon do servidor!", sendername);
                         ABroadCast(COR_LIGHTRED,string,1);
                         BanRconLog(string);
                         BanEx(i, "RconLogin");
                    }
                }
          }
     }
     return 1;
}
TPL::CheckarPosicao(playerid,giveplayerid,Float:X,Float:Y,Float:Z)
{
    new string[128];
	new Float:Position[3];
	GetPlayerPos(giveplayerid,Position[0],Position[1],Position[2]);
	if (Position[0] == X && Position[1] == Y && Position[2] == Z)
	{
	     if(GetPlayerOrg(playerid) == 8 || GetPlayerOrg(playerid) == 26)
	     {
	         format(string,128,"[ANTI-ESC] Jogador %s[%d] foi kickado por estar de ESC. Acusador: %s[%d].",PlayerName(giveplayerid),giveplayerid,PlayerName(playerid),playerid);
	         SendClientMessageToAll(COR_VERMELHO,string);
			 GotHit[giveplayerid] = 0;
	 	     PlayerInfo[giveplayerid][pHeadValue] = 0;
	         GetChased[giveplayerid] = 999;
	         GoChase[playerid] = 999;
			 Kick(giveplayerid);
		 }
		 else if(IsACop(playerid))
		 {
			 PlayerInfo[giveplayerid][pJailed] = 1;
			 PlayerInfo[giveplayerid][pJailTime] = (WantedLevel[giveplayerid])*(360);
       		 WantedLevel[giveplayerid] = 0;
       		 //PlayerInfo[giveplayerid][pDina] = 0;
       		 SetPlayerWantedLevelEx(giveplayerid, 0);
			 for(new i=0; i<75; i++)
			 {
					if(InventarioInfo[playerid][i][iSlot] == 1578)
					{
	 					InventarioInfo[playerid][i][iSlot] = 19382;
		    			InventarioInfo[playerid][i][iUnidades] = 0;
					}
					if(InventarioInfo[playerid][i][iSlot] == 1279)
					{
						InventarioInfo[playerid][i][iSlot] = 19382;
		    			InventarioInfo[playerid][i][iUnidades] = 0;
					}
					if(InventarioInfo[playerid][i][iSlot] == 1575)
					{
						InventarioInfo[playerid][i][iSlot] = 19382;
		    			InventarioInfo[playerid][i][iUnidades] = 0;
					}
					if(InventarioInfo[playerid][i][iSlot] == 1576)
					{
	 					InventarioInfo[playerid][i][iSlot] = 19382;
		    			InventarioInfo[playerid][i][iUnidades] = 0;
					}
	         }
             PlayerInfo[giveplayerid][pMats] = 0;
             PlayerInfo[giveplayerid][pPreso] ++;
             if(IsPlayerInLS(playerid))
             {
                PlayerInfo[giveplayerid][pPenitenciaria] = 1;
             }
             SetPlayerChatBubble(giveplayerid, ".", COR_VERMELHO, 1, 1);
		     format(string,128,"[ANTI-ESC] Jogador %s[%d] foi kickado por estar de ESC. Acusador: %s[%d].",PlayerName(giveplayerid),giveplayerid,PlayerName(playerid),playerid);
	         SendClientMessageToAll(COR_VERMELHO,string);
	         format(string, sizeof(string), "[Esc Procurado] %s prendeu o suspeito: %s, Crimes:[%d] Tempo:[%d].",PlayerName(playerid),PlayerName(giveplayerid),WantedLevel[giveplayerid],PlayerInfo[giveplayerid][pJailTime]);
             GivePlayerMoneyEx(playerid, 1000);
             SendFamilyMessage(1, COR_LIGHTBLUE, string);
             SendFamilyMessage(2, COR_LIGHTBLUE, string);
             SendFamilyMessage(3, COR_LIGHTBLUE, string);
             SendFamilyMessage(4, COR_LIGHTBLUE, string);
             SendFamilyMessage(7, COR_LIGHTBLUE, string);
             SendFamilyMessage(11, COR_LIGHTBLUE, string);
             SendFamilyMessage(16, COR_LIGHTBLUE, string);
             SendFamilyMessage(23, COR_LIGHTBLUE, string);
             SendFamilyMessage(25, COR_LIGHTBLUE, string);
             SendEmpregoMessage(7, COR_LIGHTBLUE, string);
             SendClientMessage(playerid, COR_LIGHTRED, "Voc� recebeu R$1000 por kickar um jogador de esc procurado.");
             format(string, sizeof(string), "Oficial: %s lhe prendeu por %d segundos e voc� foi kickado por estar de esc procurado.",PlayerName(playerid),PlayerInfo[giveplayerid][pJailTime]);
			 SendClientMessage(giveplayerid, COR_LIGHTRED, string);
			 Kick(giveplayerid);
		 }
		 else if(PlayerInfo[playerid][pEmprego] == 7)
		 {
		     SendClientMessage(playerid, COR_AMARELO, "Voc� kickou o detento de ESC e R$200 foram adicionados em seu sal�rio.");
			 PlayerInfo[playerid][pSalario] += 200;
			 GotHit[giveplayerid] = 0;
    		 PlayerInfo[giveplayerid][pHeadValue] = 0;
     		 GetChased[giveplayerid] = 999;
       		 GoChase[playerid] = 999;
		     Kick(giveplayerid);
		 }
		 else if(IsPlayerInTerritorio(playerid))
	     {
	         format(string,128,"[ANTI-ESC] Jogador %s[%d] foi kickado por estar de ESC. Acusador: %s[%d].",PlayerName(giveplayerid),giveplayerid,PlayerName(playerid),playerid);
	         SendClientMessageToAll(COR_VERMELHO,string);
			 GotHit[giveplayerid] = 0;
	 	     PlayerInfo[giveplayerid][pHeadValue] = 0;
	         GetChased[giveplayerid] = 999;
	         GoChase[playerid] = 999;
			 Kick(giveplayerid);
		 }
	}
	else
	{
	     format(string,128,"[ANTI-ESC] O Jogador %s[%d] foi avisado que voc� n�o est� de ESC.",PlayerName(playerid),playerid);
		 SendClientMessage(giveplayerid,COR_VERMELHO,string);
	     format(string,128,"[ANTI-ESC] O Jogador %s[%d] n�o est� de ESC.",PlayerName(giveplayerid),giveplayerid);
		 SendClientMessage(playerid,COR_VERMELHO,string);
	}
}
TPL::Float:SetPlayerToFacePos(playerid, Float:X, Float:Y)
{
	new Float:pX,Float:pY,Float:pZ,Float:ang;
	if(!IsPlayerConnected(playerid))
	{
	     return 0.0;
	}
	GetPlayerPos(playerid, pX, pY, pZ);
	if( Y > pY )
	{
	     ang = (-acos((X - pX) / floatsqroot((X - pX)*(X - pX) + (Y - pY)*(Y - pY))) - 90.0);
	}
	else if( Y < pY && X < pX )
	{
	     ang = (acos((X - pX) / floatsqroot((X - pX)*(X - pX) + (Y - pY)*(Y - pY))) - 450.0);
	}
	else if( Y < pY )
	{
	     ang = (acos((X - pX) / floatsqroot((X - pX)*(X - pX) + (Y - pY)*(Y - pY))) - 90.0);
	}
	if(X > pX)
	{
         ang = (floatabs(floatabs(ang) + 180.0));
    }
	else
	{
	     ang = (floatabs(ang) - 180.0);
	}
	ang += 180.0;
	SetPlayerFacingAngle(playerid, ang);
 	return ang;
}
