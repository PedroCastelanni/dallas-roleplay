	CMD:largararma(playerid)
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;

		if(gettime() < GetPVarInt(playerid, #VarFlood17))
		    return SendClientMessage(playerid, COR_GRAD1, #Voc� n�o pode usar este comando com tanta frequencia);
		SetPVarInt(playerid, #VarFlood17, gettime()+5);

  		if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_CUFFED){

			return SendClientMessage(playerid, COR_GREY, " Voc� n�o pode usar este comando agora !");
   		}

		switch(GetPlayerWeapon(playerid)){

		    case 16, 18, 44, 45, 35:
		        return SendClientMessage(playerid, COR_GREY, " Voc� n�o pode largar esta arma !");
		}
        new GunID = GetPlayerWeapon(playerid);
        new GunAmmo = GetPlayerAmmo(playerid);
        new Float:x, Float:y, Float:z;
        if(GunID > 0 && GunAmmo != 0)
        {
            new f = MAX_OBJ+1;
            for(new a = 0; a < MAX_OBJ; a++)
            {
                if(dItemData[a][ObjtPos][0] == 0.0)
                {
                    f = a;
                    break;
                }
            }
            if(f > MAX_OBJ) return SendClientMessage(playerid, 0x33AA3300, "Voc� n�o pode largar esta arma no momento, tente novamente mais tarde!");
			RemovePlayerWeapon(playerid, GunID);
			GetPlayerPos(playerid, x, y, z);
			new ObjGun = IdDaArma(GunID);
			CreateDroppedItem(ObjGun, GunAmmo, x, y, z);
            ApplyAnimation(playerid,"BOMBER","BOM_Plant_2Idle",4.1,0,1,1,0,0);
			new buffer[85];
			format(buffer, sizeof(buffer), "Voc� largou um(a) %s.", NomeDaArma(ObjGun));
			SendClientMessage(playerid, 0x33AA3300, buffer);
			format(buffer, sizeof(buffer), "*%s colocou um(a) %s no ch�o.", PlayerName(playerid), NomeDaArma(ObjGun));
			ProxDetector(30.0, playerid, buffer, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
			printf("%s", buffer);
        }
        return 1;
    }
	CMD:livrarmateriais(playerid, params[])
	{
		if(PlayerInfo[playerid][pMats] > 0)
		{
			PlayerInfo[playerid][pMats] = 0;
			format(stringZCMD, sizeof(stringZCMD), "Jogador: %s jogou os materiais fora.", PlayerName(playerid));
			ProxDetector(30.0, playerid, stringZCMD, COR_AZUL,COR_AZUL,COR_AZUL,COR_AZUL,COR_AZUL);
		}
		else
		{
