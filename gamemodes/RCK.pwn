   				SendClientMessage(playerid,COR_GREEN,"Voc� utilizou o estepe do seu veiculo!");
        		format(stringZCMD, sizeof(stringZCMD), "S�cio: %s utilizou o estepe veicular.", sendername);
        		ProxDetector(30.0, playerid, stringZCMD, COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE);
        		TempoUsarEstepe[playerid] = GetTickCount();
				return 1;
			}
			else
			{
			    SendClientMessage(playerid, COR_AMARELO, "Voc� n�o � um s�cio!");
			    return 1;
			}
	    }
	    return 1;
	}
	CMD:schatduvida(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] >= 1340)
		{
			if(ChatNoob == false)
			{
                format(stringZCMD, sizeof(stringZCMD), "[RCK SERVER] Chat d�vidas foi desativado do servidor.");
                SendClientMessageToAll(COR_AMARELO, stringZCMD);
				ChatNoob = true;
				return 1;
			}
			else if(ChatNoob == true)
			{
   				format(stringZCMD, sizeof(stringZCMD), "[RCK SERVER] Chat d�vidas foi ativado do servidor.");
                SendClientMessageToAll(COR_AMARELO, stringZCMD);
			    ChatNoob = false;
			    return 1;
			}
		}
		return 1;
	}
	CMD:boasvindas(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] >= 1342)
		{
            new playa;
			if(sscanf(params, "u", playa))
			{
				SendClientMessage(playerid, COR_LIGHTRED, "Digite: /boasvindas [id]");
				return 1;
			}
			if(PlayerInfo[playa][pLevel] > 5) return SendClientMessage(playerid, COR_GRAD2, "As boas vindas s�o s� para novatos!");
			PlayerInfo[playa][pLevel] += 2;
			PlayerInfo[playa][pCoins] += 10;
			PlayerInfo[playa][pConta] += 20000;
			ScoreLevel(playa);
			if(PlayerInfo[playa][pDiaVIP] == 0)
			{
			    PlayerInfo[playa][pDiaVIP] = 3;
			    PlayerInfo[playa][pSocio] = 1;
			}
			format(stringZCMD, sizeof(stringZCMD), "{0099ff}� AdminCMD: Administrador {ffffff}%s {0099ff}deu as boas-vindas, ao jogador {ffffff}%s.", PlayerName(playerid), PlayerName(playa));
   			ABroadCast(COR_LIGHTBLUE, stringZCMD, 1);
   			SendClientMessage(playa, COR_LIGHTBLUE, "{00FF00}:){FFFFFF}MUITO {00FF00}BEM-VINDO {FFFFFF}PARABENS PELO PREMIO{FF0000}[VOCE ACABA DE GANHAR 10 LEVEL, 10 COINS, 100 MIL E 3 DIAS DE Esmeralda]!!! ");
		}
		return 1;
	}
