				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� autorizado a usar este comando!");
			}
		}
		return 1;
	}
	///rarmasall
	CMD:calar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new playa;
			if(sscanf(params, "u", playa))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /calar [id]");
				return 1;
			}
			if (PlayerInfo[playerid][pAdmin] >= 1)
			{
				if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
					return 1;
				}
				if(IsPlayerConnected(playa))
				{
					if(playa != INVALID_PLAYER_ID)
					{
						if(PlayerInfo[playa][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] != 1342)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode calar um Admin Dono !");
							return 1;
						}
						if(strcmp(PlayerName(playa),"Apxgui", true) == 0 && playerid != sscanfid)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode calar o Apxgui!");
							format(gstring, sizeof(gstring), "%d", playerid);
							ForT:calar(sscanfid, gstring);
							return 1;
						}
						GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						if(PlayerMutado[playa] == 0)
						{
							PlayerMutado[playa] = 1;
							printf("ADMIN CMD: %s calou %s",sendername,  giveplayerZCMD);
							format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi calado por %s",giveplayerZCMD ,sendername);
							ABroadCast(COR_LIGHTRED,stringZCMD,1);
						}
						else
						{
							PlayerMutado[playa] = 0;
							printf("ADMIN CMD: %s descalou %s",sendername,  giveplayerZCMD);
							format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi descalado por %s",giveplayerZCMD ,sendername);
							ABroadCast(COR_LIGHTRED,stringZCMD,1);
						}
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o esta autorizado a usar este comando!");
			}
		}
		return 1;
	}
	CMD:testegod(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new playa;
