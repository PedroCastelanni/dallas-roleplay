				new payout = guncharge + ammocharge;
				if(location == 102 && IsACop(playerid)) { }
				else { GivePlayerMoneyEx(playerid, - payout); }
				BizzInfo[6][bTill] += payout;
				ExtortionBiz(6, payout);
				BizzInfo[0][bTill] += payout;
				ExtortionBiz(0, 2000);
				BizzInfo[1][bTill] += payout;
				ExtortionBiz(1, payout);
				new Conta = CofreOrg[7][Dinheiro] + payout;
				DepositarGranaOrg(7, Conta);
				PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
				if(formadinheiro[playerid] == 1)
				{
					GivePlayerWeaponEx(playerid, gun, ammo);
					format(gstring, 128, "Voc� comprou um(a) %s com %d bala(s) por R$[%d] com seu dinheiro.",gunid,ammo,payout);
					SendClientMessage(playerid, COR_GRAD1, gstring);
				}
				else if(formacartao[playerid] == 1)
				{
					PlayerInfo[playerid][pConta] -= ammo;
					PlayerInfo[playerid][pConta] -= gun;
					format(gstring, 128, "Voc� comprou um(a) %s com %d bala(s) por R$[%d] com seu cart�o de d�bito.",gunid,ammo,payout);
					SendClientMessage(playerid, COR_GRAD1, gstring);
				}
				formacartao[playerid] = 0;
				formadinheiro[playerid] = 0;
				GivePlayerWeaponEx(playerid, gun, ammo);
				GetPlayerName(playerid, sendername, sizeof(sendername));
				format(stringZCMD, sizeof(stringZCMD), "%s comprou armas por R$%d na empresa %d", sendername, payout, location-99);
				printf("%s", stringZCMD);
				GranaLog(stringZCMD);
			}
			else
			{
				SendClientMessage(playerid, COR_BRANCO,"Sem Equipamento de Venda.");
				return 1;
			}
		}
		return 1;
	}
	CMD:registrar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(gPlayerLogged[playerid] == 1)
			{
				SendClientMessage(playerid, COR_GREY, " Voc� j� est� logado.");
				return 1;
			}
			new loginstring[255];
			GetPlayerName(playerid, sendername, sizeof(sendername));
			new Query[64];
			format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(sendername));
			Resultado = db_query(Conexao,Query);
			if(db_num_rows(Resultado) > 0)
			{
				SendClientMessage(playerid, 0xFF0000FF, "[RCK]: Este Nick j� existe, use outro por favor.");
				format(loginstring,sizeof(loginstring),"{FC0000}Voc� n�o � registrado\n\n{FFFFFF}Ol� {07C3F7}%s,\n {FFFFFF}Voc� n�o est� cadastrado em nosso servidor.\n\n{FFFFFF}Cadastre-se agora, e venha se divertir!\n\nVisite nosso site: {00F200}https://discord.gg/SNrbT9QRhw", PlayerName(playerid));
				ShowPlayerDialog(playerid, 2, DIALOG_STYLE_PASSWORD,"N�o Registrado",loginstring,"Registrar","Esperar");
				return 1;
			}
			new tmppass[64];
			if(!strlen(params))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /registrar [Senha]");
				SendClientMessage(playerid, COR_AMARELO, "-==> Use Nome_Sobrenome ( Ex: DeaN_Josh ) <==-");
				format(loginstring,sizeof(loginstring),"{FC0000}Voc� n�o � registrado\n\n{FFFFFF}Ol� {07C3F7}%s,\n {FFFFFF}Voc� n�o est� cadastrado em nosso servidor.\n\n{FFFFFF}Cadastre-se agora, e venha se divertir!\n\nVisite nosso site: {00F200}https://discord.gg/SNrbT9QRhw", PlayerName(playerid));
				ShowPlayerDialog(playerid, 2, DIALOG_STYLE_PASSWORD,"N�o Registrado",loginstring,"Registrar","Esperar");
				return 1;
			}
			strmid(tmppass, params, 0, strlen(params), 255);
			Encrypt(tmppass);
			OnPlayerRegister(playerid,tmppass);
		}
		return 1;
	}
	CMD:mudarsenha(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(gPlayerLogged[playerid] == 0)
			{
				SendClientMessage(playerid,COR_GRAD1,"Voc� n�o est� logado !");
				return 1;
			}
			if(MudarSenhaAceito[playerid] == 0)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� autorizado,fale com um admin master!");
				return 1;
			}
			GetPlayerName(playerid,sendername,sizeof(sendername));
			if(isnull(params))
			{
				SendClientMessage(playerid,COR_GRAD1,"{0099ff}�{ffffff} USE: /mudarsenha [Nova Senha]");
				SendClientMessage(playerid,COR_GRAD1,"Guarde a senha ou tire SS da tela apertando F8 para n�o esquecer!");
				return 1;
			}
			if(strlen(params) < 3 || strlen(params) > 16)
			{
				return SendClientMessage(playerid, COR_AMARELO, "A sua senha deve ter entre 3 e 16 digitos!");
			}
			format(stringZCMD, sizeof(stringZCMD), "A sua nova senha agora �: [%s], cuidado para n�o perd�-la.", params);
			SendClientMessage(playerid, COR_BRANCO, stringZCMD);
			strmid(PlayerInfo[playerid][pSenha],params,0,strlen(params),255);
			Encrypt(PlayerInfo[playerid][pSenha]);
			OnPlayerSave(playerid);
			return 1;
		}
		return 1;
	}
	CMD:an(playerid, result[])
	{
		if(PlayerInfo[playerid][pJailed] != 0)
		{
			SendClientMessage(playerid,COR_GRAY,"Voc� est� preso,s� pode anunciar pedindo um Advogado!");
			return 1;
		}
		if(isnull(result))
		{
			SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: (/anl) [texto]");
			return true;
		}
		if(TentouDivulgar(result))
		{
			GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
			format(stringZCMD, 128, "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
			ABroadCast(COR_AMARELO,stringZCMD,1);
			DivulgouLog(stringZCMD);
			return 1;
		}
		if (panuncio == 1)
		{
			SendClientMessage(playerid, COR_GRAD2, "Espere 30 segundos para poder anunciar novamente!");
			return 1;
		}
		if (strlen(result) > 50) return SendClientMessage(playerid, 0xFFFFFFAA, "Limite de caracteres atingido [M�XIMO 50]!");
		GetPlayerName(playerid, sendername, MAX_PLAYER_NAME);
		GivePlayerMoneyEx(playerid, -150);
		SBizzInfo[7][sbTill] += 150;
		ExtortionSBiz(7, 150);
		GameTextForPlayer(playerid, "~r~-R$150", 5000, 5);
		format(stringZCMD, sizeof(stringZCMD), "{4B0082}[{ffffff}O{7CFC00}L{FFA500}X{4B0082}]{ffffff}: %s, Civil: %s[%d] - Telefone (%d) - Level [%d]", result, sendername, playerid, PlayerInfo[playerid][pPnumber], PlayerInfo[playerid][pLevel]);
		if(PlayerInfo[playerid][pSocio] == 1) format(stringZCMD, sizeof(stringZCMD), "{00FFFF}Anuncio Socio-Basico: %s, %s[%d] - Telefone (%d) - Level [%d]", result, sendername, playerid, PlayerInfo[playerid][pPnumber], PlayerInfo[playerid][pLevel]);
 		if(PlayerInfo[playerid][pSocio] == 2) format(stringZCMD, sizeof(stringZCMD), "{FFFF00}Anuncio Socio-prime: %s, %s[%d] - Telefone (%d) - Level [%d]", result, sendername, playerid, PlayerInfo[playerid][pPnumber], PlayerInfo[playerid][pLevel]);
   		if(PlayerInfo[playerid][pSocio] == 3) format(stringZCMD, sizeof(stringZCMD), "{C71585}Anuncio patrocinador: %s, %s[%d] - Telefone (%d) - Level [%d]", result, sendername, playerid, PlayerInfo[playerid][pPnumber], PlayerInfo[playerid][pLevel]);
		SendClientMessageToAll(0x00FF00FF, stringZCMD);
		print(stringZCMD);
		panuncio = 1;
		TempoAn = SetTimer("Anuncio", 15000, 0);
		return 1;
	}
