static stock AbertoFechado(carid)
{
	new txt[75];
	if(VTrancado[carid] == 0)
 	{
		format(txt, sizeof(txt),"A~n~b~n~e~n~r~n~t~n~o");
	}
	else if(VTrancado[carid] == 1)
 	{
        format(txt, sizeof(txt),"~r~t~n~r~n~a~n~n~n~c~n~a~n~d~n~o");
	}
	return txt;
}
