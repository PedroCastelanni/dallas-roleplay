	CMD:admvcarro(playerid, params[])  return ForT:admvc(playerid, params);
	CMD:admvc(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
			new vehid;
			if(sscanf(params, "d", vehid))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /admvcarro [Carro id]");
				return 1;
			}
			if (PlayerInfo[playerid][pAdmin] >= 1338)
			{
				if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
					return 1;
				}
				new arquivo[64];
				format(arquivo, sizeof(arquivo), Pasta_CarrosVIP, vehid);
				if(DOF2_FileExists(arquivo))
				{
					if(IsPlayerOnline(DOF2_GetString(arquivo, "Dono")))
					{
						new idono = GetPlayerID(DOF2_GetString(arquivo, "Dono"));
						PlayerInfo[idono][pCarKey] = 0;
						RemovePlayerFromVehicleEx(idono);
						SetVehiclePos(vehid, 268.6729, 2888.4353, 11.3289);
						SetVehicleVirtualWorld(vehid, 20);
						format(stringZCMD, sizeof(stringZCMD), "O admin: %s, vendeu seu carro vip !",PlayerName(playerid));
						SendClientMessage(idono, COR_AMARELO, stringZCMD);
					}
					else
					{
						new Query[72+MAX_PLAYER_NAME];
						format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(DOF2_GetString(arquivo, "Dono")));
						Resultado = db_query(Conexao,Query);
						if(db_num_rows(Resultado) > 0)
						{
							format(Query, sizeof(Query), "UPDATE `contas` SET `CarroVIP`='0',`OldCarroVIP`='0' WHERE `Nome`='%s'",DB_Escape(DOF2_GetString(arquivo, "Dono")));
							Resultado = db_query(Conexao,Query);
						}
						SetVehiclePos(vehid, 268.6729, 2888.4353, 11.3289);
						SetVehicleVirtualWorld(vehid, 20);
						DOF2_SaveFile();
					}
					DOF2_RemoveFile(arquivo);
					format(stringZCMD, sizeof(stringZCMD), "~w~Voce vendeu este veiculo");
					GameTextForPlayer(playerid, stringZCMD, 10000, 3);
				}
				format(arquivo, sizeof(arquivo), Pasta_CarrosFixo, vehid);
				if(DOF2_FileExists(arquivo))
				{
					if(IsPlayerOnline(DOF2_GetString(arquivo, "Dono")))
					{
						new idono = GetPlayerID(DOF2_GetString(arquivo, "Dono"));
						PlayerInfo[idono][pCarFixo] = 0;
						RemovePlayerFromVehicleEx(idono);
						SetVehiclePos(vehid, 268.6729, 2888.4353, 11.3289);
						SetVehicleVirtualWorld(vehid, 20);
						format(stringZCMD, sizeof(stringZCMD), "O admin: %s, vendeu seu carro fixo !",PlayerName(playerid));
						SendClientMessage(idono, COR_AMARELO, stringZCMD);
					}
					else
					{
						new Query[74+MAX_PLAYER_NAME];
						format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(DOF2_GetString(arquivo, "Dono")));
						Resultado = db_query(Conexao,Query);
						if(db_num_rows(Resultado) > 0)
						{
							format(Query, sizeof(Query), "UPDATE `contas` SET `CarroFIXO`='0',`OldCarroFIXO`='0' WHERE `Nome`='%s'",DB_Escape(DOF2_GetString(arquivo, "Dono")));
							Resultado = db_query(Conexao,Query);
						}
						SetVehiclePos(vehid, 268.6729, 2888.4353, 11.3289);
						SetVehicleVirtualWorld(vehid, 20);
						DOF2_SaveFile();
					}
					DOF2_RemoveFile(arquivo);
					format(stringZCMD, sizeof(stringZCMD), "~w~Voce vendeu este veiculo");
					GameTextForPlayer(playerid, stringZCMD, 10000, 3);
				}
				format(arquivo, sizeof(arquivo), Pasta_CarrosTunados, vehid);
				if(DOF2_FileExists(arquivo))
				{
					DOF2_RemoveFile(arquivo);
				}
				return 1;
			}
			else
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o tem permiss�o para usar esse comando !");
			}
		}
		return 1;
	}
