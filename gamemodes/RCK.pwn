TPL::tempoapagar(playerid)
{
	GivePlayerMoneyEx(playerid, 1000);
	SendClientMessage(playerid, 0xA0A0A0FF, "[INFO]: Voc� recebeu uma quantia de R$1000 no inc�ndio!");
	SendClientMessageToAll(COR_VAGOS, "[AVISO]: A SA:MU n�o apagaram o foco de inc�ndio e o inc�ndio se espalhou!");
	DestroyDynamicObject(FogoID[0]);
	DestroyDynamicObject(FogoID[1]);
	DestroyDynamicObject(FogoID[2]);
	DestroyDynamicObject(FogoID[3]);
	DestroyDynamicObject(FogoID[4]);
	DestroyDynamicObject(FogoID[5]);
	DestroyDynamicObject(FogoID[6]);
	DestroyDynamicObject(FogoID[7]);
	DestroyDynamicObject(FogoID[8]);
	DestroyDynamicObject(FogoID[9]);
	DestroyDynamicObject(FogoID[10]);
	DestroyDynamicObject(FogoID[11]);
	DestroyDynamicObject(FogoID[12]);
	DestroyDynamicObject(FogoID[13]);
	DestroyDynamicObject(FogoID[14]);
	DestroyDynamicObject(FogoID[15]);
	DestroyDynamicObject(FogoID[16]);
	DestroyDynamicObject(FogoID[17]);
	IncendioAcontecendo = false;
	ApagandoIncendio[playerid] = false;
	KillTimer(Foguinho);
	return 1;
}
TPL::ApagarFogo(playerid)
{
     new NickName[MAX_PLAYER_NAME];
	 if(Extintor[playerid] > 0 && ApagandoIncendio[playerid] == true && MeioDeApagar[playerid] > 0 && PlayerInfo[playerid][pMembro] == 4 || PlayerInfo[playerid][pLider] == 4)
	 {
	      if(MeioDeApagar[playerid] == EXTINTOR)
	      {
               for(new e = 0; e < 17; e++)
			   {
			        if(IsPlayerInRangeOfPoint(playerid, 20.0, FogoX[e], FogoY[e], FogoZ[e]))
			        {
		                 DestroyDynamicObject(FogoID[e]);
		                 FogoApagado[e] = true;
		                 if(FogoApagado[8] == true)
			             {
                              new string[128];
			                  IncendioAcontecendo = false;
			                  ApagandoIncendio[playerid] = false;
			                  Extintor[playerid] = 0;
			                  GetPlayerName(playerid, NickName, sizeof(NickName));
			                  MeioDeApagar[playerid] = 0;
			                  if(PlayerInfo[playerid][pSex] == 1)
			                  {
				                  format(string, sizeof(string), "[AVISO]Bombeiro: %s e a SA-MU apagaram o inc�ndio !", PlayerName(playerid));
			                      SendClientMessageToAll(COR_LIGHTRED, string);
		                      }
		                      else if(PlayerInfo[playerid][pSex] == 2)
			                  {
				                  format(string, sizeof(string), "[AVISO]M�dico: %s e a SA-MU apagaram o inc�ndio !", PlayerName(playerid));
			                      SendClientMessageToAll(COR_LIGHTRED, string);
		                      }
		                      SendFamilyMessage(4, COR_LIGHTBLUE, "[AVISO] A SA-MU apagou o inc�ndio, todos os membros ir�o receber +R$1500,00 no sal�rio !");
		                      foreach(new i: Player)
		                      {
			                       if(IsPlayerConnected(i))
			                       {
                                        if(GetPlayerOrg(i) == 4)
			                            {
				                            GameTextForPlayer(i, "~b~incendio apagado~n~ bonus: ~g~R$1500!", 5000, 1);
				                            PlayerInfo[i][pSalario] += 1500;
				                        }
				                   }
				              }
               			      new Conta = CofreOrg[4][Dinheiro] + 1000;
               			      DepositarGranaOrg(4, Conta);
		                      PlayerInfo[playerid][pApagado] += 1;
			                  KillTimer(SetTimerEx("ApagarFogo", 12000, false, "i", playerid));
			                  KillTimer(Foguinho);
			             }
				    }
			   }
		  }
		  if(MeioDeApagar[playerid] == CAMINHAO && IsPlayerInRangeOfPoint(playerid, 40.0, FogoX[1]-8.3718,FogoY[1]-8.429,FogoZ[1]) && PlayerInfo[playerid][pMembro] == 4 || PlayerInfo[playerid][pLider] == 4)
		  {
		       for(new e = 0; e < 17; e++)
			   {
			        DisablePlayerCheckpoint(playerid);
			        DestroyDynamicObject(FogoID[e]);
			        FogoApagado[e] = true;
			        if(FogoApagado[8] == true)
			        {
                         new string[128];
			             IncendioAcontecendo = false;
			             ApagandoIncendio[playerid] = false;
			             Extintor[playerid] = 0;
			             GetPlayerName(playerid, NickName, sizeof(NickName));
			             GivePlayerMoneyEx(playerid,8000);
		                 PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
		                 SendClientMessage(playerid, COR_GRAD1, "Voc� apagou um inc�ndio e ganhou R$[8000] ! ");
		                 format(string, sizeof(string), "[AVISO]M�dico: %s e a SA-MU apagaram o inc�ndio !", PlayerName(playerid));
		                 SendClientMessageToAll(COR_LIGHTRED, string);
			             MeioDeApagar[playerid] = 0;
			             KillTimer(SetTimerEx("ApagarFogo", 12000, false, "i", playerid));
			             KillTimer(Foguinho);
			        }
			   }
		  }
	 }
	 return 1;
}
stock GanharItem(playerid, Item, Ammo)
{
	new Nome[20];
	new i;
	while(i != 8)
	{
		if(CaixaArma[i][playerid] == Item)
		{
			CaixaAmmo[i][playerid]=CaixaAmmo[i][playerid]+Ammo;
			break;
		}
		if(CaixaArma[i][playerid] == 0)
		{
			CaixaArma[i][playerid]=Item;
			CaixaAmmo[i][playerid]=Ammo;
   			break;
		}
		i++;
	}
	GetWeaponName(Item, Nome, 20);
	new string[35]=" Adquirido!";
 	strins(string, Item == 18 ? ("Cocktail Molotov") : (Nome), 0, 20);
 	return SendClientMessage(playerid, -1, i == 8 ? ("Caixa de armas cheia!") : (string));
}

stock GuardarItem(playerid)
{
	new Item = GetPlayerWeapon(playerid);
	new Ammo = GetPlayerAmmo(playerid);
	if(Item == 0) return SendClientMessage(playerid, -1, "Item inv�lido!");
	new i;
	while(i != 8)
	{
		if(CaixaArma[i][playerid] == Item)
		{
			CaixaAmmo[i][playerid]=CaixaAmmo[i][playerid]+Ammo;
			RemoverItem(playerid, Item);
			break;
		}
		if(CaixaArma[i][playerid] == 0)
		{
			CaixaArma[i][playerid]=Item;
			CaixaAmmo[i][playerid]=Ammo;
			RemoverItem(playerid, Item);
			break;
		}
		i++;
	}
 	return i == 8 ? SendClientMessage(playerid, -1, "Caixa de armas cheia!") : 1;
}

stock RemoverItem(playerid, item)
{
	new Arma[13][2];
	for(new i = 1; i < 13; ++i) GetPlayerWeaponData(playerid, i, Arma[i][0], Arma[i][1]);
	ResetPlayerWeapons(playerid);
	for(new i = 1; i < 13; ++i)
	{
		if(item != Arma[i][0]) GivePlayerWeapon(playerid, Arma[i][0], Arma[i][1]);
	}
}

stock ItemOpcoes(playerid, Item)
{
	if(CaixaArma[Item][playerid] == 0) return PlayerPlaySound(playerid, 1053, 0.0, 0.0, 0.0);
	ItemOpcao[playerid]=Item;
	return ShowPlayerDialog(playerid,DialogOpc,DIALOG_STYLE_LIST,"Op��es:","Usar\nDestruir","OK","Fechar");
}
