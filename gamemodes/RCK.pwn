	CMD:departamento(playerid, params[])  return ForT:d(playerid, params);
	CMD:d(playerid, result[])
	{
		if(IsPlayerConnected(playerid))
		{
			GetPlayerName(playerid, sendername, sizeof(sendername));
			if(isnull(result))
			{
				SendClientMessage(playerid, COR_DEPARTAMENTO, "{0099ff}�{ffffff} USE: (/d)epartamento [Chat Governo]");
				return 1;
			}
			if(PlayerInfo[playerid][pCargo] < 2)
			{
				SendClientMessage(playerid, COR_BALLAS, "Apenas cargo 2+ podem falar no chat do governo.");
				return 1;
			}
			if(!IsACop(playerid) && GetPlayerOrg(playerid) != 4 && GetPlayerOrg(playerid) != 7)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� n�o faz parte de nenhuma equipe do governo !");
				return 1;
			}
			if(GetTickCount() - TempoChatGov[playerid] < 3000)
			{
				SendClientMessage(playerid,COR_GRAD1,"Voc� s� pode escrever uma mensagem a cada 3 segundos.");
				return 1;
			}
			if(TentouDivulgar(result))
			{
				GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
				format(stringZCMD, 128, "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
				ABroadCast(COR_AMARELO,stringZCMD,1);
				DivulgouLog(stringZCMD);
				return 1;
			}
			if(Palavrao(result))
			{
				GivePlayerMoneyEx(playerid, -500);
				SendClientMessage(playerid, COR_LIGHTRED, "� PROIBIDO CHINGAR NO CHAT DO GOVERNO,VOC� PERDEU 500 REAIS !");
				return 1;
			}
			if(PlayerInfo[playerid][pMembro] == 1 || PlayerInfo[playerid][pLider] == 1)
			{
				if(PlayerInfo[playerid][pCargo] == 6)
				{
					format(stringZCMD, sizeof(stringZCMD), "** PM(L) %s: %s **", sendername, result);
				}
