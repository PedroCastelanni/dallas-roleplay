forward OnPlayerDamage(&playerid, &Float:amount, &issuerid, &weapon, &bodypart);
public OnPlayerDamage(&playerid, &Float:amount, &issuerid, &weapon, &bodypart)
{
	 new string[256];
  	 new Float:Vida;
     new Float:Colete;
     GetPlayerArmour(playerid,Colete);
     GetPlayerHealth(playerid, Vida);
     SaiuSpawn[issuerid] = 0;
     // bloquear dano de admin
    
     if(AdminTrabalhando[issuerid] == 1)
     {
        ForT:trabalhar(issuerid, #);
     }
     if(IniciouCombate[issuerid] != playerid)
     {
        format(string, sizeof(string),"%s iniciou um combate contra %s", PlayerName(issuerid), PlayerName(playerid));
        WriteLog("Logs/combates.log", string);
        IniciouCombate[issuerid] = playerid;
     }
	 // bloquear dano ap�s sair da barraca guerra
	 if(SaiuSpawn[playerid] == 1)
	 {
	 	if(Colete >= 1)
		{
            SetPlayerArmour(playerid, Colete - 0);
        }
        else
        {
            SetPlayerHealth(playerid, Vida - 0);
        }
	 }
 	 // bloquear bazuca de perto
 	 if(GetPlayerWeapon(issuerid) == 35)
 	 {
 	    if(IsPlayerInEmboscada(playerid))
 	    {
     		if(Colete >= 1)
	       	{
	            SetPlayerArmour(playerid, Colete - 0);
	       	}
	       	else
	       	{
	            SetPlayerHealth(playerid, Vida - 0);
	       	}
	       	SendClientMessage(issuerid,COR_LIGHTRED, "Bazuca n�o causa dano em jogadores que est�o na emboscada.");
 	    }
	 	if(GetDistanceBetweenPlayers(issuerid, playerid) <= 20)
		{
	       	if(Colete >= 1)
	       	{
	            SetPlayerArmour(playerid, Colete - 0);
	       	}
	       	else
	       	{
	            SetPlayerHealth(playerid, Vida - 0);
	       	}
	       	SendClientMessage(issuerid,COR_LIGHTRED, "Bazuca de perto � proibido, o tiro foi bloqueado.");
	    }
 	 }
     if(EquipeQuarentena[issuerid] == 1 && EquipeQuarentena[playerid] == 1)
	 {
	    if(Colete >= 1)
