	CMD:ir(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    new plo, world;
			if(sscanf(params, "u", plo))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /ir [id]");
				return 1;
			}
			new Float:plocx,Float:plocy,Float:plocz;
			world = GetPlayerVirtualWorld(plo);
			new idinterior = GetPlayerInterior(plo);
			if (IsPlayerConnected(plo))
			{
				if(plo != INVALID_PLAYER_ID)
				{
					if (PlayerInfo[playerid][pAdmin] >= 1)
					{
						if(strcmp(PlayerName(plo),"Apxgui", true) == 0)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode ir no Apxgui, KJKJKJKJKJKJ !");
							return 1;
						}
						if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
							return 1;
						}
						if(PlayerInfo[plo][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode ir at� um Admin Dono !");
							return 1;
						}
						if(Spectate[playerid] != 255)
						{
							Spectate[playerid] = 256;
						}
						GetPlayerPos(plo, plocx, plocy, plocz);
						if(InteriorAtual[plo] > 0)
						{
							SetPlayerInterior(playerid,InteriorAtual[plo]);
							InteriorAtual[playerid] = InteriorAtual[plo];
							LocalAtual[playerid] = LocalAtual[plo];
						}
						if(InteriorAtual[plo] == 0)
						{
							SetPlayerInterior(playerid,0);
						}
						if(plocz > 530.0 && InteriorAtual[plo] == 0) //the highest land point in sa = 526.8
						{
							SetPlayerInterior(playerid,1);
							InteriorAtual[playerid] = 1;
						}
						SetPlayerInterior(playerid, idinterior);
						SetPlayerVirtualWorld(playerid, world);
						if (GetPlayerState(playerid) == 2)
						{
							new tmpcar = GetPlayerVehicleID(playerid);
							LinkVehicleToInterior(tmpcar, idinterior);
							SetVehiclePos(tmpcar, plocx, plocy+4, plocz);
							TelePos[playerid][0] = 0.0;TelePos[playerid][1] = 0.0;
						}
						else
						{
							SetPlayerPos(playerid,plocx,plocy+2, plocz);
						}
						SendClientMessage(playerid, COR_GRAD1, "Voc� foi teletransportado pelo Admin!");
						GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME, playerid);
						GetPlayerName(plo, plnameZCMD, MAX_PLAYER_NAME);
						format(stringZCMD, sizeof(stringZCMD), "Administrador %s foi at�: %s.",playernameZCMD,plnameZCMD);
						ProxDetector(30.0, playerid, stringZCMD, 0x33FF00FF,0x33FF00FF,0x33FF00FF,0x33FF00FF,0x33FF00FF);
					}
					else
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o esta autorizado a usar este comando!");
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Esse n�o � um player ativo.");
			}
		}
		return 1;
	}
	CMD:destruir(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pAdmin] < 4)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� autorizado a usar este comando !");
				return 1;
			}
			if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			new counter = 0;
			new result;
			new plyName[MAX_PLAYER_NAME];
			GetPlayerName(playerid, plyName, MAX_PLAYER_NAME);
			for(new i; i != MAX_VEHICLES; ++i)
			{
				new dist = ChecarveiculoTPL(5, playerid, i);
				if(dist)
				{
					result = i;
					counter++;
				}
			}
			switch(counter)
			{
				case 0:
				{
					SendClientMessage(playerid, COR_GREY, "N�o h� nenhum carro nesse raio!");
				}
				case 1:
				{
					if(result < MAX_VEHICLES)
					{
						SendClientMessage(playerid, COR_GREY, "Voc� s� pode destruir ve�culos criados");
						return 1;
					}
					new name[MAX_PLAYER_NAME];
					GetPlayerName(playerid, name, sizeof(name));
					format(stringZCMD, sizeof(stringZCMD), "Voc� destruiu o ve�culo ID:[%d]", result);
					SendClientMessage(playerid, COR_GREY, stringZCMD);
					format(stringZCMD, sizeof(stringZCMD), "[AdmAviso]: Carro ID:[%d] foi destruido Por: %s", result, name);
					ABroadCast(COR_AMARELO,stringZCMD,1);
					DestroyVehicle(result);
				}
				default:
				{
					SendClientMessage(playerid, COR_GREY, "Foram encontrados mais de um carro nesse raio");
				}
			}
		}
		return 1;
	}
	CMD:darrespawn(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
