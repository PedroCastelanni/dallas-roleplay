    if(TemSkinPermanente[playerid] > 0)
	{
	    new arquivo[64];
		format(arquivo, sizeof(arquivo), Pasta_Acessorio,PlayerName(playerid));
		if(DOF2_FileExists(arquivo))
		{
			new Skin;
			Skin = DOF2_GetInt(arquivo, "Skin Permanente");
			if(GetPlayerSkin(playerid) != Skin)
			{
				SetPlayerSkin(playerid, Skin);
			}
		}
	}
 	if(AdminTrabalhando[playerid] == 1)
	{
	    SetPlayerHealth(playerid,1500);
	    return 1;
	}
	if(PlayerInfo[playerid][pSocio] > 0 || PlayerInfo[playerid][pVIP] > 0)
	{
		if(PlayerInfo[playerid][pDiaVIP] <= 0)
		{
