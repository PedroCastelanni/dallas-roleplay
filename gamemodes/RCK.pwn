    CMD:setarmat(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] == 1342)
	 	{
	 	    for(new x = 1; x < MAX_ORGS; x++)
	 	    {
				if(!OrgsCOP(x))
				{
					CofreOrg[x][Materiais] = CofreOrg[x][Materiais]+=100000; //
				}
			}
			SendClientMessage(playerid, COR_LIGHTBLUE,"	Voc� setou 100000 de materiais para todas as gangs");
		}
		return true;
	}

 	CMD:setardrogas(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] == 1342)
	 	{
			for(new x = 1; x < MAX_ORGS; x++)
	 	    {
				if(!OrgsCOP(x))
				{
					CofreOrg[x][Maconha] = CofreOrg[x][Maconha]+100000; //
				}
			}
			SendClientMessage(playerid, COR_BRANCO,"	Voc� setou 100000 de drogas para todas as gangs.");
			return true;
		}
		return true;
	}
    CMD:guerramorro(playerid)
	{
		if(PlayerInfo[playerid][pAdmin] < 1337)return SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode usar este comando!");
		if(!GuerraMorro[gGuerra])
		{
	    	gIniciarGuerraMorro();
		}
		else
		{
		    gTerminarGuerraMorro();
		}
		return 1;
	}
