			            SendClientMessage(sscanfid, COR_VERMELHO, "Voc� foi teletransportado pelo ADMIN, para participar do evento, para sair, digite: /sairevento !");
						format(stringZCMD, sizeof(stringZCMD), "Jogador: %s foi colocado no evento que est� acontecendo, pelo admin: %s", PlayerName(sscanfid), PlayerName(playerid));
