			    GetPlayerName(targetid, sendername, MAX_PLAYER_NAME);
				format(xgstring, sizeof(xgstring), "{FFFF00}Personagem: %s", sendername);
				SendClientMessage(playerid, COR_AMARELO, xgstring);
			}
			format(string, sizeof(string), "{0099ff}Level[%d] Sexo[%s] Dinheiro[%s] Banco[%s] Dias VIP[%d] Coins[%d]", level, atext, ConvertMoney(cash), ConvertMoney(Conta), diasvip, PlayerInfo[targetid][pCoins]);
	        SendClientMessage(playerid, COR_LIGHTBLUE, string);
			format(string, sizeof(string), "{0099ff}Conta[{FFFF00}%s{0099ff}] Casado com[%s] Horas Jogadas[%d] Celular[%d] Cr�ditos[%d] Avisos[%d]", drank, married,ptime,pnumber,creditos,PlayerInfo[targetid][pAvisos]);
	        SendClientMessage(playerid, COR_LIGHTBLUE, string);
			format(string, sizeof(string), "{0099ff}Respeito[%d/%d] Crimes[%d] Procura[%d] Matou[%d] Morreu[%d] Doen�a[%s] T�tulo[%s{0099ff}]",exp,expquantidade, crimes,WantedLevel[targetid],matou, morreu, dtext, titulo);
	        SendClientMessage(playerid, COR_LIGHTBLUE, string);
			format(string, sizeof(string), "{0099ff}Emprego[%s] Organiza��o[%s] Cargo[%d] Pontos Carteira[%d/20] Fam�lia[%s] Troca Nick[%d]",jtext,NomeORG(targetid),PlayerInfo[targetid][pCargo], PlayerInfo[targetid][pPontos],InfoFamilia[GetPlayerFamilia(playerid)][NomeFamilia], MudarNick[playerid]);
	        SendClientMessage(playerid, COR_LIGHTBLUE, string);
			format(string, sizeof(string), "{0099ff}Maconha[%d] Cocaina[%d] Crack[%d] Lsd[%d] Mats[%d] S.Maconha[%d] S.Cocaina[%d] S.Crack[%d] S.Lsd[%d] S.Mats[%d]",Drogas,Drogas2,Drogas3,Drogas4,mats,SafeDrogas,SafeDrogas2,SafeDrogas3,SafeDrogas4,smats);
	        SendClientMessage(playerid, COR_LIGHTBLUE, string);
			format(string, sizeof(string), "{0099ff}Casa[%d] Empresa[%d] Fazenda[%d] Ve�culos[0%d/02] Carro Aluguel[id:%d] T�tulo Personalizado[%s]",Housekey,bizkey,fazkey,Veiculos,HireCar[targetid], xtextt);
	        SendClientMessage(playerid, COR_LIGHTBLUE, string);
			format(string, sizeof(string), "{FFFF00}INV: {0099ff}Dinamites[%s] Decodificador[%s] Gal�o[%s] Kit Reparo[%s]",textdina, textdecod, textgalao, textkitcarro);
	        SendClientMessage(playerid, COR_LIGHTBLUE, string);
			format(string, sizeof(string), "{FFFF00}PERMANENTES:{0099ff} Jetpack permanente [%s] Equipamento Permanente[%s] Skin Permanente[%s]",jetperm,kitperm,skintext);
