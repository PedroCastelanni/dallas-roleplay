TPL::RespawnAutomatico()
{
	new bool:IsUsed[MAX_VEHICLES];
	foreach(new i: Player)
	{
		if(IsPlayerInAnyVehicle(i))
		{
			IsUsed[GetPlayerVehicleID(i)] = true;
		}
	}

	IsUsed[CarrosOnibus[0]] = true;
	IsUsed[CarrosOnibus[1]] = true;
	for(new x = 0, mv = GetVehiclePoolSize(); x < mv; x++)
	{
		if(!IsUsed[x]) SetVehicleToRespawn(x);
	}

	SendClientMessageToAll(0x80FF8096, "{7B68EE}!{FFFFFF} Os veiculos foram respawnados automaticamente pelo servidor");
	return 1;
}

TPL::Clock()
{
	new str[128], str2[128];
	new ano, mes, dia;
	new hora, minuto, segundo;
	getdate(ano, mes, dia);
 	gettime(hora, minuto, segundo);
 	if(HV == 1)
	{
	    hora++;
	}
	if(CH > 0)
	{
	    hora+=CH;
	}
	if(CM > 0)
	{
	    minuto+=CM;
	}
	if(CS > 0)
	{
	    segundo+=CS;
	}
	new myeggtext[20];
	if(mes == 1) { myeggtext = "Janeiro"; }
	else if(mes == 2) { myeggtext = "Fevereiro"; }
	else if(mes == 3) { myeggtext = "Marco"; }
	else if(mes == 4) { myeggtext = "Abril"; }
	else if(mes == 5) { myeggtext = "Maio"; }
	else if(mes == 6) { myeggtext = "Junho"; }
	else if(mes == 7) { myeggtext = "Julho"; }
	else if(mes == 8) { myeggtext = "Agosto"; }
	else if(mes == 9) { myeggtext = "Setembro"; }
	else if(mes == 10) { myeggtext = "Outubro"; }
	else if(mes == 11) { myeggtext = "Novembro"; }
	else if(mes == 12) { myeggtext = "Dezembro"; }
	format(str, sizeof(str), "%d de %s", dia, myeggtext);
	TextDrawSetString(TextDrawdeData, str);
	format(str2, sizeof(str2), "%d:%d", hora, minuto);
	TextDrawSetString(TextDrawdeHora, str2);
	//TextDrawHideForAll(Player[0]);
	//TextDrawDestroy(Player[0]);
	//TextDrawHideForAll(Player[1]);
	//TextDrawDestroy(Player[1]);
	//UpdateMap();


    if(hora == 5 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 6 && minuto == 0 && segundo == 1) RespawnAutomatico();
	if(hora == 7 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 8 && minuto == 0 && segundo == 1) RespawnAutomatico();
	if(hora == 9 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 10 && minuto == 0 && segundo == 1) RespawnAutomatico();
	if(hora == 11 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 12 && minuto == 0 && segundo == 1) RespawnAutomatico();
	if(hora == 13 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 14 && minuto == 0 && segundo == 1) RespawnAutomatico();
	if(hora == 15 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 16 && minuto == 0 && segundo == 1) RespawnAutomatico();
	if(hora == 17 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 18 && minuto == 0 && segundo == 1) RespawnAutomatico();
	if(hora == 19 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 20 && minuto == 0 && segundo == 1) RespawnAutomatico();
	if(hora == 21 && minuto == 58 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "{808000}[INFO] {ffffff}Os veiculos sera respawnados daqui a 2 minutos automaticamente!"); }
	if(hora == 22 && minuto == 0 && segundo == 1) RespawnAutomatico();
