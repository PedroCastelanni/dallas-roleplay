	CMD:newgay(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pAdmin] < 1339)
			{
				return 1;
			}
			GaysVaga();
			if(VagasGays == 0)
			{
				SendClientMessage(playerid, COR_GRAD1, "N�o h� mais vagas na lista use /cleargay primeiro.");
				return 1;
			}
			new para1;
			new vaga;
			if(sscanf(params, "ud", para1, vaga))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /newgay [id] [vaga]");
				return 1;
			}
			if(vaga < 0 || vaga > 20) { SendClientMessage(playerid, COR_GREY, "Vaga m�nima 1 m�ximo 20 !"); return 1; }
			GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
			GetPlayerName(playerid, sendername, sizeof(sendername));
			if(IsPlayerConnected(para1))
			{
				if(para1 != INVALID_PLAYER_ID)
				{
					format(stringZCMD, sizeof(stringZCMD), "* Administrador: %s, Tornou voc� o novo gay do servidor !", PlayerName(playerid));
					SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
					format(stringZCMD, sizeof(stringZCMD), "Voc� tornou %s o novo gay do servidor.", giveplayerZCMD);
					SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
					for(new i = 0; i < sizeof(GaysInfo); ++i)
					{
						if(GaysInfo[vaga][GayVaga] == 0)
						{
							GaysInfo[vaga][gNick] = giveplayerZCMD;
							GaysInfo[vaga][GayVaga] = vaga;
							SaveGays();
							break;
						}
					}
				}
			}
		}
		return 1;
	}
	CMD:cleargay(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] < 1339)
		{
			return 1;
		}
		new Vagao;
		if(sscanf(params, "d", Vagao))
		{
			SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /cleargay [vaga]");
			return 1;
		}
		if(Vagao < 1 || Vagao > 17) { SendClientMessage(playerid, COR_GREY, "Vaga m�nima 1 m�ximo 17 !"); return 1; }
		strmid(GaysInfo[Vagao][gNick], "Vazio", 0, strlen("Vazio"), 255);
		GaysInfo[Vagao][GayVaga] = 0;
		format(stringZCMD, sizeof(stringZCMD), "Voc� limpou a vaga dos gays N� [%d]",Vagao);
		SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
		SaveGays();
		return 1;
	}
	CMD:gays(playerid, params[])
	{
		//new Dialog[1500];
		if(mudandodp[playerid] == 1)
		{
			SendClientMessage(playerid, COR_GRAD1, "Voc� est� mudando de departamento, n�o pode utilizar este comando!");
			return 1;
		}
		MEGAString[0] = EOS;
		format(stringZCMD, sizeof(stringZCMD), "Gayzao = %s\n", GaysInfo[0][gNick]);
		strcat(MEGAString,stringZCMD);
