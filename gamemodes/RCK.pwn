	CMD:rbug(playerid, result[])
 	{
			if(!strlen(result))
			{
				return true;
			}
  			getdate(Ano, Mes, Dia);
			gettime(Hora, Minuto, Segundo);
			SendClientMessage(playerid, COR_LIGHTRED, "Seu relato foi salvo em um arquivo interino, logo que o Apxgui ver, corrigir�. Obrigado!");
			new File:filebug;
			MEGAString[0] = EOS;
			filebug = fopen(Pasta_BUGS,io_append);
			format(MEGAString, 256, "//>================= [ %02d/%02d/%04d as %02d:%02d:%02d ] =================<\n\n//Por: %s\nBUG: %s\n\n",
			Dia, Mes, Ano,
			Hora, Minuto, Segundo,
			PlayerName(playerid),
			result);
			fwrite(filebug,MEGAString);
			fclose(filebug);
			return true;
    }
    CMD:vozdeprisao(playerid, params[])return ForT:vdp(playerid,params);
	CMD:vdp(playerid, params[])
	{
	    	if(!IsACop(playerid))
			{
			    SendClientMessage(playerid, COR_GREY, "   Voc� n�o � um policial!");
			    return true;
			}
			if(OnDuty[playerid] != 1)
			{
			    SendClientMessage(playerid, COR_GREY, "   Voc� n�o Bateu o cart�o!");
			    return true;
			}
	  		if(PlayerInfo[playerid][pJailed] == 9)
		    {
				SendClientMessage(playerid,COR_GRAD1," Voc� n�o pode usar este comando nas Celas da Administra��o!");
		      	return true;
		    }
		    new giveplayerid;
			if(sscanf(params, "u", giveplayerid))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /vozdeprisao [ID do Player]");
				return true;
			}
			if(IsPlayerConnected(giveplayerid))
			{
			    if(giveplayerid != INVALID_PLAYER_ID)
			    {
			        if(WantedLevel[giveplayerid] == 0)
			        {
			            SendClientMessage(playerid, COR_GREY, "   Este jogador n�o est� sendo procurado!");
				        return true;
			        }
			        if(PlayerInfo[giveplayerid][pAdmin] && AdminTrabalhando[giveplayerid])
			    	{
						SendClientMessage(playerid, COR_GREY, "   Voc� n�o pode dar vdp em admins em modo trabalho !");
						return true;
		    		}
			        if(VozDePrisao[giveplayerid] == 1)
			        {
			            SendClientMessage(playerid, COR_GREY, "   Alguem ja deu voz de prisao a este Jogador!");
				        return true;
			        }
					if (ProxDetectorS(9.0, playerid, giveplayerid))
					{
                	    new string[128];
      					format(string, sizeof(string), "*Oficial %s diz: Parado! Voc� � procurado pela justi�a, renda-se agora!", PlayerName(playerid));
						SendClientMessage(giveplayerid, COR_AMARELO, string);
						format(string, sizeof(string), "OBS: Se voc� desconectar agora, ser� preso automaticamente, fa�a com que o policial perca-o de vista!!!", PlayerName(playerid));
						SendClientMessage(giveplayerid, COR_AMARELO2, string);
						format(string, sizeof(string), "*Voc� deu voz de prisao a %s.", PlayerName(giveplayerid));
						SendClientMessage(playerid, COR_LIGHTBLUE, string);
						SendClientMessage(playerid, COR_LIGHTRED, "Se o jogador se desconectar agora, ser� preso automaticamente, n�o perca-o de vista!!!");
						PutaGorda[giveplayerid] = SetTimerEx("VozDePrisaoo", 1000, 1, "ii", giveplayerid, playerid);
						VozDePrisao[giveplayerid] = 1;
					}
					else
					{
					    SendClientMessage(playerid, COR_GREY, "   O Jogador est� longe de Voc� !");
					    return true;
					}
				}
			}
			else
			{
			    SendClientMessage(playerid, COR_GREY, "   O Jogador Est� Offline !");
			    return true;
			}
			return true;
	}

