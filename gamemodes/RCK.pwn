	CMD:report(playerid, params[])return ForT:reportar(playerid, params);
	CMD:reportar(playerid, params[]){

	    new
	        id,
	        motivo[128]
		;

		if(gettime() < GetPVarInt(playerid, #VarFlood1))
		    return SendClientMessage(playerid, COR_GRAD1, #Voc� n�o pode usar este comando com tanta frequencia);
		SetPVarInt(playerid, #VarFlood1, gettime()+5);

		if(sscanf(params, "us[128]", id, motivo))return SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /reportar [id] [motivo]");

	    if(!IsPlayerConnected(id))return SendClientMessage(playerid, COR_GRAD1, " Este player est� off-line !");

		if(gPlayerLogged[playerid]){

		    new Str[226];

		    format(Str, sizeof Str, ">>[REPORT]<< {7FFF00}%s est� reportando %s, motivo: {FF0000}%s", PlayerName(playerid), PlayerName(id), motivo);
            ABroadCast(0xFF0000FF, Str, 1);
            SendClientMessage(playerid, COR_LIGHTGREEN, "Seu report foi enviado para os admins...");
		}
	    return 1;
	}
 CMD:item(playerid, params[])
	{
		if (gPlayerLogged[playerid] == 0)
		{
			SendClientMessage(playerid, COR_GREY, "Voc� n�o est� logado!");
			return 1;
		}
		if (PlayerInfo[playerid][pAdmin] < 0)
		{
			SendClientMessage(playerid, COR_GRAD1, "Voc� n�o tem autoriza��o para usar esse comando.");
			return true;
		}
		else
		{
			if (PlayerInfo[playerid][pAdmin] == 0)
			{
			    new para1;
				new level;
				if(sscanf(params, "ud", para1, level))
				{
					SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /daradmin [ id ] [Level 0 � 1342]");
					return true;
				}
				VagaAdmins();
				if(VagasLivresAdm == 0)
				{
					SendClientMessage(playerid, COR_GRAD1, "N�o h� mais vagas na lista use /limparadmin primeiro.");
					return 1;
				}
				if (level == 0)
				{
					SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /limparadmin para limpar uma vaga");
					return 1;
				}
				GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
				GetPlayerName(playerid, sendername, sizeof(sendername));
				if (IsPlayerConnected(para1))
				{
					if (para1 != INVALID_PLAYER_ID)
					{
						format(stringZCMD, sizeof(stringZCMD), " Voc� foi promovido para level %d de Admin - pelo dono %s.", level, sendername);
						SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "   Voc� promoveu o(a) %s para o level %d de Admin.", giveplayerZCMD, level);
						SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
						getdate(year, month, day);
						gettime(hour, minute, second);
						format(stringZCMD, sizeof(stringZCMD), "%s deu admin nivel %d para %s [%d/%d/%d] �s [%d:%d:%d].", sendername, level, giveplayerZCMD, day, month, year, hour, minute, second);
						PAdminsLog(stringZCMD);
						PlayerInfo[para1][pAvaliacoes] += 1;
						PlayerInfo[para1][pAFinal] += 10;
						for (new i = 0; i < sizeof(AdmInfo); i++)
						{
							if (PlayerInfo[para1][pAdmin] > 0)
							{
								PlayerInfo[para1][pAdmin] = level;
								break;
							}
							else if (AdmInfo[i][AdminVaga] == 0)
							{
								PlayerInfo[para1][pAdmin] = level;
								AdmInfo[i][AdminNick] = giveplayerZCMD;
								AdmInfo[i][AdminVaga] = 1;
								SalvarAdmins();
								break;
							}
						}
					}
				}
			}
		}
		return 1;
	}
