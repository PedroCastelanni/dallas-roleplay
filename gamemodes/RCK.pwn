	CMD:do(playerid, params[])
	{
		if(IsPlayerInAnyVehicle(playerid) || GetPlayerSpecialAction(playerid) == 2)
		{
			SendClientMessage(playerid, COR_GRAD5, "Voc� n�o pode usar esse comando dentro de um ve�culo/jetpack.");
