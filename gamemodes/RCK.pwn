showTelaLogin(playerid){

	    for(new i; i < sizeof(textTelaLogin); i++){
	    TextDrawShowForPlayer(playerid, textTelaLogin[i]);
	    }
	    SelectTextDraw(playerid,0xa4a4a4FF);
	    NomeLogin(playerid);
}

hideTelaLogin(playerid){

	for(new i; i < sizeof(textTelaLogin); i++){
	    TextDrawHideForPlayer(playerid, textTelaLogin[i]);
	}
	CancelSelectTextDraw(playerid);
}
