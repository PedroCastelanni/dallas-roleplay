stock WriteLog(File_[], Log[])
{
	if(!fexist(File_)) return false;
	new Buf[300], BackUp[300], Format[128], File: LOG;
	LOG = fopen(File_, io_read);
	while(fread(LOG, Buf))
	{
		strcat(BackUp, Buf);
	}
	fclose(LOG);
	LOG = fopen(File_, io_write);
	new hora, minuto, segundo;
	gettime(hora, minuto, segundo);
	format(Format, sizeof Format, "[%02d:%02d:%02d] - %s\r\n",hora, minuto, segundo, Log);
	fwrite(LOG, Format);
	fclose(LOG);
	LOG = fopen(File_, io_append);
	fwrite(LOG, BackUp);
	fclose(LOG);
	return true;
}
