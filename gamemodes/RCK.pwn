	    	}
	    }*/
	    if (!IsPlayerInAnyVehicle(playerid))
		{
			new Float:pos[3];
			GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
			if (pos[1] > (Y_ELEVATOR_POS - 1.8) && pos[1] < (Y_ELEVATOR_POS + 1.8) && pos[0] < (X_ELEVATOR_POS + 1.8) && pos[0] > (X_ELEVATOR_POS - 1.8))
			{
				ShowElevatorDialog(playerid);
			}
			else
			{
				if(pos[1] < (Y_ELEVATOR_POS - 1.81) && pos[1] > (Y_ELEVATOR_POS - 3.8) && pos[0] > (X_ELEVATOR_POS + 1.21) && pos[0] < (X_ELEVATOR_POS + 3.8))
				{
					new i = 13;
					while(pos[2] < GetDoorsZCoordForFloor(i) + 3.5 && i > 0)
					{
						i --;
					}
					if(i == 0 && pos[2] < GetDoorsZCoordForFloor(0) + 2.0)
					{
						i = -1;
					}
					if (i <= 12)
					{
						if (ElevatorState != ELEVATOR_STATE_MOVING)
						{
							if (ElevatorFloor == i + 1)
							{
								GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~y~~h~DP Policia Civil Elevator O~n~~y~~h~Elevador Ja Esta Nesse Andar...~n~~w~Entre Dentro Dele ~n~~w~E Pressione 'H'", 3500, 3);
								SendClientMessage(playerid, COR_AMARELO, "[DEPARTAMENTO DE POL�CIA]: Policia Civil O Elevador Ja Est� Neste Piso Entre Dentro Dele E Aperte'{FFFFFF}H{CCCCCC}'");
								return 1;
							}
						}
						CallElevator(playerid, i + 1);
						GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~g~~h~DP Policia Civil O Elevador~n~~g~~h~Foi Chamado...~n~~w~Por favor, Espere Um Pouco", 3000, 3);
						new strTempString[100];
						if (ElevatorState == ELEVATOR_STATE_MOVING)
						{
							format(strTempString, sizeof(strTempString), "[DEPARTAMENTO DE POL�CIA]: Policia Civil o elevador foi chamado ... ele est� se movendo em dire��o ao %s.", FloorNames[ElevatorFloor]);
						}
						else
						{
							if (ElevatorFloor == 0)
							{
								format(strTempString, sizeof(strTempString), "[DEPARTAMENTO DE POL�CIA]: Policia Civil o elevador foi chamado ... ele est� no %s.", FloorNames[ElevatorFloor]);
							}
							else
							{
								format(strTempString, sizeof(strTempString), "[DEPARTAMENTO DE POL�CIA]: Policia Civil o elevador foi chamado... ele est� no %s.", FloorNames[ElevatorFloor]);
							}
						}
						SendClientMessage(playerid, COR_AMARELO, strTempString);
						return 1;
					}
				}
			}
			for(new x; x != MAX_GBOX; x++)
			{
			    if(GBInfo[x][gbCreated] && IsPlayerInRangeOfPoint(playerid, 3.0, GBInfo[x][gbX], GBInfo[x][gbY], GBInfo[x][gbZ]))
				{
					if(strfind(GBInfo[x][gbNick], PlayerName(playerid), true) != -1)
					{
						ShowPlayerDialog(playerid, 4424, DIALOG_STYLE_LIST, "Sua Caixa de Armas", "Guardar Arma\nPegar Armas\nDesmontar Caixa", "Escolher", "Cancelar");
			        	return 1;
					}
					else
					{
					    return SendClientMessage(playerid, COR_GRAD1, "Essa caixa de armas n�o � sua!");
					}
			    }
			}
		}
	}
    if((newkeys == KEY_HORN) && (IsPlayerInAnyVehicle(playerid)))
	{
	    if(GetPlayerOrg(playerid) == 1)
		{
             ForT:pe(playerid, #);
  		     ForT:pg(playerid, #);
  		}
  		if(GetPlayerOrg(playerid) == 2)
		{
  			 ForT:pb2(playerid, #);
  			 ForT:pb3(playerid, #);
  		}
  		if(GetPlayerOrg(playerid) == 3)
		{
  			 ForT:abrirgn(playerid, #);
  			 ForT:abrirgn2(playerid, #);
  			 ForT:pboxgn(playerid, #);
  		}
        if(GetPlayerOrg(playerid) == 13)
		{
  			 ForT:pPRF(playerid, #);
  		}
  		if(GetPlayerOrg(playerid) == 13 || GetPlayerOrg(playerid) == 17)
		{
  			 ForT:pPRFpc(playerid, #);
  		}
  		if(GetPlayerOrg(playerid) == 25)
  		{
  			 ForT:ppf(playerid, #);
  			 ForT:pboxpf(playerid, #);
  		}
  		if(GetPlayerOrg(playerid) == 17)
  		{
  			 ForT:ppc(playerid, #);
  		}
  		if(GetPlayerOrg(playerid) == 17 || GetPlayerOrg(playerid) == 25)
  		{
  			 ForT:pPRFpc(playerid, #);
  		}
  		if(GetPlayerOrg(playerid) == 12)
  		{
  			 ForT:prota(playerid, #);
  		}
        if(PlayerInfo[playerid][pAdmin] >= 1)
		{
		     ForT:padm(playerid, #);
   		}
        if(GetPlayerOrg(playerid) == 7)
		{
		     ForT:pgov(playerid, #);
		}
        if(GetPlayerOrg(playerid) == 9)
		{
			 ForT:portaoreporter(playerid, #);
   		}
        if(PlayerInfo[playerid][pMembro] == 8 || PlayerInfo[playerid][pLider] == 8 || IsACop(playerid))
		{
		     ForT:phit(playerid, #);
   		}
        if(IsAtGasStation(playerid))
		{
		     ForT:abastecer(playerid, #);
   		}
        if(PlayerToPoint(10.0,playerid,2495.9846,-1460.4069,24.0212) || PlayerToPoint(10.0,playerid,998.1703,2137.3923,10.8203))
		{
		     ForT:blindarposto(playerid, #);
		}
		if(PlayerInfo[playerid][pMembro] == 14 || PlayerInfo[playerid][pLider] == 14)
		{
			 ForT:pcr(playerid, #);
			 ForT:pmec(playerid, #);
		}
		if(PlayerInfo[playerid][pMembro] == 10 || PlayerInfo[playerid][pLider] == 10)
		{
 			 ForT:ptaxi(playerid, #);
 		}
 		if(GetPlayerOrg(playerid) == 26 || IsACop(playerid))
		{
  			 ForT:pass(playerid, #);
  		}
		if(IsACop(playerid))
		{
             ForT:pcr(playerid, #);
			 ForT:pmec(playerid, #);
			 ForT:pass(playerid, #);
			 ForT:ptaxi(playerid, #);
			 ForT:phit(playerid, #);
			 ForT:portaoreporter(playerid, #);
		}
	}
	return 1;
}
TPL::ScoreLevel(playerid)
{
	new LevScore;
	LevScore = PlayerInfo[playerid][pLevel];
	SetPlayerScore(playerid, LevScore);
}
TPL::Slide(playerid)
{
    if(Sliding[playerid] == 1)
    {
         new Float:X;
         new Float:Y;
         new Float:Z;
         GetPlayerPos(playerid, X, Y, Z);
         SetPlayerPos(playerid, X, Y, Z - 5.00);
         DestroyDynamicObject(Corda[playerid]);
         ApplyAnimation(playerid,"ped","abseil",4.0,0,0,0,1,0);
         Corda[playerid] = CreateDynamicObject(19089, X, Y, Z, 0.0, 0.0, 0.0);
         SetTimerEx("Slide", 1000, 0, "i", playerid);
    }
	return 1;
}
TPL::Slidee(playerid)
{
    if(Sliding[playerid] == 1)
    {
	    Sliding[playerid] = 0;
	    DestroyDynamicObject(Corda[playerid]);
        TogglePlayerControllable(playerid, 1);
	    SendClientMessage(playerid, COR_BRANCO, "Sua corda arrebentou, voc� pulou de um lugar muito alto !");
    }
}
