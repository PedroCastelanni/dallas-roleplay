	CMD:fpromover(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{

			new para1;
			new level;
			if(sscanf(params, "ud", para1, level))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /fpromover [ID/Nick] [Cargos (1-2)]");
				return 1;
			}
			if(level > 2 || level < 1) { SendClientMessage(playerid, COR_GREY, "Cargos de 1 a 2, Cargo 2 � Sub-L�der!"); return 1; }
			if (PlayerInfo[playerid][pLFamilia] > 0)
			{
				if(IsPlayerConnected(para1))
				{
					if(PlayerInfo[para1][pFamilia] == PlayerInfo[playerid][pLFamilia])
					{
						if(para1 != INVALID_PLAYER_ID)
						{
							GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
							GetPlayerName(playerid, sendername, sizeof(sendername));
							PlayerInfo[para1][pCargoF] = level;
							format(stringZCMD, sizeof(stringZCMD), "Voc� foi promovido pelo l�der da sua familia, [%s] para o cargo [%d].", sendername, level);
							SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "Voc� promoveu %s para o cargo %d.", giveplayerZCMD,level);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							new org = PlayerInfo[playerid][pLFamilia];
							if(level == 2)
							{
								if(strcmp(InfoFamilia[org][SubLider],"Ninguem",true)==0)
								{
									DemitirInfoFamilia(giveplayerZCMD);
									ConviteInfoFamilia(giveplayerZCMD, org, 2);
								}
								else
								{
									strmid(stringZCMD, InfoFamilia[org][SubLider], 0, strlen(InfoFamilia[org][SubLider]), 255);
									ConviteInfoFamilia(stringZCMD, org, 1);
									ConviteInfoFamilia(giveplayerZCMD, org, 2);
								}
							}
							if(strcmp(InfoFamilia[org][SubLider],giveplayerZCMD,true)==0)
							{
								if(level < 2)
								{
									DemitirInfoFamilia(giveplayerZCMD);
									ConviteInfoFamilia(giveplayerZCMD, org, level);
									PlayerInfo[para1][pCargoF] = 0;
								}
							}
							return 1;
						}
						if(PlayerInfo[para1][pFamilia] != PlayerInfo[playerid][pLFamilia])
						{

							SendClientMessage(playerid, COR_GREY, "N�o pode promover quem n�o � da sua org.");
							return 1;
						}
					}
				}//not connected
			}
			else
			{

				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o � um l�der de uma familia!");
			}
		}
		return 1;
	}
	CMD:limparflider(playerid, Vaga[])
	{
		if(PlayerInfo[playerid][pAdmin] < 1337)
		{
			SendClientMessage(playerid, COR_GRAD2, "Somente admins master ou dono podem usar este comando!");
			return 1;
		}
		if(sscanf(Vaga, "s[15]", Vaga))
		{
			SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /limparflider [N� Familia]");
			return 1;
		}
		new Vaga2 = strval(Vaga);
		if(Vaga2 < 1 || Vaga2 > 22) { SendClientMessage(playerid, COR_GREY, "Vaga m�nima 1 m�ximo 22!"); return 1; }
		new id=GetPlayerID(InfoFamilia[Vaga2][Lider]);
		format(stringZCMD, sizeof(stringZCMD), "ADMIN: %s limpou a vaga %d do l�der %s",PlayerName(playerid), Vaga2, InfoFamilia[Vaga2][Lider]);
		LideresFamiliaLog(stringZCMD);
		if(IsPlayerOnline(InfoFamilia[Vaga2][Lider]))
		{

			DemitirLiderFamilia(id);
		}
		strmid(InfoFamilia[Vaga2][Lider], "Ninguem", 0, strlen("Ninguem"), 255);
		strmid(InfoFamilia[Vaga2][NomeFamilia], "Ninguem", 0, strlen("Ninguem"), 255);
		format(stringZCMD, sizeof(stringZCMD), "UPDATE `familias` SET `Lider`='Ninguem', `Nome`='Ninguem', `Dias`='0', `Data`='0', `Tipo`='0' WHERE `ID`='%d'",Vaga2);
		Resultado = db_query(Conexao,stringZCMD);
		LoadFamilias();
		format(stringZCMD, sizeof(stringZCMD), "Voc� limpou o l�der da FAMILIA N� [%d].",Vaga2);
		SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
		return 1;
	}
