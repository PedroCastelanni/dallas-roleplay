									SetVehicleVirtualWorld(MotoGuincho5[playerid], 0);
									LinkVehicleToInterior(MotoGuincho5[playerid], 0);
									SetVehiclePos(MotoGuincho5[playerid], MotoMecSpawn[rand][0], MotoMecSpawn[rand][1], MotoMecSpawn[rand][2]);
									format(arquivo, sizeof(arquivo), Pasta_CarrosFixados,MotoGuincho5[playerid]);
									if(!DOF2_FileExists(arquivo))
									{
										DOF2_CreateFile(arquivo);
										DOF2_SetFloat(arquivo,"PosX", MotoMecSpawn[rand][0]);
										DOF2_SetFloat(arquivo,"PosY", MotoMecSpawn[rand][1]);
										DOF2_SetFloat(arquivo,"PosZ", MotoMecSpawn[rand][2]);
										DOF2_SetFloat(arquivo,"Angulo", 0);
										format(stringZCMD, sizeof(stringZCMD), "Mec�nico: %s fixou a moto:[%d] na hq mec�nico ls, custo para recuperar:[3000].", PlayerName(playerid), MotoGuincho5[playerid]);
										SendFamilyMessage(14, COR_AMARELO, stringZCMD);
									}
									MotoGuincho5[playerid] = 0;
								}
								DOF2_SaveFile();
							}
							else
							{
								SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� na hq mec�nicos !");
								return 1;
							}
						}
						else
						{
							SendClientMessage(playerid, COR_GRAD2, "Voc� precisa estar dirigindo!");
							return 1;
						}
					}
					else
					{
						SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem um boxville!");
						return 1;
					}
				}
				else
				{
					SendClientMessage(playerid, COR_GRAD2, "Voc� n�o est� em um boxville!");
					return 1;
				}
			}
			else
			{
				SendClientMessage(playerid,COR_GRAD2,"Voc� n�o � mecanico!");
				return 1;
			}
		}
		return 1;
	}
	CMD:guincharmoto(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(GetPlayerOrg(playerid) == 14)
			{
				if(IsPlayerInAnyVehicle(playerid))
				{
					if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 498)
					{
						if(GetPlayerState(playerid) == 2)
						{
						    new carroid;
							if(sscanf(params, "d", carroid))
							{
								SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /guincharmoto [veiculo id]");
								return 1;
							}
							new Float:vx,Float:vy,Float:vz;
							GetVehiclePos(carroid, vx, vy, vz);
							if(PlayerToPoint(7.0, playerid, vx, vy,vz))
							{
								if(veiculospawn[carroid] != 1)
								{
									SendClientMessage(playerid,COR_LIGHTBLUE,"Voc� n�o pode guinchar um veiculo que est� spawnado na hq.");
									return 1;
