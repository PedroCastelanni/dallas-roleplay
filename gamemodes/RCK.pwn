		{
			SendClientMessage(playerid, COR_GREY, "Voc� s� pode usar este comando a cada 5 segundos !");
			return 1;
		}
		if(PlayerInfo[playerid][pMembro] == 3 || PlayerInfo[playerid][pLider] == 3)
		{
			if(IsPlayerInMata(playerid))
			{
				if(Dominando[playerid] == 1)
				{
					SendClientMessage(playerid, COR_GRAD5, "Voc� ja est� dominando um territorio.");
					TempoDominar[playerid] = GetTickCount();
