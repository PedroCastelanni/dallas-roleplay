stock ShowLoadInt(playerid){
	TogglePlayerControllable(playerid, false);
	SetTimerEx("xTFixContolePlay", 3000, false,"i",playerid);
    for( new text; text < 9; text++) TextDrawShowForPlayer(playerid, LoadingInteriorG[text]);
	return 1;
}
