	CMD:infoadm(playerid, params[])  return ForT:infoadmins(playerid, params);
	CMD:infoadmin(playerid, params[])  return ForT:infoadmins(playerid, params);
	CMD:infoadmins(playerid, params[])
	{
		if (PlayerInfo[playerid][pAdmin] < 1340)
		{
			SendClientMessage(playerid, COR_GRAD1, "Voc� n�o tem autoriza��o para usar esse comando.");
			return true;
		}
		new lol = 0;
		MEGAString[0]=EOS;
		strcat(MEGAString, "{FFFF00}__[Lista de Admins do Servidor]__\n\n");
		while (lol < sizeof(AdmInfo))
		{
			if (lol == 0)
			{
				format(stringZCMD, sizeof(stringZCMD), "Scripter : %s\n", AdmInfo[0][AdminNick]);
				strcat(MEGAString, stringZCMD);
			}
			else
			{
				if (strcmp(AdmInfo[lol][AdminNick], "Vazio", true) != 0)
				{
					new Query[64];
					format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(AdmInfo[lol][AdminNick]));
					Resultado = db_query(Conexao,Query);
					if(db_num_rows(Resultado) > 0)
					{
						//mysql_store_result();
						new AdmLvl, result[10];
						db_get_field_assoc(Resultado, "AdminLevel", result, sizeof(result));
						AdmLvl = strval(result);
						format(stringZCMD, sizeof(stringZCMD), "Vaga %d: %s, Cargo: %d\n", lol, AdmInfo[lol][AdminNick], AdmLvl);
						strcat(MEGAString, stringZCMD);
					}
				}
			}
			lol++;
		}
		ShowPlayerDialog(playerid, 8724, DIALOG_STYLE_MSGBOX, "{FFFF00}Lista de Administradores", MEGAString, "Informado","");
		return true;
	}
	CMD:retirarvip(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
            new para1;
			if(sscanf(params, "u", para1))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /retirarvip [id]");
				return 1;
			}
			if(PlayerInfo[playerid][pAdmin] >= 1338)
			{
				if(IsPlayerConnected(para1))
				{
					if(para1 != INVALID_PLAYER_ID)
					{
						GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						if(PlayerInfo[playerid][pSocio] == 1)
						{
							format(stringZCMD, sizeof(stringZCMD), "Voc� retirou o status de S�cio [Comum] de %s.", giveplayerZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "Seu Status de S�cio [Comum] foi retirado pelo Administrador: %s.", sendername);
							SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
						}
						else if(PlayerInfo[playerid][pSocio] == 2)
						{
							format(stringZCMD, sizeof(stringZCMD), "Voc� retirou o status de S�cio [Premium] de %s.", giveplayerZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "Seu Status de S�cio [Premium] foi retirado pelo Administrador: %s.", sendername);
							SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
						}
						else if(PlayerInfo[playerid][pSocio] == 3)
						{
							format(stringZCMD, sizeof(stringZCMD), "Voc� retirou o status de S�cio [Diamante] de %s.", giveplayerZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "Seu Status de S�cio [Diamante] foi retirado pelo Administrador: %s.", sendername);
							SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
						}
						else if(PlayerInfo[para1][pVIP] == 1 && PlayerInfo[playerid][pSocio] == 0)
						{
							format(stringZCMD, sizeof(stringZCMD), "Voc� retirou o status de Vip [Comum] de %s.", giveplayerZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "Seu Status de Vip [Comum] foi retirado pelo Administrador: %s.", sendername);
							SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
						}
						else if(PlayerInfo[para1][pVIP] == 2 && PlayerInfo[playerid][pSocio] == 0)
						{
							format(stringZCMD, sizeof(stringZCMD), "Voc� retirou o status de Vip [Premium] de %s.", giveplayerZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "Seu Status de Vip [Premium] foi retirado pelo Administrador: %s.", sendername);
							SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
						}
					}
					if(PlayerInfo[para1][pVIP] > 0 && PlayerInfo[playerid][pSocio] == 0)
					{
						format(stringZCMD, sizeof(stringZCMD), "* Voc� retirou o vip level %d de %s (%d/%d/%d - %d:%d)",PlayerInfo[para1][pVIP],giveplayerZCMD,day, month, year,hour, minute);
					}
					else if(PlayerInfo[para1][pVIP] > 0 && PlayerInfo[playerid][pSocio] > 0)
					{
						format(stringZCMD, sizeof(stringZCMD), "* Voc� retirou o s�cio level %d de %s (%d/%d/%d - %d:%d)",PlayerInfo[para1][pVIP],giveplayerZCMD,day, month, year,hour, minute);
					}
					SendClientMessage(playerid, COR_AMARELO, stringZCMD);
					PlayerInfo[para1][pVIP] = 0;
					PlayerInfo[para1][pSocio] = 0;
					PlayerInfo[para1][pDiaVIP] = 0;
					VipRetirado(stringZCMD);
				}
			}
		}
		else
		{
			SendClientMessage(playerid, COR_GRAD1, "   Voc� n�o esta autorizado a usar este comando!");
			return 1;
		}
		return 1;
	}
