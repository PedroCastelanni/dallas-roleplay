 	CMD:ativarcoinsapx(playerid, params[])return ForT:setarCoins(playerid,params);
	CMD:setarCoins(playerid, params[])
	{
	    if(PlayerInfo[playerid][pAdmin] > 1341)
	    {
			new playa;
			new Coins;
			if(sscanf(params, "ud", playa, Coins))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /setarCoins [ id ] [ Coins ]");
				return 1;
			}
			if (IsPlayerConnected(playerid))
			{
			    if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
					return 1;
				}
			    if(IsPlayerConnected(playa))
			    {
			        if(playa != INVALID_PLAYER_ID)
			        {
			            PlayerInfo[playa][pReceberCoins] += Coins;
						format(stringZCMD, 256, "O Admin %s lhe deu [%d] Coins, V� ao menu vip mais pr�ximo para resgata-l�s.",PlayerName(playerid), Coins, PlayerName(playa));
						SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
						format(stringZCMD, 256, "Voc� deu [%d] Coins para o jogador [%s].", Coins, PlayerName(playa));
						SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
						format(stringZCMD, 256, "O Admin %s deu [%d] Coins para o jogador [%s].", PlayerName(playerid), Coins, PlayerName(playa));
                        MoedaLog(stringZCMD);

					}
				}
            }
		}
		else
		{
		     return 1;
		}
		return 1;
	}
