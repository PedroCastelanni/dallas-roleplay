			format(gstring, sizeof(gstring), "[Disputa Fam�lias] A Fam�lia %s ficou na frente na vota��o mensal de melhor fam�lia, com: [%d] Votos, L�der[%s].", InfoFamilia[20][NomeFamilia], conta, InfoFamilia[20][Lider]);
			SendClientMessageToAll(COR_AMARELO, gstring);
		}
	}
	if(dia == 2 && hora == 23 && minuto == 59 && segundo == 59)
	{
		new arquivo[64];
		format(arquivo, sizeof(arquivo), "Votos Familia/Ja Votou/Ja Votou.txt");
		DOF2_RemoveFile(arquivo);
		DOF2_SaveFile();
	}
}
//===================Sistema de carros das casas trancados======================
public OnVehicleStreamIn(vehicleid, forplayerid)
{
  	if (VTrancado[vehicleid] >= 1)
	{
		SetVehicleParamsForPlayer(vehicleid,forplayerid,0,1);
	}
	else
	{
		SetVehicleParamsForPlayer(vehicleid,forplayerid,0,0);
	}
	return 1;
}
TPL::LockCar(carid)
{
	foreach(new i: Player)
	{
		if(IsPlayerConnected(i))
		{
			SetVehicleParamsForPlayer(carid,i,0,1);
			gCarLock[carid] = 1;
		}
	}
}
TPL::UnLockCar(carid)
{
	foreach(new i: Player)
	{
		if(IsPlayerConnected(i))
		{
			SetVehicleParamsForPlayer(carid,i,0,0);
			gCarLock[carid] = 0;
		}
	}
}
