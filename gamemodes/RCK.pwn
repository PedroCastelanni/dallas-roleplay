    CMD:TPLvenderhqTPL(playerid)
	{
	    if(PlayerInfo[playerid][pEmprego] != 13 && PlayerInfo[playerid][pEmprego] != 14)
	        return SendClientMessage(playerid, COR_GRAD1, "Area somente para vendedores de Drogas ou Materiais.");
 		Controle(playerid, 1);
		TipoOrg[playerid] = OrgCofre[playerid];
		ShowPlayerDialog(playerid, 8901, DIALOG_STYLE_LIST, "Vender para essa HQ", "Vender Materiais\nVender Drogas", "Selecionar", "Voltar");
		return true;
	}
	CMD:bolsafamilia(playerid, params[])
	{
	        if(PlayerInfo[playerid][pLider] != 7)
	        {
				SendClientMessage(playerid, COR_GREY, "   Voc� n�o � o Prefeito !");
				return true;
	        }
	        if(PlayerInfo[playerid][pJailed] >= 1)
	        {
	            SendClientMessage(playerid, COR_GRAD1, "  Voc� n�o pode usar este comando na cadeia");
	            return 1;
			}
			new dindin;
			new giveplayerid;
			if(sscanf(params, "ud", giveplayerid, dindin))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /bolsafamilia [ID do Player] [quantidade]");
				return true;
			}
			if(AdminTrabalhando[giveplayerid] != 0 && PlayerInfo[giveplayerid][pAdmin] >= 1)
			{
			    SendClientMessage(playerid, COR_GREY, "   Voc� n�o pode pagar para admins em trabalho!");
			    return true;
			}
			if(dindin < 1 || dindin > 100000)
			{
			    SendClientMessage(playerid, COR_GRAD1, "Pagamento m�nimo 1, m�ximo 100000 por vez");
			    return true;
			}
   			new string[128];
			if (IsPlayerConnected(giveplayerid))
			{
			    if(giveplayerid != INVALID_PLAYER_ID)
			    {
					if (ProxDetectorS(5.0, playerid, giveplayerid))
					{
						playerdinheiroZCMD = GetPlayerMoney(playerid);
						if (CofreOrg[7][Dinheiro] >= dindin)
						{
							SacarOrgGrana(7,dindin);
							PLV +=dindin;
							GivePlayerMoneyEx(giveplayerid, dindin);
							format(string, sizeof(string), "   Voc� deu Bolsa Famlia %s(Para: %d), R$%d.", PlayerName(giveplayerid),giveplayerid, dindin);
							PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
							SendClientMessage(playerid, COR_GRAD1, string);
							format(string, sizeof(string), "   Voc� recebeu R$%d de bolsa familia do prefeito %s(ID: %d).", dindin, PlayerName(playerid), playerid);
							SendClientMessage(giveplayerid, COR_GRAD1, string);
							format(string, sizeof(string), "%s deu grana para %s", PlayerName(playerid), PlayerName(giveplayerid));
							//ABroadCast(COR_AMARELO,string,1);
							PlayerPlaySound(giveplayerid, 1052, 0.0, 0.0, 0.0);
							format(string, sizeof(string), "* %s deu Bolsa Familia para %s.", PlayerName(playerid), PlayerName(giveplayerid));
							ProxDetector(30.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
						}
						else
						{
							SendClientMessage(playerid, COR_GRAD1, "   Voc� n�o est� com essa grana no Cofre.");
						}
					}
					else
					{
						SendClientMessage(playerid, COR_GRAD1, "   Jogador est� longe.");
					}
				}//invalid id
			}
			else
			{
				format(string, sizeof(string), "   %d n�o � um jogador ativo.", giveplayerid);
				SendClientMessage(playerid, COR_GRAD1, string);
			}
			return true;
	}
	CMD:pagamento(playerid, params[])
    {
	        if(PlayerInfo[playerid][pLider] != 7)
	        {
				SendClientMessage(playerid, COR_GREY, "   Voc� n�o � o Prefeito !");
				return true;
	        }
	        new org;
	        new dindin;
			if(sscanf(params, "dd", org, dindin))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /pagamento [ID da Org] [quantidade]");
				return true;
			}
		    if(dindin < 1)return SendClientMessage(playerid, COR_GRAD1, " Valor invalido !");
	        if(Tax < 1)
			{
			    SendClientMessage(playerid, COR_GREY, "   N�o h� Dinheiro suficiente no banco de Impostos !");
				return true;
			}
			if(org < 1 || org > 35)
			{
				SendClientMessage(playerid, COR_GREY, "Organiza��es de 1 a 35");
				return true;
			}
			new Orgs = 0;
    	    new string[128];
			foreach(new i: Player)
			{
			    if(GetPlayerOrg(i) == org)
			    {
			        Orgs += 1;
			    }
			}
			if(Orgs >= 1)
			{
			    new price = dindin * Orgs;
			    if(CofreOrg[7][Dinheiro] < price)return SendClientMessage(playerid, COR_GRAD1, "O cofre da prefeitura n�o tem esse dinheiro todo!");
                SacarOrgGrana(7,price);
                PLV += price;
                format(string, sizeof(string), "Voc� deu R$%d de taxa para cada um da Organiza��o %s!",dindin, GetOrgName(org));
				SendClientMessage(playerid, COR_GREY, string);
				format(string, sizeof(string), "Gasto Total: R$%d!",price);
				SendClientMessage(playerid, COR_GREY, string);
			    foreach(new i: Player)
				{
				    if(GetPlayerOrg(i) == org)
			    	{
				        format(string, sizeof(string), "* Voc� recebeu R$%d do banco de Impostos pelo Prefeito.",dindin);
						SendClientMessage(i, COR_LIGHTBLUE, string);
						GivePlayerMoneyEx(i, dindin);
			     	}
				}
			}
			else
			{
			    SendClientMessage(playerid, COR_GREY, "  N�o h� nenhum Membro Desta Org Online no Momento !");
				return true;
			}
			return true;
	}
