stock TentouDivulgar(string[])
{
	new x=0;
	for (new i = 0, j = strlen(string); i <= j; ++i)
	{
		if (string[i] >= 46 && string[i] <= 58)
		{
		    x+=1;
		}
	}
	if(x >= 8) return 1;
	if(strfind(string, "67", true) != -1 || strfind(string, "75", true) != -1 || strfind(string, "91", true) != -1 || strfind(string, "109", true) != -1
 	|| strfind(string, "112", true) != -1 || strfind(string, "120", true) != -1 || strfind(string, "121", true) != -1 || strfind(string, "124", true) != -1|| strfind(string, "157", true) != -1 || strfind(string, "157", true) != -1 || strfind(string, "167", true) != -1 ||  strfind(string, "168", true) != -1
 	|| strfind(string, "168", true) != -1 || strfind(string, "1 6 8", true) != -1 || strfind(string, "169", true) != -1 ||  strfind(string, "1 6 9", true) != -1|| strfind(string, "172", true) != -1 || strfind(string, "175", true) != -1 || strfind(string, "178", true) != -1 ||  strfind(string, "189", true) != -1
