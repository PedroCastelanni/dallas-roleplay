	CMD:assaltar(playerid, params[])
	{
        if(IsACop(playerid))
		{
			SendClientMessage(playerid, COR_LIGHTRED, "{FF0000}[Erro]{FFFFFF} apenas membros de familia ou organizacoes podem efetuar acoes como roubos" );
			return 1;
		}
		if(!IsABand(playerid))
		{
			SendClientMessage(playerid, COR_LIGHTRED, "{FF0000}[Erro]{FFFFFF} apenas membros de familia ou organizacoes podem efetuar acoes como roubos" );
			return 1;
		}
		if(PlayerInfo[playerid][pJailed] != 0)
		{
			SendClientMessage(playerid,COR_LIGHTRED," Voc� n�o pode assaltar agora!");
			return 1;
		}
		if(PlayerInfo[playerid][pAdmin] >= 1 && PlayerInfo[playerid][pAdmin] <= 1339)
		{
			SendClientMessage(playerid, COR_GRAD1, "Voc� � um admin, n�o pode assaltar !");
			return 1;
		}
		if(IsPlayerConnected(playerid))
		{
			if(UsouComando[playerid] == 1)
			{
				SendClientMessage(playerid, COR_VERMELHO, "Voc� j� usou esse comando uma vez, espere mais 5 minutos!");
				return 1;
			}
			if(sscanf(params, "u", sscanfid))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /assaltar [id]");
				return 1;
			}
			if (IsPlayerConnected(sscanfid))
			{
				if(sscanfid != INVALID_PLAYER_ID)
				{
					if(PlayerInfo[sscanfid][pLevel] == 2)
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode assaltar novatos!");
						return 1;
					}
					if(GetPlayerOrg(sscanfid) == GetPlayerOrg(playerid))
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode usar este comando na sua pr�pria org!");
						return 1;
					}
					if (ProxDetectorS(5.0, playerid, sscanfid))
					{
						new dinheiro;
						dinheiro = GetPlayerMoneyEx(sscanfid);
						GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						format(stringZCMD, sizeof(stringZCMD), "* Voc� est� assaltando R$[%d] de %s.", dinheiro, giveplayerZCMD);
						SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "* %s: Isso � um assalto, Use /aceitar assalto. N�o seja ant-RP.", sendername, dinheiro);
						SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
