		if(!strcmp(npcname, "TPL_Motorista1", true)) //Checando se o nome do NPC � MeuPrimeiroNPC
		{
			PutPlayerInVehicle(playerid, CarrosOnibus[0], 0); //Colocar o NPC dentro do ve�culo que criamos para isso.
