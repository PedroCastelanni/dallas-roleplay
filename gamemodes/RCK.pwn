	CMD:multar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(!IsACop(playerid) && GetPlayerOrg(playerid) != 7)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o � um Oficial da Justi�a !");
				return 1;
			}
			if(OnDuty[playerid] != 1 && GetPlayerOrg(playerid) != 7)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o Bateu o cart�o!");
				return 1;
			}
			new result[64];
			if(sscanf(params, "us[64]", sscanfid, result))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /multar [ID] [Multa]");
				return 1;
			}
			if(IsPlayerConnected(sscanfid))
			{
				if(OnDuty[sscanfid] != 0)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode multar Policiais!");
					return 1;
				}
				if(PlayerInfo[sscanfid][pJailed] > 0)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode multar jogadores que estejam presos!");
					return 1;
				}
				if(GetPlayerState(sscanfid) != PLAYER_STATE_DRIVER)
				{
					SendClientMessage(playerid, -1, "Este jogador n�o est� dirigindo um ve�culo!");
					return 1;
				}
				if(PlayerInfo[sscanfid][pConnectTime] <  5)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode multar jogadores com menos de 5 horas de jogada !");
					return 1;
				}
				if(GetTickCount() - TempoMulta[sscanfid] < 4000)
				{
					SendClientMessage(playerid, COR_GRAD5, "Usaram este comando a pouco tempo,aguarde um pouco !");
					return 1;
				}
				if(sscanfid != INVALID_PLAYER_ID)
				{
					if (ProxDetectorS(25.0, playerid, sscanfid))
					{
						GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						if(!MultasServidor(result))
						{
							SendClientMessage(playerid, COR_LIGHTRED, "Esta multa que voc� digitou n�o existe, digite /multas para ver as multas existentes!");
							return 1;
						}
						if(sscanfid == playerid)
						{
							SendClientMessage(playerid, COR_GREY, "Voc� n�o pode se multar!");
							return 1;
						}
						if(strcmp(result,"CM",true) == 0) { result = "Dirigindo na Contra-M�o"; MultadoCM[sscanfid] = 1; }
						if(strcmp(result,"DB",true) == 0) { result = "Dirigindo Embreagado"; MultadoDB[sscanfid] = 1; }
						if(strcmp(result,"DP",true) == 0) { result = "Dire��o Perigosa"; MultadoDP[sscanfid] = 1; }
						if(strcmp(result,"EI",true) == 0) { result = "Estacionamento Indevido"; MultadoEI[sscanfid] = 1; }
						if(strcmp(result,"FD",true) == 0) { result = "Farol Desligado"; MultadoFD[sscanfid] = 1; }
						if(strcmp(result,"VD",true) == 0) { result = "Ve�culo Danificado"; MultadoVD[sscanfid] = 1; }
						if(strcmp(result,"TNC",true) == 0) { result = "Trafegando na Cal�ada"; MultadoTNC[sscanfid] = 1; }
						//talvez colocar aki as variav�ls do setamento dos valores das multas.
						format(stringZCMD, sizeof(stringZCMD), "[MULTAS] %s multou %s por R$[%d], Raz�o:[%s] Speed:[%d]", PlayerName(playerid), giveplayerZCMD, moneysZCMD, (result), GetPlayerSpeed(sscanfid, true));
						SendFamilyMessage(1, COR_LIGHTBLUE, stringZCMD);
						SendFamilyMessage(2, COR_LIGHTBLUE, stringZCMD);
