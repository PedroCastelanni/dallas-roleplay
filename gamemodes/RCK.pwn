			{

				new lolz = GetPlayerFamilia(playerid);
				if(TemVagaF(lolz) == 0)
				{

					SendClientMessage(playerid, COR_GRAD1, "N�o h� mais vagas na lista use /limparvagaf primeiro.");
					return 1;
