			HouseInfo[idx][hArm] = DOF2_GetInt(files, "Arm");
			HouseInfo[idx][hInt] = DOF2_GetInt(files, "Interior");
			HouseInfo[idx][hLock] = DOF2_GetInt(files, "Lock");
			HouseInfo[idx][hOwned] = DOF2_GetInt(files, "TemDono");
			HouseInfo[idx][hRooms] = DOF2_GetInt(files, "Rooms");
			HouseInfo[idx][hRent] = DOF2_GetInt(files, "Rent");
			HouseInfo[idx][hRentabil] = DOF2_GetInt(files, "Rentabil");
			HouseInfo[idx][hTakings] = DOF2_GetInt(files, "Takings");
			HouseInfo[idx][hVec] = DOF2_GetInt(files, "Veiculo");
			HouseInfo[idx][hVcol1] = DOF2_GetInt(files, "color1");
			HouseInfo[idx][hVcol2] = DOF2_GetInt(files, "color2");
			HouseInfo[idx][hDate] = DOF2_GetInt(files, "Data");
			HouseInfo[idx][hLevel] = DOF2_GetInt(files, "Nivel");
			HouseInfo[idx][hWorld] = idx;

			HouseInfo[idx][hCarrox] = DOF2_GetFloat(files, "Carrox");
			HouseInfo[idx][hCarroy] = DOF2_GetFloat(files, "Carroy");
			HouseInfo[idx][hCarroz] = DOF2_GetFloat(files, "Carroz");
			HouseInfo[idx][hCarroa] = DOF2_GetFloat(files, "Carroa");

   			//HouseInfo[idx][hIdCarro] = AddStaticVehicleEx(HouseInfo[idx][hVec], HouseInfo[idx][hCarrox], HouseInfo[idx][hCarroy], HouseInfo[idx][hCarroz], HouseInfo[idx][hCarroa], HouseInfo[idx][hVcol1], HouseInfo[idx][hVcol2], -1);
			VTrancado[HouseInfo[idx][hIdCarro]] = 1;
			gCarLock[HouseInfo[idx][hIdCarro]] = 1;

	    	if(HouseInfo[idx][hOwned] == 0)
			{
	        	HousePickup[idx] = AddStaticPickup(1273, 23, HouseInfo[idx][hEntrancex], HouseInfo[idx][hEntrancey], HouseInfo[idx][hEntrancez]);
	        	format(tstring, sizeof(tstring), TextCasaVenda,HouseInfo[idx][hValue],HouseInfo[idx][hDiscription],HouseInfo[idx][hLevel]);
	        	HouseLabel[idx] = Create3DTextLabel(tstring,0x00FF00FF,HouseInfo[idx][hEntrancex], HouseInfo[idx][hEntrancey], HouseInfo[idx][hEntrancez]+0.5,13.0, 0);
	   	 	}
	    	if(HouseInfo[idx][hOwned] == 1)
			{
	        	HousePickup[idx] = AddStaticPickup(19522, 23, HouseInfo[idx][hEntrancex], HouseInfo[idx][hEntrancey], HouseInfo[idx][hEntrancez]);
	        	if(HouseInfo[idx][hRentabil] == 0)
				{
	            	format(tstring, sizeof(tstring), TextCasa,HouseInfo[idx][hOwner],HouseInfo[idx][hRentabil],HouseInfo[idx][hDiscription]);
	            	HouseLabel[idx] = Create3DTextLabel(tstring,0x00FF00FF,HouseInfo[idx][hEntrancex], HouseInfo[idx][hEntrancey], HouseInfo[idx][hEntrancez]+0.5,13.0, 0);
	        	}
	        	else
				{
	            	format(tstring, sizeof(tstring), TextCasaAl,HouseInfo[idx][hOwner],HouseInfo[idx][hRent],HouseInfo[idx][hDiscription]);
	            	HouseLabel[idx] = Create3DTextLabel(tstring,0x00FF00FF,HouseInfo[idx][hEntrancex], HouseInfo[idx][hEntrancey], HouseInfo[idx][hEntrancez]+0.5,13.0, 0);
	        	}
	    	}
	    	carregarMoveis(idx);
		}
		idx++;
	}
	return idx;
}
