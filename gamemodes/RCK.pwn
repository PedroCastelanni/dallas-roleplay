forward AccountExists(Name[]);
public AccountExists(Name[])
{
    new Query[200];
    format(Query, sizeof(Query), "SELECT `ID` FROM `contas` WHERE `Nome` = '%s'", DB_Escape(Name));
    Resultado = db_query(Conexao,Query);
    if(db_num_rows(Resultado) > 0)
    {
     	db_free_result(Resultado);
        return true;
    }
    else
    {
     	db_free_result(Resultado);
        return false;
    }
}

stock SaveToMysql(String[])
{
	CharReplace(String, ''', '~');
	CharReplace(String, '`', '~');
	CharReplace(String, '|', '#');
}
stock LoadFromMysql(String[])
{
	CharReplace(String, '~', ''');
	CharReplace(String, '#', '|');
}
stock CharReplace(string[], character, replace) //n3d
{
    for(new i = strlen(string); (--i) != -1; )
        if(string[i] == character) string[i] = replace;
    return false;
}
TPL::ClearMarriage(playerid)
{
	if(IsPlayerConnected(playerid))
	{
		strmid(PlayerInfo[playerid][pMarriedTo], "Ninguem", 0, strlen("Ninguem"), 255);
		PlayerInfo[playerid][pMarried] = 0;
	}
	return 1;
}
TPL::ClearCrime(playerid)
{
	if(IsPlayerConnected(playerid))
	{
		new string[MAX_PLAYER_NAME];
		format(string, sizeof(string), "********");
		strmid(PlayerCrime[playerid][pAcusado], string, 0, strlen(string), 255);
		strmid(PlayerCrime[playerid][pAcusador], string, 0, strlen(string), 255);
		strmid(PlayerCrime[playerid][pAcusoCrime], string, 0, strlen(string), 255);
		strmid(PlayerCrime[playerid][pAccusedof], string, 0, strlen(string), 255);
	}
	return 1;
}
TPL::RemoverCorpo(playerid)
{
    DestroyActor(cActor[playerid][cActorID]);
	Delete3DTextLabel(cActor[playerid][cLabelID]);
	format(cActor[playerid][cName], 24, "");
	cActor[playerid][cPos][0] = 0.0;
	cActor[playerid][cPos][1] = 0.0;
	cActor[playerid][cPos][2] = 0.0;
	cActor[playerid][cPos][3] = 0.0;
	cActor[playerid][cSkinID] = 0;
	cActor[playerid][cInterior] = 0;
	cActor[playerid][cWorld] = 0;
	cActor[playerid][cActorID] = 0;
	return 1;
}

TPL::Lotto(number)//kfm hs sbhfgj
{
	new JackpotFallen = 0;
	TempoDisputa = SetTimer("DisputaHitAss", 5000, false); // Disputa Hitmans Assassins
    CheckFamiliaVIP();
    SendClientMessageToAll(COR_BRANCO, "Lot�rica: J� come�ou a loteria, a pr�xima ser� em 60 minutos.");
	format(gstring, sizeof(gstring), "Lot�rica: Hoje o bilhete sorteado foi o n� [%d].", number);
    SendClientMessageToAll(COR_LIGHTBLUE, gstring);
    foreach(new i: Player)
	{
		if(IsPlayerConnected(i))
		{
		    if(PlayerInfo[i][pLottoNr] > 0)
		    {
			    if(PlayerInfo[i][pLottoNr] == number)
			    {
			        JackpotFallen = 1;
					format(gstring, sizeof(gstring), "Lot�rica: %s ganhou na loteria e recebeu R$[%d].", PlayerName(i), Jackpot);
					SendClientMessageToAll(COR_LIGHTBLUE, gstring);
					format(gstring, sizeof(gstring), "* Voc� ganhou R$[%d] com seu bilhete da loteria.", Jackpot);
					SendClientMessage(i, COR_AMARELO, gstring);
					ConsumingMoney[i] = 1;
					GivePlayerMoneyEx(i, Jackpot);
			    }
			    else
			    {
			        SendClientMessage(i, COR_LIGHTBLUE, "* Seu bilhete n�o foi sorteado !");
			    }
			}
			PlayerInfo[i][pLottoNr] = 0;
		}
	}
	if(JackpotFallen)
	{
	    new rand = random(2000); rand += 3000;
	    Jackpot = rand;
	    SaveStuff();
	    format(gstring, sizeof(gstring), "Lot�rica: A Bolada foi levantada para: R$[%d].", Jackpot);
		SendClientMessageToAll(COR_LIGHTBLUE, gstring);
    }
	else
	{
	    new rand = random(2000); rand += 3000;
	    Jackpot += rand;
	    SaveStuff();
	    format(gstring, sizeof(gstring), "Lot�rica: A Bolada foi levantada para: R$[%d].", Jackpot);
		SendClientMessageToAll(COR_LIGHTBLUE, gstring);
	}
	return 1;
}
public OnPlayerDisconnect(playerid, reason)
{
    TaRgb[playerid] = false;
	SetPlayerColor(playerid, 0xFFFFFFFF);

    if(PlayerInfo[playerid][pCarKey] > 0)
    {
		 new arquivo[64];
		 new Float:Pos[3];
         format(arquivo, sizeof(arquivo), Pasta_CarrosVIP, PlayerInfo[playerid][pCarKey]);
	     if(DOF2_FileExists(arquivo))
	     {
	         if(!strcmp(DOF2_GetString(arquivo, "Dono"), PlayerName(playerid)))
			 {
			     foreach(new i: Player)
			     {
				     if(IsPlayerInVehicle(i, PlayerInfo[playerid][pCarKey]))
				     {
				        RemovePlayerFromVehicleEx(i);
				        GetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
                 		SetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
				     }
			     }
        		 SetVehiclePos(PlayerInfo[playerid][pCarKey], 268.6729, 2888.4353, 11.3289);
			     SetVehicleVirtualWorld(PlayerInfo[playerid][pCarKey], 20);
			 }
		 }
	}
	DOF2_SaveFile();
    OlhandoLojaVipText[playerid] = 0;
    OlhandoTDSkinsTDD[playerid] = 0;
    OlhandoTDCelularTXD[playerid] = 0;

    TirarTDCelularTXD(playerid);
    TirarTDSkinsTDD(playerid);
    TirarLojaVipText(playerid);
    {
    
    }
	if(JBL[playerid] > -1)
    {
        for(new j; j < MAX_JBL; j++)
        {
            if(InfoJBL[JblUsed][j] == JBL[playerid])
            {
                InfoJBL[JblUsed][j] = -1;
                DestroyDynamic3DTextLabel(InfoJBL[TextJBL][j]);
                InfoJBL[TextJBL][j] = CreateDynamic3DTextLabel("{FFFFFF}JBL", -1, -999.0, -98383.3, -9292.0, 10.0);//Text3D
            }
        }
        DestroyDynamicObject(JBL[playerid]);
        JBL[playerid] = -1;
    }
 	if(PlayerInfo[playerid][pCarFixo] > 0)
    {
		 new arquivo[64];
		 new Float:Pos[3];
         format(arquivo, sizeof(arquivo), Pasta_CarrosFixo, PlayerInfo[playerid][pCarFixo]);
	     if(DOF2_FileExists(arquivo))
	     {
	         if(!strcmp(DOF2_GetString(arquivo, "Dono"), PlayerName(playerid)))
			 {
			     foreach(new i: Player)
			     {
				     if(IsPlayerInVehicle(i, PlayerInfo[playerid][pCarFixo]))
				     {
				        RemovePlayerFromVehicleEx(i);
				        GetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
                 		SetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
				     }
			     }
                 SetVehiclePos(PlayerInfo[playerid][pCarFixo], 268.6729, 2888.4353, 11.3289);
			     SetVehicleVirtualWorld(PlayerInfo[playerid][pCarFixo], 20);
			 }
		 }
	}
 	if(ChatAtendimento[playerid] > 0)
	{
		foreach(new i: Player)
		{
			if(InviteAtt[i] == playerid)
			{
				ChatAtendimento[playerid] = 0;
				ChatAtendimento[i] = 0;
				InviteAtt[i] = 999;
				InviteAtt[playerid] = 999;
				IDAvaliou[playerid] = 999;
				IDAvaliou[i] = 999;
				NumeroChatAtendimento[i] = 0;
				NumeroChatAtendimento[playerid] = 0;
				format(gstring, 128, "* %s saiu do jogo.", PlayerName(playerid));
				SendClientMessage(i, COR_LIGHTBLUE, gstring);
			}
		}
	}
    new arquivofila[64];
	format(arquivofila, sizeof(arquivofila), Pasta_Relatorios,playerid);
	if(DOF2_FileExists(arquivofila))
	{
	    DOF2_RemoveFile(arquivofila);
	}
	new File[56],Float:pPosX[MAX_PLAYERS], Float:pPosY[MAX_PLAYERS], Float:pPosZ[MAX_PLAYERS], Float:pPosA[MAX_PLAYERS],pInterior[MAX_PLAYERS];
	format(File, 56, "Posicoes/%s.txt", PlayerName(playerid)); // Cria o "caminho" at� o local onde ser� salvo o Arquivo com a posi��o do Player
	GetPlayerPos(playerid, pPosX[playerid], pPosY[playerid], pPosZ[playerid]); // Pega a Posi��o do Player em X, Y e Z, e converte para "pPosX", "pPosY" e "pPosZ", respectivamente.
	GetPlayerFacingAngle(playerid, pPosA[playerid]); // Pega o �ngulo do Player em A e converte para pPosA, logo pPosA = �ngulo do Player
	pInterior[playerid] = GetPlayerInterior(playerid); // Pega o interior do Player, que fica armazenado em pInterior.
	if(!DOF2_FileExists(File)) // Checa se a File existe
	{
	    DOF2_CreateFile(File); // Se n�o existir, cria
	}
 	DOF2_SetFloat(File, "PosX", pPosX[playerid]); // Escreve dentro do Arquivo: "PosX = pPosX (posi��o que pegamos antes, lembra ?)
 	DOF2_SetFloat(File, "PosY", pPosY[playerid]); // Escreve dentro do Arquivo: "PosY = pPosY (posi��o que pegamos antes, lembra ?)
 	DOF2_SetFloat(File, "PosZ", pPosZ[playerid]); // Escreve dentro do Arquivo: "PosZ = pPosZ (posi��o que pegamos antes, lembra ?)
 	DOF2_SetFloat(File, "PosA", pPosA[playerid]); // Escreve dentro do Arquivo: "PosA = pPosA (posi��o que pegamos antes, lembra ?)
	DOF2_SetInt(File, "Interior", pInterior[playerid]); // Escreve dentro do Arquivo: "Interior = pInterior (interior que pegamos antes, lembra ?)
 	DOF2_SaveFile(); // Salva o arquivo.
 	//DestruirTimers
 	KillTimer(TimerAtualizador[playerid]);
 	KillTimer(checkgastimer[playerid]);
 	KillTimer(procuradotimer[playerid]);
 	//SalvarGrafites(playerid);
