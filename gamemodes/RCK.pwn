	CMD:entrargaragem(playerid, params[])
	{
		new string[64];
	    for(new g=0; g<MAX_GARAGENS; g++)
    	{
			if(PlayerToPointG(3.0, playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]))
			{
			    if(Garagem[g][cnLock] == 0)
			    {
			        if(Deletado[g] == false)
			        {
						if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
						{
							SetPlayerPos(playerid, COORDENADASGARAGEM);
							SetPlayerVirtualWorld(playerid, g+10);
							SetPlayerInterior(playerid, 2);
							format(string, sizeof(string), "Bem Vindo a Garagem %d.", g);
				    		SendClientMessage(playerid, 0x00AB00AA, string);
						}
						else
						{
						    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
       						{
								if(Garagem[g][cnCar] <= MAX_CARS)
							    {
              						foreach(new i: Player)
						        	{
										new tmpcar = GetPlayerVehicleID(playerid);
        								if(IsPlayerInVehicle(i, tmpcar))
        								{
											SetPlayerVirtualWorld(i, g+10);
											SetPlayerInterior(playerid, 2);
											Garagem[g][cnCar] ++;
											SetVehicleVirtualWorld(tmpcar, g+10);
											LinkVehicleToInterior(tmpcar, 2);
											SetVehiclePos(tmpcar, COORDENADASGARAGEM);
											//SetVehicleVirtualWorld(tmpcar, GetPlayerVirtualWorld(playerid));
											format(string, sizeof(string), "Bem Vindo a Garagem %d.", g);
 											SendClientMessage(i, 0x00AB00AA, string);
										}
									}
    							}
    							else
			    				{
			    				    SendClientMessage(playerid, 0xAD0000AA, "J� tem o m�ximo de Ve�culos aceitos dentro desta Garagem.");
			    				}
				    		}
			    			else
			    			{
			    			    SendClientMessage(playerid, 0xAD0000AA, "Apenas Motoristas podem Entrar e Sair da Garagem.");
			    			}
						}
					}
				}
				else
				{
				    format(string, sizeof(string), "O Port�o est� %s{AD0000}.", GetLockGaragem(g));
				    SendClientMessage(playerid, 0xAD0000AA, string);
				    break;
				}
			}
		}
	    return true;
	}
	CMD:sairgaragem(playerid, params[])
	{
		new string[128];
		for(new g=0; g<MAX_GARAGENS; g++)
    	{
    	    if(g == GetPlayerVirtualWorld(playerid)-10)
    	    {
	    		if(PlayerToPointG(3.0, playerid, COORDENADASGARAGEM))
    			{
    			    if(Garagem[g][cnLock] == 0)
    			    {
        		    	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
						{
							SetPlayerPos(playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]);
							SetPlayerVirtualWorld(playerid, 0);
							SetPlayerInterior(playerid, 0);
							format(string, sizeof(string), "Volte Sempre a Garagem %d.", g);
				    		SendClientMessage(playerid, 0x00AB00AA, string);
						}
						else
						{
						    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
             				{
              					foreach(new i: Player)
				        		{
									new tmpcar = GetPlayerVehicleID(playerid);
        							if(IsPlayerInVehicle(i, tmpcar))
        							{
										SetPlayerVirtualWorld(i, 0);
										SetPlayerInterior(playerid, 0);
										Garagem[g][cnCar] --;
										SetVehicleVirtualWorld(tmpcar, 0);
								        LinkVehicleToInterior(tmpcar, 0);
                                        SetVehiclePos(tmpcar, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]);
										format(string, sizeof(string), "Volte Sempre a Garagem %d.", g);
 										SendClientMessage(i, 0x00AB00AA, string);
									}
								}
				    		}
			    			else
			    			{
			    			    SendClientMessage(playerid, 0xAD0000AA, "Apenas Motoristas podem Entrar e Sair da Garagem.");
			    			}
						}
     				}
					else
					{
     					format(string, sizeof(string), "O Port�o est� %s{AD0000}.", GetLockGaragem(g));
     					SendClientMessage(playerid, 0xAD0000AA, string);
     					break;
					}
    			}
   			}
  		}
	    return true;
	}
