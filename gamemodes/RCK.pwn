//=================================[ COMANDOS ]=================================//
	CMD:disc(playerid, params[])
	{
		if(isnull(params)) return SendClientMessage(playerid, -1, "Use: /disc [Texto]");
	    new Str[500], Name[MAX_PLAYER_NAME];
	    GetPlayerName(playerid, Name, sizeof Name);
	    format(Str, sizeof Str, "{4682B4}Discord {FFFFFF}[%s] {FF8000}(ID: %d): {4682B4}%s", Name, playerid, params);
	    SendClientMessageToAll(0xACF6FFF6, Str);
	    printf("ChatGlobal", Str);
	    return true;
	}
    CMD:saciarall(playerid, params[])
	{
     		if(PlayerInfo[playerid][pAdmin] < 1340)
	    	{
				SendClientMessage(playerid, COR_GRAD1, " {FFFFFF} 	Voc� n�o pode usar este comando!");
				return 1;
	    	}
	    	if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			foreach(new i: Player)
			{
				PlayerInfo[i][pFome] = 100;
				PlayerInfo[i][pSede] = 100;
				AtualizarFomeSedeTDTD(i);
			}
			new string[128];
			format(string, 128, "AdmCmd: O Admin %s saciou a fome e sede de todos do servidor.",PlayerName(playerid));
			SendClientMessageToAll(COR_LIGHTGREEN,string);
			return 1;
	}
	CMD:saciar(playerid, params[])
	{
     		if(PlayerInfo[playerid][pAdmin] < 4)
	    	{
				SendClientMessage(playerid, COR_GRAD1, " {FFFFFF} 	Voc� n�o pode usar este comando!");
				return 1;
	    	}
	    	if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			new para1;
			if(sscanf(params, "u", para1))
			{
				SendClientMessage(playerid, COR_GRAD2, "USE: /saciarfome [ID do Player]");
				return 1;
			}
			GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
			GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
		    if(IsPlayerConnected(para1))
		    {
		        if(para1 != INVALID_PLAYER_ID)
		        {
		            new string[128];
					PlayerInfo[para1][pFome] = 100;
					PlayerInfo[para1][pSede] = 100;
					format(string, 128, "AdmCmd: O Admin %s saciou a fome/sede de %s.",playernameZCMD, giveplayerZCMD);
					ABroadCast(COR_LIGHTGREEN,string,1337);
					AtualizarFomeSedeTDTD(playerid);
				}
			}
			return 1;
	}
	CMD:verinventario(playerid, params[])
	{
	    new playa;
		if(PlayerInfo[playerid][pAdmin] < 3) return 1;
        if(sscanf(params, "u", playa))
	    {
            SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /verinventario [ID]");
			return 1;
	    }
		for(new i=0; i<75; i++)
		{
			if(InventarioInfo[playa][i][iSlot] != 19382)
			{
			    new id = InventarioInfo[playa][i][iSlot];
				format(stringZCMD, sizeof(stringZCMD), "Slot[%d]: %s, Quantidade [%d].", i, NomeItemInv(id), InventarioInfo[playa][i][iUnidades]);
				SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
			}
		}
		format(stringZCMD, sizeof(stringZCMD), "Invent�rio de %s",PlayerName(playa));
		SendClientMessage(playerid, COR_AMARELO, stringZCMD);
 		return 1;
	}
    CMD:saciarfome(playerid, params[])
	{
     		if(PlayerInfo[playerid][pAdmin] < 4)
	    	{
				SendClientMessage(playerid, COR_GRAD1, " {FFFFFF} 	Voc� n�o pode usar este comando!");
				return 1;
	    	}
	    	if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			new para1;
			new level;
			if(sscanf(params, "ud", para1, level))
			{
				SendClientMessage(playerid, COR_GRAD2, "USE: /saciarfome [ID do Player] [quantia]");
				return 1;
			}
			GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
			GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
		    if(IsPlayerConnected(para1))
		    {
		        if(para1 != INVALID_PLAYER_ID)
		        {
		            if(level < 1 || level > 100) return SendClientMessage(playerid, COR_GRAD2, "Use um valor de 1 - 100.");
		            new string[128];
					PlayerInfo[para1][pFome] = level;
					format(string, 128, "AdmCmd: O Admin %s saciou %d% de fome para %s.",playernameZCMD, level, giveplayerZCMD);
					ABroadCast(COR_LIGHTGREEN,string,1337);
					AtualizarFomeSedeTDTD(playerid);
				}
			}
			return 1;
	}
