TPL::Fazenda()
{
    new randomValor;
	randomValor = random(4);
	switch(randomValor)
	{
		case 0:
		{
		    for(new f = 0; f < sizeof(FBizzInfo); f++)
			{
	    		FBizzInfo[f][fbTill] += 1121;
				ExtortionFBiz(f, 1121);
				FBizzInfo[f][fbProducts] =- 3;
				PLE += 2121;
				DepositarOrgGrana(7,2121);

			}
		}
		case 1:
		{
		    for(new f = 0; f < sizeof(FBizzInfo); f++)
			{
	    		FBizzInfo[f][fbTill] += 2521;
				ExtortionFBiz(f, 2521);
				FBizzInfo[f][fbProducts] =- 2;
				PLE += 3426;
				DepositarOrgGrana(7,3426);
			}
		}
		case 2:
		{
		    for(new f = 0; f < sizeof(FBizzInfo); f++)
			{
	    		FBizzInfo[f][fbTill] += 1675;
				ExtortionFBiz(f, 1675);
				FBizzInfo[f][fbProducts] =- 1;
				PLE += 1633;
				DepositarOrgGrana(7,1633);
			}
		}
		case 3:
		{
		    for(new f = 0; f < sizeof(FBizzInfo); f++)
			{
	    		FBizzInfo[f][fbTill] += 3369;
				ExtortionFBiz(f, 3369);
				FBizzInfo[f][fbProducts] =- 4;
				PLE += 3483;
				DepositarOrgGrana(7,3483);
			}
		}
	}
}

TPL::SetPlayerSpawn(playerid)
{
	new rand;
	if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
	{
		if(PlayerInfo[playerid][pSex] == 0)
		{
			PlayerInfo[playerid][pSex] = 1;
		}
		if(sincronizando[playerid] == 1)
		{
			return 1;
		}
		if(MedicBill[playerid] >= 2 && PlayerInfo[playerid][pJailed] == 0)
		{

		}
		if(PlayerInfo[playerid][pVIP] > 0)
		{
			SetPlayerHealth(playerid, 100.0);
		}
		else
		{
			SetPlayerHealth(playerid, 100+PlayerInfo[playerid][pSHealth]);
		}
		MenuTR[playerid] = 0;
		headshot[playerid] = 0;
		spawnado[playerid] = 1;
		MedicBill[playerid] ++;
		SetPlayerToTeamColor(playerid);
		protecao[playerid] = 0;
		RemovePlayerAttachedObject(playerid,9);
	 	// -------------------------------------------------//
	 	if(AindaTemConta[playerid] == 1)
	 	{
	 		 new string2[150];
			 format(string2, sizeof(string2), "Players/%s.ini", PlayerName(playerid));
			 new stringc3[150];
	 		 format(stringc3, sizeof(stringc3), "Players/%s.cfg", PlayerName(playerid));
		 	 strmid(PlayerInfo[playerid][pAntiBug], DOF2_GetString(string2, "AntiBug"), 0, strlen(DOF2_GetString(string2, "AntiBug")), 255);
			 strmid(PlayerInfo[playerid][pSenha], DOF2_GetString(string2, "Key"), 0, strlen(DOF2_GetString(string2, "Key")), 255);
		     PlayerInfo[playerid][pLevel] = DOF2_GetInt(string2, "Level");
		     PlayerInfo[playerid][pAdmin] = DOF2_GetInt(string2, "AdminLevel");
		     PlayerInfo[playerid][pAvaliacoes] = DOF2_GetInt(string2, "Avaliacoes");
		     PlayerInfo[playerid][pAFinal] = DOF2_GetInt(string2, "AvaFinal");
		     PlayerInfo[playerid][pVIP] = DOF2_GetInt(string2, "VipLevel");
		     PlayerInfo[playerid][pSocio] = DOF2_GetInt(string2, "SocioLevel");
		     PlayerInfo[playerid][pConnectTime] = DOF2_GetInt(string2, "HorasJogadas");
		     PlayerInfo[playerid][pReg] = DOF2_GetInt(string2, "Registrado");
