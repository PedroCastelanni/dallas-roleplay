				GivePlayerWeapon(playerid, 36, 2);
				return 1;
			}
			if (PlayerInfo[playerid][pCargo] == 3)
			{
				format(string, sizeof(string), "[%s]: %s pega seus equipamentos de [C3]." ,NomeORG(playerid), sendername);
