					SetPlayerAttachedObject(playerid, 10, 2906, 6, -0.2, 0.0, 0.0, 0, 345, 270, 1.0, 1.0, 1.0);
					SetPlayerAttachedObject(playerid, 2, 2908, 2, 0.05,0.06, 0.0, 180, 0.0, 90, 1.1, 1.1, 1.1);
					SetPlayerAttachedObject(playerid, 3, 2905, 12, 0.1, 0.05, 0.0, 0.0, 0.0, -70, 1.0, 1.0, 1.0);
					ResetPlayerWeaponsEx(playerid);
	  				SetPlayerSkin(playerid, 162);
	          		//
			        if(InfectouHumanos[issuerid] == 1 || InfectouHumanos[issuerid] == 2)
			        {
			        	format(string, sizeof(string), "[Quarentena]%s infectou %s - Ganhou:[R$4000] e recuperou[30] da sua vida.",PlayerName(issuerid), PlayerName(playerid));
				        MensagemQuarentena(COR_VERDE, string);
				        GivePlayerHealth(issuerid, 30);
			        }
			        if(InfectouHumanos[issuerid] == 3)
			        {
		        		format(string, sizeof(string), "[Quarentena]%s infectou %s - Ganhou:[R$4000] e recuperou[30] da sua vida.",PlayerName(issuerid), PlayerName(playerid));
				        MensagemQuarentena(COR_VERDE, string);
			        	format(string, sizeof(string), "[Quarentena] Infectado: %s infectou 3 humanos virou jumper - Ganhou [R$5000] e recuperou sua vida.",PlayerName(issuerid), PlayerName(playerid));
				        MensagemQuarentena(COR_LIGHTRED, string);
				        format(string, sizeof(string), "[Quarentena] Dica: Pule mais alto apertando a tecla shift e busque os jogadores nos telhados !");
				        SendClientMessage(issuerid, COR_LIGHTRED, string);
				        SetPlayerSkin(issuerid,160);
				        pClassiQuarentena[issuerid] = JUMPER;
				        GivePlayerHealth(issuerid, 100);
				        GivePlayerMoneyEx(issuerid, 5000);
			        }
			        if(InfectouHumanos[issuerid] == 4)
			        {
		        		format(string, sizeof(string), "[Quarentena]%s infectou %s - Ganhou:[R$4000] e recuperou[30] da sua vida.",PlayerName(issuerid), PlayerName(playerid));
				        MensagemQuarentena(COR_VERDE, string);
			        	format(string, sizeof(string), "[Quarentena] Infectado: %s infectou 4 humanos virou jumper - Ganhou [R$5000] e recuperou sua vida.",PlayerName(issuerid), PlayerName(playerid));
				        MensagemQuarentena(COR_LIGHTRED, string);
				        SetPlayerSkin(issuerid, 181);
				        GivePlayerHealth(issuerid, 100);
				        GivePlayerMoneyEx(issuerid, 5000);
			        }
			        if(InfectouHumanos[issuerid] == 5)
			        {
		        		format(string, sizeof(string), "[Quarentena]%s infectou %s - Ganhou:[R$4000] e recuperou[30] da sua vida.",PlayerName(issuerid), PlayerName(playerid));
				        MensagemQuarentena(COR_GREEN, string);
			        	format(string, sizeof(string), "[Quarentena] Infectado: %s infectou 5 humanos, virou boomer  - Ganhou[R$6000] e recuperou sua vida.",PlayerName(issuerid), PlayerName(playerid));
				        MensagemQuarentena(COR_LIGHTRED, string);
				        format(string, sizeof(string), "[Quarentena] Dica: Se voc� for morrer, se aproxime dos humanos, voc� ir� infect�-los com sua explos�o !");
				        SendClientMessage(issuerid, COR_LIGHTRED, string);
				        pClassiQuarentena[issuerid] = BOOMER;
				        SetPlayerSkin(issuerid, 264);
				        SetPlayerHealth(issuerid, 100);
				        GivePlayerMoneyEx(issuerid, 6000);
			        }
		    	    if(Vidaa >= 90)
		    	    {
	                    SetPlayerHealth(issuerid, 100);
		    	    }
	           	}
		    }
			return 1;
	     }
     }
     //MARTELINHO DO BAN
	 if(UmMartelinho[issuerid] == true && weapon == 5)
	 {
		new banmessage[50+MAX_PLAYER_NAME*2]; //Our string
		format(banmessage,sizeof(banmessage),"{FF0000}O admin %s baniu %s com seu martelinho do ban.",PlayerName(issuerid),PlayerName(playerid)); //We format it with the player and victim's name.
		SendClientMessageToAll(-1,banmessage); //We send the message to everyone.
	    getdate(Ano, Mes, Dia); //We get the date.
	    gettime(Hora, Minuto, Segundo); //We get the time.
	    format(gstring, sizeof(gstring), "[%04d/%02d/%02d - %02d:%02d:%02d] %s baniu %s com seu martelinho do ban\r\n", Ano, Mes, Dia, Hora, Minuto, Segundo, PlayerName(issuerid),PlayerName(playerid)); //We format the string
	    BanLog(gstring);
		PlayerInfo[playerid][pDiaBanTemp] = 0;
		PlayerInfo[playerid][pMesBanTemp] = 0;
		PlayerInfo[playerid][pAnoBanTemp] = 0;
		OnPlayerSave(playerid);
		PlayerPlaySound(playerid, 31202, 0.0, 0.0, 0.0);
		BanTPL(playerid, "MARTELINHO DO BAN", PlayerName(issuerid));
	 }
	 //------------------------------------------------------------------------------
	 //playerid
