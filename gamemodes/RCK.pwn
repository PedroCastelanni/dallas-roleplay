	CMD:dc(playerid, params[])return ForT:deletarconta(playerid,params);
	CMD:deletarconta(playerid, params[])
	{
	    if(PlayerInfo[playerid][pAdmin] != 1342) return 1;
     	if(isnull(params))  return SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /deletarconta [Nick]");
     	if (PlayerInfo[playerid][pAdmin] < 1341)
		{
     		SendClientMessage(playerid, COR_GREY,"Voc� n�o tem permiss�o para usar esse comando!");
     		return 1;
		}
		getdate(v[0], v[1], v[2]);
		gettime(v[3], v[4], v[5]);
		new Query[200];
	    format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(params));
	    Resultado = db_query(Conexao,Query);
	    if(db_num_rows(Resultado) > 0)
	    {
			format(stringZCMD, 128, "[%d/%d/%d] [%d:%d:%d] %s Apagou a conta: %s", v[2], v[1], v[0], v[3], v[4], v[5] , PlayerName(playerid), params);
			SendClientMessage(playerid, COR_AMARELO, stringZCMD);
			format(Query, sizeof(Query), "DELETE FROM `contas` WHERE `Nome`='%s'",DB_Escape(params));
			Resultado = db_query(Conexao,Query);
	    	//mysql_store_result();
	    }
	    else
	    {
	        SendClientMessage(playerid, COR_AMARELO, "Usuario n�o encontrado em nosso banco de dados!");
	        return 1;
	    }
     	return 1;
	}
