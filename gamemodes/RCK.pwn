	new contarcarrosvip = 0;
	new contarcarrosfixo = 0;
 	for(new x = 991; x != 1200; ++x)
	{
	    new arquivo[20];
		format(arquivo, sizeof(arquivo), Pasta_CarrosVIP,x);
		x = AddStaticVehicleEx(560, 268.6729, 2888.4353, 11.3289, 0.0, 0, 0, -1);
		SetVehicleVirtualWorld(x, 20);
		if(DOF2_FileExists(arquivo))
		{
			SetVehicleVirtualWorld(x, 20);
			VTrancado[x] = 1;
			gCarLock[x] = 1;
			LockCar(x);
			Gas[x] = 100;
			SetVehicleNumberPlate(x, "{000000}CARRO VIP");
			CarrosFixados(x);
			PlacaCarros(x);
			contarcarrosvip++;
		}
		format(arquivo, sizeof(arquivo), Pasta_CarrosFixo,x);
		if(DOF2_FileExists(arquivo))
		{
		    SetVehicleVirtualWorld(x, 21);
			VTrancado[x] = 1;
			gCarLock[x] = 1;
			LockCar(x);
			Gas[x] = 100;
			SetVehicleNumberPlate(x, "{000000}CARRO FIXO");
			CarrosFixados(x);
			PlacaCarros(x);
			contarcarrosfixo++;
		}
 	}
 	printf("=> Carros VIPs       		: %d Carregados",contarcarrosvip);
	printf("=> Carros Fixos       		: %d Carregados",contarcarrosfixo);
	printf("=> Total Carros       		: %d Criados", TOTAL_CARROS);
	printf("=> M�ximo de Jogadores      	: %d Vagas", MAX_PLAYERS-1);
	for(new car; car != MAX_VEHICLES; ++car)
	{
		new Float:Distancia = GetVehicleDistanceFromPoint(car, 1.5343,-0.8107,3.1172); // Essa Fun��o � a Mais Importante, Veja Sobre ela no final do code.
		if(Distancia <= 20)
		{
  			foreach(new viado: Player)
	    	{
	    		if(!IsPlayerInVehicle(viado, car))
		    	{
					SetVehicleVirtualWorld(car, 1);
				}
			}
		}
	}
	CriarTDSkinsTDD();
	CriarTDLojaVipText();
	CriarTDCelularTXD();
	//NPC
	//ConnectNPC("TPL_Motorista1","Bus");
	//ConnectNPC("TPL_Motorista2","Bus2");
    return 1;
}

TPL::SyncTime()
{
	new tmphour;
	new tmpminute;
	new tmpsecond;
	gettime(tmphour, tmpminute, tmpsecond);
	Fixhour(tmphour);
	tmphour = shifthour;
	if ((tmphour > ghour) || (tmphour == 0 && ghour == 23))
	{
		ghour = tmphour;
		new rand = random(99);
		if(rand < 96) { rand += 3; }
		Lotto(rand);
		VenderCasa();
		//VenderEmp();
		SetHora();
	}
}
TPL::GetClosestPlayer(p1)
{
	new x,Float:dis,Float:dis2,player;
	player = -1;
	dis = 99999.99;
	for (x=0;x<MAX_PLAYERS;x++)
	{
		if(IsPlayerConnected(x))
		{
			if(x != p1)
			{
				dis2 = GetDistanceBetweenPlayers(x,p1);
				if(dis2 < dis && dis2 != -1.00)
				{
					dis = dis2;
					player = x;
				}
			}
		}
	}
	return player;
}
TPL::Procuradonivel(playerid)
{
	if(IsPlayerConnected(playerid))
	{
 		if(WantedLevel[playerid] >= 1)
		{
			WantedLevel[playerid] -= 1;
			SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
   			format(gstring, sizeof(gstring), "N�vel de Procura Atual: %d", WantedLevel[playerid]);
			SendClientMessage(playerid, COR_AMARELO, gstring);
			SetPlayerChatBubble(playerid, ".", COR_VERMELHO, 1, 1);
		}
	}
}
stock SetPlayerWantedLevelEx(playerid, level)
{
	SetPlayerWantedLevel(playerid, 0);
	new string[55];
	if(level < 1){
		PlayerTextDrawHide(playerid, Estrelas[0][playerid]);
		PlayerTextDrawHide(playerid, Estrelas[1][playerid]);
		return true;
	}
	if(level > 10){

	    level = 10;
	}
	for(new i; i < level; i++){

	    strcat(string, "~y~]");
	    if(i == 5)
			strcat(string, "~n~");

	}
	PlayerTextDrawSetString(playerid, Estrelas[1][playerid], string);
	PlayerTextDrawShow(playerid, Estrelas[0][playerid]);
	PlayerTextDrawShow(playerid, Estrelas[1][playerid]);
	return true;
}
