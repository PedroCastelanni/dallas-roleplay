			if(PlayerInfo[playerid][pMembro] > 0 || PlayerInfo[playerid][pLider] > 0)
			{
				if(DeslogandoSocio[playerid] == 1) { return 1; }
				if(lideradmin[playerid] == 1) { return 1; }
				if(PlayerInfo[playerid][pLider] > 0) { SendClientMessage(playerid, COR_LIGHTRED, "Voc� foi demitido de l�der por um admin, agora voc� � um Civil !"); }
				else { SendClientMessage(playerid, COR_LIGHTRED, "O Seu l�der lhe demitiu. Voc� agora � um Civil !"); }
