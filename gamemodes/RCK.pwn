	CMD:entrar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			for(new i = 0; i < sizeof(HouseInfo); ++i)
			{
				if (PlayerToPoint(2, playerid,HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
				{
					if(PlayerInfo[playerid][pLevel] == 2)
					{
						SendClientMessage(playerid, -1, "Voc� n�o tem level necess�rio para entrar em casa !");
						return 1;
					}
					if(PlayerInfo[playerid][pPHousekey] == i || HouseInfo[i][hLock] == 0)
					{
						SetPlayerInterior(playerid,HouseInfo[i][hInt]);
						SetPlayerVirtualWorld(playerid,HouseInfo[i][hWorld]);
						SetPlayerPos(playerid,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]);
						GameTextForPlayer(playerid, "~w~Bem vindo em casa", 5000, 6);
						InteriorAtual[playerid] = HouseInfo[i][hInt];
						LocalAtual[playerid] = i;
						HouseEntered[playerid] = i;
						ShowLoadInt(playerid);
					}
					else
					{
						GameTextForPlayer(playerid, "~r~Fechado", 5000, 3);
					}
				}
			}
			for(new i = 0; i < sizeof(BizzInfo); ++i)
			{
				if (PlayerToPoint(2, playerid,BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ]))
				{
					if(PlayerInfo[playerid][pPbiskey] == i || GetPlayerMoneyEx(playerid) >= BizzInfo[i][bEntranceCost])
					{
						if(PlayerInfo[playerid][pPbiskey] != i)
						{
							if(BizzInfo[i][bLocked] == 1)
							{
								GameTextForPlayer(playerid, "~r~Fechado", 5000, 3);
								return 1;
							}
							GivePlayerMoneyEx(playerid,-BizzInfo[i][bEntranceCost]);
							format(stringZCMD, sizeof(stringZCMD), "~r~-R$%d", BizzInfo[i][bEntranceCost]);
							GameTextForPlayer(playerid, stringZCMD, 5000, 3);
							BizzInfo[i][bTill] += BizzInfo[i][bEntranceCost];
							ExtortionBiz(i, BizzInfo[i][bEntranceCost]);
						}
						SetPlayerInterior(playerid,BizzInfo[i][bInterior]);
						if(PlayerToPoint(2, playerid,1412.078979,-1700.173583,13.539500))
						{
							InteriorAtual[playerid] = 47;
						}
						else if(PlayerToPoint(2, playerid,2085.6714,2066.7856,11.0579))
						{
							InteriorAtual[playerid] = 48;
						}
						else if(PlayerToPoint(2, playerid,1791.2120,-1164.6317,23.8281))
						{
							InteriorAtual[playerid] = 40;
						}
						else if(PlayerToPoint(2, playerid,851.2082,-2017.8881,12.8672))
						{
							InteriorAtual[playerid] = 41;
						}
						else if(PlayerToPoint(2, playerid,1498.3601,-1583.0319,13.5469))
						{
							InteriorAtual[playerid] = 49;
						}
						else if(PlayerToPoint(2, playerid,2177.5850,961.3901,10.8203))
						{
							InteriorAtual[playerid] = 50;
						}
						else if(PlayerToPoint(2, playerid,1631.8335,-1172.7843,24.0843))
						{
							InteriorAtual[playerid] = 51;
						}
						if (PlayerToPoint(2, playerid,BizzInfo[4][bEntranceX], BizzInfo[4][bEntranceY], BizzInfo[4][bEntranceZ]))
						{
							InteriorAtual[playerid] = 52;
							LoadObjects(playerid);
						}
						SetPlayerPos(playerid,BizzInfo[i][bExitX],BizzInfo[i][bExitY],BizzInfo[i][bExitZ]);
						LocalAtual[playerid] = i+99;
						new dood[MAX_PLAYER_NAME];
						GetPlayerName(playerid, dood, sizeof(dood));
						format(stringZCMD, sizeof(stringZCMD), "%s pagou R$%d para entrar na empresa %d", dood, BizzInfo[i][bEntranceCost], i);
						printf("%s", stringZCMD);
					}
					else
					{
						GameTextForPlayer(playerid, "~r~Voce nao tem dinheiro suficiente", 5000, 1);
					}
				}
			}
			for(new i = 0; i < sizeof(FBizzInfo); i++)
			{
				if (PlayerToPoint(3, playerid,FBizzInfo[i][fbEntranceX], FBizzInfo[i][fbEntranceY], FBizzInfo[i][fbEntranceZ]))
				{
					if(PlayerInfo[playerid][pPFazkey] == i || GetPlayerMoney(playerid) >= FBizzInfo[i][fbEntranceCost])
					{
						if(PlayerInfo[playerid][pPFazkey] != i)
						{
							if(FBizzInfo[i][fbProducts] < 1)
							{
								GameTextForPlayer(playerid, "~r~Fazenda sem produtos", 5000, 1);
								return true;
							}
							if(FBizzInfo[i][fbLocked] == 1)
							{
								GameTextForPlayer(playerid, "~r~Fazenda fechada", 5000, 1);
								return 1;
							}
						}
						SetPlayerInterior(playerid,3);
						InteriorAtual[playerid] = 52+i;
						GivePlayerMoneyEx(playerid,-FBizzInfo[i][fbEntranceCost]);
						format(stringZCMD, sizeof(stringZCMD), "~r~-R$%d", FBizzInfo[i][fbEntranceCost]);
						GameTextForPlayer(playerid, stringZCMD, 5000, 3);
						FBizzInfo[i][fbTill] += FBizzInfo[i][fbEntranceCost];
						SetPlayerPos(playerid,293.2219,309.9532,999.1522);
						SetPlayerVirtualWorld(playerid, i);
						format(stringZCMD, sizeof(stringZCMD), "%s pagou R$%d para entrar na fazenda %d", PlayerName(playerid), FBizzInfo[i][fbEntranceCost], i);
						printf("%s", stringZCMD);
						return true;
					}
					else
					{
						GameTextForPlayer(playerid, "~r~Voc� n�o possui dinheiro suficiente", 5000, 1);
						return true;
					}
				}
			}
		}
		return 1;
	}
	CMD:sair(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			for(new i = 0; i <  sizeof(HouseInfo); ++i)
			{
				if(PlayerToPoint(1, playerid,HouseInfo[i][hExitx], HouseInfo[i][hExity], HouseInfo[i][hExitz]))
				{
					if(HouseEntered[playerid] == i)
					{
						SetPlayerInterior(playerid,0);
						SetPlayerVirtualWorld(playerid,0);
						SetPlayerPos(playerid,HouseInfo[i][hEntrancex],HouseInfo[i][hEntrancey],HouseInfo[i][hEntrancez]);
						InteriorAtual[playerid] = 0;
						SetPlayerVirtualWorld(playerid, 0);
						LocalAtual[playerid] = 255;
						HouseEntered[playerid] = 999;
						return 1;
					}
				}
			}
			if(PlayerToPoint(2, playerid,316.3746,-169.6989,999.6010) ||  PlayerToPoint(2, playerid,285.8286,-85.2722,1001.5156)
			|| PlayerToPoint(2, playerid, -794.9362,490.6324,1376.1953) || PlayerToPoint(2, playerid,315.7019,-142.9840,999.6016)
			|| PlayerToPoint(2, playerid,1846.6278,-1721.8167,5202.5859) || PlayerToPoint(2, playerid, 832.6270,7.2666,1004.1797))
			{
				InteriorAtual[playerid] = 0;
			}
			for(new i = 0; i <  sizeof(BizzInfo); ++i)
			{
				if(PlayerToPoint(2, playerid,BizzInfo[i][bExitX], BizzInfo[i][bExitY], BizzInfo[i][bExitZ]))
				{
					ctlicencasls[playerid] = 0;
					ctlicencaslv[playerid] = 0;
					SetPlayerInterior(playerid,0);
					InteriorAtual[playerid] = 0;
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerPos(playerid,BizzInfo[i][bEntranceX],BizzInfo[i][bEntranceY],BizzInfo[i][bEntranceZ]);
					LocalAtual[playerid] = 255;
					return 1;
				}
			}
			if(PlayerToPoint(2, playerid, 293.2219,309.9532,999.1522))
			{
				SetPlayerInterior(playerid,0);
				InteriorAtual[playerid] = 0;
				SetPlayerPos(playerid,FBizzInfo[GetPlayerVirtualWorld(playerid)][fbEntranceX],FBizzInfo[GetPlayerVirtualWorld(playerid)][fbEntranceY],FBizzInfo[GetPlayerVirtualWorld(playerid)][fbEntranceZ]);
                SetPlayerVirtualWorld(playerid, 0);
				LocalAtual[playerid] = 255;
				return 1;
			}
			if(IsPlayerInAnyVehicle(playerid))
			{
				TogglePlayerControllable(playerid, 1);
				RemovePlayerFromVehicleEx(playerid);
			}
		}
		return 1;
	}
	CMD:home(playerid, params[])  return ForT:mapacasa(playerid, params);
