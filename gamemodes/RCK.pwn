	CMD:sacarfazenda(playerid, params[])
	{
			new borse = PlayerInfo[playerid][pPFazkey];
			if (borse == 255)
			{
				SendClientMessage(playerid, COR_GRAD2, "   Voc� n�o tem uma Empresa");
				return true;
			}
			new quant;
    	    new string[128];
			if(sscanf(params, "d", quant))
			{
				if (borse < 255)
				{
					format(string, sizeof(string), "  Voc� tem R$%d no cofre da fazenda.", FBizzInfo[borse][fbTill]);
					SendClientMessage(playerid, COR_GRAD3, string);
				}
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /sacarfazenda [quantidade]");
				return true;
			}
			new cashdeposit = quant;
			if (borse < 255)
			{
				if(cashdeposit > FBizzInfo[borse][fbTill] || cashdeposit < 1)
				{
					SendClientMessage(playerid, COR_GRAD2, "   Voc� nao tem essa quantia em sua Fazenda.");
					return true;
				}
			}
			if (borse < 255)
			{
				if(!PlayerToPoint(100, playerid,FBizzInfo[borse][fbEntranceX],FBizzInfo[borse][fbEntranceY],FBizzInfo[borse][fbEntranceZ]))
				{
					SendClientMessage(playerid, COR_GRAD2, "  Sua Fazenda esta longe de voc�.");
					return true;
				}
				else
				{
					GivePlayerMoneyEx(playerid,cashdeposit);
					FBizzInfo[borse][fbTill] -= cashdeposit;
					format(string, sizeof(string), "  Voc� retirou R$%d de sua fazenda - restante: R$%d ", cashdeposit,FBizzInfo[borse][fbTill]);
					SendClientMessage(playerid, COR_AMARELO, string);
					SalvarFEmpresa(borse);
				}
			}
			Atualizar3Dtexts();
			return true;
	}
 	CMD:depositarfazenda(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new borse = PlayerInfo[playerid][pPFazkey];
			if (borse == 255)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem uma fazenda.");
				return 1;
			}
			new cashdeposit;
			if(sscanf(params, "d", cashdeposit))
			{
				format(stringZCMD, sizeof(stringZCMD), "Voc� tem R$%d de saldo em sua fazenda.", FBizzInfo[borse][fbTill]);
				SendClientMessage(playerid, COR_GRAD3, stringZCMD);
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /depositarfazenda [quantidade]");
				return 1;
			}
			if (cashdeposit > GetPlayerMoneyEx(playerid) || cashdeposit < 1)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� n�o tem tanto");
				return 1;
			}
			if(!PlayerToPoint(100, playerid,FBizzInfo[borse][fbEntranceX],FBizzInfo[borse][fbEntranceY],FBizzInfo[borse][fbEntranceZ]))
			{
				SendClientMessage(playerid, COR_GRAD2, "  Sua Fazenda esta longe de voc�.");
				return true;
			}
			else
			{
				GivePlayerMoneyEx(playerid,-cashdeposit);
				FBizzInfo[borse][fbTill] += cashdeposit;
				ExtortionBiz(borse, cashdeposit);
				format(stringZCMD, sizeof(stringZCMD), "Voce depositou $%d no cofre de sua fazenda Total: $%d", cashdeposit,FBizzInfo[borse][fbTill]);
				SendClientMessage(playerid, COR_AMARELO, stringZCMD);
				return 1;
			}
		}
		return 1;
	}
