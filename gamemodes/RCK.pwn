	}
    if(sincronizando[playerid] == 1)
	{
		return 1;
	}
	gTeam[playerid] = PlayerInfo[playerid][pTeam];
	if (gTeam[playerid] == 4)
	{
		gTeam[playerid] = 3;
	}
