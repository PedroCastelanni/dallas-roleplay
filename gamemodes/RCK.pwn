	CMD:setarorgvip(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new org, tipo, dias;
			if(sscanf(params, "ddi", org, tipo, dias))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /setarorgvip [org] [tipo] [dias]");
				return 1;
			}
			if(org < 1 || org > 33)
			{
				SendClientMessage(playerid, COR_GRAD2, "Orgs 1 � 33.");
				return 1;
			}
			if(tipo < 1 || tipo > 3)
			{
				SendClientMessage(playerid, COR_GRAD2, "Tipos: 1 (Bronze), 2 (Prata), 3 (Ouro).");
				return 1;
			}
			new lolz[7];
			if(tipo == 1)
			{
				lolz = "Bronze";
			}
			if(tipo == 2)
			{
				lolz = "Prata";
			}
			if(tipo == 3)
			{
				lolz = "Ouro";
			}
			if(PlayerInfo[playerid][pAdmin] >= 1341)
			{

				new arquivo[64];
				getdate(year, month, day);
				format(arquivo, sizeof(arquivo), Pasta_ORGVIP, org);
				if(DOF2_FileExists(arquivo))
				{
					DOF2_SetInt(arquivo,"Tipo",tipo);
					DOF2_SetInt(arquivo,"Dias",dias);
					DOF2_SetInt(arquivo,"Data",day);
					format(stringZCMD, sizeof(stringZCMD), "AdmCmd: %s Ativou uma ORG VIP para a ORG:[%s], Tipo[%s], Dias[%d].",PlayerName(playerid),GetOrgName(org),lolz,dias);
					ABroadCast(COR_AMARELO,stringZCMD,1);
				}
				else
				{
					DOF2_CreateFile(arquivo);
					DOF2_SetInt(arquivo,"Tipo",tipo);
					DOF2_SetInt(arquivo,"Dias",dias);
					DOF2_SetInt(arquivo,"Data",day);
					format(stringZCMD, sizeof(stringZCMD), "AdmCmd: %s Ativou uma ORG VIP para a ORG:[%s], Tipo[%s], Dias[%d].",PlayerName(playerid),GetOrgName(org),lolz,dias);
					ABroadCast(COR_AMARELO,stringZCMD,1);
				}
				DOF2_SaveFile();
				LoadOrgs();
				return 1;
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o tem permissao para usar esse comando !");
			}
		}
		return 1;
	}
	CMD:agendarCoins(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new playa[64];
			new Coins;
			if(sscanf(params, "s[64]d", playa, Coins))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /agendarCoins [nomejogador] [Coins]");
				return 1;
			}
			if(PlayerInfo[playerid][pAdmin] >= 1342)
			{
				if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
					return 1;
				}
				new arquivo[64];
				GetPlayerName(playerid, sendername, sizeof(sendername));
				new Query[65];
				format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(playa));
				Resultado = db_query(Conexao,Query);
    			if(db_num_rows(Resultado) == 0)
				{
					SendClientMessage(playerid, COR_GRAD1, "Conta Inexistente!");
					return true;
				}
				format(arquivo, sizeof(arquivo), Pasta_Coins,playa);
				if(DOF2_FileExists(arquivo))
				{
					DOF2_SetString(arquivo,"Admin",PlayerName(playerid));
					DOF2_SetInt(arquivo,"Coins",Coins);
					format(stringZCMD,sizeof(stringZCMD), "[%d/%d/%d][Coins agendadas]%s agendou Coins no jogador: %s, Coins [%d].", day, month, year, sendername, playa, Coins);
					ABroadCast(COR_AMARELO,stringZCMD,1);
					CoinsAgendadasLog(stringZCMD);
				}
				else
				{
					DOF2_CreateFile(arquivo);
					DOF2_SetString(arquivo,"Admin",PlayerName(playerid));
					DOF2_SetInt(arquivo,"Coins",Coins);
					format(stringZCMD,sizeof(stringZCMD), "[%d/%d/%d][Coins agendadas]%s agendou Coins no jogador: %s, Coins [%d].", day, month, year, sendername, playa, Coins);
					ABroadCast(COR_AMARELO,stringZCMD,1);
					CoinsAgendadasLog(stringZCMD);
				}
				DOF2_SaveFile();
				return 1;
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o tem permissao para usar esse comando !");
			}
		}
		return 1;
	}
