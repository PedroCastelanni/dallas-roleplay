	CMD:corrida(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pMembro] == 10 || PlayerInfo[playerid][pLider] == 10 || PlayerInfo[playerid][pEmprego] == 4)
			{
				if(TransportDuty[playerid] > 0)
				{
					if(TransportDuty[playerid] == 1)
					{
						TaxiDrivers -= 1;
					}
					else if(TransportDuty[playerid] == 2)
					{
						BusDrivers -= 1;
					}
					TransportDuty[playerid] = 0;
					format(stringZCMD, sizeof(stringZCMD), "* Est� fora do servi�o, ganhou R$[%d].", TransportMoney[playerid]);
					SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
					GivePlayerMoneyEx(playerid, TransportMoney[playerid]);
					ConsumingMoney[playerid] = 1; TransportValue[playerid] = 0; TransportMoney[playerid] = 0;
					return 1;
				}
				new Veh = GetPlayerVehicleID(playerid);
				if(sscanf(params, "d", moneysZCMD))
				{
					SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /corrida [Preco]");
					return 1;
				}
				if(TaxistaCarros(Veh) && (PlayerInfo[playerid][pMembro] == 10||PlayerInfo[playerid][pLider] == 10))
				{
					if(GetPlayerState(playerid) == 2)
					{
						if(moneysZCMD < 1 || moneysZCMD > 110) { SendClientMessage(playerid, COR_GREY, "Pre�o da corrida m�nimo R$1 M�ximo R$110!"); return 1; }
						TaxiDrivers += 1; TransportDuty[playerid] = 1; TransportValue[playerid] = moneysZCMD;
						GetPlayerName(playerid,sendername,sizeof(sendername));
						format(stringZCMD, sizeof(stringZCMD), "[Taxista Dispon�vel] {FFFFFF}%s est� em servi�o, /servico taxi - Corrida: R$[%d]", sendername, TransportValue[playerid]);
						SendClientMessageToAll(COR_TAXI,stringZCMD);
						return 1;
					}
					else
					{
						SendClientMessage(playerid, COR_GREY, "Voce n�o � o motorista!");
						return 1;
					}
				}
				else if(OnibusCarros(Veh) && PlayerInfo[playerid][pEmprego] == 4)
				{
					if(GetPlayerState(playerid) == 2)
					{
						if(moneysZCMD < 1 || moneysZCMD > 2000) { SendClientMessage(playerid, COR_GREY, "{FFFFFF}Escolha o valor da sua corrida de R$1 ate {00FF00}R$2000!"); return 1; }
						BusDrivers += 1; TransportDuty[playerid] = 2; TransportValue[playerid]= moneysZCMD;
						GetPlayerName(playerid,sendername,sizeof(sendername));
						format(stringZCMD, sizeof(stringZCMD), "{FFFFFF}[Uber {FFFF00}99 pop {FFFFFF}Disponivel] {FFFFFF}%s esta rodando de uber - valor da corrida: {00ff00}R$[%d]", sendername, TransportValue[playerid]);
						SendClientMessageToAll(0x2993edFF,stringZCMD);
						return 1;
					}
					else
					{
						SendClientMessage(playerid, COR_GREY, "Voce n�o � o motorista!");
						return 1;
					}
				}
				else
				{
					SendClientMessage(playerid, COR_GREY, "Voce n�o est� em um taxi/onibus!");
					return 1;
				}
			}
			else
			{
				SendClientMessage(playerid,COR_GREY,"Voce n�o � um taxista/motorista de �nibus!");
				return 1;
			}
		}
		return 1;
	}
