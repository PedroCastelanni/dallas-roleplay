    CMD:showul(playerid)
	{
		new org = GetPlayerOrg(playerid);
		if(org < 1)return true;
		MEGAString[0] = EOS;

		new string[128];
		strcat(MEGAString, "{FF0000}|_____________[ L�deres ]_____________|\n");
	//--------------- Lideres -----------------
        new Query[80], result[10];
    	format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(InfoOrg[org][Lider]));
    	Resultado = db_query(Conexao,Query);
   		db_get_field_assoc(Resultado, "DiaLogin", result, sizeof(result));
		Dia = strval(result);
		db_get_field_assoc(Resultado, "MesLogin", result, sizeof(result));
		Mes = strval(result);
    	if(db_num_rows(Resultado) > 0)
		if(!strcmp(InfoOrg[org][Lider], "Ninguem", true)) strcat(MEGAString, "L�der: Ninguem - Login: Nunca\n");
		else format(string, 128, "L�der: %s - Login: [%02d/%02d]\n", InfoOrg[org][Lider], Dia, Mes),strcat(MEGAString, string);
    	format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(InfoOrg[org][SubLider]));
    	Resultado = db_query(Conexao,Query);
   		db_get_field_assoc(Resultado, "DiaLogin", result, sizeof(result));
		Dia = strval(result);
		db_get_field_assoc(Resultado, "MesLogin", result, sizeof(result));
		Mes = strval(result);
		if(!strcmp(InfoOrg[org][SubLider], "Ninguem", true)) strcat(MEGAString, "1� Sub-L�der: Ninguem - Login: Nunca\n");
		else format(string, 128, "Sub-L�der: %s - Login: [%02d/%02d]\n", InfoOrg[org][SubLider], Dia, Mes),strcat(MEGAString, string);
	//--------------- Membros ------------------
		strcat(MEGAString, "{FF0000}|_____________[ Membros ]_____________|\n");
    	format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(InfoOrg[org][Membro1]));
    	Resultado = db_query(Conexao,Query);
    	//mysql_store_result();
   		db_get_field_assoc(Resultado, "DiaLogin", result, sizeof(result));
		Dia = strval(result);
		db_get_field_assoc(Resultado, "MesLogin", result, sizeof(result));
		Mes = strval(result);
		if(!strcmp(InfoOrg[org][Membro1], "Ninguem", true)) strcat(MEGAString, "Membro 1: Ninguem - Login: Nunca\n");
		else format(string, 128, "Membro 1: %s - Login: [%02d/%02d]\n", InfoOrg[org][Membro1], Dia, Mes),strcat(MEGAString, string);
    	format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(InfoOrg[org][Membro2]));
