	CMD:gmx(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new gmx[100];
			if(PlayerInfo[playerid][pAdmin] >= 1337)
			{
				if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342) { return SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)"); }
				foreach(new i: Player)
				{
					if(IsPlayerConnected(i))
					{
						OnPlayerSave(i);
						EventoAcontecendo = 0;
						PlayerInfo[i][pTiroteio] = 0;
					}
					salvarGrafites();
					getdate(year, month, day);
					gettime(hour, minute);
					GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
					format(gmx,sizeof(gmx),"Admin: %s Reiniciou o Servidor!", playernameZCMD);
					SendClientMessage(i, COR_AMARELO, gmx);
					StopAudioStreamForPlayer(i);
				}
				GameModeExitFunc();
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o tem autoriza��o para usar este comando !");
			}
			GmxLog(gmx);
		}
		return 1;
	}
	CMD:infoorgvip(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			//SendClientMessage(playerid, 0xb6b7b9ff, "___________ Info OrgVip ___________");
			new arquivo[64];
			new InfoORGVIP[4000];
			InfoORGVIP[0] = EOS;
			for(new o = 1; o < MAX_ORGS; o++)
			{
				format(arquivo, sizeof(arquivo), "ORG VIPS/Org%d.ini",o);
				new tipo[25];
				if(DOF2_GetInt(arquivo, "Tipo") == 1)
				{
					tipo = "Bronze";
				}
				else if(DOF2_GetInt(arquivo, "Tipo") == 2)
				{
					tipo = "Prata";
				}
				else if(DOF2_GetInt(arquivo, "Tipo") == 3)
				{
					tipo = "Ouro";
				}
				if(DOF2_FileExists(arquivo))
				{
					if(DOF2_GetInt(arquivo, "Tipo") >= 1)
					{
						format(stringZCMD, 256, "%s: Dias[%d] Tipo[%s]\n",GetOrgName2(o), DOF2_GetInt(arquivo, "Dias"), tipo);
						strcat(InfoORGVIP, stringZCMD);
					}
				}
			}
			ShowPlayerDialog(playerid, 10201, DIALOG_STYLE_MSGBOX, "Info OrgVip", InfoORGVIP, "Fechar", "");
		}
		return 1;
	}
	CMD:admins(playerid, params[])
	{
		new str[126], strDialog[4000], Cont = 0, Nome[MAX_PLAYER_NAME];
		format(str, sizeof(str), "Nome\tStatus\tAvalia��es\n");
		strcat(strDialog, str);
		foreach(new i: Player)
		{
			if(IsPlayerConnected(i) == 1 && PlayerInfo[i][pAdmin] > 0 && PlayerInfo[i][pAdmin] < 1342)
			{
				new lolz[25];
				if(PlayerInfo[i][pAdmin] == 1)lolz = "Aprendiz";
				if(PlayerInfo[i][pAdmin] == 2)lolz = "Est�giario";
				if(PlayerInfo[i][pAdmin] == 3)lolz = "Auxiliar";
				if(PlayerInfo[i][pAdmin] == 4)lolz = "T�cnico";
				if(PlayerInfo[i][pAdmin] == 1337)lolz = "Administrador";
				if(PlayerInfo[i][pAdmin] == 1338)lolz = "Master";
				if(PlayerInfo[i][pAdmin] == 1339)lolz = "Gerente";
	            if(PlayerInfo[i][pAdmin] == 1340)lolz = "Sub-Dono";
				if(PlayerInfo[i][pAdmin] == 1341)lolz = "Dono";
				if(PlayerInfo[i][pAdmin] == 1342)lolz = "Fundador";
				GetPlayerName(i, Nome, MAX_PLAYER_NAME);
				new sub1 = PlayerInfo[i][pAFinal];
				new sub2 = PlayerInfo[i][pAvaliacoes];
				new conta = sub1 / sub2;
				if(admhide[i] == 0)
				{
					if(AdminTrabalhando[i] == 1 && EstaAFK[i] == 0)
					{

						format (str, sizeof str, "%s[%s]\t{00d900}Trabalhando\t{FFFFFF}%2d.0\n", Nome, lolz,conta);
						Cont++;
					}
					else if(PlayerInfo[i][pAvaliacoes] == 0 || PlayerInfo[i][pAFinal] == 0)
					{
						format (str, sizeof str, "%s[%s]\t{00d900}Trabalhando\t{FFFFFF}0.0\n", Nome, lolz);
						Cont++;
					}
					else
					{
						new taafk[25];
						if(EstaAFK[i] == 1) taafk = "{696969}Ausente";
						if(EstaAFK[i] == 0) taafk = "Jogando";
						format (str, sizeof str, "%s[%s]\t%s\t%d.0\n", Nome, lolz,taafk,conta);
						Cont++;
					}
				}
				strcat(strDialog, str);
			}
		}
		new titulo[35];
		format(titulo, sizeof(titulo), "Administradores Online {00d900}%d",Cont);
		{
			ShowPlayerDialog(playerid, 9997, DIALOG_STYLE_TABLIST_HEADERS, titulo, strDialog, "Particular", "Cancelar");
		}
		return 1;
	}
	CMD:trabalhar(playerid, params[])  return ForT:tb(playerid, params);
	CMD:tb(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] >= 1 && PlayerInfo[playerid][pAdmin] <= 1342)
		{
			if(AdminTrabalhando[playerid] > 0)
			{
				AdminTrabalhando[playerid] = 0;
				GetPlayerName(playerid,sendername,sizeof(sendername));
				format(stringZCMD, 128, "{BDBDBD}[STAFF] O administrador %s est� jogando.",sendername, playerid);
				SendClientMessageToAll(COR_DBLUE, stringZCMD);
				SetPlayerToTeamColor(playerid);
				ResetPlayerWeaponsEx(playerid);
				SetPlayerHealth(playerid, 100);
				SetPlayerSkin(playerid,skinadm[playerid]);
				TirarAureola(playerid);
			}
			else
			{
				AdminTrabalhando[playerid] = 1;
				GetPlayerName(playerid,sendername,sizeof(sendername));
				format(stringZCMD, 128, "{BDBDBD}[STAFF] O administrador %s est� trabalhando.",sendername, playerid);
				SendClientMessageToAll(COR_DBLUE, stringZCMD);
				SetPlayerToTeamColor(playerid);
				skinadm[playerid] = GetPlayerSkin(playerid);
				SetPlayerSkin(playerid,217);
				SetPlayerArmour(playerid, 100);
				SetPlayerHealth(playerid, 100);
				if(PlayerInfo[playerid][pSex] == 2) { SetPlayerSkin(playerid, 211); }
				ColocarAureola(playerid);
			}
		}
		return 1;
	}
