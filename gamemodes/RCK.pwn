	CMD:cordinha(playerid, params[])
	{
		if (PlayerInfo[playerid][pVIP] == 0 && !IsACop(playerid) && GetPlayerOrg(playerid) != 7 && GetPlayerOrg(playerid) != 4)
		{
			SendClientMessage(playerid, COR_GREY, "Voc� n�o � um VIP /COP /GOV /SAMU !");
			return 1;
		}
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsPlayerInAnyVehicle(playerid) && IsAAviao(vehicleid) && Sliding[playerid] == 0)
		{
			Sliding[playerid] = 1;
			RemovePlayerFromVehicle(playerid);
			TogglePlayerControllable(playerid, 0);
			SetTimerEx("Slide", 100, 0, "i", playerid);
			SetTimerEx("Slidee", 9000, 0, "i", playerid);
			SendClientMessage(playerid, COR_BRANCO, "Voc� est� escorregando na cordinha, quando chegar perto do ch�o digite novamente /cordinha !");
		}
		else if(Sliding[playerid] == 1)
		{
			Sliding[playerid] = 0;
			DestroyDynamicObject(Corda[playerid]);
			TogglePlayerControllable(playerid, 1);
		}
		return 1;
	}
	CMD:pararroubo(playerid, params[])
	{
		if(Roubando[playerid] > 0)
		{
		    if(InteriorAtual[playerid] >= 53 && InteriorAtual[playerid] <= 72) FazendaRoubada = GetPlayerVirtualWorld(playerid);
			foreach(new i: Player)
			{
				if(PlayerInfo[i][pChatRoubo] == 0)
				{
					format(stringZCMD, sizeof(stringZCMD), "%s e os %s cancelaram um roubo %s! ID:[%d]",PlayerName(playerid), NomeORG(playerid), getNameLocalRoubo(LocalDeRoubo[playerid]) , playerid);
					SendClientMessage(i, GetPlayerColor(playerid), stringZCMD);
				}
			}
			TogglePlayerControllable(playerid, 1);
			Roubando[playerid] = 0;
			KillTimer(TimerRoubando[playerid]);
			TempoRoubo_[playerid] = 0;
			RemovePlayerAttachedObject(playerid,9);
			ClearAnimations(playerid);
			SendClientMessage(playerid, COR_LIGHTRED, "Voc� perdeu -R$5.000 por cancelar este roubo!");
			GivePlayerMoneyEx(playerid, -5000);
		}
		else
		{
			SendClientMessage(playerid, COR_BRANCO, "Voc� n�o est� roubando nenhum lugar.");
			return 1;
		}
		return 1;
	}
	CMD:entrarorg(playerid, params[])
	{
		if (IsPlayerConnected(playerid))
		{
			new Float:Vida;
			GetPlayerHealth(playerid, Vida);
			if(PlayerInfo[playerid][pSocio] < 1)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o � um S�cio !");
				return 1;
			}
			if(pentrarorg[playerid] == 1)
			{
				SendClientMessage(playerid,COR_GRAD2,"Voc� s� pode usar este comando a cada 5 minutos, usou a pouco tempo!");
				return 1;
			}
			if(PlayerInfo[playerid][pMembro] != 0 || PlayerInfo[playerid][pLider] != 0)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� est� em algumar org,use /pedircontas antes !");
				return 1;
			}
			if(WantedLevel[playerid] != 0)
			{
				SendClientMessage(playerid, COR_AMARELO, "Voc� n�o pode trocar de org estando procurado pela pol�cia !");
				return 1;
			}
			if(PlayerInfo[playerid][pEmprego] == 3 || PlayerInfo[playerid][pEmprego] == 4 || PlayerInfo[playerid][pEmprego] == 5 || PlayerInfo[playerid][pEmprego] == 9)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� est� em um emprego que n�o pode ter organiza��o. digite /sairdoemprego !");
				return 1;
			}
			if(PlayerInfo[playerid][pJailed] != 0)
			{
				SendClientMessage(playerid,COR_AMARELO,"Voc� n�o pode trocar de org nesta situa��o !");
				return 1;
			}
			if(Vida <= 50)
			{
				SendClientMessage(playerid, COR_AMARELO, "Voc� deve ter mais da metade da vida pra trocar de org !");
				return 1;
			}
			new Celulas[140], str[4000];
			for(new x = 1; x < MAX_ORGS; x++)
			{
				format(Celulas, 140, "%s\n", GetOrgName(x));
				strcat(str, Celulas);
				ShowPlayerDialog(playerid, 585, DIALOG_STYLE_LIST, "Menu De Orgs S�cio", str, "Confirmar", "Cancelar");
			}
		}
		return true;
	}
