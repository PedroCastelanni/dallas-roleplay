TPL::BanTPL(playerid, string[], string2[])
{
	new arquivo[64],arquivo2[64], tmp[20], tmp2[20], ip[16];
	GetPlayerIp(playerid, ip, sizeof ip);
	format(arquivo, sizeof(arquivo), Pasta_Banidos,PlayerName(playerid));
	format(arquivo2, sizeof(arquivo2), Pasta_IPBanidos, ip);
	getdate(Ano, Mes, Dia);
	format(tmp, 20, "%d/%d/%d", Dia, Mes, Ano);
	gettime(Hora, Minuto, Segundo);
	format(tmp2, 20, "%d:%d:%d", Hora, Minuto, Segundo);
	format(gstring, 128, "[%d/%d/%d] [%d:%d:%d] %s IP:%s foi banido pelo admin %s, motivo: %s", v[2], v[1], v[0], v[3], v[4], v[5], PlayerName(playerid),
	ip, string2, string);
	SBanLog(gstring);
	if(DOF2_FileExists(arquivo) && DOF2_FileExists(arquivo2))
	{
		Kick(playerid);
	}
	else
	{
     	if(!DOF2_FileExists(arquivo))
     	{
			DOF2_CreateFile(arquivo);
			DOF2_SetString(arquivo,"Motivo",string);
			DOF2_SetString(arquivo,"Admin",string2);
			DOF2_SetString(arquivo,"Data",tmp);
			DOF2_SetString(arquivo,"Hora",tmp2);
			DOF2_SetString(arquivo2,"IP", ip);
			DOF2_SaveFile();
		}
		if(!DOF2_FileExists(arquivo2))
		{
			DOF2_CreateFile(arquivo2);
			DOF2_SetString(arquivo2,"Motivo",string);
			DOF2_SetString(arquivo2,"Admin",string2);
			DOF2_SetString(arquivo2,"Data",tmp);
			DOF2_SetString(arquivo2,"Hora",tmp2);
			DOF2_SetString(arquivo2,"Nick",PlayerName(playerid));
			DOF2_SaveFile();
		}
		Ban(playerid);
		Kick(playerid);
	}
	return 1;
}
