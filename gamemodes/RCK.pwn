	CMD:mostrarCoins(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(sscanf(params, "u", sscanfid))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /mostrarCoins [ id ]");
				return 1;
			}
			if(AdminTrabalhando[sscanfid] > 0)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode doar nada para um admin em modo trabalho !");
				return 1;
			}
			if(IsPlayerConnected(sscanfid))
			{
				if(sscanfid != INVALID_PLAYER_ID)
				{

					if (ProxDetectorS(8.0, playerid, sscanfid))
					{
						if(PlayerInfo[playerid][pCoins] == 0)
						{
							SendClientMessage(playerid, COR_LIGHTBLUE, "Voc� n�o possui Coins para mostrar !");
							return 1;
						}
						if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Para ver suas Coins, use /rg!"); return 1; }
						GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
						{
							format(stringZCMD, sizeof(stringZCMD), "[Coins] %s mostrou para voc� que possui:[%d Coins]",sendername,PlayerInfo[sscanfid][pCoins]);
							SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "* Voc� mostrou suas Coins para %s.", giveplayerZCMD);
							SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
						}

					}
					else
					{
						SendClientMessage(playerid, COR_GREY, "O Jogador esta longe de Voc� !");
						return 1;
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GREY, "O Jogador est� offline !");
				return 1;
			}
		}
		return 1;
	}
