			|| modelovid == 548	|| modelovid == 553 || modelovid == 563 || modelovid == 564 || modelovid == 570 || modelovid == 577 || modelovid == 592 || modelovid == 593
		 	|| modelovid == 595)
			{
   				SendClientMessage(playerid, COR_AMARELO,"Voc� n�o pode trocar o estepe neste tipo de ve�culo !");
       			return 1;
			}
	        if(VehicleTireState[vid] == 0)
	        {
	            SendClientMessage(playerid, COR_AMARELO , "O seu ve�culo precisa estar com alguma roda furada !");
	            return 1;
	        }
	        if(EngineCarro[vid] != 0)
	        {
	            SendClientMessage(playerid, COR_GREY, "Voc� precisa estar com o motor desligado para usar o estepe.");
