}

public FecharGaragem(playerid, garageid)
{
    if(Deletado[garageid] == false)
    {
    	SendClientMessage(playerid, 0x00AB00AA, "O Port�o foi {F60000}Fechado {00AB00}totalmente.");
    	Garagem[garageid][cnLock] = 1;
    	new string[256];
    	format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Entrada\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", garageid, LabelString[garageid], GetLockGaragem(garageid), NameString[garageid]);
		UpdateDynamic3DTextLabelText(LabelEntrada[garageid], 0xFFFFFFFF, string);
		format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Sa�da\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", garageid, LabelString[garageid], GetLockGaragem(garageid), NameString[garageid]);
		UpdateDynamic3DTextLabelText(LabelSaida[garageid], 0xFFFFFFFF, string);
		//PlayerPlaySound(playerid, 1154, 0.0, 0.0, 0.0);
		SalvarGaragens();
	}
	return 1;
}

