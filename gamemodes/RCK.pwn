	CMD:seditar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pAdmin] == 0)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o � um admin !");
				return 1;
			}
			if(PlayerInfo[playerid][pAdmin] < 1337)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o tem autoriza��o para usar esse comando!");
				return 1;
			}
			if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
				return 1;
			}
			new x_Emprego[32], proplev;
			if(sscanf(params, "s[25]d", x_Emprego, proplev))
			{
				SendClientMessage(playerid, COR_BRANCO, "|____________ Editar ____________|");
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /seditar [nome] [quantidade] (Use para casas e empresas)");
				SendClientMessage(playerid, COR_GREY, "Casas: Level, Preco, carro, descricao, chave(0 aberto - 1 fechado)");
				SendClientMessage(playerid, COR_GREY, "Empresas: Level, Preco, fundos, descricao, chave(0 aberto - 1 fechado)");
				SendClientMessage(playerid, COR_GREY, "Fazendas: Level, Preco, fundos, descricao, chave(0 aberto - 1 fechado)");
				return 1;
			}
			for(new i = 0; i < sizeof(HouseInfo); ++i)
			{
				if (PlayerToPoint(3, playerid,HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
				{
					format(stringZCMD, sizeof(stringZCMD), "Casa: %d", i);
					SendClientMessage(playerid, COR_GRAD2, stringZCMD);
					if(strcmp(x_Emprego,"level",true) == 0)
					{
						if(proplev < 1) { return 1; }
						HouseInfo[i][hLevel] = proplev;
						format(stringZCMD, sizeof(stringZCMD), "Voc� Ajustou o Level Min�mo da Casa para: %d", proplev);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
						SaveCasa(i);
					}
					else if(strcmp(x_Emprego,"preco",true) == 0)
					{
						if(proplev < 1) { return 1; }
						HouseInfo[i][hValue] = proplev;
						format(stringZCMD, sizeof(stringZCMD), "Voc� Ajustou o Pre�o Min�mo da Casa para: %d", proplev);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
						SaveCasa(i);
					}
					else if(strcmp(x_Emprego,"carro",true) == 0)
					{
						if(proplev < 1) { return 1; }
						HouseInfo[i][hVec] = proplev;
						format(stringZCMD, sizeof(stringZCMD), "Voc� Ajustou o Carro da Casa para: %d", proplev);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
						SaveCasa(i);
					}
					if(strcmp(x_Emprego,"chave",true) == 0)
					{
						if(proplev < 0 || proplev > 1) { SendClientMessage(playerid, COR_GRAD1, "Voc� s� pode Abrir(0) ou Fechar(1) a Empresa."); return 1; }
						HouseInfo[i][hLock] = proplev;
						format(stringZCMD, sizeof(stringZCMD), "Voc� Ajustou a Chave da Casa para: %d", proplev);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
						SaveCasa(i);
					}
				}
			}
			for(new i = 0; i < sizeof(BizzInfo); ++i)
			{
				if (PlayerToPoint(3, playerid,BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ]))
				{
					format(stringZCMD, sizeof(stringZCMD), "Bizz: %d (Empresa com interior)", i);
					SendClientMessage(playerid, COR_GRAD2, stringZCMD);
					if(strcmp(x_Emprego,"level",true) == 0)
					{
						if(proplev < 1) { return 1; }
						BizzInfo[i][bLevelNeeded] = proplev;
						format(stringZCMD, sizeof(stringZCMD), "Voc� Ajustou o Level Min�mo da Empresa para: %d", proplev);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
						SalvarEmpresa(i);
					}
					else if(strcmp(x_Emprego,"preco",true) == 0)
					{
						if(proplev < 1) { return 1; }
						BizzInfo[i][bBuyPrice] = proplev;
						format(stringZCMD, sizeof(stringZCMD), "Voc� Ajustou o Pre�o Min�mo da Empresa para: %d", proplev);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
						SalvarEmpresa(i);
