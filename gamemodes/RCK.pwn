						format(stringZCMD, sizeof(stringZCMD), "UPDATE `familias` SET `Tipo`='%d', `Dias`='%d',`Data`='%d' WHERE `ID`='%d'", 1, dias, day, org);
 						Resultado = db_query(Conexao,stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "AvisoAdmin: %s ativou a fam�lia vip [%s] por [%d] dias.",PlayerName(playerid),result,dias);
						ABroadCast(COR_AMARELO,stringZCMD,1);
