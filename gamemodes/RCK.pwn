			strcat(MEGAString, " de caracteres s�o 128, se ultrapassar n�o ser� escito no arquivo interno.\n\n");
			strcat(MEGAString, " Por favor, reporte algo que realmente seja bug, caso\nreporte algo que n�o tenha nada relacionado, ser�\n punido logo que um admin dono ver.\n\n");
			strcat(MEGAString, " Reportando um bug(erro), voc� estar� ajudando o servidor\n a ficar cada vez melhor, fazendo com que os novos usu�rios,\nn�o tenham uma m� imagem do servidor. Obrigado!");
			ShowPlayerDialog(playerid, 8912, DIALOG_STYLE_INPUT, "Relatar Bug",MEGAString,"Reportar","Cancelar");
