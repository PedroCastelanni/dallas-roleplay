				{
					SendClientMessage(playerid, COR_GREY, "Voce precisa ser maior que cargo 2 para usar este comando!");
					return 1;
				}
				if(sscanf(params, "u", sscanfid))
				{
					SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /aovivo [id]");
					return 1;
