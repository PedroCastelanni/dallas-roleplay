stock MostrarCandidatos(playerid)
{
	    new string[128];
	    new org = GetPlayerOrg(playerid);
	    MEGAString[0] = EOS;
	    strcat(MEGAString,"Candidato\tNick\tStatus\n");
		if(IsPlayerOnline(InfoCandtiados[org][Candidato1]))
		{
   			format(string,sizeof(string),"1\t%s\t{33FF00}(online)\n",InfoCandtiados[org][Candidato1]);
   			strcat(MEGAString,string);
   		}
   		else
   		{
   			format(string,sizeof(string),"1\t%s\t{FC0015}(offline)\n",InfoCandtiados[org][Candidato1]);
