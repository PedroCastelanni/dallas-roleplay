stock MostrarTDCelularTXD(playerid)
{
	for(new i; i < 46; i++)
	{
		TextDrawShowForPlayer(playerid, TDCelularTXD[i]);
	}
	SelectTextDraw(playerid, 0x0080FFC8);
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
    SetPlayerAttachedObject(playerid, Slot_CelularTXD, 330, 6);
    OlhandoTDCelularTXD[playerid] = 1;
	return 1;
}

stock TirarTDCelularTXD(playerid)
{
	for(new i; i < 46; i++)
	{
		TextDrawHideForPlayer(playerid, TDCelularTXD[i]);
	}
	CancelSelectTextDraw(playerid);
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
    RemovePlayerAttachedObject(playerid, Slot_CelularTXD);
    OlhandoTDCelularTXD[playerid] = 0;
	return 1;
}
stock MostrarTDSkinsTDD(playerid)
