	CMD:passarnivel(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if (gPlayerLogged[playerid] != 0)
			{
				PlayerInfo[playerid][pDinheiro] = GetPlayerMoneyEx(playerid);
				if(PlayerInfo[playerid][pLevel] >= 0)
				{
					new nxtlevel = PlayerInfo[playerid][pLevel]+1;
					new expquantidade = nxtlevel*levelexp;
					if (PlayerInfo[playerid][pExp] < expquantidade)
					{
						format(gstring, 128, "Voc� precisa de %d pontos de respeito, Voc� tem: [%d] !",expquantidade,PlayerInfo[playerid][pExp]);
						SendClientMessage(playerid, COR_GRAD1, gstring);
						return 1;
					}
					else
					{
						new RandomRespeitos = 1 + random(PlayerInfo[playerid][pLevel]);
						PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
						PlayerPlayMusic(playerid);
						PlayerInfo[playerid][pLevel]++;
						ScoreLevel(playerid);
						PlayerInfo[playerid][pExp] -= expquantidade;
						format(gstring, sizeof(gstring), "{FFFF00}: Parabens! Voc� Passou De N�vel.");
		                strcat(MEGAString,gstring);
		                format(gstring, sizeof(gstring), "\n{F7FE2E}Voc� agora � Level [%d].",nxtlevel);
		                strcat(MEGAString,gstring);
		                format(gstring, sizeof(gstring), "\n{FFFFFF}Voce Ganhou %d Respeitos Por Passar de N�vel.", RandomRespeitos);
		                strcat(MEGAString,gstring);
		                PlayerInfo[playerid][pExp] += RandomRespeitos;
		                ShowPlayerDialog(playerid,11112,DIALOG_STYLE_MSGBOX, "{000000}�{BDBDBD}Upagem De Level{000000}�", MEGAString, "OK", "");
					}
				}
				return 1;
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� logado !");
			}
		}
		return 1;
	}
