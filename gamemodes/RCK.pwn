								{
									MotoGuincho2[playerid] = carroid;
									SetVehicleVirtualWorld(carroid, 20);
									LinkVehicleToInterior(carroid, 1);
									SetVehiclePos(carroid, 2085.2268,-1375.3748,305.5588);
									format(stringZCMD, sizeof(stringZCMD), "Voc� guinchou a moto: [%d], para fixa-la na hq, use /soltarmotos.", carroid);
									SendClientMessage(playerid, COR_GRAD1, stringZCMD);
								}
