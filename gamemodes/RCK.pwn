TPL::RemoveBloqueio(playerid)
{
	BloqueioInfo[playerid][bqCreated]=0;
    BloqueioInfo[playerid][bqX]=0.0;
    BloqueioInfo[playerid][bqY]=0.0;
    BloqueioInfo[playerid][bqZ]=0.0;
    if(PlayerInfo[playerid][pMembro] == 1 || PlayerInfo[playerid][pLider] == 1)
	{
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioPM]);
    }
    else if(PlayerInfo[playerid][pMembro] == 2 || PlayerInfo[playerid][pLider] == 2)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioBOPE]);
	}
	else if(PlayerInfo[playerid][pMembro] == 3 || PlayerInfo[playerid][pLider] == 3)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioEXE]);
	}
	else if(PlayerInfo[playerid][pMembro] == 12 || PlayerInfo[playerid][pLider] == 12)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioIP]);
	}
	else if(PlayerInfo[playerid][pMembro] == 13 || PlayerInfo[playerid][pLider] == 13)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioPRF]);
	}
	else if(PlayerInfo[playerid][pMembro] == 17 || PlayerInfo[playerid][pLider] == 17)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioPC]);
	}
	else if(PlayerInfo[playerid][pMembro] == 25 || PlayerInfo[playerid][pLider] == 25)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioPF]);
	}
}
