	CMD:soltar(playerid, params[])
	{
		if(!PlayerToPoint(30.0,playerid,1767.2574,-1573.4009,1735.5995))
		{
			SendClientMessage(playerid, COR_GRAD1, "Voc� n�o et� na penitenciaria !");
			return 1;
		}
		if(PlayerInfo[playerid][pEmprego] != 2)
		{
			SendClientMessage(playerid, COR_GREY, "Voc� n�o � um advogado!");
			return 1;
		}
		if(PlayerInfo[playerid][pJailed] != 0)
		{
			SendClientMessage(playerid,COR_AMARELO," Voc� n�o pode usar esse comando na cadeia!");
			return 1;
		}
		new playa;
		new money;
		if(sscanf(params, "ud", playa, money))
		{
			SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /soltar [id] [preco]");
			return 1;
		}
		new granapreso = GetPlayerMoneyEx(playa);
		if(money < 500 || money > 5000000) { SendClientMessage(playerid, COR_GREY, "Custo entre R$ 500 e 5000000 !"); return 1; }
		if(GetPlayerMoneyEx(playa) < money) { format(stringZCMD, sizeof(stringZCMD), "* Voc� ofereceu soltar o preso %s por R$[%d], ele s� tem R$[%d] !", PlayerName(playa), money, granapreso); SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD); return 1; }
		if(IsPlayerConnected(playa))
		{
			if(playa != INVALID_PLAYER_ID)
			{
			    if(PlayerInfo[playa][pJailed] != 1)
			    {
			        SendClientMessage(playerid, COR_GRAD1, "Este preso n�o est� no carandiru !");
					return 1;
			    }
				if(JaTemAdvogado[playa] == 1)
				{
					SendClientMessage(playerid, COR_GRAD1, "Este preso j� tem um advogado !");
					return 1;
				}
				new level = PlayerInfo[playerid][pLawSkill];
				if(level >= 0 && level <= 50 && PlayerInfo[playa][pJailTime] > 300)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 1, s� pode soltar presos com at� 5 minutos(300 segundos) de cadeia!");
					return 1;
				}
				if(level >= 51 && level <= 100 && PlayerInfo[playa][pJailTime] > 700)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 2, s� pode soltar presos com at� 11 minutos(700 segundos) de cadeia!");
					return 1;
				}
				if(level >= 101 && level <= 200 && PlayerInfo[playa][pJailTime] > 900)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 3, s� pode soltar presos com at� 15 minutos(900 segundos) de cadeia!");
					return 1;
				}
				if(level >= 201 && level <= 300 && PlayerInfo[playa][pJailTime] > 1100)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 4, s� pode soltar presos com at� 18 minutos(1100 segundos) de cadeia!");
					return 1;
				}
				if(level >= 300 && PlayerInfo[playa][pJailTime] > 200000)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 4, s� pode soltar presos com at� 3333 minutos(200000 segundos) de cadeia!");
					return 1;
				}
				//--------------Preo�o para Soltar-------------//
				if(level >= 0 && level <= 50 && money > 1000)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 1, s� pode cobrar at� R$1000!");
					return 1;
				}
				if(level >= 51 && level <= 100 && money > 2000)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 2, s� pode cobrar at� R$2000!");
					return 1;
				}
				if(level >= 101 && level <= 200 && money > 3000)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 3, s� pode cobrar at� R$3000!");
					return 1;
				}
				if(level >= 201 && level <= 300 && money > 4000)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 4, s� pode cobrar at� R$4000!");
					return 1;
				}
				if(level >= 301 && money > 5000000)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� � advogado nivel 5, s� pode cobrar at� R$5000000!");
					return 1;
				}
				if(LicencaAdvogado[playerid] == 0 && level < 301)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� autorizado,pegue uma autoriza��o !");
					return 1;
				}
				if(playa == playerid) { SendClientMessage(playerid, COR_GREY, "Voc� n�o pode se libertar!"); return true; }
				if(PlayerInfo[playa][pJailed] == 1 || PlayerInfo[playa][pJailed] == 2
				|| PlayerInfo[playa][pJailed] == 3 && LicencaAdvogado[playerid] == 1 || level >= 301)
				{
					GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
					GetPlayerName(playerid, sendername, sizeof(sendername));
					format(gstring,sizeof(gstring),"* Advogado: %s ofereceu para te soltar por R$[%d]\nVoc� deseja pagar R$[%d] para ser solto?", PlayerName(playerid), money, money);
					ShowPlayerDialog(playa ,9,DIALOG_STYLE_MSGBOX,"Advogado",gstring,"Sim","N�o");
					format(stringZCMD, sizeof(stringZCMD), "* Voc� ofereceu a liberdade para o preso:%s, por R$[%d] !", giveplayerZCMD, money);
					SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
					JaTemAdvogado[playa] = 1;
					CuraOffer[playa] = playerid;
					CuraPrice[playa] = money;
				}
				else
				{
					SendClientMessage(playerid, COR_GRAD1, "O jogador n�o precisa de advogado ou voc� n�o tem autoriza��o !");
				}
			}
		}
		return 1;
	}
	CMD:consertarcaixas(playerid, params[])
	{
		if(PlayerInfo[playerid][pAdmin] < 1337)return SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando.");
		for(new i; i < MAX_CAIXAS; i++)
		{
			RestoreCaixaADM(i);
		}
		format(stringZCMD, sizeof stringZCMD, "{9370DB}!{FFFFFF} Staff %s ajeitou todos os caixinhas eletronicos da cidade", PlayerName(playerid));
		SendClientMessageToAll(COR_LIGHTGREEN, stringZCMD);
		return 1;
	}
	CMD:cancelar(playerid, x_Emprego[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(isnull(x_Emprego))
			{
				SendClientMessage(playerid, COR_BRANCO, "|_____________ Cancelar _____________|");
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /cancelar [nome]");
				SendClientMessage(playerid, COR_GREY, "Nomes Validos: Taxi, Onibus, Medico, Mecanico, Policia Pizza");
				return 1;
			}
			if(strcmp(x_Emprego,"taxi",true) == 0)
			{
				if(TransportDuty[playerid] == 1 && TaxiCallTime[playerid] > 0)
				{
					TaxiAccepted[playerid] = 999;
					GameTextForPlayer(playerid, "~w~Voce~n~~r~Cancelou a Chamada", 5000, 1);
					TaxiCallTime[playerid] = 0;
					DisablePlayerCheckpoint(playerid);
					PediuServico[sscanfid] = 0;
					TaxiCall = 999;
				}
				else
				{
					if(IsPlayerConnected(TaxiCall)) { if(TaxiCall == playerid) { TaxiCall = 999; } }
					foreach(new i: Player)
					{
						if(IsPlayerConnected(i))
						{
							if(TaxiAccepted[i] < 999)
							{
								if(TaxiAccepted[i] == playerid)
								{
									TaxiAccepted[i] = 999;
									GameTextForPlayer(i, "~w~Cliente~n~~r~Cancelou a Chamada", 5000, 1);
									TaxiCallTime[i] = 0;
									DisablePlayerCheckpoint(i);
								}
							}
						}
					}
				}
			}
			else if(strcmp(x_Emprego,"bus",true) == 0 || strcmp(x_Emprego,"onibus",true) == 0)
			{
				if(TransportDuty[playerid] == 2 && BusCallTime[playerid] > 0)
				{
					BusAccepted[playerid] = 999;
					GameTextForPlayer(playerid, "~w~Voce~n~~r~Cancelou a Chamada", 5000, 1);
					BusCallTime[playerid] = 0;
					DisablePlayerCheckpoint(playerid);
					BusCall = 999;
				}
				else
				{
					if(IsPlayerConnected(BusCall)) { if(BusCall == playerid) { BusCall = 999; } }
					foreach(new i: Player)
					{
						if(IsPlayerConnected(i))
						{
							if(BusAccepted[i] < 999)
							{
								if(BusAccepted[i] == playerid)
								{
									BusAccepted[i] = 999;
									GameTextForPlayer(i, "~w~Cliente~n~~r~Cancelou a Chamada", 5000, 1);
									BusCallTime[i] = 0;
									DisablePlayerCheckpoint(i);
								}
							}
						}
					}
				}
			}
			else if(strcmp(x_Emprego,"pizza",true) == 0 || strcmp(x_Emprego,"agua",true) == 0)
			{
			        if(EmpregoDuty[playerid] == 1 && PizzaCallTime[playerid] > 0)
			        {
			            PizzaAccepted[playerid] = 999;
						GameTextForPlayer(playerid, "~w~Voce~n~~r~Cancelou a Chamada", 5000, 1);
						PizzaCallTime[playerid] = 0;
						DisablePlayerCheckpoint(playerid);
						PizzaCall = 999;
			        }
			        else
			        {
						if(IsPlayerConnected(BusCall)) { if(PizzaCall == playerid) { PizzaCall = 999; } }
						for(new i = 0; i < MAX_PLAYERS; i++)
						{
						    if(IsPlayerConnected(i))
						    {
						        if(PizzaAccepted[i] < 999)
						        {
							        if(PizzaAccepted[i] == playerid)
							        {
							            PizzaAccepted[i] = 999;
							            GameTextForPlayer(i, "~w~Cliente~n~~r~Cancelou a Chamada", 5000, 1);
							            PizzaCallTime[i] = 0;
							            DisablePlayerCheckpoint(i);
						            }
						        }
						    }
				  	   }
				  }
			}
			else if(strcmp(x_Emprego,"mecanico",true) == 0)
			{
				if(MechanicCallTime[playerid] > 0)
				{
					MechanicAccepted[playerid] = 999;
					GameTextForPlayer(playerid, "~w~Voce~n~~r~Cancelou a Chamada", 5000, 1);
					MechanicCallTime[playerid] = 0;
					DisablePlayerCheckpoint(playerid);
					PediuServicoMec[playerid] = 0;
