TPL::contarx1()
{
	switch(countx1)
	{
		case 3:
		{
			GameTextForPlayer(Playersx1[0],"~p~| ~y~3 ~p~|", 4000, 6);
			GameTextForPlayer(Playersx1[1],"~p~| ~y~3 ~p~|", 4000, 6);
		}
		case 2:
		{
			GameTextForPlayer(Playersx1[0],"~p~| ~y~2 ~p~|", 4000, 6);
			GameTextForPlayer(Playersx1[1],"~p~| ~y~2 ~p~|", 4000, 6);
		}
		case 1:
		{
			GameTextForPlayer(Playersx1[0],"~p~| ~y~1 ~p~|", 4000, 6);
			GameTextForPlayer(Playersx1[1],"~p~| ~y~1 ~p~|", 4000, 6);
		}
		case 0:
		{
			GameTextForPlayer(Playersx1[0],"~p~| ~g~Go Go Go ~p~|", 2000, 6);
			GameTextForPlayer(Playersx1[1],"~p~| ~g~Go Go Go ~p~|", 4000, 6);
			tempox1 = gettime();
		}
	}
	if(countx1 > 0)
	{
		countx1 --;
	}
	else
	{
		SetCameraBehindPlayer(Playersx1[0]);
		SetCameraBehindPlayer(Playersx1[1]);
		TogglePlayerControllable(Playersx1[0], 1);
		TogglePlayerControllable(Playersx1[1], 1);
		KillTimer(timerx1);
	}
}
stock NomeArma(armaid)
{
	new nome[35];
	if(armaid >= 1 || armaid <= 47) GetWeaponName(armaid, nome, sizeof nome);
	if(armaid == 18)nome = "Molotov";
	if(armaid == 44 || armaid == 45)nome = "Visao Noturna";
	//if(armaid == 47)nome = "Explosivo";
	else GetWeaponName(armaid, nome, sizeof nome);
	return nome;
}
