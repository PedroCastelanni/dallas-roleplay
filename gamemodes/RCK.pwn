				foreach(new i: Player)
				{
					SetPVarInt(i, "inFall", 0);
					ShowPlayerDialog(i, 333, DIALOG_STYLE_MSGBOX, "Evento FallOut", "Voc� deseja ir ao evento ?", "Sim", "Nao");
					SendClientMessage(i, COR_LIGHTBLUE, "Admin est� chamando todos para um evento de Parkour!");
					SendClientMessage(i, COR_LIGHTBLUE, "Clique em Sim para ir ou N�o Para Continuar aonde est� !");
				}
				fallstart = 0;
				SetTimer("IniciarFalloutA", 15000, false);
			}
			else
