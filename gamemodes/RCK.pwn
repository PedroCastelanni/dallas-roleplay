	CMD:revistar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(!IsACop(playerid))
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o � um Oficial!");
				return 1;
			}
			if(OnDuty[playerid] != 1 && GetPlayerOrg(playerid) != 7)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o Bateu o cart�o!");
				return 1;
			}
			if(sscanf(params, "u", sscanfid))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /revistar [id]");
				return 1;
			}
			if(IsPlayerConnected(sscanfid))
			{
				if(sscanfid != INVALID_PLAYER_ID)
				{
					if (ProxDetectorS(8.0, playerid, sscanfid))
					{
						if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voc� n�o pode se Revistar!"); return 1; }
						GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						new text1[20], text2[20], text3[20], text4[20], text5[20], text6[20];
						text1 = "| Vazio.";
						text2 = "| Vazio.";
						text3 = "| Vazio.";
						text4 = "| Vazio.";
						new ContarMaconha, ContarCrack, ContarCoca, ContarLSD;
					    for(new i=0; i<75; i++)
						{
							if(InventarioInfo[sscanfid][i][iSlot] == 1578)
							{
								text1 = "| Maconha.";
								ContarMaconha++;
							}
							if(InventarioInfo[sscanfid][i][iSlot] == 1279)
							{
								text2 = "| Cocaina.";
								ContarCoca++;
							}
							if(InventarioInfo[sscanfid][i][iSlot] == 1575)
							{
								text3 = "| Crack.";
								ContarCrack++;
							}
							if(InventarioInfo[sscanfid][i][iSlot] == 1576)
							{
								text4 = "| Lsd.";
								ContarLSD++;
							}
						}
						if(PlayerInfo[sscanfid][pMats] > 0) { text5 = "| Materiais."; } else { text5 = "| Vazio."; }
						if(PlayerInfo[sscanfid][pAgendaT] > 0) { text6 = "| Lista Telefonica."; } else { text6 = "| Vazio."; }
						format(stringZCMD, sizeof(stringZCMD), "|__________ Itens %s __________|", giveplayerZCMD);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text1, ContarMaconha);
						SendClientMessage(playerid, COR_GREY, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text2, ContarCoca);
						SendClientMessage(playerid, COR_GREY, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text3, ContarCrack);
						SendClientMessage(playerid, COR_GREY, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text4, ContarLSD);
						SendClientMessage(playerid, COR_GREY, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text5, PlayerInfo[sscanfid][pMats]);
						SendClientMessage(playerid, COR_GREY, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "%s.", text6);
						SendClientMessage(playerid, COR_GREY, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "* %s revistou %s para ver se tem qualquer item ilegal.", sendername ,giveplayerZCMD);
						ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
					}
					else
					{
						SendClientMessage(playerid, COR_GREY, "O Jogador est� longe de Voc� !");
						return 1;
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GREY, "O Jogador Est� Offline !");
				return 1;
			}
		}
		return 1;
	}
	CMD:presos(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			SendClientMessage(playerid, 0xf5deb3FF, "|_B_L_C_|PRESOS|_B_L_C_|::");
			foreach(new i: Player)
			{
				if(IsPlayerConnected(i))
				{
					if(PlayerInfo[i][pJailed] == 1)
					{
						GetPlayerName(i, sendername, sizeof(sendername));
						format(stringZCMD, 128, "ID: %d Preso: %s Local: Penitenci�ria LS - Tempo: %d seg.", i, sendername, PlayerInfo[i][pJailTime]);
						SendClientMessage(playerid, COR_GRAD2, stringZCMD);
					}
					if(PlayerInfo[playerid][pAdmin] > 0)
					{
						if(PlayerInfo[i][pJailed] == 2)
						{
							GetPlayerName(i, sendername, sizeof(sendername));
							format(stringZCMD, 128, "ID: %d Preso: %s Local: Carandiru Tempo: %d seg.", i, sendername, PlayerInfo[i][pJailTime]);
							SendClientMessage(playerid, COR_GRAD2, stringZCMD);
						}
						if(PlayerInfo[i][pJailed] == 3)
						{
							GetPlayerName(i, sendername, sizeof(sendername));
							format(stringZCMD, 128, "ID : %d Preso: %s Local: Cela Admin Tempo: %d seg.", i, sendername, PlayerInfo[i][pJailTime]);
							SendClientMessage(playerid, COR_GRAD2, stringZCMD);
						}
					}
				}
			}
		}
		return 1;
	}
	CMD:procurados(playerid, params[])
	{
		if(IsPlayerConnected(playerid) )
		{
			if(!IsACop(playerid) && PlayerInfo[playerid][pAdmin] < 1)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o � um Oficial/Administrador!");
				return 1;
			}
			if(OnDuty[playerid] != 1 && GetPlayerOrg(playerid) != 7 && PlayerInfo[playerid][pAdmin] < 1)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o Bateu o cart�o!");
				return 1;
			}
			new x;
			new string[128];
			SendClientMessage(playerid, COR_GREEN, "|_B_L_C_|Suspeitos|_B_L_C_|:");
			foreach(new i: Player)
			{
				if(IsPlayerConnected(i))
				{
					if(WantedLevel[i] > 0)
					{
						GetPlayerName(i, giveplayerZCMD, sizeof(giveplayerZCMD));
						format(string, sizeof(string), "%s%s(%d): %d", string,giveplayerZCMD,i,WantedLevel[i]);
						x++;
						if(x > 3)
						{
							SendClientMessage(playerid, COR_AMARELO, string);
							x = 0;
							format(string, sizeof(string), "");
						}
						else
						{
							format(string, sizeof(string), "%s, ", string);
						}
					}
				}
			}
			if(x <= 3 && x > 0)
			{
				string[strlen(string)-2] = '.';
				SendClientMessage(playerid, COR_AMARELO, string);
			}
		}//not connected
		return 1;
	}
	CMD:sairdoemprego(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			tempocolheita[playerid] = 0;
			KillTimer(colheitapickup[playerid]);
			if(PlayerInfo[playerid][pEmprego] > 0)
			{
				if(GetPlayerInterior(playerid) > 0)
				{
					rouboucarro[playerid] = 0;
					tempocolheita[playerid] = 0;
					StopPlayerHoldingObject(playerid);
					if(PlayerInfo[playerid][pVIP] > 0)
					{
						if(PlayerInfo[playerid][pContractTime] >= 0)
						{
							TransportDuty[playerid] = 0;
							ConsumingMoney[playerid] = 1; TransportValue[playerid] = 0; TransportMoney[playerid] = 0;
							SendClientMessage(playerid, COR_LIGHTBLUE, "{FF0000}{Demitido} voce se demitiu do seu emprego!");
							SetPlayerSkin(playerid, 250);
							PlayerInfo[playerid][pEmprego] = 0;
							PlayerInfo[playerid][pContractTime] = 0;
							ResetPlayerWeaponsEx(playerid);
						}
					}
					else
					{
						if(PlayerInfo[playerid][pContractTime] >= 0)
						{
							TransportDuty[playerid] = 0;
							ConsumingMoney[playerid] = 1; TransportValue[playerid] = 0; TransportMoney[playerid] = 0;
							SendClientMessage(playerid, COR_LIGHTBLUE, "{FF0000}{Demitido} voce se demitiu do seu emprego!");
							SetPlayerSkin(playerid, 250);
							PlayerInfo[playerid][pEmprego] = 0;
							PlayerInfo[playerid][pContractTime] = 0;
							ResetPlayerWeaponsEx(playerid);

						}
					}
				}
				else
				{
					SendClientMessage(playerid, COR_AMARELO, "{8B0000}ERRO  {FFFFFF}para sair do emprego voce tem que esta dentro da prefeitura.");
				}
			}
			else
			{
				SendClientMessage(playerid, COR_VAGOS, "Voc� n�o est� em nenhum emprego!");
			}
		}//not connected
		return 1;
	}
