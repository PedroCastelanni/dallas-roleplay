    CMD:portamalas(playerid)
    {
	new RCKp[2000];
	new string[128],pVeiculo = -1,Float:vPos[3];
	for(new V = 0; V < MAX_VEHICLES; V++){
		GetVehiclePos(V,vPos[0], vPos[1], vPos[2]);
		if(IsPlayerInRangeOfPoint(playerid, 5.0, vPos[0], vPos[1], vPos[2])){ pVeiculo = V; break;}
	}
	if(pVeiculo == -1) return SendClientMessage(playerid, 0xFF0000FF, "Voce nao esta proximo a nenhuma veiculo!");
	if(pTrancarPM[pVeiculo] > 0) if(pTrancarPM[pVeiculo] != playerid+1) return SendClientMessage(playerid, 0xFF0000FF, "PortaMalas Trancado! Voce nao possui as Chaves!");
	for(new i = 0; i < QntSlots; i++){
	    format(string, sizeof(string), "{FFFFFF}[%i]\t{33CC33}%s\t{FFFFFF}%i\n", i, InfoNomeItem[PortaMala[i][ID_Item][pVeiculo]], PortaMala[i][Quantidade][pVeiculo]);
	    strcat(RCKp, string);
	}
	format(string, sizeof(string), "{FFFFFF}Clique para (Trancar ou Destrancar) [%s]\n", pTrancarPM[pVeiculo] > 0 ? ("{FF0000}Trancado") : ("{00FF00}Destrancado"));
	strcat(RCKp, string);//
	strcat(RCKp, "{FFFFFF}Pressione para fechar o {FFFF00}Porta-malas.\n");//
	PorM_Players[0][playerid] = pVeiculo;
	AbrirFecharMala(1,pVeiculo);
    ShowPlayerDialog(playerid, Dig_MalaCentral, DIALOG_STYLE_LIST , "{00FF00}PORTA-MALAS", RCKp, "Retirar", "Colocar");
    SendClientMessage(playerid, -1, "{FFFFFF}[{00FF00}PORTA-MALAS ABERTO{FFFFFF}] Voce abriu o porta-malas");
	return 1;
	
    }
    CMD:iniciarrotas(playerid, params[])
	{
  			if(GetTickCount() - TempoTerroristBomb[playerid] < 900000)
            {
	             SendClientMessage(playerid, COR_GREY, "{FF0000}AGUARDE: {FFFFFF}Aguarde 15 minutos para iniciar outra rota.");
                 return 1;
	}
            if(IsPlayerInRangeOfPoint(playerid, 1, 2499.5530,-947.0037,82.4708))
    {
        TerroristBomb[playerid] = 1;
        new name[MAX_PLAYER_NAME], string[128];
        GetPlayerName(playerid, name, sizeof(name));
        TraficanTex(playerid)
        format(string, sizeof(string), "{FF0000}%s {FFFFFF}INICIOU UMA ROTA DE DROGAS PELA CIDADE!", name);
        WantedLevel[playerid] += 5;
        SendClientMessage(playerid, 0xFFFF00AA, "{FF0000}[ATENCAO]{FFFFFF} Voce acabou de iniciar uma rota de drogas e recebeu 5 estrelas de procurado.");
        SendClientMessageToAll(0xFFFF00AA, string);
        SendClientMessage(playerid, 0xFFFF00AA, "{FFFFFF}Por favor, siga o {00ff00}[checkpoint vermelho] {FFFFFF}para come�ar as rotas");
        SetPlayerCheckpoint(playerid, 2734.9304,-2014.3604,13.5547, 3);
        TempoTerroristBomb[playerid] = GetTickCount();
        return 1;
    }
            else
    {
        SendClientMessage(playerid, 0xFF0000AA, "Voce deve esta no traficante para pegar as drogas e inicar as rotas.");
    }
            return 1;
    }
    CMD:fazerrotas(playerid, params[])
    {
    if(TerroristBomb[playerid] == 7)
    {
        SendClientMessage(playerid, 0xFF0000AA, "Voce nao pode iniciar outras rotas em quanto estiver com rotas para completar");
        return 1;
    }
    else
    {
        SendClientMessage(playerid, 0xFF0000AA, "{00FF00}UM TRAFICANTE FOI MARCADO EM SEU MAPA, SIGA NO {FFFFFF}GPS {00FF00}PARA INICIAR AS ROTAS");
        SetPlayerCheckpoint(playerid,2499.5530,-947.0037,82.4708, 3);
    }
    return 1;
    }
	CMD:desmanchar(playerid)
    {
    if(IsPlayerInRangeOfPoint(playerid,3.0,-375.8726,-1324.2439,31.4565))
    {
    if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,0xFF0000AA,"[ERRO]Voce nao esta em um veiculo!");
    DesmanchTex(playerid);
    WantedLevel[playerid] += 5;
    new name[MAX_PLAYER_NAME], string[128];
    GetPlayerName(playerid, name, sizeof(name));
    format(string, sizeof(string), "{FF0000}%s {FFFFFF}ESTA DESMANCHANDO UM VEICULO", name);
    SendClientMessageToAll(-1,"{FFFFFF}Criminosos da {5c5c5c}Peaky Blinders {FFFFFF}estao desmanchando um veiculo!!");
    }
    return 1;
}
