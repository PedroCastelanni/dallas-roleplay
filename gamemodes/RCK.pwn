	CMD:limparficha(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    new result[64];
			if(sscanf(params, "us[64]", sscanfid, result))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /limparficha [id] [Motivo]");
				return 1;
			}
			if(IsACop(playerid))
			{
				if(IsPlayerConnected(sscanfid))
				{
					if(sscanfid != INVALID_PLAYER_ID)
					{
						if(OnDuty[playerid] != 1) { return SendClientMessage(playerid, COR_GREY, "Voc� n�o Bateu o cart�o !"); }
						if(sscanfid == playerid) { return SendClientMessage(playerid, COR_GREY, "Voc� n�o pode limpar sua propria ficha !"); }
						if(!IsACop(playerid)) { return SendClientMessage(playerid, COR_GREY, "Voc� n�o � um policial !"); }
						if(PlayerInfo[playerid][pCargo] < 4) { return SendClientMessage(playerid, COR_GREY, "Voc� precisa ser cargo 4+ para poder limpar fichas !"); }
						if(DeslogandoSocio[playerid] == 1) { return SendClientMessage(playerid, COR_GREY, "Voc� n�o pode limpar ficha tendo usado o comando /entrarorg."); }
						GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						format(stringZCMD, sizeof(stringZCMD), "* Voc� limpou a ficha de %s.", giveplayerZCMD);
						SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "* Oficial %s limpou sua ficha.", sendername);
						SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "* Oficial %s limpou a ficha de: %s,Motivo: %s.",PlayerName(playerid),giveplayerZCMD,(result));
						SendFamilyMessage(1, COR_LIGHTBLUE, stringZCMD);
						SendFamilyMessage(2, COR_LIGHTBLUE, stringZCMD);
						SendFamilyMessage(3, COR_LIGHTBLUE, stringZCMD);
						SendFamilyMessage(11, COR_LIGHTBLUE, stringZCMD);
						SendFamilyMessage(16, COR_LIGHTBLUE, stringZCMD);
						SendFamilyMessage(23, COR_LIGHTBLUE, stringZCMD);
						SendFamilyMessage(25, COR_LIGHTBLUE, stringZCMD);
						WantedLevel[sscanfid] = 0;
						SetPlayerChatBubble(sscanfid, "*", COR_VERMELHO, 1, 1);
						SetPlayerWantedLevelEx(sscanfid, 0);
						ClearCrime(sscanfid);
					}
				}
				else
				{
					SendClientMessage(playerid, COR_GREY, "ID/Nick! Invalido");
				}
			}

		}//not connected
		return 1;
	}
