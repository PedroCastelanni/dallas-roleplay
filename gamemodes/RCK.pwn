			if (PlayerInfo[playerid][pEmprego] != 0)
			{
				format(stringZCMD, sizeof(stringZCMD), "** %s %s: %s **", jtext, PlayerName(playerid), result);
				SendEmpregoMessage(PlayerInfo[playerid][pEmprego], 0xBEBEBEFF, stringZCMD);
				foreach(new i: Player)
				{
					if(IsPlayerConnected(i))
					{
						if(PlayerInfo[i][pVIP] == 0 && PlayerInfo[playerid][pSocio] == 0)
						{
							SendClientMessage(i, 0xba55d3FF,stringZCMD);
						}
					}
				}
			}
			format(stringZCMD, sizeof(stringZCMD), "* %s usou o r�dio para falar com o seu emprego(/echat).", PlayerName(playerid));
			ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
		}
		return 1;
	}
	CMD:cs(playerid, params[])  return ForT:cq(playerid, params);
	CMD:cq(playerid, result[])
	{
		if(PlayerMutado[playerid] == 1)
		{
			SendClientMessage(playerid, TEAM_CYAN_COR, "Voc� n�o pode falar, pois foi calado ! !");
			return 1;
		}
		if(IsPlayerConnected(playerid))
		{
			if(TendoQuarentena == 1 || TanoWarZone[playerid] == 1)
			{
				GetPlayerName(playerid, sendername, sizeof(sendername));
				if(isnull(result))
				{
					SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: (/cs) [Chat CS]");
					return 1;
				}
				if(TentouDivulgar(result))
				{
					GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
					format(stringZCMD, 128, "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
					ABroadCast(COR_AMARELO,stringZCMD,1);
					DivulgouLog(stringZCMD);
					return 1;
				}
				if (EquipeQuarentena[playerid] == 1)
				{
					format(stringZCMD, sizeof(stringZCMD), "[Humano] %s: %s", PlayerName(playerid), result);
					SendCSMessage(1, COR_DBLUE, stringZCMD);
				}
				if (EquipeQuarentena[playerid] == 2)
				{
					format(stringZCMD, sizeof(stringZCMD), "[Infectado] %s: %s", PlayerName(playerid), result);
					SendCSMessage(2, COR_VERMELHO, stringZCMD);
				}
				if (EquipeWarZone[playerid] == 3)
				{
					format(stringZCMD, sizeof(stringZCMD), "[Green] %s: %s", PlayerName(playerid), result);
					SendCSMessage(1, COR_GREEN, stringZCMD);
				}
				if (EquipeWarZone[playerid] == 2)
				{
					format(stringZCMD, sizeof(stringZCMD), "[Blue] %s: %s", PlayerName(playerid), result);
					SendCSMessage(2, COR_AZTECAS, stringZCMD);
				}
				if (EquipeWarZone[playerid] == 1)
				{
					format(stringZCMD, sizeof(stringZCMD), "[Red] %s: %s", PlayerName(playerid), result);
					SendCSMessage(3, COR_VERMELHO, stringZCMD);
				}
				//TempoChatEmprego[playerid] = GetTickCount();
			}
			else
			{
				SendClientMessage(playerid, COR_BALLAS, "Voc� n�o pode usar este comando agora!");
			}
		}
		return 1;
	}
	CMD:noob(playerid, params[])  return ForT:chatduvida(playerid, params);
	CMD:ig(playerid, params[])  return ForT:chatduvida(playerid, params);
	CMD:chatduvida(playerid, result[])
	{
		if(PlayerMutado[playerid] == 1)
		return SendClientMessage(playerid, TEAM_CYAN_COR, "Voc� n�o pode falar, pois foi calado !");
		if(GetTickCount() - TempoChatNoob[playerid] < 15000)
		return SendClientMessage(playerid,COR_GRAD1,"{FFFFFF}voce so pode mandar mensagem no insta a cada 15 segundos.");
		if(ChatNoob == true)
		return SendClientMessage(playerid, COR_GRAD1, "{FFFFFF}instagram global desativado pela staf");
		if(PlayerInfo[playerid][pBloqueadoChatDuvida] > 0)
		return SendClientMessage(playerid, COR_GRAD1, "{FF0000}voce esta bloqueado de usar o instagram");

		if(IsPlayerConnected(playerid))
		{
			if(isnull(result))
				return SendClientMessage(playerid, COR_GRAD2, "{FFFFFF}Digite: /ig [Sua mensagem] para falar com todos");
			if(TentouDivulgar(result))
			{
				GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
				format(stringZCMD, 128, "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
				ABroadCast(COR_AMARELO,stringZCMD,1);
				DivulgouLog(stringZCMD);
				return 1;
			}
			if(Palavrao(result))
			{
				GivePlayerMoneyEx(playerid, -100000);
				// TempoChatEmprego[playerid] = GetTickCount();
				SendClientMessage(playerid, COR_LIGHTRED, "{FF0000}[Para de ser lerdo} {FFFFFF}e proibido xingar no chat e por isso voce perdeu 1 milhao de reais, xingue de novo para perder mais");
				return 1;
			}
			strmid(VarChatDuvida[playerid], result, 0, strlen(result), 255);
			new Dialog[300];
			format(stringZCMD, sizeof(stringZCMD), "{6A5ACD}{%s}{FFFFFF}, Esse chat � exclusivo para conversas / duvidas,\n\ncaso seja usado para algo n�o relacionado, ser� punido imediatamente!\n\n\n\n",PlayerName(playerid));
			strcat(Dialog,stringZCMD);
			format(stringZCMD, sizeof(stringZCMD), "\nSua mensagem: {FFFFFF}%s \n{FF0000}deseja enviar essa mensagem ?",VarChatDuvida[playerid]);
			strcat(Dialog,stringZCMD);
			ShowPlayerDialog(playerid, 8725, DIALOG_STYLE_MSGBOX, "{6A5ACD}Instagram", Dialog, "Enviar", "Cancelar");
		}
		return 1;
	}
	CMD:admin(playerid, params[])  return ForT:a(playerid, params);
