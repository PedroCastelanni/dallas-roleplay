					{
						GameTextForPlayer(i, stringZCMD, 5000, txtid);
					}
				}
				format(stringZCMD, sizeof(stringZCMD), "%s : %s", PlayerName(playerid), result);
				cnnlog(stringZCMD);
				return 1;
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o esta autorizado a usar este comando!");
				return 1;
			}
		}
		return 1;
	}
	CMD:cadeia(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    if(PlayerInfo[playerid][pAdmin] < 1340)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o esta autorizado para usar este comando!");
				return 1;
			}
		    new playa, tempo, result[64];
   			if(sscanf(params, "uds[64]", playa, tempo, result))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /cadeia [id] [tempo] [motivo]");
				return 1;
			}
			if(PlayerInfo[playerid][pAdmin] < 2)
			{
				return 1;
			}
			if(PlayerInfo[playa][pJailed] != 0 && PlayerInfo[playerid][pAdmin] < 4)
			{
				SendClientMessage(playerid,COR_AMARELO,"Voc� n�o pode soltar presos,s� admins nivel 4 + !");
				return 1;
			}
			if (PlayerInfo[playerid][pAdmin] >= 2)
			{
				if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
					return 1;
				}
				if(IsPlayerConnected(playa))
				{
					if(playa != INVALID_PLAYER_ID)
					{
						PlayerInfo[playa][pSkin] = GetPlayerSkin(playa);
						if(PlayerInfo[playa][pSex] == 1)
						{
							SetPlayerSkin(playa, 42);
						}
						else
						{
							SetPlayerSkin(playa, 69);
						}
						SetPlayerSkin(playa, 268);
						if(PlayerInfo[playa][pSex] == 2) {  SetPlayerSkin(playa, 69); }
						if(PlayerInfo[playa][pSocio] >= 1) {  SetPlayerSkin(playa, 42); }
						GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						ResetPlayerWeaponsEx(playa);
						WantedLevel[playa] = 0;
						PlayerInfo[playa][pJailed] = 3;
						PlayerInfo[playa][pJailTime] = tempo*60;
						SetPlayerInterior(playa, 0);
						SetPlayerPos(playa, 1175.5886,-1182.0431,87.0254);
						format(stringZCMD, sizeof(stringZCMD), "* Vo�� prendeu %s,Motivo: %s.", PlayerName(playa),(result));
						SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "ADMCMD: %s colocou %s por [%d] minutos na cadeia. Motivo: %s.", PlayerName(playerid), PlayerName(playa) ,tempo,(result));
						SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
						if(AdminTrabalhando[playerid] < 1 && admhide[playerid] == 1)
						{
							format(stringZCMD, sizeof(stringZCMD), "* Voc� foi preso por [%d] minutos por algum Administrador.", tempo);
							SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
						}
						else
						{
							format(stringZCMD, sizeof(stringZCMD), "* Voc� foi preso por [%d] minutos por %s.", tempo,sendername);
							SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
						}
						SetPlayerChatBubble(playa, ".", COR_VERMELHO, 1, 1);
						return 1;
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voce n�o esta autorizado a usar este comando!");
			}
		}
		return 1;
	}
	CMD:cadeiaoculta(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pAdmin] < 1340)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o esta autorizado para usar este comando!");
				return 1;
			}
			if(sscanf(params, "u", sscanfid))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /cadeiaoculta [ ID ]");
				return 1;
			}
			if(IsPlayerConnected(sscanfid))
			{
				if(sscanfid != INVALID_PLAYER_ID)
				{
					if(PlayerInfo[sscanfid][pSex] == 1)
					{
						SetPlayerSkin(sscanfid, 42);
					}
					else
					{
						SetPlayerSkin(sscanfid, 69);
					}
					GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
					GetPlayerName(playerid, sendername, sizeof(sendername));
					format(stringZCMD, sizeof(stringZCMD), "* Voc� retirou o player %s da cadeia.", giveplayerZCMD);
					SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
					SetPlayerWorldBounds(sscanfid,20000.0000,-20000.0000,20000.0000,-20000.0000); //Reset world to player
					PlayerInfo[sscanfid][pJailed] = 0;
					SetPlayerSkin(sscanfid, PlayerInfo[sscanfid][pSkin]);
					if(gTeam[sscanfid] == 4) { gTeam[sscanfid] = 3; }
					ClearCrime(sscanfid);
					SetPlayerToTeamColor(sscanfid);
					ResetPlayerWeaponsEx(sscanfid);
					WantedLevel[sscanfid] = 0;
