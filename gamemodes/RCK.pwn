	CMD:pagar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(sscanf(params, "ud", sscanfid, moneysZCMD))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /pagar [id] [quantidade]");
				return 1;
			}
			if(AdminTrabalhando[sscanfid] != 0 && PlayerInfo[sscanfid][pAdmin] >= 1)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o pode pagar para admins em trabalho!");
				return 1;
			}
			if(moneysZCMD > 1000 && PlayerInfo[playerid][pLevel] < 3)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� precisa ser level 3+ para pagar mais que R$ 1000 !");
				return 1;
			}
			if(moneysZCMD > 1000 && PlayerInfo[playerid][pLevel] < 3)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� precisa ser level 2+ para pagar mais de R$1000 !");
				return 1;
			}
			if(moneysZCMD > 4000 && PlayerInfo[playerid][pLevel] < 4)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� precisa ser level 4+ para pagar mais de R$4000 !");
				return 1;
			}
			if(moneysZCMD > 5000 && PlayerInfo[playerid][pVIP] == 0)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� precisa ser vip para pagar mais de 5000(digite:/vip)");
				return 1;
			}
			if(moneysZCMD < 1 || moneysZCMD > 10000)
			{
				SendClientMessage(playerid, COR_GRAD1, "M�nimo R$1 - M�ximo R$10000.");
				return 1;
			}
			if (IsPlayerConnected(sscanfid))
			{
				if(sscanfid != INVALID_PLAYER_ID)
				{
					if(LocalAtual[sscanfid] == 106)
					{
						SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode usar este comando neste local !");
						return 1;
					}
					if (ProxDetectorS(5.0, playerid, sscanfid))
					{
						GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						playerdinheiroZCMD = GetPlayerMoneyEx(playerid);
						if (playerdinheiroZCMD >= moneysZCMD)
						{
							ConsumingMoney[sscanfid] = 1;
							GivePlayerMoneyEx(playerid, (0 - moneysZCMD));
							GivePlayerMoneyEx(sscanfid, moneysZCMD);
							format(stringZCMD, sizeof(stringZCMD), "Voc� pagou %s(Para: %d), R$%d.", giveplayerZCMD,sscanfid, moneysZCMD);
							PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
							SendClientMessage(playerid, COR_GRAD1, stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "Voc� recebeu R$%d de %s(ID: %d).", moneysZCMD, sendername, playerid);
							SendClientMessage(sscanfid, COR_GRAD1, stringZCMD);
							PlayerPlaySound(sscanfid, 1052, 0.0, 0.0, 0.0);
							format(stringZCMD, sizeof(stringZCMD), "* %s deu alguma grana para %s.", sendername ,giveplayerZCMD);
							ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
							GranaLog(stringZCMD);
						}
						else
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� com essa grana no bolso.");
						}
					}
					else
					{
						SendClientMessage(playerid, COR_GRAD1, "O jogador est� longe.");
					}
				}//invalid id
			}
			else
			{
				format(stringZCMD, sizeof(stringZCMD), "%d n�o � um jogador ativo.", sscanfid);
				SendClientMessage(playerid, COR_GRAD1, stringZCMD);
			}
		}
		return 1;
	}
	CMD:caridade(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(sscanf(params, "d", moneysZCMD))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /caridade [quantidade]");
				return 1;
			}
			if(LocalAtual[playerid] == 106)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode usar este comando neste local");
				return 1;
			}
			if(moneysZCMD < 1)
			{
				SendClientMessage(playerid, COR_GRAD1, "M�nimo R$ 1");
				return 1;
			}
			if(GetPlayerMoneyEx(playerid) < moneysZCMD)
			{
				SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� com essa grana no bolso.");
				return 1;
			}
			GivePlayerMoneyEx(playerid, -moneysZCMD);
			GetPlayerName(playerid, sendername, sizeof(sendername));
			format(stringZCMD, sizeof(stringZCMD), "%s obrigado pela sua doa��o de R$[%d].",sendername, moneysZCMD);
			Tax += moneysZCMD;
			PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
			SendClientMessage(playerid, COR_GRAD1, stringZCMD);
		}
		return 1;
	}
