	               foreach(new i: Player)
	               {
						if(PlayerInfo[i][pConnectTime] < 12)
   						{
         					new local[MAX_ZONE_NAME];
              				GetPlayer2DZone(sscanfid, local, MAX_ZONE_NAME);
