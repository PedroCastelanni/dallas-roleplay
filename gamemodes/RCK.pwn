	CMD:servico(playerid, x_nr[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(isnull(x_nr)) {
				SendClientMessage(playerid, COR_BRANCO, "|________________________ Service Names ________________________|");
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /servico [nome]");
				SendClientMessage(playerid, COR_GREY, "Servi�os: Taxi,Medico,Mecanico,Policia,Advogado,Pizza,Agua.");
				SendClientMessage(playerid, COR_BRANCO, "|_________________________________________________________|");
				return 1;
			}
			if(strcmp(x_nr,"taxi",true) == 0)
			{
				if(TaxiDrivers < 1)
				{
					SendClientMessage(playerid, COR_GREY, " N�o tem taxista online agora, tente /servico onibus...");
					return 1;
				}
				if(GetPlayerInterior(playerid) > 0)
				{
					SendClientMessage(playerid,COR_GREY,"Voc� n�o pode fazer pedidos neste momento !");
					return 1;
				}
				if(TransportDuty[playerid] > 0)
				{
					SendClientMessage(playerid, COR_GREY, "   Voc� n�o pode ligar para um Taxi agora !");
					return 1;
				}
				if(GetTickCount() - TempoTaxi[playerid] < 10000)
				{
					SendClientMessage(playerid,COR_HITMAN,"Usaram /servico taxi a pouco tempo, aguarde.");
					return 1;
				}
				GetPlayerName(playerid, sendername, sizeof(sendername));
				format(stringZCMD, sizeof(stringZCMD), "** %s Necessita de um Taxi. Use /servicos para ver a lista de servi�os dispon�veis.", sendername);
				SendFamilyMessage(10, TEAM_AZTECAS_COR, stringZCMD);
				SendClientMessage(playerid, COR_LIGHTBLUE, "* Voc� chamou um Taxi, Agora espere por uma resposta...");
				PediuServico[playerid] = 1;
				TaxiCall = playerid;
				return 1;
			}
			else if(strcmp(x_nr,"pizza",true) == 0 || strcmp(x_nr,"agua",true) == 0)
			{
			    if(Pizzaboys < 1)
		        {
		            SendClientMessage(playerid, COR_GREY, "N�o tem nenhum pizzaboy online neste momento, v� at� o restaurante ls !");
		            return 1;
		        }
		        if(GetPlayerInterior(playerid) > 0)
                {
                    SendClientMessage(playerid,COR_GREY,"Voc� n�o pode fazer pedidos neste momento !");
                    return 1;
                }
		        if(GetTickCount() - TempoPizza[playerid] < 10000)
    	        {
		            SendClientMessage(playerid,COR_HITMAN,"Usaram /servico pizza a pouco tempo, aguarde.");
		            return 1;
	            }
		        GetPlayerName(playerid, sendername, sizeof(sendername));
			    format(stringZCMD, sizeof(stringZCMD), "** %s Necessita de um Pizzaboy. (/aceitar pedido - Para aceitar a chamada.)", sendername);
		    	SendEmpregoMessage(15, TEAM_AZTECAS_COR, stringZCMD);
		    	SendClientMessage(playerid, COR_LIGHTBLUE, "* Voc� chamou um Pizzaboy... Agora espere a resposta.");
		    	PizzaCall = playerid;
		    	return 1;
			}
			else if(strcmp(x_nr,"onibus",true) == 0)
			{
			    if(BusDrivers < 1)
		        {
		            SendClientMessage(playerid, COR_GREY, "N�o tem Motorista de Uber online neste momento, espere um entrar !");
		            return 1;
		        }
		        if(GetPlayerInterior(playerid) > 0)
                {
                    SendClientMessage(playerid,COR_GREY,"Voc� n�o pode fazer pedidos neste momento !");
                    return 1;
                }
		        if(GetTickCount() - TempoOnibus[playerid] < 10000)
    	        {
		            SendClientMessage(playerid,COR_HITMAN,"Usaram /servico onibus a pouco tempo, aguarde.");
		            return 1;
	            }
		        GetPlayerName(playerid, sendername, sizeof(sendername));
			    format(stringZCMD, sizeof(stringZCMD), "** %s Necessita de um Onibus. Use /servicos para ver a lista de servi�oes disponiveis.", sendername);
		    	SendEmpregoMessage(10, TEAM_AZTECAS_COR, stringZCMD);
		    	SendClientMessage(playerid, COR_LIGHTBLUE, "* Voc� chamou um Onibus... Agora espere a resposta.");
		    	BusCall = playerid;
		    	return 1;
			}
			else if(strcmp(x_nr,"medico",true) == 0)
			{
				if(Medics < 1)
				{
					SendClientMessage(playerid, COR_GREY, "N�o tem nenhum medico online neste momento, espere um entrar !");
					return 1;
				}
				if(GetPlayerInterior(playerid) > 0)
				{
					SendClientMessage(playerid,COR_GREY,"Voc� n�o pode fazer pedidos neste momento !");
					return 1;
				}
				if(GetTickCount() - TempoPMedico[playerid] < 6000)
				{
					SendClientMessage(playerid,COR_HITMAN,"Usaram /servico medico a pouco tempo, aguarde.");
					return 1;
				}
				GetPlayerName(playerid, sendername, sizeof(sendername));
				format(stringZCMD, sizeof(stringZCMD), "** %s Necessita de um m�dico. Use /servicos para ver a lista de servi�os dispon�veis.", sendername);
				SendFamilyMessage(4, TEAM_AZTECAS_COR, stringZCMD);
				SendClientMessage(playerid, COR_LIGHTBLUE, "* Voc� chamou um m�dico.... Agora espere por resposta.");
				PediuServicoMed[playerid] = 1;
				MedicCall = playerid;
				return 1;
			}
			else if(strcmp(x_nr,"policia",true) == 0)
			{
				if(IsAGangster(playerid))
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� faz parte de uma organiza��o criminosa, n�o pode chamar a pol�cia !");
					return 1;
				}
				if(GetTickCount() - TempoPolicial[playerid] < 10000)
				{
					SendClientMessage(playerid,COR_HITMAN,"Usaram /servico policia a pouco tempo, aguarde.");
					return 1;
				}
				if(GetPlayerInterior(playerid) > 0)
				{
					SendClientMessage(playerid,COR_GREY,"Voc� n�o pode fazer pedidos neste momento !");
					return 1;
				}
				foreach(new i: Player)
				{
					if(IsACop(i) && IsPlayerConnected(i))
					{
						if(PolicialInRonda[i] == 1)
						{
							SendClientMessage(playerid, COR_LIGHTBLUE, "* Est�o fazendo uma chamada.");
							return 1;
