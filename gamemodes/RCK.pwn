						else
						{
							format(stringZCMD, sizeof(stringZCMD), "{9370DB}!{FFFFFF}: %s ganhou um teste god pelo administrador %s",giveplayerZCMD ,sendername);
						}
						ABroadCast(COR_LIGHTRED,stringZCMD,1);
