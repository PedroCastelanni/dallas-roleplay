				SendClientMessage(playerid, COR_GREY, "Voc� n�o tem permiss�o para usar esse comando!");
				return 1;
			}
		}
		return 1;
	}
	CMD:editar(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new editarnome[MAX_PLAYER_NAME];
			new editarnome2[MAX_PLAYER_NAME];
			new stat, quantidade;
			if(sscanf(params, "udd", sscanfid, stat, quantidade))
			{
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /editar [ ID ] [STATUS] [QUANTIDADE]");
				SendClientMessage(playerid, COR_GRAD4, "|1 Level |2 Horas Jogadas |3 Conta Banc�ria |4 N� Telefone |5 Respeito");
				SendClientMessage(playerid, COR_GRAD3, "|6 Chave Casa |7 ChaveBizz |8 ChaveFazenda |9 Detetive |10 Advogado |11 Mec�nico");
				SendClientMessage(playerid, COR_GRAD2, "|12 V.Drogas|13 Avisos |14 P.Neg Carteira |15 VIP |16 S�cio");
				SendClientMessage(playerid, COR_GRAD2, "|17 Crimes Cometidos |18 Dias VIP |19 Mudan�as de Nick");
				SendClientMessage(playerid, COR_GRAD2, "|20 Carro VIP |21 Carro Fixo |22 Coins |23 Materias");
				return 1;
			}
			if(IsPlayerConnected(sscanfid))
			{
				GetPlayerName(playerid,editarnome,sizeof(editarnome));
				GetPlayerName(sscanfid,editarnome2,sizeof(editarnome2));
				if(sscanfid != INVALID_PLAYER_ID)
				{
					if (PlayerInfo[playerid][pAdmin] >= 1337)
					{
						if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
							return 1;
						}
						if(PlayerInfo[sscanfid][pAdmin] == 1342 && PlayerInfo[playerid][pAdmin] != 1342)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode editar o Dono/Scripter !");
							return 1;
						}
						if(sscanfid == playerid && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
						{
							SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode se editar");
							return 1;
						}
						switch (stat)
						{
							case 1:
							{
								PlayerInfo[sscanfid][pLevel] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou level [%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								ScoreLevel(sscanfid);
								EditarLog(stringZCMD);
							}
							case 2:
							{
								PlayerInfo[sscanfid][pConnectTime] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou horas jogadas:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 3:
							{
								if(PlayerInfo[playerid][pAdmin] < 1340)
								{
									if(quantidade > 500000)
									{
										SendClientMessage(playerid, COR_GRAD1, "Apenas um Administrador Dono, pode editar um valor mais alto que 500000 !");
										return 1;
									}
								}
								new ValorAntigo;
								ValorAntigo = PlayerInfo[sscanfid][pConta];
								PlayerInfo[sscanfid][pConta] = quantidade;
								new logs[256];
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou saldo bancario:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								format(logs, sizeof(logs), "{B0E0E6}Server: o staff %s setou saldo bancario:[%d] no(a) player %s(Saldo bancario antigo era de R$%d)",PlayerName(playerid), quantidade, ValorAntigo);
								EditarLog(logs);
							}
							case 4:
							{
								PlayerInfo[sscanfid][pPnumber] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou numero:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 5:
							{
								PlayerInfo[sscanfid][pExp] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou respeito:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 6:
							{
								PlayerInfo[sscanfid][pPHousekey] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s deu-lhe uma chave da casa:[%d] pro(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 7:
							{
								PlayerInfo[sscanfid][pPbiskey] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s deu-lhe uma chave da empresa:[%d] pro(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 8:
							{
								PlayerInfo[sscanfid][pPFazkey] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s deu-lhe uma chave da fazenda:[%d] pro(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 9:
							{
								PlayerInfo[sscanfid][pDetSkill] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou nivel detetive:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 10:
							{
								PlayerInfo[sscanfid][pLawSkill] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou nivel advogado:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 11:
							{
								PlayerInfo[sscanfid][pMechSkill] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou nivel de mecanico:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 12:
							{
								PlayerInfo[sscanfid][pDrogasSkill] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou nivel de uso de drogas:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 13:
							{
								PlayerInfo[sscanfid][pAvisos] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou avisos 1/1:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 14:
							{
								PlayerInfo[sscanfid][pPontos] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou multas na carteira:[%d] no(a) player: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 15:
							{
								if(quantidade > 2) { return 1; }
								PlayerInfo[sscanfid][pVIP] = quantidade;
								format(stringZCMD, sizeof(stringZCMD), "{B0E0E6}Server: o staff %s setou vip:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
								EditarLog(stringZCMD);
							}
							case 16:
							{
