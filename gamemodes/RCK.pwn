TPL::LoginAgora(playerid)
{
	if(IsPlayerConnected(playerid))
	{
		logouagora[playerid] = 0;
		KillTimer(TempoLogin);
	}
}
TPL::Corrida()
{
	if(pcorrida > 0)
	{
			pcorrida = 0;
	}
}
TPL::CorridaOni()
{
	if(pcorridaoni > 0)
	{
			pcorridaoni = 0;
	}
}
TPL::cbomba()
{
	if(pcbomba > 0)
	{
			pcbomba = 0;
	}
}
TPL::Sinc()
{
	if(psinc > 0)
	{
			psinc = 0;
	}
}
TPL::Sequestrar()
{
	if(psequestrar > 0)
	{
			psequestrar = 0;
	}
}
TPL::ChecarDonob(playerid)
{
    if(IsPlayerConnected(playerid))
	{
		// Empresas Com interiores
 			for(new i = 0; i < sizeof(BizzInfo); ++i)
			{
			    new playername[MAX_PLAYER_NAME];
	        	GetPlayerName(playerid,playername,sizeof(playername));
	        	if(strcmp(playername,BizzInfo[i][bOwner],true)==0)
	        	{
	        	    PlayerInfo[playerid][pPbiskey] = i;
	        	    return 1;
	        	}
			}
			// Empresas sem interiores
			for(new i = 0; i < sizeof(SBizzInfo); ++i)
			{
			    new playername[MAX_PLAYER_NAME];
	        	GetPlayerName(playerid,playername,sizeof(playername));
	        	if(strcmp(playername,SBizzInfo[i][sbOwner],true)==0)
	        	{
	        	    PlayerInfo[playerid][pPbiskey] = i+100;
	        	    return 1;
	        	}
			}
			PlayerInfo[playerid][pPbiskey] = 255;
			return 1;
	}
	return 1;
}
TPL::CheckOwnerf(playerid)
{
		new playername[MAX_PLAYER_NAME];
		for(new i = 0; i < sizeof(FBizzInfo); i++)
		{
	       	GetPlayerName(playerid,playername,sizeof(playername));
	       	if(strcmp(playername,FBizzInfo[i][fbOwner],true)==0)
	       	{
	       	    PlayerInfo[playerid][pPFazkey] = i;
	       	    return true;
	       	}
		}
		PlayerInfo[playerid][pPFazkey] = 255;
		return true;
}

TPL::ChecarDonoh(playerid)
{
    if(IsPlayerConnected(playerid))
	{
		// Casas
		for(new h = 0; h < sizeof(HouseInfo); h++)
		{
		    new playername[MAX_PLAYER_NAME];
        	GetPlayerName(playerid,playername,sizeof(playername));
        	if(strcmp(playername,HouseInfo[h][hOwner],true)==0 && HouseInfo[h][Created])
        	{
        	    PlayerInfo[playerid][pPHousekey] = h;
                PlayerInfo[playerid][pCarroCasa] = HouseInfo[h][hIdCarro];
        	    return 1;
        	}
		}
		PlayerInfo[playerid][pPHousekey] = 999;
		return 1;
	}
	return 1;
}
TPL::DestruirObjeto(ObjID)
{
     DestroyDynamicObject(ObjID);
}
TPL::CriarExplosao(Float:X,Float:Y,Float:Z,tipo,Float:diam)
{
     CreateExplosion(X,Y,Z,tipo,diam);
}
TPL::SalarioPlayer(playerid)
{
	if(PlayerInfo[playerid][pCargo] > 0 || PlayerInfo[playerid][pLider] > 0)
	{
       	if(PlayerInfo[playerid][pCargo] == 1)
		{
  			new org = GetPlayerOrg(playerid);
  			if(CofreOrg[org][salarioc1] == 0)
		    {
      			SendClientMessage(playerid, COR_LIGHTRED, "� Sal�rio da organiza��o(C1):N�o definido.");
      			return 1;
			}
	    	if(CofreOrg[org][Dinheiro] < CofreOrg[org][salarioc1])
		    {
      			SendClientMessage(playerid, COR_LIGHTRED, "� Sua organiza��o n�o pode pagar o seu Sal�rio neste PayDay");
      			return 1;
			}
			PlayerInfo[playerid][pConta]=CofreOrg[org][salarioc1]+PlayerInfo[playerid][pConta];
			CofreOrg[org][Dinheiro] -= CofreOrg[org][salarioc1];
			format(gstring, sizeof(gstring), "� Sal�rio da organiza��o(C1): R$%d", CofreOrg[org][salarioc1]);
			SendClientMessage(playerid, COR_GRAD1, gstring);
			SacarGranaOrg(org,CofreOrg[org][salarioc1]);
		}
		if(PlayerInfo[playerid][pCargo] == 2)
		{
  			new org = GetPlayerOrg(playerid);
  			if(CofreOrg[org][salarioc2] == 0)
		    {
      			SendClientMessage(playerid, COR_LIGHTRED, "� Sal�rio da organiza��o(C2):N�o definido.");
      			return 1;
			}
	    	if(CofreOrg[org][Dinheiro] < CofreOrg[org][salarioc2])
		    {
		        SendClientMessage(playerid, COR_LIGHTRED, "� Sua organiza��o n�o pode pagar o seu Sal�rio neste PayDay");
      			return 1;
			}
			PlayerInfo[playerid][pConta]=CofreOrg[org][salarioc2]+PlayerInfo[playerid][pConta];
			CofreOrg[org][Dinheiro] -= CofreOrg[org][salarioc2];
			format(gstring, sizeof(gstring), "  Sal�rio da organiza��o(C2): R$%d", CofreOrg[org][salarioc2]);
			SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
			SacarGranaOrg(org,CofreOrg[org][salarioc2]);
		}
		if(PlayerInfo[playerid][pCargo] == 3)
		{
		    new org = GetPlayerOrg(playerid);
		    if(CofreOrg[org][salarioc3] == 0)
		    {
      			SendClientMessage(playerid, COR_LIGHTRED, "� Sal�rio da organiza��o(C3):N�o definido.");
      			return 1;
			}
		    if(CofreOrg[org][Dinheiro] < CofreOrg[org][salarioc3])
		    {
		        SendClientMessage(playerid, COR_LIGHTRED, "� Sua organiza��o n�o pode pagar o seu Sal�rio neste PayDay");
		        return 1;
			}
			PlayerInfo[playerid][pConta]=CofreOrg[org][salarioc3]+PlayerInfo[playerid][pConta];
			CofreOrg[org][Dinheiro] -= CofreOrg[org][salarioc3];
			format(gstring, sizeof(gstring), "� Sal�rio da organiza��o(C3): R$%d", CofreOrg[org][salarioc3]);
			SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
			SacarGranaOrg(org,CofreOrg[org][salarioc3]);
		}
		if(PlayerInfo[playerid][pCargo] == 4)
		{
		    new org = GetPlayerOrg(playerid);
		    if(CofreOrg[org][salarioc4] == 0)
		    {
      			SendClientMessage(playerid, COR_LIGHTRED, "� Sal�rio da organiza��o(C4):N�o definido.");
      			return 1;
			}
		    if(CofreOrg[org][Dinheiro] < CofreOrg[org][salarioc4])
		    {
		        SendClientMessage(playerid, COR_LIGHTRED, "� Sua organiza��o n�o pode pagar o seu Sal�rio neste PayDay");
		        return 1;
			}
			PlayerInfo[playerid][pConta]=CofreOrg[org][salarioc4]+PlayerInfo[playerid][pConta];
			CofreOrg[org][Dinheiro] -= CofreOrg[org][salarioc4];
			format(gstring, sizeof(gstring), "� Sal�rio da organiza��o(c4): R$%d", CofreOrg[org][salarioc4]);
			SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
			SacarGranaOrg(org,CofreOrg[org][salarioc4]);
		}
		if(PlayerInfo[playerid][pCargo] == 5 || PlayerInfo[playerid][pCargo] == 5)
		{
		    new org = GetPlayerOrg(playerid);
		    if(CofreOrg[org][salarioc5] == 0)
		    {
      			SendClientMessage(playerid, COR_LIGHTRED, "� Sal�rio da organiza��o(C5+):N�o definido.");
      			return 1;
			}
		    if(CofreOrg[org][Dinheiro] < CofreOrg[org][salarioc5])
		    {
		        SendClientMessage(playerid, COR_LIGHTRED, "Sua organiza��o n�o pode pagar o seu Sal�rio neste PayDay");
		        return 1;
			}
			PlayerInfo[playerid][pConta]=CofreOrg[org][salarioc5]+PlayerInfo[playerid][pConta];
			CofreOrg[org][Dinheiro] -= CofreOrg[org][salarioc5];
			format(gstring, sizeof(gstring), "� Sal�rio da organiza��o(C5+): R$%d", CofreOrg[org][salarioc2]);
			SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
			SacarGranaOrg(org,CofreOrg[org][salarioc5]);
		}
		if(PlayerInfo[playerid][pCargo] == 6 || PlayerInfo[playerid][pLider] > 0)
		{
		    new org = GetPlayerOrg(playerid);
		    if(CofreOrg[org][salariolider] == 0)
		    {
      			SendClientMessage(playerid, COR_LIGHTRED, "� Sal�rio da organiza��o(L�der):N�o definido.");
      			return 1;
			}
		    if(CofreOrg[org][Dinheiro] < CofreOrg[org][salariolider])
		    {
	     		SendClientMessage(playerid, COR_LIGHTRED, "� Sua organiza��o n�o pode pagar o seu Sal�rio neste PayDay");
			    return 1;
			}
			PlayerInfo[playerid][pConta]=CofreOrg[org][salariolider]+PlayerInfo[playerid][pConta];
			CofreOrg[org][Dinheiro] -= CofreOrg[org][salariolider];
			format(gstring, sizeof(gstring), "� Sal�rio da organiza��o(L�der): R$%d", CofreOrg[org][salariolider]);
			SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
			SacarGranaOrg(org,CofreOrg[org][salariolider]);
		}
	}
	return true;
}
TPL::Sincronizar(playerid)
{
 	if(IsPlayerConnected(playerid))
	{
		SetPlayerPos(playerid,xx[playerid],yy[playerid],zz[playerid]);
		SetPlayerFacingAngle(playerid,FaceAngle[playerid]);
		SetPlayerHealth(playerid,PlayerHPP[playerid]);
		SetPlayerVirtualWorld(playerid,virt[playerid]);
		SetPlayerInterior(playerid,interior[playerid]);
		SetPlayerSkin(playerid,skinneg[playerid]);
		SetPlayerArmour(playerid,APP[playerid]);
		ResetPlayerWeaponsEx(playerid);
		GivePlayerWeaponEx(playerid,gunsinc[1][playerid],ammoo[1][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[2][playerid],ammoo[2][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[3][playerid],ammoo[3][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[4][playerid],ammoo[4][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[5][playerid],ammoo[5][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[6][playerid],ammoo[6][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[7][playerid],ammoo[7][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[8][playerid],ammoo[8][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[9][playerid],ammoo[9][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[10][playerid],ammoo[10][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[11][playerid],ammoo[11][playerid]);
		GivePlayerWeaponEx(playerid,gunsinc[12][playerid],ammoo[12][playerid]);
		if(vehicledd[playerid] == 1) { PutPlayerInVehicle(playerid,VehicleIDD[playerid],1); vehicledd[playerid] = 0; }
		sincronizando[playerid] = 0;
		KillTimer(TempoSinc);
		desbugando[playerid] = 0;
		SendClientMessage(playerid,COR_AMARELO,"Sincronizado com sucesso!");
	}
}
public OnPlayerClickPlayer(playerid, clickedplayerid, source)
{
	new string[128];
	new pstring[128];
	new plname[MAX_PLAYER_NAME];
	if(NoTuto[playerid] != 0) { return 1; }
	if(IsPlayerInAnyVehicle(playerid)) { return SendClientMessage(playerid, COR_AMARELO, "Voc� n�o pode usar esta fun��o dentro de um ve�culo !"); }
	BernInfo[playerid][Tels] = 0;
    GetPlayerName(clickedplayerid, plname, sizeof(plname));
    format(string, sizeof(string), "Menu do(a) %s", plname);
    format(pstring, sizeof(pstring), "Ligar para %s\nMandar SMS para %s", plname,plname);
    ShowPlayerDialog(playerid, 3, DIALOG_STYLE_LIST, string, pstring, "Confirmar", "Cancelar");
    BernInfo[playerid][Tels] = PlayerInfo[clickedplayerid][pPnumber];
	return 1;
}
TPL::Emboscada(playerid)
{
	SendClientMessageToAll(COR_LIGHTBLUE, "[EMBOSCADA] A emboscada chegou ao fim !");
	TendoEmboscada = 0;
	KillTimer(TempoEmboscada);
 	GangZoneHideForAll(GZEmboscada);
    GangZoneDestroy(GZEmboscada);
    return 1;
}
TPL::GuerraTerrorista(playerid)
{
    new string[128];
	new plname[MAX_PLAYER_NAME];
 	GetPlayerName(playerid, plname, MAX_PLAYER_NAME);
 	TendoGuerra = 0;
    KillTimer(TempoGuerra);
    BernInfo[playerid][InicioGuerra] = 0;
    GangZoneHideForAll(GZGuerra);
    GangZoneDestroy(GZGuerra);
    for(new i; i != MAX_VEHICLES; ++i)
    {
    	if(IsPlayerInTerritorio(CarrosExe[i]) || IsPlayerInTerritorio(CarrosTaliban[i]) || IsPlayerInTerritorio(CarrosAlqaeda[i]))
    	{
    	    SetVehicleToRespawn(i);
    	}
    }
    SendClientMessageToAll(0x33ccffFF, "__________Final Guerra Terrorista__________");
 	format(string, sizeof(string), "Placar: {f4005b}Taliban[%d] {FFFFFF}X {33aa33}Exercito[%d] {FFFFFF}X {ffcc99}estado islamico[%d] !",Territorio[talibankill], Territorio[exercitokill] , Territorio[alqaedakill]);
    SendClientMessageToAll(COR_AMARELO, string);
    SendClientMessageToAll(0x33ccffFF, "__________Final Guerra Terrorista__________");
    if(Territorio[exercitokill] > Territorio[talibankill] && Territorio[exercitokill] > Territorio[alqaedakill])
    {
        DepositarGranaOrg(3, 1000000);
    }
	else if(Territorio[talibankill] > Territorio[exercitokill] && Territorio[talibankill] > Territorio[alqaedakill])
    {
        DepositarGranaOrg(6, 1000000);
    }
    else if(Territorio[alqaedakill] > Territorio[exercitokill] && Territorio[alqaedakill] > Territorio[talibankill])
    {
        DepositarGranaOrg(16, 1000000);
    }
	return 1;
}
