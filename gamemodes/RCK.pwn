 	    new contagem = 0;
	 	foreach(new x: Player)
	  	{
	  	    new files[MAX_PLAYER_NAME];
 	        format(files, sizeof files, "DJ/%s.ini", PlayerName(x));
 	        new UrlSom[256];
			if(DOF2_FileExists(files))
	        {
	            strmid(UrlSom, DOF2_GetString(files,"UrlSom"), 0, strlen(DOF2_GetString(files,"UrlSom")), 255);
			    if(IsPlayerInRangeOfPoint(playerid, DOF2_GetFloat(files, "DistanciaSom"), DOF2_GetFloat(files, "SomX"), DOF2_GetFloat(files, "SomY"), DOF2_GetFloat(files, "SomZ")))
				{
				    contagem++;
					if(DonoFesta[x] == 1 && EscutandoSom[playerid] == 0 && SomID[playerid] != x)
 					{
  						EscutandoSom[playerid] = 1;
						SomID[playerid] = x;
    					if(strfind(UrlSom,"www.youtube.com",true) != -1)
						{
   							format(UrlSom, 128, "http://www.youtubeinmp3.com/fetch/?video=%s", UrlSom);
			    			//format(inputtext, sizeof(128), "http://www.youtubeinmp3.com/fetch/?video=%s", inputtext);
						}
						SendClientMessage(playerid, COR_LIGHTRED, "[AVISO]: O Som est� tocando! Caso voc� n�o esteja ouvindo digite /rsom");
						if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid, UrlSom, DOF2_GetFloat(files, "SomX"), DOF2_GetFloat(files, "SomY"), DOF2_GetFloat(files, "SomZ"), DOF2_GetFloat(files, "DistanciaSom"), 1);
						return 1;
  					}
				}
			}
		}
		if(contagem == 0)
		{
		    EscutandoSom[playerid] = 0;
		}
	}
	if(IsAPishing(playerid))
	{
	        if(PlayerToPoint(1.0,playerid,2196.0759,-1741.0487,13.2835))
			{
