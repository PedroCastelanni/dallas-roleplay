		    	MoveObject(LSPrisonPRFsObject[0], 1824.318481, -1534.731201, 14.296878 - 0.01, 0.002, 0, 0, 343);
		    	MoveObject(LSPrisonPRFsObject[1], 1822.407592, -1540.949951, 14.296878 - 0.01, 0.002, 0, 0, 163);
		    	EasternPRFsStatus = PRFS_CLOSING;
	    	}
	    }
	    else if (IsPlayerInRangeOfPoint(playerid, 10.0, 1754.27, -1592.18, 13.54))
	    {
	        if (SouthernPRFsStatus == PRFS_OPENING)
	        {
	            SendClientMessage(playerid, COR_AMARELO, "* Voc� deve esperar para que os port�es se abram totalmente primeiro..");
	            return 1;
	        }
	        else if (SouthernPRFsStatus == PRFS_CLOSING)
	        {
	            SendClientMessage(playerid, COR_AMARELO, "* Voc� deve esperar para que os port�es se fechem totalmente primeiro..");
	            return 1;
