TPL::TextosObjetosSV()
{
	//PLACARES
 	new TextosPlacaresSV1 = CreateObject(19482,1456.838745,-1020.448852,32.050563,-0.199999,0.099999,-89.994148);
	SetObjectMaterialText(TextosPlacaresSV1,"{48D1CC}BANCO",0,100,"Arial Black",54,1,-1,0,1);

	new TextosPlacaresSV2 = CreateObject(19482,1461.441040,-1020.448852,32.034572,-0.199999,0.099999,-89.994148);
	SetObjectMaterialText(TextosPlacaresSV2,"{48D1CC}CENTRAL",0,100,"Arial Black",54,1,-1,0,1);

	new TextosPlacaresSV3 = CreateObject(19482,1464.922241,-1020.448852,32.022407,-0.199999,0.099999,-89.994148);
	SetObjectMaterialText(TextosPlacaresSV3,"{48D1CC}DE",0,100,"Arial Black",54,1,-1,0,1);

