}
TPL::ChecarDoenca()//ATUAL
{
    for(new f = 0; f < MAX_OBJ; f++)
    {
    	if(dItemData[f][ObjtPos][0] != 0.0){
     		if(gettime() > dItemData[f][droptTimer]){
       			DestroyDroppedObject(f);
       		}
       	}
    }
	for(new c = 1; c < 254; c++)
	{
 		if (gLastDriver[c] >= 300)
		{
			gLastDriver[c]++;
		}
	}
	return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
     new string[100];
     new vid = GetPlayerVehicleID(playerid);
     new panels,doors,lights,tires;
     if(TransportCost[playerid] > 0 && TransportDriver[playerid] < 999)
     {
          if(IsPlayerConnected(TransportDriver[playerid]))
 		  {
		       TransportMoney[TransportDriver[playerid]] += TransportCost[playerid];
			   format(gstring, sizeof(gstring), "~w~Custo da corrida~n~~r~R$[%d]",TransportCost[playerid]);
			   GameTextForPlayer(playerid, gstring, 5000, 1);
			   GivePlayerMoneyEx(playerid, -TransportCost[playerid]);
			   format(gstring, sizeof(gstring), "~w~Passageiro saiu do taxi~n~~g~ganhou R$[%d]",TransportCost[playerid]);
			   GameTextForPlayer(TransportDriver[playerid], gstring, 5000, 1);
			   TransportTime[TransportDriver[playerid]] = 0;
			   TransportCost[TransportDriver[playerid]] = 0;
			   TransportTime[playerid] = 0;
			   TransportCost[playerid] = 0;
			   TransportDriver[playerid] = 999;
          }
     }
     if(TransportDuty[playerid] > 0)
     {
          if(TransportDuty[playerid] == 1)
          {
               TaxiDrivers -= 1;
          }
          else if(TransportDuty[playerid] == 2)
          {
                BusDrivers -= 1;
          }
          TransportDuty[playerid] = 0;
	  	  format(string, sizeof(string), "* Est� fora do servi�o, ganhou R$[%d].", TransportMoney[playerid]);
          SendClientMessage(playerid, COR_LIGHTBLUE, string);
          GivePlayerMoneyEx(playerid, TransportMoney[playerid]);
          ConsumingMoney[playerid] = 1; TransportValue[playerid] = 0; TransportMoney[playerid] = 0;
     }
     if(GetPVarInt(playerid, "VarFPS"))
	 {
          if(IsValidObject(dcObject[playerid])==1)DestroyObject(dcObject[playerid]);
          SetCameraBehindPlayer(playerid);
          SetPVarInt(playerid, "VarFPS", 0);
	 }
 	 if (GetPlayerState(playerid) == 1)
	 {
 	      return 1;
 	 }
	 if(ativoualarme[playerid] == 1)
	 {
          GetVehicleDamageStatus(vid,panels,doors,lights,tires);
          UpdateVehicleDamageStatus(vid, panels, doors, 0, tires);
          alarmeativado[vid] = 0;
          ativoualarme[playerid] = 0;
          KillTimer(tempopiscar[playerid]);
	 }
	 TogglePlayerControllable(playerid, 1);
	 return 1;
}
public OnPlayerRequestClass(playerid, classid)
{
    if(IsPlayerNPC(playerid))
	{
        SpawnPlayer(playerid);
		return 1;
	}
 	if (RegistrationStep[playerid] == 0 && gPlayerLogged[playerid] != 1)
	{
      	TogglePlayerSpectating(playerid, true);
      	TimerLogin[playerid] = SetTimerEx("mostrarTelaLogin", 100, true, "d", playerid);
 		PlayerPlaySound(playerid, 1098, 0.0, 0.0, 0.0);
		ClearChatbox(playerid, 10);
		PlayAudioStreamForPlayer(playerid, "http://som.brasilplaygames.com.br/som/Rocketmisic.mp3");

		InterpolateCameraPos(playerid, -2235.281494, 1246.057739, 790.175903, -2238.119140, 1251.406372, 789.115722, 10000);
        InterpolateCameraLookAt(playerid, -2237.549072, 1250.420898, 789.270019, -2243.100830, 1251.505615, 788.700988, 10000);


  		/*InterpolateCameraPos(playerid, 987.909362, -1712.450805, 47.442787, 1238.741821, -1714.237304, 28.193325, 50000);
		InterpolateCameraLookAt(playerid, 992.657348, -1712.335937, 45.879596, 1239.015380, -1710.006103, 25.543354, 60000);
		SetPlayerCameraPos(playerid, 1519.85, -1070.90, 131.08);
		SetPlayerCameraLookAt(playerid, 1516.31, -1075.42, 129.33);*/
		PlayerInfo[playerid][pSkin] = Peds[classid][0];
		SetPlayerTeamFromClass(playerid,classid);
		ClearChatbox(playerid, 10);
	}
	else
	{
	    SpawnPlayer(playerid);
	}

	return 1;
}

TPL::SetPlayerTeamFromClass(playerid,classid)
{
 	if (classid >= 1 && classid <= 11)
	{
		gTeam[playerid] = 11; //admin
		PlayerInfo[playerid][pTeam] = 11;
	}
	else
	{
	    gTeam[playerid] = 2;
	    PlayerInfo[playerid][pTeam] = 2;
	}
	return 1;
}
TPL::SetPlayerCriminal(playerid,declare,reason[])
{
	if(IsPlayerConnected(playerid) && !IsACop(playerid) && AdminTrabalhando[playerid] == 0 && NaPorraDoEvento[playerid] == false)
	{
	    PTC++;
	    if(WantedLevel[playerid] < 100000) WantedLevel[playerid] += 1;
	    PlayerInfo[playerid][pCrimes] += 1;
		new turned[MAX_PLAYER_NAME];
		new turner[MAX_PLAYER_NAME];
		new location[MAX_ZONE_NAME];
		GetPlayer2DZone(playerid, location, MAX_ZONE_NAME);
		strmid(PlayerCrime[playerid][pAccusedof], reason, 0, strlen(reason), 255);
		GetPlayerName(playerid, turned, sizeof(turned));
		if (declare == 255)
		{
		    format(turner, sizeof(turner), "C�meras de Seguran�a");
			strmid(PlayerCrime[playerid][pAcusador], turner, 0, strlen(turner), 255);
		}
		else
		{
		    if(IsPlayerConnected(declare))
		    {
				GetPlayerName(declare, turner, sizeof(turner));
				strmid(PlayerCrime[playerid][pAcusador], turner, 0, strlen(turner), 255);
				strmid(PlayerCrime[declare][pAcusado], turned, 0, strlen(turned), 255);
				strmid(PlayerCrime[declare][pAcusoCrime], reason, 0, strlen(reason), 255);
			}
		}
		new giveplayer[MAX_PLAYER_NAME];
        new giveplayerid;
        new playername[MAX_PLAYER_NAME];
        GetPlayerName(playerid,playername,sizeof(playername));
        GetPlayerName(giveplayerid, giveplayer, sizeof(giveplayer));
		format(gstring, sizeof(gstring), "Voc� cometeu um crime ( %s ). Denunciante: %s.",reason,turner);
		SendClientMessage(playerid, COR_LIGHTRED, gstring);
		SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
		format(gstring, sizeof(gstring), "N�vel de Procurado: %d", WantedLevel[playerid]);
		SendClientMessage(playerid, COR_AMARELO, gstring);
		foreach(new i: Player)
		{
			if(IsPlayerConnected(i))
			{
			    if(IsACop(i) || PlayerInfo[i][pEmprego] == 7)
			    {
                    SendClientMessage(i, COR_LIGHTRED, "Aten��o Todas As Unidades");
					format(gstring, sizeof(gstring), "HQ: Denunciante: Relato: %s | Suspeito: {FF0000}%s[%d]",turner,turned,playerid);
					SendClientMessage(i, TEAM_BLUE_COR, gstring);
					if(GetPlayerInterior(playerid) == 0)
					{
						format(gstring, sizeof(gstring), "HQ: Crime: %s | Localiza��o: %s | Em Interior: N�o",reason,location);
						SendClientMessage(i, TEAM_BLUE_COR, gstring);
					}
					else
					{
						format(gstring, sizeof(gstring), "HQ: Crime: %s | Localiza��o: %s | Em Interior: Sim",reason,location);
						SendClientMessage(i, TEAM_BLUE_COR, gstring);
					}
				}
			}
		}
	}
}
TPL::RingToner()
{
	foreach(new i: Player)
	{
	    if(IsPlayerConnected(i))
	    {
			if(RingTone[i] != 6 && RingTone[i] != 0 && RingTone[i] < 11)
			{
				RingTone[i] = RingTone[i] -1;
				PlayerPlaySound(i, 1138, 0.0, 0.0, 0.0);
			}
			if(RingTone[i] == 6)
			{
				RingTone[i] = RingTone[i] -1;
			}
			if(RingTone[i] == 20)
			{
				RingTone[i] = RingTone[i] -1;
				PlayerPlaySound(i, 1139, 0.0, 0.0, 0.0);
			}
		}
	}
	SetTimer("RingTonerRev", 1000, 0);
	return 1;
}
TPL::RingTonerRev()
{
	foreach(new i: Player)
	{
	    if(IsPlayerConnected(i))
	    {
			if(RingTone[i] != 5 && RingTone[i] != 0 && RingTone[i] < 10)
			{
				RingTone[i] = RingTone[i] -1;
				PlayerPlaySound(i, 1137, 0.0, 0.0, 0.0);
			}
			if(RingTone[i] == 5)
			{
				RingTone[i] = RingTone[i] -1;
			}
			if(RingTone[i] == 19)
			{
				PlayerPlaySound(i, 1139, 0.0, 0.0, 0.0);
				RingTone[i] = 0;
			}
		}
	}
	SetTimer("RingToner", 1000, 0);
	return 1;
}
TPL::Procurando(playerid,give)
{
	new string[250];
    if(!IsPlayerConnected(give))
	{
	     KillTimer(timer[playerid]);
	     DisablePlayerCheckpoint(playerid);
	     ProcuraOffer[playerid] = 999;
	     format(string, sizeof(string), "[Procurando] [%d] que voc� estava procurando saiu do jogo, a busca foi cancelada.", give);
	     SendClientMessage(playerid, COR_AMARELO, string);
		 return 1;
    }
    static Float:X,Float:Y,Float:Z;
    GetPlayerPos(give,X,Y,Z);
    SetPlayerCheckpoint(playerid, X,Y,Z, 6);
	if(PlayerToPoint(4.0,playerid,X,Y,Z))
	{
         DisablePlayerCheckpoint(playerid);
	     KillTimer(timer[playerid]);
	     ProcuraOffer[playerid] = 999;
	     GameTextForPlayer(playerid, "~w~Chegou ao Destino", 5000, 1);
    }
	return true;
}
TPL::CheckGas(playerid)
{

    	if(IsPlayerConnected(playerid))
       	{
       	    new vid = GetPlayerVehicleID(playerid);
       	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && !IsPlayerNPC(playerid) && EngineCarro[vid] == 1 && !IsAAviao(vid) && !CivisCarros(vid))
       	    {
	       		new vehicle = GetPlayerVehicleID(playerid);
	       		new engine,lights,alarm,doors,bonnet,boot,objective;
                if(Gas[vehicle] >= 1)
		   		{
		   		    if(Gas[vehicle] <= 10)
			   		{
					   PlayerPlaySound(playerid, 1085, 0.0, 0.0, 0.0);
				   	}
                    if(CaimnhoneiroCarros(vehicle) || CoveiroCarros(vehicle) || CarteiroCarros(vehicle) || SegurancasCarros(vehicle) || OnibusCarros(vehicle) || PizzaboysCarros(vehicle) || LixeiroCarros(vehicle) || CarrosPlantacao(vehicle) || CarrosColheita(vehicle) || CarrosPesquisa(vehicle))
					{
					 	Gas[vehicle]++;
				 	}
					//Gas[vehicle]++;
        		    Gas[vehicle]--;
		   		}
	   			else
	           	{
	           	    if(vehicle >= TOTAL_CARROS)return 1;
	              	EngineCarro[vid] = 0;
                    PlayerPlaySound(playerid, 1159, 0.0, 0.0, 0.0);
                    GetVehicleParamsEx(vid,engine,lights,alarm,doors,bonnet,boot,objective);
          	        SetVehicleParamsEx(vid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
		        	GameTextForPlayer(playerid,"~r~~n~~n~~n~~n~~n~~n~~n~~n~SEM GAS !",1500,3);
				}
			}
    	}
		return 1;
}
