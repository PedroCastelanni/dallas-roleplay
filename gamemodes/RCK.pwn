CMD:desjbl(playerid)
{
        if(EleTEmJbl[playerid] == 1)
        {
            if(JBL[playerid] == -1)
            {
                return SendClientMessage(playerid, 0xFF4500FF, "{FF0000}[ERRO]{FFFFFF} para desligar sua jbl, ela precisa esta {FFFF00}ligada");
            }
            for(new j; j < MAX_JBL; j++)
            {
                if(InfoJBL[JblUsed][j] == JBL[playerid])
                {
                    new Float:X, Float:Y, Float:Z; GetDynamicObjectPos(InfoJBL[JblUsed][j], X, Y, Z);
                    if(IsPlayerInRangeOfPoint(playerid, 3.0, X, Y, Z))
                    {
                        SendClientMessage(playerid, 0xFFFF00FF, "| INFO | Voc� desligou sua JBL");
                        DestroyDynamicObject(InfoJBL[JblUsed][j]);
                        JBL[playerid] = -1;
                        InfoJBL[JblUsed][j] = -1;
                        DestroyDynamic3DTextLabel(InfoJBL[TextJBL][j]);
                        InfoJBL[TextJBL][j] = CreateDynamic3DTextLabel("{FFFFFF}JBL", -1, -999.0, -98383.3, -9292.0, 10.0);//Text3D
                        for(new i; i < MAX_PLAYERS; i++)
                        {
                            if(IsPlayerInRangeOfPoint(i, 20.0, X, Y, Z))
                            {
                                StopAudioStreamForPlayer(i);
                                OuvindoMusica[i] = 0;
                            }
                        }
                        return 1;
                    }
                    else
                    {
                        return SendClientMessage(playerid, 0xFF4500FF, "{FF0000}[ERRO]{FFFFFF} precisa esta perto de sua jbl para desligar.");
                    }
                }
            }
            return SendClientMessage(playerid, 0xFF4500FF, "{FF0000}[ERRO]{FFFFFF} sua jbl nao foi encontrada, procure.");
        }
        else
        {
            return SendClientMessage(playerid, 0xFF4500FF, "{FF0000}[ERRO]{FFFFFF} voce nao possui uma jbl compre uma no /vip ou em nosso discord");
        }
}

