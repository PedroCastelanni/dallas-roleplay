					SendClientMessage(playerid, COR_GRAD5, "J� est� tendo uma guerra nesse territorio.");
					TempoDominar[playerid] = GetTickCount();
					return 1;
				}
				TempoDominar[playerid] = GetTickCount();
				GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
				foreach(new i: Player)
				{
					if(PlayerInfo[i][pChatTerritorio] == 0)
					{
						format(stringZCMD, sizeof(stringZCMD), "[Territ�rios]: %s e os Vagos est�o dominando a Pista de Skate!",playernameZCMD);
						SendClientMessage(i, COR_VAGOS, stringZCMD);
					}
				}
				SendClientMessage(playerid, COR_GRAD3, "Fique atento, seus inimigos foram avisados e ir�o aparecer a qualquer momento.");
				SendClientMessage(playerid, COR_GRAD5, "Espere 1 minuto para dominar est� area .");
				GangZoneFlashForAll(GZSkate,COR_VAGOS);
				Dominando[playerid] = 1;
				MenuTR[playerid] = 0;
				ProvocoSkate[playerid] = 1;
				GuerranoSkate = 1;
				TempoGuerraSkate = SetTimerEx("GuerraSkate", 60000, 0, "i", playerid);
				return 1;
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD3, "Voc� n�o est� em nenhum territ�rio!");
			}
			return 1;
		}
		return 1;
	}
	CMD:deslogartodos(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if (PlayerInfo[playerid][pAdmin] >= 1341)
			{
				if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
					return 1;
				}
				GetPlayerName(playerid, sendername, sizeof(sendername));
				foreach(new i: Player)
				{
					if(IsPlayerConnected(i))
					{
						OnPlayerUpdate(i);
						gPlayerLogged[i] = 0;
						format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Deslogou Todos os Players",sendername);
						SendClientMessage(i, COR_LIGHTRED, stringZCMD);
						Kick(i);
					}
				}
				SendClientMessage(playerid, COR_GRAD1, " Todos os players deslogados.");
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Voce n�o est� autorizado a usar o comando!");
			}
		}
		return 1;
	}
	CMD:kick(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    new result[64];
			if(sscanf(params, "us[64]", sscanfid, result))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /kick [Id Do Jogador] [motivo]");
				return 1;
			}
			if (PlayerInfo[playerid][pAdmin] >= 1)
			{
				if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
					return 1;
				}
				if(IsPlayerNPC(sscanfid)) return 1;
				if(PlayerInfo[sscanfid][pAdmin] > 1340)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o pode kickar um Admin Dono/Scripter,VOC� � UM MERDA HUAHUAHUA!");
					return 1;
				}
				if(IsPlayerConnected(sscanfid))
				{
					if(sscanfid != INVALID_PLAYER_ID)
					{
						if(PlayerInfo[sscanfid][pAdmin] >= 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
						{
							if(sscanfid != playerid)
							{
								format(stringZCMD, sizeof(stringZCMD), "ID [%d] N�o est� Online.", sscanfid);
								SendClientMessage(playerid, COR_GRAD1, stringZCMD);
								return 1;
							}
						}
						GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						getdate(year, month, day);
						format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Foi Kickado by %s, Motivo: %s", giveplayerZCMD, sendername, (result));
						SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
						KickLog(stringZCMD);
						Kick(sscanfid);
						return 1;
					}
				}
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Esse n�o � um jogador ativo.");
			}
		}
		return 1;
	}
	CMD:avisados(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			new nome[24];
			GetPlayerName(playerid, nome, sizeof nome);
			if(PlayerInfo[playerid][pAdmin] < 1)
			{
				SendClientMessage(playerid, COR_GRAD2, "Voc� n�o � um Admin !");
				return 1;
			}
			SendClientMessage(playerid, COR_VERDE, "Avisados Online:");
			foreach(new i: Player)
			{
				if(IsPlayerConnected(i))
				{
					if(PlayerInfo[i][pAvisos] > 0)
					{
						GetPlayerName(i, sendername, sizeof(sendername));
						format(stringZCMD, 256, "Player: %s, com [%d] aviso(s). ", sendername, PlayerInfo[i][pAvisos]);
						SendClientMessage(playerid, COR_BRANCO, stringZCMD);
					}
				}
			}
		}
		return 1;
	}
	CMD:aviso(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
		    new result[64];
			if(sscanf(params, "us[64]", sscanfid, result))
			{
				SendClientMessage(playerid, COR_GRAD2, "{0099ff}�{ffffff} USE: /aviso [id] [motivo]");
				return 1;
			}
			if (PlayerInfo[playerid][pAdmin] >= 4)
			{
				if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1342 && PlayerInfo[playerid][pAdmin] != 1341)
				{
					SendClientMessage(playerid, COR_GRAD1, "Voc� n�o est� trabalhando! (/trabalhar)");
					return 1;
				}
				if(PlayerInfo[sscanfid][pAdmin] >= 1  && PlayerInfo[sscanfid][pAdmin] != 1342)
				{
					format(stringZCMD, sizeof(stringZCMD), "ID[%d] est� off-line.", sscanfid);
					SendClientMessage(playerid, COR_GRAD1, stringZCMD);
					return 1;
				}
				if(IsPlayerConnected(sscanfid))
				{
					if(sscanfid != INVALID_PLAYER_ID)
					{
						GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
						GetPlayerName(playerid, sendername, sizeof(sendername));
						PlayerInfo[sscanfid][pAvisos] += 1;
						if(PlayerInfo[sscanfid][pAvisos] >= 3)
						{
							getdate(year, month, day);
							pban[playerid] += 1;
							if(pban[playerid] >= 3 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
							{
								BanTPL(playerid, "Baniu mais de 3", "Automatico");
								return 1;
							}
							format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi banido por %s(3� Aviso), Motivo: %s (%d-%d-%d)", giveplayerZCMD, sendername, (result),day,month,year);
							BanTempLog(stringZCMD);
							format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi banido por %s(3� Aviso), Motivo: %s", giveplayerZCMD, sendername, (result));
							SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
							getdate(Ano, Mes, Dia);
							PlayerInfo[sscanfid][pDiaBanTemp] = Dia;
							if(Mes == 11)
							{
								PlayerInfo[sscanfid][pMesBanTemp] = 1;
								PlayerInfo[sscanfid][pAnoBanTemp] = Ano+1;
							}
							else if(Mes == 12)
							{
								PlayerInfo[sscanfid][pMesBanTemp] = 2;
								PlayerInfo[sscanfid][pAnoBanTemp] = Ano+1;
							}
							else if(Mes <= 10)
							{
								PlayerInfo[sscanfid][pMesBanTemp] = Mes+2;
								PlayerInfo[sscanfid][pAnoBanTemp] = Ano;
							}
							OnPlayerSave(sscanfid);
							PlayerInfo[playerid][pAvisos] = 0;
							BanTemp(sscanfid, "Terceiro aviso", PlayerName(playerid));
							return 1;
						}
						format(stringZCMD, sizeof(stringZCMD), "Admin %s avisou %s, Motivo: %s", sendername,giveplayerZCMD, (result));
						SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
						format(stringZCMD, sizeof(stringZCMD), "Voc� foi avisado por %s, Motivo: %s",sendername, (result));
						SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
						return 1;
					}
				}//not connected
			}
			else
			{
				SendClientMessage(playerid, COR_GRAD1, "Esse n�o � um jogador ativo.");
			}
		}
		return 1;
	}
