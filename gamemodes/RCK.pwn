	CMD:advogados(playerid, params[])
	{
		if(IsPlayerConnected(sscanfid))
		{
			SendClientMessage(playerid, COR_VERDE, "Advogados Online:");
			foreach(new i: Player)
			{
				if(IsPlayerConnected(i))
				{
					if(PlayerInfo[i][pEmprego] == 2)
					{
						new cel = PlayerInfo[i][pPnumber];
						new level = PlayerInfo[i][pLawSkill];
						GetPlayerName(i,sendername,sizeof(sendername));
						if(level >= 0 && level <= 50)
						{
							format(stringZCMD, 128, "%s: ID[%d] - Cel[%d] - Hab[Um]",sendername,i,cel);
							SendClientMessage(playerid, COR_GRAD2, stringZCMD);
						}
						if(level >= 51 && level <= 100)
						{
							format(stringZCMD, 128, "%s: ID[%d] - Cel[%d] - Hab[Dois]",sendername,i,cel);
							SendClientMessage(playerid, COR_GRAD2, stringZCMD);
						}
						if(level >= 101 && level <= 200)
						{
							format(stringZCMD, 128, "%s: ID[%d] - Cel[%d] - Hab[Tr�s]",sendername,i,cel);
							SendClientMessage(playerid, COR_GRAD2, stringZCMD);
						}
						if(level >= 201 && level <= 300)
						{
							format(stringZCMD, 128, "%s: ID[%d] - Cel[%d] - Hab[Quatro]",sendername,i,cel);
							SendClientMessage(playerid, COR_GRAD2, stringZCMD);
						}
						if(level >= 301)
						{
							format(stringZCMD, 128, "%s: ID[%d] - Cel[%d] - Hab[Cinco]",sendername,i,cel);
							SendClientMessage(playerid, COR_GRAD2, stringZCMD);
						}
					}
				}
			}
		}
		return true;
	}
