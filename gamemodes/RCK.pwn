stock AbrirFecharMala(rstatus,veiculoid){
	new mot, lu, alar, por, cap, porma, ob;
    GetVehicleParamsEx(veiculoid, mot, lu, alar, por, cap, porma, ob);
    if(rstatus == 1) SetVehicleParamsEx(veiculoid, mot, lu, alar, por, cap, VEHICLE_PARAMS_ON, ob);
    if(rstatus == 0) SetVehicleParamsEx(veiculoid, mot, lu, alar, por, cap, VEHICLE_PARAMS_OFF, ob);
	return 1;
}
