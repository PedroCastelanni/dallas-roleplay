	           	SetPlayerArmour(playerid,Colete - 0);
	       	}
	       	else
	       	{
	           	SetPlayerHealth(playerid,Vida - 0);
	      	}
          	if(WantedLevel[playerid] != 0)
            {
               	new vid = GetPlayerVehicleID(playerid);
                if(!IsPlayerInVehicle(issuerid, vid))
