	CMD:setartaxa(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pLider] != 7)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o � o Governador !");
				return 1;
			}
			if(sscanf(params, "d", moneysZCMD)) {
				SendClientMessage(playerid, COR_BRANCO, "{0099ff}�{ffffff} USE: /setartaxa [quantidade]");
				return 1;
			}
			if(moneysZCMD < 1 || moneysZCMD > 1000) { SendClientMessage(playerid, COR_GREY, "O Dinheiro da Taxa n�o pode ser menor que 1 ou maior que 1000 !"); return 1; }
			Tax = moneysZCMD;
			SaveStuff();
			format(stringZCMD, sizeof(stringZCMD), "* Cada Jogador vai pagar uma taxa de R$[%d], apartir de agora!", Tax);
			SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
			format(stringZCMD, sizeof(stringZCMD), "Not�cias: O Governador acaba de mudar a Taxa por Pessoa para: R$[%d].", Tax);
			SendClientMessageToAll(COR_LIGHTBLUE, stringZCMD);
		}
		return 1;
	}
	CMD:dartaxa(playerid, params[])
	{
		if(IsPlayerConnected(playerid))
		{
			if(PlayerInfo[playerid][pLider] != 7)
			{
				SendClientMessage(playerid, COR_GREY, "Voc� n�o � o Governador !");
				return 1;
			}
			if(Tax < 1)
			{
				SendClientMessage(playerid, COR_GREY, "N�o h� Dinheiro suficiente no banco de Impostos !");
				return 1;
			}
			new Cops = 0;
			foreach(new i: Player)
			{
				if(IsPlayerConnected(i))
				{
					if(IsACop(i))
					{
						Cops += 1;
					}
				}
			}
			if(Cops >= 1)
			{
				new price = Tax / Cops;
				if(CofreOrg[7][Dinheiro] < Tax)return SendClientMessage(playerid, COR_GRAD1, "O cofre da prefeitura n�o tem esse dinheiro todo!");
				SacarOrgGrana(7,Tax);
				PLV += Tax;
				foreach(new i: Player)
				{
					if(IsPlayerConnected(i))
					{
						if(IsACop(i))
						{
							SendClientMessage(playerid, COR_GREY, "Voc� deu a taxa para todos os policiais online!");
							format(stringZCMD, sizeof(stringZCMD), "* Voc� recebeu R$[%d] do banco de Impostos pelo Governador.",price);
							SendClientMessage(i, COR_LIGHTBLUE, stringZCMD);
							GivePlayerMoneyEx(i, price);
							Tax = 0;
						}
					}
				}
				SaveStuff();
			}
			else
			{
				SendClientMessage(playerid, COR_GREY, "N�o h� nenhum Policial Online no Momento !");
				return 1;
			}
		}
		return 1;
	}
