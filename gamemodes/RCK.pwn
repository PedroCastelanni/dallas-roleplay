	CMD:bloqueio(playerid, params[])  return ForT:bq(playerid, params);
	CMD:bq(playerid, params[])
	{
		if (!IsACop(playerid))
		{
			SendClientMessage(playerid,COR_AMARELO," Voc� n�o e um policial!");
			return 1;
		}
		if(IsPlayerInAnyVehicle(playerid))
		{
			SendClientMessage(playerid, COR_GREY, "N�o � possivel plantar bloqueios dentro de veiculos!");
			return 1;
		}
		if(PlayerInfo[playerid][pJailed] != 0)
		{
			SendClientMessage(playerid,COR_AMARELO," Voc� n�o pode plantar bloqueio na cadeia!");
			return 1;
		}
		if(GetTickCount() - AguardarB[playerid] < 5000)
		{
